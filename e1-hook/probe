#!/bin/bash
# e1-hook/probe: the three coprocessor words the sleep engine polls, read in the
# state the one-way recipe leaves them in, without a one-way run. In a safe boot
# only, as root; the charger may stay in:
#
#   pkexec /home/corey/src/sleep-drain/e1-hook/probe
#
# What it's for (PLAN.md, "The order after run 17"; RESEARCH.md, "After run 17"):
# B2, the second sequence of the engine's entry pair, powers SIO's, ANS's and the
# PMP's domains up in turn and waits each time for bit 1 of the first word of the
# coprocessor's mailbox block. Nothing had read those words, and run 17 says B2
# doesn't get through that part.
#
# What it does: loads e1_hook with --m1-mark's parameters and probe=1, and asks
# for one suspend. With probe=1 the module never replays: at that suspend's
# prepare and prepare_late it stops SIO's firmware and the PMP's as the recipe
# does, raises SIO's power again as the recipe does, raises ANS2 as the engine
# does and puts it back, reads the three words around each step, and then fails
# the suspend, so the Mac comes straight back awake. No key is written to the
# SMC and nothing is committed (e1-hook/asc_probe.h has the steps and the bytes).
#
# Then it prints what the module logged, for a photo, and saves it with
# sleep-drain-safe save. After the probe SIO's firmware and the PMP's are
# stopped for the rest of the boot. Neither of the kernel's drivers for them
# does anything at resume (apple-sio's resume is empty, apple_pmp has none), so
# the Mac should come back with its screen and keyboard; sound, which goes
# through SIO, won't work. In case more is gone than that, once the probe has
# run this uses only bash builtins and files in RAM, as e1a-platform does, and
# the one thing left to do is restart the Mac (hold the power key if nothing
# else works). If the screen never comes back at all, the module has left its
# record in the PMU, the step it reached and three bytes: e1-hook/m1-crumbs
# reads it after the restart.
#
# With --look (PLAN.md, "The order after the probe"; e1-hook/look.h) it loads the
# module with look=1 as well, and the module then takes none of those steps: it
# stops nothing and writes no register. It reads the words the pair's remaining
# waits depend on, awake at its load and again after the noirq pass of the
# suspend it fails, and logs them. This script then doesn't load
# pmp_sleep_release either, and refuses if it's loaded. Nothing is stopped, so
# that suspend should be an ordinary failed one, with the Mac back as it was;
# that hasn't been tried, and the probe's own suspend didn't come back. So the
# look at the load is printed and saved before the suspend is asked for.
#
# With --gate (e1-hook/gate_test.h) it's --look and one test more, the only part
# of a look that writes registers: after the second look the module switches
# off the five UARTs Linux's suspend leaves at 4, watches the gate the engine
# waits on after SIO's subtree, gives the fabric lane above SIO macOS's value,
# watches again, and writes all six words back as it found them. If the gate
# does close, SIO's island loses power with SIO's firmware running, which
# Linux's own suspend doesn't do here: the Mac may then not come back, as after
# the probe, and e1-hook/m1-crumbs reads the test's record from the PMU.
#
# With --pre (e1-hook/pre_test.h) it's --look and another test that writes
# registers: after the second look the module writes the 22 clock words the
# engine's entry writes first (0x28e03801c, seven from 0x28e0a0004, fourteen
# from 0x28e5b0004) as the engine writes them, reads each back at once and
# 100 ms later, and writes all 22 back as it found them. The run that wrote
# them in the recipe's state went on to its commit; whether the kernel keeps
# running across them and resumes hasn't been tried, so this too may not come
# back, and e1-hook/m1-crumbs reads the test's record from the PMU.
#
# It asks for the suspend through /sys/power/state, so systemd's sleep hook
# doesn't run: no line in the sleep log, and the radios stay as they are.
#
# Before the load it has pmp_sleep_release withdraw the PMP's display report
# requests at this suspend's noirq (sleep-drain-pmp release 0xc 0xd), as
# run-floor does for every run since run 7 and as T8140's driver does before it
# idles the PMP: the PMP has never been idled here with them asserted. That
# module asserts them again at resume, which here is to a stopped PMP: each
# times out after 0.1 s and is logged as an error, and nothing else follows from
# it (pmp_sleep_release.c). It stays loaded until the restart.
set -u
die() { echo "probe: $*" >&2; exit 1; }

here=$(cd "$(dirname "$0")" && pwd)
ko=${PROBE_KO:-$here/e1_hook.ko}
SAFE_FLAG=${PROBE_SAFE_FLAG:-/run/sleep-drain-safe/active}
MODDIR=${PROBE_MODDIR:-/sys/module/e1_hook}
STATE=${PROBE_STATE:-/sys/power/state}
PM_TEST=${PROBE_PM_TEST:-/sys/power/pm_test}
MEM_SLEEP=${PROBE_MEM_SLEEP:-/sys/power/mem_sleep}
LOGDIR=${PROBE_LOGDIR:-/var/log/sleep-drain}
RUNDIR=${PROBE_RUNDIR:-/run}
SAVE=${PROBE_SAVE:-/usr/local/bin/sleep-drain-safe}
PMP=${PROBE_PMP:-/usr/local/bin/sleep-drain-pmp}
PMPMOD=${PROBE_PMPMOD:-/sys/module/pmp_sleep_release}
CRUMBS=${PROBE_CRUMBS:-$here/m1-crumbs}
# --m1-mark's parameters, the latest recipe's, and probe=1 on top: the module refuses probe=1 without them.
PARAMS=(replay=15 oneway=1 quiet=1 m1=1 pmgr_late=1 alarm=1 hold=1 hold_nowatch=1 pmp_out=1 sio_on=1 disp_off=1 one_commit=1
        smc_idle=1 sio_stop=1 ps_words=1 wd2_bite=1 cluster_ack=1 fabric_up=1 wd1_mark=1 probe=1)

look=0
gate=0
pre=0
if [[ ${1:-} == --look ]]; then
  look=1
  shift
  PARAMS+=(look=1)
elif [[ ${1:-} == --gate ]]; then
  look=1
  gate=1
  shift
  PARAMS+=(look=1 gate=1)
elif [[ ${1:-} == --pre ]]; then
  look=1
  pre=1
  shift
  PARAMS+=(look=1 pre_test=1)
fi
(($# == 0)) || die "usage: probe [--look | --gate | --pre]"
# The module's count that says its part of a suspend has begun: the probe's first half runs at prepare; the look
# does nothing there, and runs at the first prepare_late.
count=prepare_calls
((look)) && count=prepare_late_calls
[[ $EUID -eq 0 ]] || die "run with pkexec"
[[ -f $SAFE_FLAG ]] || die "safe boot only: pkexec sleep-drain-safe boot, then restart"
[[ ! -d $MODDIR ]] || die "e1_hook is loaded already: restart into a fresh safe boot"
[[ -f $ko ]] || die "no $ko: make -C $here"
[[ $(modinfo -F vermagic "$ko" 2> /dev/null | cut -d' ' -f1) == "$(uname -r)" ]] || die "$ko isn't built for $(uname -r): make -C $here"
for src in e1_hook.c asc_probe.h look.h gate_test.h pre_test.h sio_steps.h sio_down.h gates_mark.h fabric_up.h wd1_mark.h wd2_bite.h recfg_bite.h m1_position.h; do
  [[ $ko -nt $here/$src ]] || die "e1_hook.ko is older than $src: make -C $here"
done
[[ $(modinfo -p "$ko" 2> /dev/null) == *$'\n'probe:* || $(modinfo -p "$ko" 2> /dev/null) == probe:* ]] ||
  die "$ko is an older build, without probe: make -C $here"
if ((look)); then
  [[ $(modinfo -p "$ko" 2> /dev/null) == *$'\n'look:* || $(modinfo -p "$ko" 2> /dev/null) == look:* ]] ||
    die "$ko is an older build, without look: make -C $here"
  ((!gate)) || [[ $(modinfo -p "$ko" 2> /dev/null) == *$'\n'gate:* || $(modinfo -p "$ko" 2> /dev/null) == gate:* ]] ||
    die "$ko is an older build, without gate: make -C $here"
  ((!pre)) || [[ $(modinfo -p "$ko" 2> /dev/null) == *$'\n'pre_test:* || $(modinfo -p "$ko" 2> /dev/null) == pre_test:* ]] ||
    die "$ko is an older build, without pre_test: make -C $here"
  # Left loaded by a probe earlier in this boot, it would withdraw the PMP's requests at this suspend too.
  [[ ! -d $PMPMOD ]] || die "pmp_sleep_release is loaded, so the look's suspend wouldn't be an ordinary one: restart into a fresh safe boot"
fi
[[ $(< "$PM_TEST") == *"[none]"* ]] || die "pm_test isn't none"
[[ $(< "$MEM_SLEEP") == *"[s2idle]"* ]] || die "s2idle isn't the sleep mode"
# The breadcrumbs have to be clear: the module refuses otherwise, and says so less plainly.
crumbs=$("$CRUMBS" 2> /dev/null)
grep -q "^stage 0x6004 = 0x00:" <<< "$crumbs" || die "the PMU's breadcrumbs aren't clear: pkexec $here/m1-crumbs --clear"
# And the bytes beside the stage, where the gate test leaves the lane's reads: none left there under a zero stage (Pullfrog on #80).
grep -q "^0x6010: 00 00 00 00 00 00 00 " <<< "$crumbs" || die "the PMU's 0x6010-0x6016 aren't clear, though the stage is: pkexec $here/m1-crumbs --clear"

mkdir -p "$LOGDIR" || die "couldn't make $LOGDIR"
# The log as it grows is kept out of $LOGDIR: sleep-drain-safe save archives every new file there as it finds it, and
# collect never replaces a file with a different copy of itself, so a file saved twice at two lengths would be
# collected at its first (Pullfrog on #78). A file goes into $LOGDIR whole, once, just before the save that takes it.
stamp=$(date +%Y%m%dT%H%M%S)
live=$RUNDIR/asc-probe-$stamp.txt
out=$LOGDIR/asc-probe-$stamp.txt
: > "$live" || die "couldn't write $live"
# Builtins only from here on: printf, read, $(< file), [[ ]].
log() { printf '%s\n' "$*"; printf '%s\n' "$*" >> "$live"; }
# The log so far, copied to the new file $1 and saved; by builtins alone, for after the probe.
keep() {
  local line
  [[ ! -e $1 ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do printf '%s\n' "$line"; done < "$live" > "$1" || return 1
  "$SAVE" save "$1" > /dev/null 2>&1
}
now() { printf '%(%F %T)T' -1; }
get() {
  local v=
  if IFS= read -r v 2> /dev/null < "$1" || [[ -n $v ]]; then
    printf '%s' "$v"
  else
    printf 'READ FAILED'
  fi
}
# The kernel log's lines that contain $1. dmesg and grep are programs on the disk, and so is sleep (used only
# while nothing has been stopped): this very pipeline runs once before the suspend, so they're in memory after it.
klog() {
  local lines line
  if lines=$(dmesg 2>&1 | grep -F -- "$1"); then
    while IFS= read -r line; do log "  $line"; done <<< "$lines"
  else
    log "  (no line with \"$1\" in the kernel log, or dmesg failed: $lines)"
  fi
}

# Not for the look: it idles nothing, and the suspend it fails is to be an ordinary one.
if ((!look)); then
  "$PMP" release 0xc 0xd > /dev/null 2>&1 || die "couldn't load the PMP report-release module (pkexec bash install.sh?): nothing loaded, nothing probed"
fi
log "$(now) loading e1_hook with ${PARAMS[*]}"
if ! insmod "$ko" "${PARAMS[@]}"; then
  log "e1_hook didn't load; nothing was probed. The kernel's last lines from it:"
  klog e1_hook
  keep "$out" || log "(that wasn't saved: the lines above are the record)"
  exit 1
fi
# A build that doesn't know probe would load with it ignored: then this would be a one-way run. Never go on without it:
# its replay is called off first, so that even a module that won't unload can't run it.
if [[ $(get "$MODDIR/parameters/probe") != Y ]]; then
  if printf 1 > "$MODDIR/parameters/cancel" 2> /dev/null; then off="its replay is called off"; else off="ITS REPLAY COULD NOT BE CALLED OFF"; fi
  rmmod e1_hook 2> /dev/null && die "e1_hook didn't take probe=1, and was unloaded: nothing was probed. make -C $here"
  die "e1_hook didn't take probe=1 and DID NOT UNLOAD ($off): restart the Mac now, and don't let it suspend first. Nothing was probed"
fi
# The same for look=1: without it the module would stop SIO's firmware and the PMP's, and the Mac wouldn't come back.
if ((look)) && [[ $(get "$MODDIR/parameters/look") != Y ]]; then
  rmmod e1_hook 2> /dev/null && die "e1_hook didn't take look=1, and was unloaded: nothing was read. make -C $here"
  die "e1_hook didn't take look=1 and DID NOT UNLOAD: restart the Mac now, and don't let it suspend first. Nothing was read"
fi
# And for gate=1: without it this would be a plain look, and the test asked for wouldn't run.
if ((gate)) && [[ $(get "$MODDIR/parameters/gate") != Y ]]; then
  rmmod e1_hook 2> /dev/null && die "e1_hook didn't take gate=1, and was unloaded: nothing was read. make -C $here"
  die "e1_hook didn't take gate=1 and DID NOT UNLOAD: restart the Mac now, and don't let it suspend first. Nothing was read"
fi
# And for pre_test=1, the same.
if ((pre)) && [[ $(get "$MODDIR/parameters/pre_test") != Y ]]; then
  rmmod e1_hook 2> /dev/null && die "e1_hook didn't take pre_test=1, and was unloaded: the test wasn't run. make -C $here"
  die "e1_hook didn't take pre_test=1 and DID NOT UNLOAD: restart the Mac now, and don't let it suspend first. The test wasn't run"
fi
# Into memory now, for after the probe: the pipeline klog runs, on the kernel log as it is, and sleep.
dmesg 2>&1 | grep -F -- "e1_hook: probe:" > /dev/null; sleep 0
# The look at the load is in the kernel log already: printed and saved now, in case the suspend doesn't come back.
if ((look)); then
  log "kernel log, the look awake, at the load:"
  klog "e1_hook: look: awake, at load"
  ((!pre)) || klog "e1_hook: look: pre: awake, at load"
  if keep "${out%.txt}-load.txt"; then log "(saved: the look at the load is on the boot partition)"; else log "(NOT SAVED: the lines above are the record of the look at the load)"; fi
fi
# A suspend that ends before the module's part of it (a key still going up, a device that says no) has probed nothing
# and stopped nothing: it's asked for again, twice at most. Once that part has begun, in this script's suspend or in
# one something else asked for meanwhile (the lid, logind), there is no other.
rc=none
# The gate test's other ending, said before it can happen: afterwards there may be no screen to say it on.
((!gate)) || log "THE GATE TEST MAY NOT COME BACK. If the screen goes dark and is still dark after a minute, hold the power key until the Mac restarts, log in, and tell Claude: that is one of this test's two endings, and its result is then in the PMU."
((!pre)) || log "THIS TEST MAY NOT COME BACK. If the screen goes dark or freezes and is still so after a minute, hold the power key until the Mac restarts, log in, and tell Claude: its result is then in the PMU."
for try in 1 2 3; do
  [[ $(get "$MODDIR/parameters/$count") == 0 ]] || break
  log "$(now) asking for the suspend ($try of 3 at most). HANDS OFF the keyboard and trackpad until the photo block. The screen may flicker; the Mac does not sleep: the module fails the suspend when it's done"
  printf mem > "$STATE" 2> /dev/null
  rc=$?
  [[ $(get "$MODDIR/parameters/$count") == 0 ]] || break
  log "$(now) that suspend ended before the module's part of it (it returned $rc): nothing was probed or stopped"
  ((try < 3)) && sleep 3
done
began=$(get "$MODDIR/parameters/$count")
pc=$(get "$MODDIR/parameters/prepare_calls")
plc=$(get "$MODDIR/parameters/prepare_late_calls")
if [[ $began == 0 ]]; then
  log "NOTHING WAS PROBED: three suspends ended before the module ran, and nothing was stopped. The kernel's PM lines:"
  klog "PM: "
  if rmmod e1_hook; then
    log "e1_hook is unloaded again. Run the same command once more: no restart is needed."
  else
    log "e1_hook didn't unload: restart into a fresh safe boot before trying again."
  fi
  keep "$out" || log "(that wasn't saved: the lines above are the record)"
  exit 1
fi
# The gate test's look after noirq goes above the photo block: below it, its thirty lines would push the SUMMARY off the screen.
if ((gate)); then
  log "kernel log, the look after noirq, which came before the gate test:"
  klog "e1_hook: look: after noirq"
fi
if ((pre)); then
  log "kernel log, the look after noirq, which came before the 22 words' test:"
  klog "e1_hook: look: after noirq"
fi
log ""
log "==================== TAKE A PHOTO OF THIS SCREEN ===================="
log "$(now) back; this script's last suspend returned $rc (non-zero is right: the module fails it; none: another suspend got there first)"
log "replay_done=$(get "$MODDIR/parameters/replay_done") (0 is right: nothing replayed) prepare_calls=$pc prepare_late_calls=$plc"
if ((look)); then
  [[ $plc == 1 ]] || log "THE LOOK AFTER NOIRQ RAN AT ANOTHER SUSPEND THAN THIS SCRIPT'S LAST (prepare_late_calls 1 is the plain case): the lines below are what there is."
  if ((gate)); then
    log "kernel log, the gate test (the SUMMARY line is the result; both looks are above, and in the saved file):"
    klog "e1_hook: look: gate:"
  elif ((pre)); then
    log "kernel log, the 22 words' test (the SUMMARY line is the result; both looks are above, and in the saved file):"
    klog "e1_hook: look: pre:"
  else
    log "kernel log, the look after noirq (the look at the load is above, and in the saved file):"
    klog "e1_hook: look: after noirq"
  fi
else
  [[ $pc == 1 && $plc == 1 ]] || log "ONLY PART OF THE PROBE RAN (1 and 1 is a whole one): the lines below are what there is."
  log "kernel log, the probe's lines (the SUMMARY line is the result):"
  klog "e1_hook: probe:"
fi
log "====================================================================="
log ""
log "Saving to the boot partition. If nothing more appears within a minute, the photo is the result: restart the Mac."
if keep "$out"; then
  log "Saved. Now restart the Mac (hold the power key if the keyboard doesn't answer), log in, and tell Claude."
else
  log "NOT SAVED: the photo is the result. Then restart the Mac (hold the power key if the keyboard doesn't answer)."
fi
