#!/bin/bash
# e1-hook/run-floor: the floor (PLAN.md, A5), in a safe boot only, as root:
#
#   pkexec /home/corey/src/sleep-drain/e1-hook/run-floor [--quick] [--quiet | --m1 | --m1-observe | --m1-late | --m1-alarm | --m1-hold | --m1-hold-nowatch | --m1-pmp | --m1-pmp-idle | --m1-position | --m1-sio-pmp | --m1-disp-off | --m1-macos-end | --m1-sio-stop | --m1-power-words]
#
# --quick, ahead of the recipe, makes the reading 1 minute instead of 10, with no need to wait
# 20 minutes off the charger: for a run whose question is how it ends. If one ever goes dark for
# good, repeat it without --quick before trusting a drain number from it.
#
# THIS IS ONE WAY: THE MAC NEVER WAKES FROM IT. It loads e1_hook with
# replay=15 oneway=1, so the next suspend's prepare_late runs maralcbr's
# replay at its floor setting, bits 0-3 (e1_hook.c says what: the keys, the
# PMP words, the 74 post-slpa writes, then every CPU powered down for good),
# then takes the 10-minute reading, saves it and suspends, as V2 and E1a did
# (sleep-drain-reading take --label floor --then suspend), and waits for that
# suspend. --quiet (E2's first rung, PLAN.md) adds quiet=1: the same, but
# without maralcbr's 500 ms and its two reads after the post-slpa writes, so
# the commit is the last thing the replay touches before the CPUs power down;
# its reading's label is floor-quiet. --m1 (E2's M1 recipe, PLAN.md) adds m1=1
# to --quiet's: the other CPUs parked before the post-slpa writes and stopped
# one by one before the commit, every interrupt masked, the AP wake mask, boot
# stage 0x50 and breadcrumbs in the PMU (e1_hook.c says what); its reading's
# label is floor-m1. --m1-observe (E2's M1 run 2) adds observe=1 to --m1's:
# CPU7 stays up through the commit, watches CPU0 and the E complex power down,
# reads the watchdogs and records it all in the same breadcrumbs before it
# stops; its label is floor-m1-observe, and what's said of --m1 below holds
# for it too. --m1-late (E2's M1 run 3) adds pmgr_late=1 to --m1-observe's:
# the table's PMGR quiesce goes out after slpa, in its place, with macOS's
# waits, and the breadcrumbs say which waits timed out and when EACC and
# PACC0 finished powering down; its label is floor-m1-late, and what's said
# of --m1 and --m1-observe below holds for it too. --m1-alarm (E2's M1 run 4)
# is --m1 with pmgr_late=1 and alarm=1: the PMGR quiesce as in --m1-late, no
# observer (CPU7 goes down before the commit, as in --m1, so no CPU7 record),
# and the PMU's RTC alarm, for an hour after the commit, written between the
# commit's first write and the other two; its label is floor-m1-alarm, and
# what's said of --m1 below holds for it too. --m1-hold (E2's hold rung,
# PLAN.md) is --m1-alarm with hold=1: each other CPU writes its own stop bit
# in step 6 and holds, awake and spinning, through the commit (modeled on
# XNU's H13 global sleep, whose secondaries stall in WFE); after the third
# commit CPU0 lets go, they power down, and CPU0 reads them off and records
# that, then takes its own deep WFI last; its label is
# floor-m1-hold. --m1-hold-nowatch adds hold_nowatch=1: CPU0 doesn't read
# them, the run to make once a watched one comes back clean; its label is
# floor-m1-hold-nowatch. --m1-pmp (E2's PMP rung, PLAN.md rung 3) is --m1-hold
# with pmp_out=1: right after slpa, while interrupts are still on, the PMP's idle
# pair (SetAPPower 0x201 then SetIOPPower 0x201, once each), and if its ASC then
# reads idle, its CPU stopped with one write (RUN, bit 4 of 0x28ec00044); its
# label is floor-m1-pmp. --m1-pmp-idle adds pmp_stop=0, the idle pair only; its
# label is floor-m1-pmp-idle. --m1-position (E2's position read, PLAN.md) is
# --m1-hold with position=1: after reading the others down CPU0 stays up, every
# exception still masked, and samples where the engine is, about 1 s and about 25
# s after the third commit, and records each sample in the PMU's breadcrumbs. It
# reads only, and writes no PMU byte --m1-hold doesn't. pkexec
# /home/corey/src/sleep-drain/e1-hook/recfg-peek --position must have read every
# word awake first, in this boot, and this refuses without its mark in /run; its
# label is floor-m1-position. --m1-sio-pmp (E2's combined rung, PLAN.md) is --m1-pmp
# with position=1 and sio_on=1: right before the table's SIO_CPU word, ps_sio, UART_P
# and SPI_P on (new PMGR writes, Corey's OK of 2026-11-09); it also withdraws the PMP's
# display report requests (sleep-drain-pmp release 0xc 0xd), and takes one position
# sample at about 1 s, CPU0 then going down at once. A hang in those raises is dark at
# stage 0x90 (0x10 with bit 7). No awake pass needed; its label is floor-m1-sio-pmp.
# --m1-disp-off (E2's display rung, PLAN.md) adds disp_off=1 to that: before noirq, both DCPs'
# firmware shut down through RTKit and their CPUs stopped, then after slpa their domains off
# (new RTKit messages, ASC writes and PMGR writes, Corey's OK of 2026-11-09). A hang there is
# dark at stage 0x02 or 0x84, and a suspend that then fails has no display to show NO FLOOR on
# (its log has it). Its label is floor-m1-disp-off. --m1-macos-end adds one_commit=1 and
# smc_idle=1 to that: the commit written once, and after K4 the AP idle notice to the SMC (a new
# RTKit message, Corey's OK of 2026-11-09). Its label is floor-m1-macos-end. --m1-sio-stop is that
# with SIO's firmware stopped before noirq (its idle pair, and if that returns 0, RUN cleared: Corey's
# OK of 2026-11-09) and hold_nowatch=1 in place of position=1, so CPU0 goes straight to its deep WFI
# after the commit and there's no sample. Its label is floor-m1-sio-stop. --m1-power-words is that with
# ps_words=1: macOS's remaining 20 power words at the end of step 5, after the table (new PMGR writes, Corey's
# OK of 2026-11-09). A hang in them is dark at stage 0xa8. Its label is floor-m1-power-words.
# What's said of --m1, --m1-alarm and --m1-hold
# below holds for all of them. It ends one of three ways:
#   - A reset: about 30 s after the screen goes dark, the Mac restarts by
#     itself into the regular boot. That's most likely the S2R entry's
#     watchdog, WD2 (RESEARCH.md, "The floor"): the entry didn't complete.
#     After --m1-observe and --m1-late, m1-crumbs says which watchdogs were
#     armed at CPU7's read after its polls (at most about 1.5 s after the
#     commit, likely a few ms) and when the first would bite;
#     if it was WD1, armed again, the entry may have completed before it.
#     In the regular boot, pkexec /usr/local/bin/sleep-drain-safe collect;
#     BACC dates it.
#     After --m1, also, before anything else touches the PMU:
#       /home/corey/src/sleep-drain/e1-hook/m1-crumbs, for a photo or a copy,
#       then pkexec /home/corey/src/sleep-drain/e1-hook/m1-crumbs --clear
#       (after --m1-alarm, --m1-hold, --m1-position, --m1-sio-pmp, --m1-disp-off, --m1-macos-end, --m1-sio-stop and --m1-power-words, --clear also disarms the alarm the run armed, 0x1401
#       back to 0x01, so that it can't power the Mac on an hour later; every
#       m1 run refuses to load while it reads armed).
#     After --m1-position, also, in that same boot, once m1-crumbs and collect
#     are done (the next restart would lose what the reset left):
#       pkexec /home/corey/src/sleep-drain/e1-hook/recfg-peek --position-after
#   - Dark for good: the screen goes dark, if it isn't already, and it and
#     the keyboard (dark since the reading began) stay dark past 2 minutes.
#     Nothing wakes the Mac from it. If that's new (it's a candidate for a
#     completed entry), leave it at least 30 minutes, then the steps below.
#     After --m1-alarm, --m1-hold, --m1-position, --m1-sio-pmp, --m1-disp-off, --m1-macos-end, --m1-sio-stop or --m1-power-words, do them before about 55 minutes: the alarm fires 60
#     minutes after the commit, and if it wakes the SoC, the wake lands in
#     m1n1 with no way back and the Mac hangs, at an unknown draw, until the
#     power key. If it's dark past that, expect that and end it the same way.
#       1. Press the power key once, briefly, and wait 30 s. If the screen
#          comes back, it's the last ending, below.
#       2. If it stays dark, hold the key until the Mac is off (about 10 s;
#          the screen gives no cue), let go, and press it once more straight
#          away, so that BACC dates the end. Then, in the next boot:
#            pkexec bash -c '/usr/local/bin/sleep-drain-safe collect &&
#                            /usr/local/bin/sleep-drain-reading take --label floor'
#          and after run-floor --quiet, the same with --label floor-quiet.
#          After --m1: m1-crumbs first, as above, then the same with --label
#          floor-m1 (floor-m1-observe after --m1-observe, floor-m1-late
#          after --m1-late, floor-m1-alarm after --m1-alarm, floor-m1-hold
#          and floor-m1-hold-nowatch after those, floor-m1-pmp and
#          floor-m1-pmp-idle after --m1-pmp and --m1-pmp-idle, floor-m1-position
#          after --m1-position, floor-m1-sio-pmp after --m1-sio-pmp, floor-m1-disp-off after --m1-disp-off, floor-m1-macos-end after --m1-macos-end, floor-m1-sio-stop after --m1-sio-stop, floor-m1-power-words after --m1-power-words: --clear before
#          the reading, since a PMU write can't change BQCC). After --m1-position,
#          collect on its own first, then, before the reading, recfg-peek
#          --position-after as above. --m1 can also hang
#          dark without completing the entry: DeepIdle's R20 did, on an M2
#          Pro, and its S2R watchdog never reset it. Only that reading's BQCC tells the two apart, and m1-crumbs
#          says how far it got, at least. So for --m1, be ready to end it
#          this way.
#   - No floor: the keyboard lights up, full, and this prints "NO FLOOR"
#     with what happened (unlock the screen to see it), and tries to save it.
#     Photograph it, then restart. That happens when the suspend
#     fails, when the replay stops short (e1_hook then fails the suspend, so
#     that the Mac wakes with its log), or when no suspend begins within
#     120 s. With e1_hook loaded, nothing else can put the Mac to sleep: only
#     the first suspend after its load can replay, and any suspend that
#     doesn't replay fails. So dark always means the floor.
#
# A fault in the replay (an oops, or the SError a bad write raises) would
# leave the Mac hung and dark, as if it were in the floor. So this sets
# kernel.panic=10 and kernel.panic_on_oops=1 before it loads the module: a
# fault then restarts the Mac 10 s later (into the regular boot), which BACC
# dates. They stay set until the restart.
#
# Until the reading has asked for the suspend, any other way out (a failed
# reading or save, a closed terminal, a signal, a broken stdout) unloads the
# module again, so nothing stays armed without its saved reading. After that,
# a way out calls the replay off instead: an unload then would let the
# suspend already asked for sleep as a plain s2idle, dark like the floor.
set -euo pipefail

SAFE_FLAG=${FLOOR_SAFE_FLAG:-/run/sleep-drain-safe/active}
AC=${FLOOR_AC:-/sys/class/power_supply/macsmc-ac}
MODDIR=${FLOOR_MODDIR:-/sys/module/e1_hook}
READING=${FLOOR_READING:-/usr/local/bin/sleep-drain-reading}
SAVE=${FLOOR_SAVE:-/usr/local/bin/sleep-drain-safe}
PM_TEST=${FLOOR_PM_TEST:-/sys/power/pm_test}
STATS=${FLOOR_STATS:-/sys/power/suspend_stats}
SYSCTL=${FLOOR_SYSCTL:-/proc/sys/kernel}
LOGDIR=${FLOOR_LOGDIR:-/var/log}
KBD=${FLOOR_KBD:-/sys/class/leds/kbd_backlight}
RUNDIR=${FLOOR_RUNDIR:-/run}
PMP=${FLOOR_PMP:-/usr/local/bin/sleep-drain-pmp}
# How long, awake, the suspend may take to begin after the reading asks.
WATCH_S=${FLOOR_WATCH_S:-120}

die() { echo "run-floor: $*" >&2; exit 1; }

quiet=0
m1=0
observe=0
late=0
alarm=0
hold=0
nowatch=0
pmp=0
nostop=0
position=0
sio=0
disp=0
macend=0
siostop=0
pwords=0
quick=()
label=floor
# --quick, ahead of the rest: a 1-minute reading, for a run whose question is how it ends, not what it draws.
if [[ ${1:-} == --quick ]]; then
  quick=(--minutes 1)
  shift
fi
if (($# == 1)) && [[ $1 == --quiet ]]; then
  quiet=1
  label=floor-quiet
elif (($# == 1)) && [[ $1 == --m1 ]]; then
  quiet=1
  m1=1
  label=floor-m1
elif (($# == 1)) && [[ $1 == --m1-observe ]]; then
  quiet=1
  m1=1
  observe=1
  label=floor-m1-observe
elif (($# == 1)) && [[ $1 == --m1-late ]]; then
  quiet=1
  m1=1
  observe=1
  late=1
  label=floor-m1-late
elif (($# == 1)) && [[ $1 == --m1-alarm ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  label=floor-m1-alarm
elif (($# == 1)) && [[ $1 == --m1-hold || $1 == --m1-hold-nowatch ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  hold=1
  label=floor-m1-hold
  if [[ $1 == --m1-hold-nowatch ]]; then
    nowatch=1
    label=floor-m1-hold-nowatch
  fi
elif (($# == 1)) && [[ $1 == --m1-pmp || $1 == --m1-pmp-idle ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  hold=1
  pmp=1
  label=floor-m1-pmp
  if [[ $1 == --m1-pmp-idle ]]; then
    nostop=1
    label=floor-m1-pmp-idle
  fi
elif (($# == 1)) && [[ $1 == --m1-position ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  hold=1
  position=1
  label=floor-m1-position
elif (($# == 1)) && [[ $1 == --m1-sio-pmp ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  hold=1
  pmp=1
  position=1
  sio=1
  label=floor-m1-sio-pmp
elif (($# == 1)) && [[ $1 == --m1-disp-off ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  hold=1
  pmp=1
  position=1
  sio=1
  disp=1
  label=floor-m1-disp-off
elif (($# == 1)) && [[ $1 == --m1-macos-end ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  hold=1
  pmp=1
  position=1
  sio=1
  disp=1
  macend=1
  label=floor-m1-macos-end
elif (($# == 1)) && [[ $1 == --m1-sio-stop ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  hold=1
  nowatch=1
  pmp=1
  sio=1
  disp=1
  macend=1
  siostop=1
  label=floor-m1-sio-stop
elif (($# == 1)) && [[ $1 == --m1-power-words ]]; then
  quiet=1
  m1=1
  late=1
  alarm=1
  hold=1
  nowatch=1
  pmp=1
  sio=1
  disp=1
  macend=1
  siostop=1
  pwords=1
  label=floor-m1-power-words
elif (($# != 0)); then
  die "usage: run-floor [--quick] [--quiet | --m1 | --m1-observe | --m1-late | --m1-alarm | --m1-hold | --m1-hold-nowatch | --m1-pmp | --m1-pmp-idle | --m1-position | --m1-sio-pmp | --m1-disp-off | --m1-macos-end | --m1-sio-stop | --m1-power-words]"
fi

here=$(cd "$(dirname "$0")" && pwd)
ko=$here/e1_hook.ko
[[ $EUID -eq 0 ]] || die "run as root (pkexec)"
[[ -f $SAFE_FLAG ]] || die "the floor runs in a safe boot only: pkexec sleep-drain-safe boot, then restart"
[[ -f $ko ]] || die "no $ko: make -C $here"
[[ $(modinfo -F vermagic "$ko" | cut -d' ' -f1) == "$(uname -r)" ]] || die "$ko isn't built for $(uname -r): make -C $here"
# Builds before this one have no cancel (E1a's has no oneway either), and
# their insmod would fail with a bare "Invalid parameters", or load without
# the one-shot rule.
parms=$'\n'$(modinfo -F parm "$ko")
[[ $parms == *$'\n'cancel:* ]] || die "$ko is an older build, without the floor: make -C $here"
((!quiet)) || [[ $parms == *$'\n'quiet:* ]] || die "$ko is an older build, without quiet: make -C $here"
((!m1)) || [[ $parms == *$'\n'm1:* ]] || die "$ko is an older build, without m1: make -C $here"
((!observe)) || [[ $parms == *$'\n'observe:* ]] || die "$ko is an older build, without observe: make -C $here"
((!late)) || [[ $parms == *$'\n'pmgr_late:* ]] || die "$ko is an older build, without pmgr_late: make -C $here"
((!alarm)) || [[ $parms == *$'\n'alarm:* ]] || die "$ko is an older build, without alarm: make -C $here"
((!hold)) || [[ $parms == *$'\n'hold:* ]] || die "$ko is an older build, without hold: make -C $here"
((!pmp)) || [[ $parms == *$'\n'pmp_out:* ]] || die "$ko is an older build, without pmp_out: make -C $here"
((!position)) || [[ $parms == *$'\n'position:* ]] || die "$ko is an older build, without position: make -C $here"
((!sio)) || [[ $parms == *$'\n'sio_on:* ]] || die "$ko is an older build, without sio_on: make -C $here"
((!disp)) || [[ $parms == *$'\n'disp_off:* ]] || die "$ko is an older build, without disp_off: make -C $here"
((!macend)) || [[ $parms == *$'\n'one_commit:* && $parms == *$'\n'smc_idle:* ]] || die "$ko is an older build, without one_commit and smc_idle: make -C $here"
((!siostop)) || [[ $parms == *$'\n'sio_stop:* ]] || die "$ko is an older build, without sio_stop: make -C $here"
((!pwords)) || [[ $parms == *$'\n'ps_words:* ]] || die "$ko is an older build, without ps_words: make -C $here"
[[ ! -d $MODDIR ]] || die "e1_hook is loaded already; restart for a clean safe boot"
[[ $(cat "$AC/online") == 0 ]] || die "unplug the charger first"
[[ $(cat "$PM_TEST") == *"[none]"* ]] || die "pm_test isn't none, so the suspend wouldn't be a real one: echo none > $PM_TEST"
# The awake pass first, in this boot: a bad address faults there, not after the commit. --m1-sio-pmp doesn't
# need it: run 6 read every one of its addresses after the commit, and its load log has them awake.
((!position || sio)) || [[ -f $RUNDIR/sleep-drain-position-awake ]] ||
  die "the awake pass hasn't run in this boot: pkexec $here/recfg-peek --position first"

# Disarm on every way out but the floor itself. Before the hand-off
# (armed=1), that's an unload. The reading runs in the background and the
# launcher waits for it, because bash holds a trapped signal until a
# foreground command ends: a signal now interrupts the wait at once. Its
# handler stops the reading's own process (a save under way still finishes;
# only the request for the suspend, its last step, can't come any more), waits
# for it to end, and exits with 128 + the signal, which runs the EXIT trap.
# After the hand-off (armed=2), it's calling the replay off: the suspend may be
# on its way, and e1_hook has to stay loaded for it, so that it fails. SIGPIPE
# is ignored, so a broken stdout fails the write (and set -e exits) instead of
# killing the launcher outright.
armed=0
reader=
disarm() {
  case $armed in
  1)
    if rmmod e1_hook 2> /dev/null; then
      echo "run-floor: nothing replayed; e1_hook unloaded" >&2 2> /dev/null || true
    fi
    ;;
  2)
    printf '1\n' 2> /dev/null > "$MODDIR/parameters/cancel" || true
    ;;
  esac
  armed=0
}
cancel() {
  if [[ -n $reader ]]; then
    kill -TERM "$reader" 2> /dev/null || true
    wait "$reader" 2> /dev/null || true
    reader=
  fi
  exit "$1"
}
trap 'disarm' EXIT
trap 'cancel 129' HUP
trap 'cancel 130' INT
trap 'cancel 143' TERM
trap '' PIPE

echo 10 > "$SYSCTL/panic"
echo 1 > "$SYSCTL/panic_on_oops"

# Ready for the watch now, while the disk is certainly there: its log file, a
# FIFO for read -t to wait on (a sleep without a program), and dmesg and grep,
# run once so that they're in memory. After a replay the NVMe may be gone, and
# then a program that isn't in memory can't start (e1a-platform, #28).
out=$LOGDIR/run-floor-$(date +%Y%m%dT%H%M%S).txt
: > "$out"
fifo=$(mktemp -u "$RUNDIR/run-floor.XXXXXX")
mkfifo -m 600 "$fifo"
exec {tick}<> "$fifo"
rm -f "$fifo"
dmesg > /dev/null 2>&1 || true
grep -F x /dev/null || true

params=(replay=15 oneway=1)
((!quiet)) || params+=(quiet=1)
((!m1)) || params+=(m1=1)
((!observe)) || params+=(observe=1)
((!late)) || params+=(pmgr_late=1)
((!alarm)) || params+=(alarm=1)
((!hold)) || params+=(hold=1)
((!nowatch)) || params+=(hold_nowatch=1)
((!pmp)) || params+=(pmp_out=1)
((!nostop)) || params+=(pmp_stop=0)
((!position)) || params+=(position=1)
((!sio)) || params+=(sio_on=1)
((!disp)) || params+=(disp_off=1)
((!macend)) || params+=(one_commit=1 smc_idle=1)
((!siostop)) || params+=(sio_stop=1)
((!pwords)) || params+=(ps_words=1)
armed=1
insmod "$ko" "${params[@]}"
# A build that doesn't know them would load with them ignored, and only warn.
[[ $(cat "$MODDIR/parameters/replay") == 15 && $(cat "$MODDIR/parameters/oneway") == Y ]] &&
  { ((!quiet)) || [[ $(cat "$MODDIR/parameters/quiet") == Y ]]; } &&
  { ((!m1)) || [[ $(cat "$MODDIR/parameters/m1") == Y ]]; } &&
  { ((!observe)) || [[ $(cat "$MODDIR/parameters/observe") == Y ]]; } &&
  { ((!late)) || [[ $(cat "$MODDIR/parameters/pmgr_late") == Y ]]; } &&
  { ((!alarm)) || [[ $(cat "$MODDIR/parameters/alarm") == Y ]]; } &&
  { ((!hold)) || [[ $(cat "$MODDIR/parameters/hold") == Y ]]; } &&
  { ((!nowatch)) || [[ $(cat "$MODDIR/parameters/hold_nowatch") == Y ]]; } &&
  { ((!pmp)) || [[ $(cat "$MODDIR/parameters/pmp_out") == Y ]]; } &&
  { ((!nostop)) || [[ $(cat "$MODDIR/parameters/pmp_stop") == N ]]; } &&
  { ((!position)) || [[ $(cat "$MODDIR/parameters/position") == Y ]]; } &&
  { ((!sio)) || [[ $(cat "$MODDIR/parameters/sio_on") == Y ]]; } &&
  { ((!disp)) || [[ $(cat "$MODDIR/parameters/disp_off") == Y ]]; } &&
  { ((!macend)) || [[ $(cat "$MODDIR/parameters/one_commit") == Y && $(cat "$MODDIR/parameters/smc_idle") == Y ]]; } &&
  { ((!siostop)) || [[ $(cat "$MODDIR/parameters/sio_stop") == Y ]]; } &&
  { ((!pwords)) || [[ $(cat "$MODDIR/parameters/ps_words") == Y ]]; } ||
  die "e1_hook didn't take ${params[*]}: make -C $here"
# --m1-sio-pmp: the PMP's display report requests withdrawn at this suspend's noirq (Corey's pick of 2026-11-09), as
# T8140's driver does before it idles the PMP. A reboot undoes it; the module stays loaded on the ways out here.
if ((sio)); then
  "$PMP" release 0xc 0xd > /dev/null || die "couldn't load the PMP report-release module: nothing replayed"
fi
minutes=10
if ((${#quick[@]})); then minutes=1; fi
echo "e1_hook loaded with ${params[*]}. Leave the Mac alone: in about $minutes minutes the reading ends and the Mac suspends into the floor, one way (this script's header says how it can end)"
"$READING" take "${quick[@]}" --label "$label" --then suspend &
reader=$!
wait "$reader"
reader=

# The reading saved and asked for the suspend, but systemctl only queues it.
# So this stays, and watches for the kernel's try: every suspend adds one to
# suspend_stats' success or fail, whether it fails or not. If the floor runs,
# nothing here runs again. If the suspend comes back, or none has begun within
# WATCH_S s awake, the floor didn't happen: the replay is called off, and what
# happened is printed, for a photo, and saved if the disk still answers. From
# here on: bash builtins, and the two programs run above.
armed=2
log() {
  printf '%s\n' "$*" 2> /dev/null || true
  printf '%s\n' "$*" 2> /dev/null >> "$out" || true
}
now() { printf '%(%F %T)T' -1; }
# One sysfs read, or what went wrong: a checked read, as in e1a-platform.
get() {
  local v=
  if IFS= read -r v 2> /dev/null < "$1" || [[ -n $v ]]; then
    printf '%s' "$v"
  else
    printf 'READ FAILED'
  fi
}
tries() { printf 'success=%s fail=%s' "$(get "$STATS/success")" "$(get "$STATS/fail")"; }
klog() {
  local lines line
  if lines=$(dmesg 2>&1 | grep -F -- "$1"); then
    while IFS= read -r line; do log "  $line"; done <<< "$lines"
  else
    log "  (dmesg | grep found nothing, or failed: $lines)"
  fi
}

base=$(tries)
for ((i = 0; i < WATCH_S; i++)); do
  read -r -t 1 -u "$tick" || true
  [[ $(tries) == "$base" ]] || break
done
if ((i < WATCH_S)); then
  what="the suspend failed or came back"
else
  what="no suspend began within $WATCH_S s"
fi
printf '1\n' 2> /dev/null > "$MODDIR/parameters/cancel" || true
# The sign that shows without touching the Mac: the keyboard, dark since the
# reading began, lit full.
kbd=$(get "$KBD/max_brightness")
[[ $kbd =~ ^[0-9]+$ ]] || kbd=255
printf '%s\n' "$kbd" 2> /dev/null > "$KBD/brightness" || true
p=$MODDIR/parameters
log ""
log "===================== NO FLOOR: TAKE A PHOTO OF THIS SCREEN ====================="
log "$(now) $what: the floor didn't happen, and the replay is called off"
log "suspend_stats: before $base, now $(tries); last failed step $(get "$STATS/last_failed_step"), errno $(get "$STATS/last_failed_errno")"
log "e1_hook: attempts=$(get "$p/attempts") prepare_late_calls=$(get "$p/prepare_late_calls") replay_done=$(get "$p/replay_done")"
log "         replay_ret=$(get "$p/replay_ret") eh_writes=$(get "$p/eh_writes") post_writes=$(get "$p/post_writes") late_ret=$(get "$p/late_ret")"
log "  (replay_done: 1 = ran and stopped short, 2 = called off; replay_ret: MBSE=slpw, pmVC, WKTP, MBSE=slpa, 0 = accepted, 1 = not sent)"
((!m1)) || log "         m1_ret=$(get "$p/m1_ret") m1_undo=$(get "$p/m1_undo") (the PMU at the replay's start, then boot stage 0x30 again and the breadcrumbs zeroed; 0 = done, 1 = not sent or not needed)"
log "kernel log, e1_hook:"
klog e1_hook
log "================================================================================="
log "Saving to the boot partition (this fails if the NVMe is gone)..."
"$SAVE" save "$out" || log "NOT SAVED: the photo is the result"
log "Then restart the Mac. With e1_hook loaded it can't sleep, so don't close the lid first."
exit 2
