[[ $(modinfo -F vermagic "$ko" | cut -d' ' -f1) == "$(uname -r)" ]] || die "$ko isn't built for $(uname -r): make -C $here"
# A build older than its sources may be another version's, with the same parameters: what it leaves in the PMU would be
# read by this version's m1-crumbs, and --m1-recfg-bite's first build had its byte's two bite codes the other way round.
