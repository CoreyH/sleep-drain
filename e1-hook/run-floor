# Disarm on every way out but the floor itself. Before the hand-off
# (armed=1), that's an unload. The reading runs in the background and the
# launcher waits for it, because bash holds a trapped signal until a
# foreground command ends: a signal now interrupts the wait at once. Its
# handler stops the reading's own process (a save under way still finishes;
# only the request for the suspend, its last step, can't come any more), waits
# for it to end, and exits with 128 + the signal, which runs the EXIT trap.
# After the hand-off (armed=2), it's calling the replay off: the suspend may be
# on its way, and e1_hook has to stay loaded for it, so that it fails. SIGPIPE
# is ignored, so a broken stdout fails the write (and set -e exits) instead of
# killing the launcher outright.
armed=0
patched=0
wd2took=0
# The option that ran wd2-bite, for the message about what its store left.
wd2opt=--m1-wd2-bite
((!ack)) || wd2opt=--m1-cluster-ack
((!fab)) || wd2opt=--m1-fabric-up
((!mark)) || wd2opt=--m1-mark
((!gates)) || wd2opt=--m1-gates
((!siodown)) || wd2opt=--m1-sio-down
((!pciedown)) || wd2opt=--m1-pcie-down
((!siosteps)) || wd2opt=--m1-sio-steps
((!a2pre)) || wd2opt=--m1-a2-pre
((!acclast)) || wd2opt=--m1-acc-last
reader=
disarm() {
  local again
  case $armed in
  1)
    if rmmod e1_hook 2> /dev/null; then
      echo "run-floor: nothing replayed; e1_hook unloaded" >&2 2> /dev/null || true
    fi
    ;;
  2)
    printf '1\n' 2> /dev/null > "$MODDIR/parameters/cancel" || true
    ;;
  esac
  armed=0
  # --m1-recfg-bite: the one write isn't undone here (its header says why). Say what's left, and whether this boot can
  # still be used: with e1_hook loaded (the replay called off, or an unload that failed) the launcher refuses.
  if ((patched)); then
    patched=0
    again="run-floor --m1-recfg-bite can simply be run again"
    [[ ! -d $MODDIR ]] || again="e1_hook is still loaded, so restart before another run"
    echo "run-floor: A2's bite word was changed and still reads 45 s (recfg-bite --restore, in a safe boot, writes 30 s again; $again)" >&2 2> /dev/null || true
  fi
  # --m1-wd2-bite: nothing writes the 90 s back (the OK is for one value). Say what's left.
  if ((wd2took)); then
    wd2took=0
    again="run-floor $wd2opt can simply be run again"
    [[ ! -d $MODDIR ]] || again="e1_hook is still loaded, so restart before another run"
    echo "run-floor: WD2's bite still reads 120 s from wd2-bite's write (WD2 isn't armed awake, so that changes nothing by itself, and a restart undoes it; $again)" >&2 2> /dev/null || true
  fi
}
cancel() {
  if [[ -n $reader ]]; then
    kill -TERM "$reader" 2> /dev/null || true
    wait "$reader" 2> /dev/null || true
    reader=
  fi
  exit "$1"
}
trap 'disarm' EXIT
trap 'cancel 129' HUP
trap 'cancel 130' INT
trap 'cancel 143' TERM
trap '' PIPE

echo 10 > "$SYSCTL/panic"
echo 1 > "$SYSCTL/panic_on_oops"

# Ready for the watch now, while the disk is certainly there: its log file, a
# FIFO for read -t to wait on (a sleep without a program), and dmesg and grep,
# run once so that they're in memory. After a replay the NVMe may be gone, and
# then a program that isn't in memory can't start (e1a-platform, #28).
out=$LOGDIR/run-floor-$(date +%Y%m%dT%H%M%S).txt
: > "$out"
fifo=$(mktemp -u "$RUNDIR/run-floor.XXXXXX")
mkfifo -m 600 "$fifo"
exec {tick}<> "$fifo"
rm -f "$fifo"
dmesg > /dev/null 2>&1 || true
grep -F x /dev/null || true

# --m1-recfg-bite: the one SRAM write, before anything is loaded (recfg-bite: the check, saved, then the write,
# saved). kernel.panic is set by now, so a write that faults restarts the Mac 10 s later. If the word can't be
# changed, that's the run's result, and nothing else happens.
if ((recfg)); then
  # A line of this script's own first: with a broken stdout it fails here, and set -e stops before anything is written.
  echo "run-floor: A2's bite word first (recfg-bite), then the module and the reading"
  rc=0
  "$BITE" || rc=$?
  case $rc in
  0) patched=1 ;;
  3)
    die "A2's bite word wasn't changed: the SRAM isn't as expected (recfg-bite exit 3, above). Nothing is loaded and nothing replays. That's a result, and what was saved of it is on the boot partition: restart the Mac"
    ;;
  5)
    die "the write was made and the ten words don't read as meant (recfg-bite exit 5: the writer's lines above say what they read now). Nothing is loaded and nothing replays. That's a result, and what was saved of it is on the boot partition: restart the Mac"
    ;;
  4)
    die "recfg-bite stopped before its write (exit 4, above: a tool to rebuild, or a save that failed). Nothing was written and nothing is loaded. Once that's fixed this can be run again, in this same boot"
    ;;
  *)
    # recfg-bite says itself, in capitals, when the writer ran and the word may read 45 s.
    die "recfg-bite failed (exit $rc), above. Nothing is loaded and nothing replays: restart the Mac"
    ;;
  esac
fi

# --m1-wd2-bite: the control, before anything is loaded (wd2-bite: a read-only check, saved, then one store to WD2's
# bite from user space, saved). kernel.panic is set by now, so a write that faults restarts the Mac 10 s later.
# Whether the store took is the control's result, and the run goes on either way: e1_hook's own write, after the
# commit, is the kernel's. It goes on, too, if the bite read 120 s before any store in this boot (no control then,
# and no store). It stops if WD2 isn't as it is awake, or the launcher failed.
if ((wd2)); then
  # A line of this script's own first: with a broken stdout it fails here, and set -e stops before anything is written.
  echo "run-floor: WD2's bite from user space first (wd2-bite), then the module and the reading"
  rc=0
  "$WD2BITE" || rc=$?
  case $rc in
  0)
    wd2took=1
    echo "run-floor: wd2-bite's store took: WD2's bite reads 120 s. Going on to the run"
    ;;
  5)
    echo "run-floor: wd2-bite's store didn't take (exit 5, above): that's a result, and it's saved. Going on to the run: e1_hook's write is the kernel's"
    ;;
  7)
    echo "run-floor: wd2-bite made no store: WD2's bite read 120 s already, with none made in this boot (exit 7, above). The control wasn't made, and that's saved. Going on to the run"
    ;;
  3)
    die "WD2 isn't as it is awake (wd2-bite exit 3, above), so nothing was written. Nothing is loaded and nothing replays. That's a result, and what was saved of it is on the boot partition: restart the Mac"
    ;;
  4)
    die "wd2-bite stopped before its write (exit 4, above: a tool to rebuild, most likely). Nothing was written and nothing is loaded. Once that's fixed this can be run again, in this same boot"
    ;;
  *)
    # wd2-bite says itself, in capitals, when the writer ran and the bite may read 120 s. A save that failed ends here
    # too, whatever the store did: it can leave the boot partition mounted.
    die "wd2-bite failed (exit $rc), above. Nothing is loaded and nothing replays: restart the Mac"
    ;;
  esac
fi

params=(replay=15 oneway=1)
((!quiet)) || params+=(quiet=1)
((!m1)) || params+=(m1=1)
((!observe)) || params+=(observe=1)
((!late)) || params+=(pmgr_late=1)
((!alarm)) || params+=(alarm=1)
((!hold)) || params+=(hold=1)
((!nowatch)) || params+=(hold_nowatch=1)
((!pmp)) || params+=(pmp_out=1)
((!nostop)) || params+=(pmp_stop=0)
((!position)) || params+=(position=1)
((!sio)) || params+=(sio_on=1)
((!disp)) || params+=(disp_off=1)
((!macend)) || params+=(one_commit=1 smc_idle=1)
((!siostop)) || params+=(sio_stop=1)
((!pwords)) || params+=(ps_words=1)
((!recfg)) || params+=(recfg_bite=1)
((!wd2)) || params+=(wd2_bite=1)
((!ack)) || params+=(cluster_ack=1)
((!fab)) || params+=(fabric_up=1)
((!mark)) || params+=(wd1_mark=1)
((!gates)) || params+=(gates_mark=1)
((!siodown)) || params+=(sio_down=1)
((!pciedown)) || params+=(pcie_down=1)
((!siosteps)) || params+=(sio_steps=1)
((!a2pre)) || params+=(a2_pre=1)
((!acclast)) || params+=(acc_last=1)
armed=1
if ! insmod "$ko" "${params[@]}"; then
  # The module says why in the kernel log, which a safe boot loses at the restart: show it now, and keep it.
  {
    echo "run-floor: e1_hook didn't load; nothing replayed. The kernel's last lines from it:"
    dmesg 2> /dev/null | grep -F e1_hook | tail -n 6 || true
  } 2>&1 | tee -a "$out" >&2 || true
  "$SAVE" save "$out" > /dev/null 2>&1 || echo "run-floor: (that wasn't saved: the lines above are the record)" >&2
  exit 1
fi
# A build that doesn't know them would load with them ignored, and only warn.
[[ $(cat "$MODDIR/parameters/replay") == 15 && $(cat "$MODDIR/parameters/oneway") == Y ]] &&
  { ((!quiet)) || [[ $(cat "$MODDIR/parameters/quiet") == Y ]]; } &&
  { ((!m1)) || [[ $(cat "$MODDIR/parameters/m1") == Y ]]; } &&
  { ((!observe)) || [[ $(cat "$MODDIR/parameters/observe") == Y ]]; } &&
  { ((!late)) || [[ $(cat "$MODDIR/parameters/pmgr_late") == Y ]]; } &&
  { ((!alarm)) || [[ $(cat "$MODDIR/parameters/alarm") == Y ]]; } &&
  { ((!hold)) || [[ $(cat "$MODDIR/parameters/hold") == Y ]]; } &&
  { ((!nowatch)) || [[ $(cat "$MODDIR/parameters/hold_nowatch") == Y ]]; } &&
  { ((!pmp)) || [[ $(cat "$MODDIR/parameters/pmp_out") == Y ]]; } &&
  { ((!nostop)) || [[ $(cat "$MODDIR/parameters/pmp_stop") == N ]]; } &&
  { ((!position)) || [[ $(cat "$MODDIR/parameters/position") == Y ]]; } &&
  { ((!sio)) || [[ $(cat "$MODDIR/parameters/sio_on") == Y ]]; } &&
  { ((!disp)) || [[ $(cat "$MODDIR/parameters/disp_off") == Y ]]; } &&
  { ((!macend)) || [[ $(cat "$MODDIR/parameters/one_commit") == Y && $(cat "$MODDIR/parameters/smc_idle") == Y ]]; } &&
  { ((!siostop)) || [[ $(cat "$MODDIR/parameters/sio_stop") == Y ]]; } &&
  { ((!pwords)) || [[ $(cat "$MODDIR/parameters/ps_words") == Y ]]; } &&
  { ((!recfg)) || [[ $(cat "$MODDIR/parameters/recfg_bite") == Y ]]; } &&
  { ((!wd2)) || [[ $(cat "$MODDIR/parameters/wd2_bite") == Y ]]; } &&
  { ((!ack)) || [[ $(cat "$MODDIR/parameters/cluster_ack") == Y ]]; } &&
  { ((!fab)) || [[ $(cat "$MODDIR/parameters/fabric_up") == Y ]]; } &&
  { ((!mark)) || [[ $(cat "$MODDIR/parameters/wd1_mark") == Y ]]; } &&
  { ((!gates)) || [[ $(cat "$MODDIR/parameters/gates_mark") == Y ]]; } &&
  { ((!siodown)) || [[ $(cat "$MODDIR/parameters/sio_down") == Y ]]; } &&
  { ((!pciedown)) || [[ $(cat "$MODDIR/parameters/pcie_down") == Y ]]; } &&
  { ((!siosteps)) || [[ $(cat "$MODDIR/parameters/sio_steps") == Y ]]; } &&
  { ((!a2pre)) || [[ $(cat "$MODDIR/parameters/a2_pre") == Y ]]; } &&
  { ((!acclast)) || [[ $(cat "$MODDIR/parameters/acc_last") == Y ]]; } ||
  die "e1_hook didn't take ${params[*]}: make -C $here"
# --m1-sio-pmp: the PMP's display report requests withdrawn at this suspend's noirq (Corey's pick of 2026-11-09), as
# T8140's driver does before it idles the PMP. A reboot undoes it; the module stays loaded on the ways out here.
if ((sio)); then
  "$PMP" release 0xc 0xd > /dev/null || die "couldn't load the PMP report-release module: nothing replayed"
fi
minutes=10
if ((${#quick[@]})); then minutes=1; fi
echo "e1_hook loaded with ${params[*]}. Leave the Mac alone: in about $minutes minutes the reading ends and the Mac suspends into the floor, one way (this script's header says how it can end)"
"$READING" take "${quick[@]}" --label "$label" --then suspend &
reader=$!
wait "$reader"
reader=

# The reading saved and asked for the suspend, but systemctl only queues it.
# So this stays, and watches for the kernel's try: every suspend adds one to
# suspend_stats' success or fail, whether it fails or not. If the floor runs,
# nothing here runs again. If the suspend comes back, or none has begun within
# WATCH_S s awake, the floor didn't happen: the replay is called off, and what
# happened is printed, for a photo, and saved if the disk still answers. From
# here on: bash builtins, and the two programs run above.
armed=2
log() {
  printf '%s\n' "$*" 2> /dev/null || true
  printf '%s\n' "$*" 2> /dev/null >> "$out" || true
}
now() { printf '%(%F %T)T' -1; }
# One sysfs read, or what went wrong: a checked read, as in e1a-platform.
get() {
  local v=
  if IFS= read -r v 2> /dev/null < "$1" || [[ -n $v ]]; then
    printf '%s' "$v"
  else
    printf 'READ FAILED'
  fi
}
tries() { printf 'success=%s fail=%s' "$(get "$STATS/success")" "$(get "$STATS/fail")"; }
klog() {
  local lines line
  if lines=$(dmesg 2>&1 | grep -F -- "$1"); then
    while IFS= read -r line; do log "  $line"; done <<< "$lines"
  else
    log "  (dmesg | grep found nothing, or failed: $lines)"
  fi
}

base=$(tries)
for ((i = 0; i < WATCH_S; i++)); do
  read -r -t 1 -u "$tick" || true
  [[ $(tries) == "$base" ]] || break
done
if ((i < WATCH_S)); then
  what="the suspend failed or came back"
else
  what="no suspend began within $WATCH_S s"
fi
printf '1\n' 2> /dev/null > "$MODDIR/parameters/cancel" || true
# The sign that shows without touching the Mac: the keyboard, dark since the
# reading began, lit full.
kbd=$(get "$KBD/max_brightness")
[[ $kbd =~ ^[0-9]+$ ]] || kbd=255
printf '%s\n' "$kbd" 2> /dev/null > "$KBD/brightness" || true
p=$MODDIR/parameters
log ""
log "===================== NO FLOOR: TAKE A PHOTO OF THIS SCREEN ====================="
log "$(now) $what: the floor didn't happen, and the replay is called off"
log "suspend_stats: before $base, now $(tries); last failed step $(get "$STATS/last_failed_step"), errno $(get "$STATS/last_failed_errno")"
log "e1_hook: attempts=$(get "$p/attempts") prepare_late_calls=$(get "$p/prepare_late_calls") replay_done=$(get "$p/replay_done")"
log "         replay_ret=$(get "$p/replay_ret") eh_writes=$(get "$p/eh_writes") post_writes=$(get "$p/post_writes") late_ret=$(get "$p/late_ret")"
log "  (replay_done: 1 = ran and stopped short, 2 = called off; replay_ret: MBSE=slpw, pmVC, WKTP, MBSE=slpa, 0 = accepted, 1 = not sent)"
((!m1)) || log "         m1_ret=$(get "$p/m1_ret") m1_undo=$(get "$p/m1_undo") (the PMU at the replay's start, then boot stage 0x30 again and the breadcrumbs zeroed; 0 = done, 1 = not sent or not needed)"
log "kernel log, e1_hook:"
klog e1_hook
if ((patched)); then
  patched=0
  log "A2's bite word was changed and still reads 45 s: nothing here puts it back (recfg-bite's header says why)"
fi
if ((wd2took)); then
  wd2took=0
  log "WD2's bite still reads 120 s from wd2-bite's write: nothing here puts the 90 s back (WD2 isn't armed awake, and a restart undoes it)"
fi
log "================================================================================="
log "Saving to the boot partition (this fails if the NVMe is gone)..."
"$SAVE" save "$out" || log "NOT SAVED: the photo is the result"
log "Then restart the Mac. With e1_hook loaded it can't sleep, so don't close the lid first."
exit 2
