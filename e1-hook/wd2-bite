#!/bin/bash
# e1-hook/wd2-bite: WD2's bite register written once from user space, awake, the control for
# runs 13 and 14 (PLAN.md, "The order after run 14"; RESEARCH.md, "M1 run 14"), as root, in a
# safe boot:
#
#   pkexec /home/corey/src/sleep-drain/e1-hook/wd2-bite
#
# Corey's OK of 2026-11-10: one register, 0x2922b0024, to 0xaba95000 (120 s), written here once
# and once more by e1_hook after the commit. run-floor --m1-wd2-bite runs this itself, before
# it loads anything.
#
# recfg_poke's stores to the reconfig SRAM were dropped, and nothing had shown that a store
# made its way, from user space through /dev/mem, changes any register on this Mac. This makes
# one such store where nothing is at stake: awake, WD2 isn't armed, and the engine's sequences
# write the bite themselves before they arm it. First wd2_poke check, read-only: WD2's control,
# count and bite. Its output, and a line that says the write comes next, are saved to the boot
# partition (sleep-drain-safe save) before anything is written, so a crash at the write keeps
# them. Then wd2_poke patch: it reads the three words again, writes only if WD2 is as it is
# awake (control 0, bite 90 s), and reads all three back. Its output is saved too.
#
# Nothing puts the 90 s back: the OK is for one value. The bite of a watchdog that isn't armed
# changes nothing by itself, and a restart brings the 90 s back (inferred).
#
# kernel.panic is set to 10 before the store, as run-floor sets it: an access that faults then
# restarts the Mac 10 s later instead of leaving it hung.
#
# Each step has a directory of its own, /var/log/sleep-drain/wd2-bite-<time>-<step>/, never
# changed after its save.
#
# Exit status: 0, the bite reads 120 s (written now, or there already): a store of this kind
# works here; 5, the write was made and the bite still reads 90 s: that's a result too, and
# the run can go on; 3, WD2 isn't as it is awake, and nothing was written; 4, it stopped
# before the write for another reason, and nothing was written; 1, anything else (the write
# was made and WD2 reads some other way, or the writer or a save failed after it began).
set -u

fail=4
die() { echo "wd2-bite: $*" >&2; exit "$fail"; }

HERE=$(dirname "$(realpath "$0")")
POKE=${WD2_POKE:-$HERE/wd2_poke}
POKE_SRC=${WD2_POKE_SRC:-$HERE/wd2_poke.c}
HEADER=${WD2_HEADER:-$HERE/wd2_bite.h}
SAFE_FLAG=${WD2_SAFE_FLAG:-/run/sleep-drain-safe/active}
SAVE=${WD2_SAVE:-/usr/local/bin/sleep-drain-safe}
LOG_ROOT=${WD2_LOG_ROOT:-/var/log/sleep-drain}
SYSCTL=${WD2_SYSCTL:-/proc/sys/kernel}

if (($# != 0)); then
  fail=1
  die "usage: wd2-bite"
fi
# Until the writer starts, a stop means nothing was written: run-floor goes by that.
[[ $EUID -eq 0 ]] || die "run as root (pkexec)"
[[ -f $SAFE_FLAG ]] || die "this runs in a safe boot only: pkexec sleep-drain-safe boot, then restart"
# The tool is built from the header too.
[[ -x $POKE && $POKE -nt $POKE_SRC && $POKE -nt $HEADER ]] || die "$POKE is missing or older than its source: cc -O2 -Wall -o $POKE $POKE_SRC"

now=$(date +%Y%m%dT%H%M%S)

# A step's output is in the boot partition's save before the next step.
keep() {
  sync -f "$1"
  "$SAVE" save > /dev/null
}

# dir NAME: a step's own directory, new: one that exists is another run's, a second ago, and may be in a save already.
# Sets out and log.
dir() {
  out=$LOG_ROOT/wd2-bite-$now-$1
  mkdir "$out" 2> /dev/null || die "couldn't make $out (if it's there already, wait a second and run this again)"
  log=$out/log.txt
}

# For a stop that is itself a result: say so if its record didn't reach the boot partition.
keep_or_say() {
  keep "$1" > /dev/null 2>&1 || echo "wd2-bite: NOT SAVED: the lines above are the only record, so photograph them before any restart" >&2
}

# run PROGRAM ARGS...: its output shown, and appended to $log. Sets rc.
run() {
  local st
  "$@" 2>&1 | tee -a "$log"
  st=("${PIPESTATUS[@]}")
  rc=${st[0]}
  if ((st[1] != 0)); then
    keep "$log" > /dev/null 2>&1
    die "couldn't write $log (tee exit ${st[1]}); ${1##*/} exited $rc"
  fi
}

# From the writer's start to a finished, saved write, any way out says what state the register may be in.
started=0
warn() {
  ((started)) || return 0
  echo "wd2-bite: WD2'S BITE MAY READ 120 s NOW: the writer ran, and this ended before its record was complete. WD2 isn't armed awake, so that changes nothing by itself, and a restart undoes it" >&2
}
trap warn EXIT

echo "wd2-bite: saving under $LOG_ROOT/wd2-bite-$now-*/"
dir check
run "$POKE" check
if ((rc == 3)); then
  keep_or_say "$log"
  echo "wd2-bite: WD2 isn't as it is awake (above): nothing written. That's a result." >&2
  exit 3
fi
if ((rc != 0)); then
  echo "the check failed (exit $rc); nothing written" | tee -a "$log"
  keep_or_say "$log"
  die "the check failed (exit $rc); nothing written"
fi
echo "next: wd2_poke patch, one 32-bit store from user space, 0x2922b0024 := 0xaba95000 (120 s), if the check above still holds" | tee -a "$log"
keep "$log" || die "couldn't save the check; nothing written"
# A store that faults: a restart 10 s later, not a hang (run-floor's own setting, for a run by hand).
echo 10 > "$SYSCTL/panic" || die "couldn't set kernel.panic"

dir write
fail=1
started=1
run "$POKE" patch
case $rc in
0) ;;
3)
  # The writer read the three words again and refused.
  started=0
  keep_or_say "$log"
  echo "wd2-bite: WD2 changed between the check and the write: nothing written." >&2
  exit 3
  ;;
5)
  started=0
  keep_or_say "$log"
  echo "wd2-bite: THE WRITE DIDN'T TAKE: a store from user space didn't change this register. That's a result: runs 13 and 14 then say nothing about the SRAM." >&2
  exit 5
  ;;
*)
  keep_or_say "$log"
  die "wd2_poke failed (exit $rc)"
  ;;
esac
keep "$log" || die "couldn't save the write's record"
started=0
echo "wd2-bite: done: WD2's bite reads 120 s, so a store from user space changes a register here. It stays 120 s until the engine arms WD2 or the Mac restarts."
exit 0
