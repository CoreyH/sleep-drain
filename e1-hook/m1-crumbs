def pmp_byte(p):
    """0x6015 in a pmp_out=1 run: K4's byte; bit 7 says it landed."""
    if not p & 0x80:
        return (f"0x6015 = 0x{p:02x}: bit 7 is clear, so the PMP's byte didn't land or didn't survive the reset; the PMP's"
                " state at the commit is unknown")
    res = p >> 4 & 3
    st = p & 3
    pend = "; some core had an interrupt pending at its stop" if p & 0x40 else ""
    if res == 1:
        what = ("the idle pair TIMED OUT (-ETIME): an ack never came within 1 s (so SetIOPPower may not have gone out);"
                " the PMP's state is unknown, RUN wasn't touched")
    elif res == 2:
        what = "the PMP's firmware had CRASHED by the idle pair (the pair may not have been sent); RUN wasn't touched"
    elif res == 3:
        what = "the idle pair FAILED with another error; the PMP's state is unknown, RUN wasn't touched"
    elif not st:
        what = ("the idle pair returned 0, but CPU_STATUS's low two bits read 0 for the whole 10 ms (not idle by macOS's"
                " mask), so RUN wasn't cleared: the PMP is idled, its CPU not stopped")
    elif not p & 0x0c:
        what = (f"the idle pair returned 0 and CPU_STATUS read non-zero by macOS's mask (low bits {st:02b}; the load log"
                " has the awake value); RUN wasn't touched (pmp_stop=0): the PMP is idled, its CPU not stopped")
    elif not p & 0x04:
        what = (f"the idle pair returned 0, CPU_STATUS read non-zero by macOS's mask (low bits {st:02b}; the load log has"
                " the awake value), and RUN was already 0 before the write, which nothing predicted"
                f"{'; it reads 0 after' if p & 0x08 else ''}")
    elif p & 0x08:
        what = (f"the idle pair returned 0, CPU_STATUS read non-zero by macOS's mask (low bits {st:02b}; the load log has"
                " the awake value), and RUN read 1 before its clear and reads 0 after the write: the PMP's CPU is stopped")
    else:
        what = (f"the idle pair returned 0, CPU_STATUS read non-zero by macOS's mask (low bits {st:02b}; the load log has"
                " the awake value), and RUN read 1 before its clear and 1 after the write: NOT stopped")
    return f"0x6015 = 0x{p:02x}: K4 ran: {what}{pend}"


