def pmp_byte(p):
    """0x6015 in a pmp_out=1 run: K4's byte; bit 7 says it landed."""
    if not p & 0x80:
        return (f"0x6015 = 0x{p:02x}: bit 7 is clear, so the PMP's byte didn't land or didn't survive the reset; the PMP's"
                " state at the commit is unknown")
    res = p >> 4 & 3
    st = p & 3
    pend = "; some core had an interrupt pending at its stop" if p & 0x40 else ""
    if res == 1:
        what = ("the idle pair TIMED OUT (-ETIME): an ack never came within 1 s (so SetIOPPower may not have gone out);"
                " the PMP's state is unknown, RUN wasn't touched")
    elif res == 2:
        what = "the PMP's firmware had CRASHED by the idle pair (the pair may not have been sent); RUN wasn't touched"
    elif res == 3:
        what = "the idle pair FAILED with another error; the PMP's state is unknown, RUN wasn't touched"
    elif not st:
        what = ("the idle pair returned 0, but CPU_STATUS's low two bits read 0 for the whole 10 ms (not idle by macOS's"
                " mask), so RUN wasn't cleared: the PMP is idled, its CPU not stopped")
    elif not p & 0x0c:
        what = (f"the idle pair returned 0 and CPU_STATUS read non-zero by macOS's mask (low bits {st:02b}; the load log"
                " has the awake value); RUN wasn't touched (pmp_stop=0): the PMP is idled, its CPU not stopped")
    elif not p & 0x04:
        what = (f"the idle pair returned 0, CPU_STATUS read non-zero by macOS's mask (low bits {st:02b}; the load log has"
                " the awake value), and RUN was already 0 before the write, which nothing predicted"
                f"{'; it reads 0 after' if p & 0x08 else ''}")
    elif p & 0x08:
        what = (f"the idle pair returned 0, CPU_STATUS read non-zero by macOS's mask (low bits {st:02b}; the load log has"
                " the awake value), and RUN read 1 before its clear and reads 0 after the write: the PMP's CPU is stopped")
    else:
        what = (f"the idle pair returned 0, CPU_STATUS read non-zero by macOS's mask (low bits {st:02b}; the load log has"
                " the awake value), and RUN read 1 before its clear and 1 after the write: NOT stopped")
    return f"0x6015 = 0x{p:02x}: K4 ran: {what}{pend}"


PHASES = {0: "pair 0's", 2: "pair 1's", 3: "pair 1's last", 4: "the entry pair's first (A2)", 5: "the entry pair's second (A2)",
          6: "pair 3's first", 7: "the entry pair's last (A2)", 8: "pair 1's", 9: "pair 3's second", 0xa: "pair 1's",
          0xb: "pair 1's", 0xc: "pair 1's", 0xd: "pair 1's"}
STATE_WORDS = ("0xa03 (a sequence's start)", "1 (a sequence's end)", "0xa02 (A1's close)", "some other value")
K_MARK = 0xa5  # e1_hook's M1_K_MARK: 0x6013, when 0x6012 has sio_stop=1's outcomes
W_MARK = 0xc0  # e1_hook's M1_W_MARK: 0x6013's top two bits in a ps_words=1 run, one bit per group below them
W_GROUPS = ("the five UARTs", "MSG", "ATC1-3_USB_AON", "ATC0-3_PCIE", "ATC1-3_COMMON")  # bits 0-4; e1_hook's M1_PW_*
BITE_CLASSES = ("another value", "the new value, 45 s", "the old value, 30 s", "its awake value")  # recfg_bite.h's M1_BITE_*
# wd2_bite.h's M1_WD2_PRE_*: 30 s is every A sequence's, and A2's only while PHASE reads 4 or 5
WD2_PRE = ("another value", "30 s, an A sequence's opening's", "the new value, 120 s", "the value it read awake at load")
WD2_PHASES = (0, 4, 5, None)  # wd2_bite.h's m1_wd2_phase(): None is any other value
DCP_CODES = ("its RTKit shutdown TIMED OUT", "its RTKit shutdown FAILED another way", "shut down, but RUN didn't read 1 then 0", "stopped")
SIO_CODES = ("its RTKit idle pair TIMED OUT", "its RTKit idle pair FAILED another way", "idle returned 0, but RUN didn't read 1 then 0", "stopped")
SIO_CLASSES = ("all ones: a failed read", "target 0, bit 11 set (B2 at op 91, inferred)",
               "target 0, bit 11 clear (past op 91, inferred)", "another target, bits 27:24 not f",
               "another target, bits 27:24 f, actual not f", "another target, bits 27:24 f, actual f",
               "not a class e1_hook sends (6)", "not a class e1_hook sends (7)")


def sample_lines(n, addr_a, a, addr_b, b, disp=False):
    """position=1: one sample's two bytes, one line per word (m1_position.h has the layout). disp: disp_off=1's byte B."""
    phase = a & 0xf
    middle = (f"  display (K3b): internal DCP: {DCP_CODES[b & 3]}; external DCP: {DCP_CODES[b >> 2 & 3]}; the domains of the DCPs"
              f" that stopped: {'all read off' if b & 0x10 else 'NOT all read off, or none stopped'}") if disp else (
             f"  SIO_CPU: {SIO_CLASSES[b & 7]}; WD2 RESET_EN {'set' if b & 8 else 'clear'}; WD2's count"
             f" {'within' if b & 0x10 else 'NOT within'} 0.25 s of CPU0's time since the first commit write")
    return [f"position sample {n} (0x{addr_a:04x} = 0x{a:02x}, 0x{addr_b:04x} = 0x{b:02x}):",
            f"  PHASE {phase:#x} ({PHASES.get(phase, 'not a phase the sequences read so far write')}); HS_A bit 31"
            f" {'up' if a & 0x10 else 'down'}, bit 24 {'up' if a & 0x20 else 'clear'}; state word"
            f" {STATE_WORDS[a >> 6]}",
            middle,
            f"  gate words: 0x2922c0044 bit 2 {'set' if b & 0x20 else 'clear'}, bit 3 {'set' if b & 0x40 else 'clear'};"
            f" 0x2922c0040 bit 1 {'set' if b & 0x80 else 'clear'}"]


def recfg_lines(v):
    """recfg_bite=1, stages 0x46 and 0x47: 0x6005, what CPU0 read once it had let the others go (recfg_bite.h has the layout)."""
    cls, phase, armed, sram = v & 3, v >> 2 & 0xf, bool(v & 0x40), bool(v & 0x80)
    if cls == 1:
        so = ("the engine took WD2's bite from the changed word: the SRAM takes a write and the engine runs it. Feasibility shown,"
              " whenever the reset came")
        if not armed and phase in (0, 4, 5):
            so += (". But RESET_EN didn't show within 0.3 s: CPU0 looked inside A2's opening, or the word after the bite was"
                   " disturbed. Then WD2 never bites, and a Mac that stayed dark is that, not a completed entry")
        elif not armed:
            so += (f". RESET_EN didn't show within 0.3 s, with PHASE {phase:#x}, which isn't one A2 shows before its last (0, 4,"
                   " 5): every A sequence clears RESET_EN at its end, so A2 may have run to its end before CPU0 looked. A Mac that"
                   " then stayed dark may be a completed entry")
        if not sram:
            so += ". (Step 8's read of the word didn't show the new value, which doesn't fit a new bite in WD2: that read isn't to be trusted then)"
    elif cls == 2 and not sram:
        so = "the edit wasn't in place at the commit (the word didn't read the new value in step 8), so it wasn't tested. Not a negative"
    elif cls == 2 and phase in (4, 5) and armed:
        so = ("A2, before its last phase, armed WD2 with the old bite though the word read the new one: the engine didn't take the"
              " bite from this word. (A copy elsewhere isn't excluded: only the first 64 KiB of the SRAM has been read)")
    elif cls == 2 and phase in (4, 5):
        so = ("nothing decided: WD2 holds the old bite with A2 before its last phase, though the word read the new one, which"
              " points at the engine not taking the bite from this word. But RESET_EN didn't show within 0.3 s, and A2's opening"
              " sets it right after the bite: this isn't the state that opening leaves, so the record alone doesn't say")
    elif cls == 2:
        so = (f"nothing decided about the edit: with PHASE {phase:#x}, a later sequence's opening may have re-armed WD2 with its"
              " own 30 s before CPU0 looked")
    elif not sram:
        so = ("nothing decided, and the edit wasn't in place at the commit (the word didn't read the new value in step 8): the"
              " reset time says nothing about it either")
    elif cls == 3:
        so = ("nothing decided: WD2 showed RESET_EN with its awake bite, which no sequence read so far would leave" if armed else
              "nothing decided: nothing had armed WD2 within 0.3 s of the release. If the Mac then stayed dark, WD2 was never armed:"
              " not a completed entry, and the edit is the first suspect")
    else:
        so = "nothing decided: not a bite any sequence read so far writes. Unreadable, not a negative"
    if v == 0xfe:
        so += (". And 0xfe is what stage 0x4e leaves in this byte (the parked cores): if the stage's command landed without its"
               " second byte, this isn't a sample at all")
    if v == 0:
        so += ". And 0x00 is also what a byte that didn't land, or didn't survive the reset, reads: not a reading to lean on"
    what = "its awake value, or pair 0's" if phase == 0 else PHASES.get(phase, "not a phase the sequences read so far write")
    return [f"0x6005 = 0x{v:02x}: recfg_bite=1, after the commit, the alarm and the release (A2's bite word in the SRAM was changed"
            " to 45 s before the load):",
            f"  WD2's bite: {BITE_CLASSES[cls]}; WD2's control {'showed RESET_EN' if armed else 'did NOT show RESET_EN within 0.3 s'}",
            f"  PHASE {phase:#x} ({what}), read after the bite; A2's bite word in the SRAM, read in step 8 just before the commit:"
            f" {'the new value' if sram else 'NOT the new value'}",
            f"  so: {so}",
            "  (the reset time is a second fact, never the test: RESEARCH.md, \"A different approach\")"]


def wd2_lines(v, pend=False):
    """wd2_bite=1, stages 0x56 and 0x57: 0x6005, what CPU0 read around its one write to WD2's bite (wd2_bite.h has the layout).
    pend: the stage is 0x56, CPU0 had an exception pending after its reads."""
    pre, seen, post, still, counting, ph = v & 3, bool(v & 4), bool(v & 8), bool(v & 0x10), bool(v & 0x20), WD2_PHASES[v >> 6]
    if v == 0xfe:
        # Before anything is read out of it: this is the byte the stage before leaves here.
        so = ("0xfe is what stage 0x4e leaves in this byte (the parked cores): the stage's command most likely landed without its"
              " second byte, and then this isn't a sample at all. None of the three lines above is to be leaned on")
    elif not seen and post and pre != 2:
        so = ("an inconsistent record: CPU0 made no write, and the bite read 120 s after that though it didn't just before. Something"
              " else wrote it between the two reads, or the byte isn't the one CPU0 sent: not to be leaned on")
    elif not seen:
        so = ("CPU0 made no write: nothing had armed WD2 within 0.3 s of the release, so the bite wasn't moved and the reset's time"
              " says nothing about a moved bite. A Mac that then stayed dark isn't a completed entry by this record: WD2 was never seen"
              " armed")
        if post:
            so += (". The bite read 120 s before and after: wd2-bite's store from user space, still there, which also says no"
                   " sequence's opening had written its own 30 s")
    elif not post:
        so = ("CPU0 MADE ITS WRITE AND THE BITE DIDN'T READ 120 s AFTER IT: the register didn't keep the kernel's store (or"
              " something wrote it again at once). The bite wasn't moved, and the reset's time says nothing about a moved bite")
    elif not still:
        so = ("the bite reads 120 s, but RESET_EN didn't show after the write: WD2 wasn't armed any more (a sequence closing just"
              " then, or the write itself). An unarmed WD2 doesn't bite, so a Mac that then stayed dark is that as readily as a"
              " completed entry")
    elif not counting:
        so = ("the bite reads 120 s with RESET_EN set, but the count didn't change within 1 ms: WD2 may not be counting any more."
              " A Mac that then stayed dark may be that, and isn't a completed entry by this record")
    else:
        took = ("the write took, and" if pre != 2 else
                "the bite read 120 s before CPU0's write as after it, so this record doesn't show that write took;")
        who = "A2" if ph in (4, 5) else "the sequence that armed WD2"
        dark = ("no reset is a candidate for a completed entry" if not pend else
                "no reset isn't a candidate for a completed entry here, since CPU0 likely never went down (the stage)")
        so = (f"{took} WD2 was armed and counting with a 120 s bite. The reset's time is the result now: about 120 s"
              f" after the commit fits {who} arming last and never closing; {dark}; about 30 s,"
              " or another time T, fits a later sequence arming WD2 again, T - 30 s after the commit")
        if ph == 0:
            so += (". PHASE still read 0 after 10 ms, where A2 writes 4 a few ops after its opening: which sequence armed WD2 isn't"
                   " shown by this record")
        elif ph is None:
            so += (". PHASE read neither 4 nor 5, A2's before its last: A2 may have run to its end already and a later A sequence"
                   " armed WD2, each opening with the same 30 s. Then the entry had finished before CPU0's write, and the bite that"
                   " was moved is that sequence's")
    if seen and pre != 1 and v != 0xfe:
        so += (f". But the bite read {WD2_PRE[pre]} before the write, not the 30 s an A sequence's opening leaves, though RESET_EN"
               " showed: what armed WD2 isn't clear from this record")
    if pend and v != 0xfe and not (seen and post and still and counting):
        so += ". And CPU0 had an exception pending after its reads (the stage): it likely never went down"
    if v == 0:
        so += ". And 0x00 is also what a byte that didn't land, or didn't survive the reset, reads: not a reading to lean on"
    what = ("neither 0, 4 nor 5: A2's last, or a later sequence's" if ph is None else
            f"{ph:#x} ({'its awake value, or pair 0' + chr(39) + 's' if ph == 0 else PHASES[ph]})")
    return [f"0x6005 = 0x{v:02x}: wd2_bite=1, after the commit, the alarm and the release:",
            f"  WD2's bite before CPU0's write: {WD2_PRE[pre]}; WD2's control"
            f" {'showed RESET_EN, so CPU0 wrote the bite, 120 s' if seen else 'did NOT show RESET_EN within 0.3 s, so CPU0 wrote nothing'}",
            f"  read after that: the bite {'120 s' if post else 'NOT 120 s'}; RESET_EN {'set' if still else 'NOT set'}; the"
            f" count {'changing' if counting else 'NOT changing within 1 ms'}",
            f"  PHASE, read last: {what}",
            f"  so: {so}",
            "  (the readings, and why one run narrows the cases without deciding them: PLAN.md, \"The order after run 14\")"]


def k_lines(b):
    """sio_stop=1: 0x6012, the steps before the commit, if 0x6013 says it landed (e1_hook.c's m1 comment has the layout)."""
    k = b[0x12]
    m = b[0x13]
    words = m & W_MARK == W_MARK
    if m != K_MARK and not words:
        return [f"0x6012 0x6013 = {k:02x} {m:02x}: the steps' outcomes didn't land (0x6013 is neither their marker, 0x{K_MARK:02x}, nor"
                f" ps_words=1's, 0x{W_MARK:02x} and up): nothing here says how the DCPs, the SMC's notice, SIO or any power word went"]
    out = [f"0x6012 = 0x{k:02x}, the steps before the commit:",
            f"  internal DCP: {DCP_CODES[k & 3]}; external DCP: {DCP_CODES[k >> 2 & 3]}; the domains of the DCPs that stopped:"
            f" {'all read off' if k & 0x10 else 'NOT all read off, or none stopped'}",
            f"  SMC's AP idle notice: {'acked within 200 ms' if k & 0x20 else 'NOT acked'}; SIO's firmware: {SIO_CODES[k >> 6]}"]
    if words:
        out.append(f"0x6013 = 0x{m:02x}: ps_words=1 wrote the 20 power words, after the table:")
        out += [f"  {g}: " + ("read actual 0 within 10 ms each" if m >> i & 1 else "NOT all read actual 0 within 10 ms each") for i, g in enumerate(W_GROUPS)]
        out.append("  PCIE0_REF, APCIE_GP_SYS, AFNC1_LW2, AFNC2_LW1: target and auto fields "
                   + ("read back as written" if m & 0x20 else "NOT all read back as written"))
    return out


def position_lines(s, b, pmp=False, disp=False):
    """position=1, stages 0x40-0x45: which samples these bytes are, and what they say. pmp: sio_on=1's layout, one sample;
    disp: disp_off=1's byte B."""
    out = []
    if s in POS_S1:
        out += sample_lines(1, 0x6012, b[0x12], 0x6013, b[0x13], disp)
    elif s == 0x41:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}: step 8's second's upper bytes or sample 1's, its"
                   " bytes' stage didn't follow: not decoded")
    else:
        out.append("no sample recorded yet")
    if pmp:
        if s in POS_S1:
            out.append("  one sample by design (pmp_out=1 keeps 0x6015), about 1 s after the commit: it can't tell a stop from"
                       " slow progress" + ("" if s in POS_S2 else ", and only stages 0x44 and 0x45 say whether a read failed"))
    elif s in POS_S2:
        out += sample_lines(2, 0x6007, b[0x07], 0x6015, b[0x15])
    elif s == 0x43:
        out.append(f"0x6007 0x6015 = {b[0x07]:02x} {b[0x15]:02x}: held and step 8's byte, or sample 2's, the stage after"
                   " them didn't follow: not decoded")
    if not pmp and s in (0x42, 0x43):
        out.append("  sample 1 alone, about 1 s after the commit: only stages 0x44 and 0x45 say whether a read failed, and one"
                   " sample can't tell a stop from slow progress, so no rung from it")
    if s in POS_S1:
        out.append("  (compare each word with the awake pass, recfg-peek-*-p*/, or the load log's position line; a word still at its awake value says"
                   " nothing. PLAN.md has the reading guide)")
    return out


def die(msg):
    print(f"m1-crumbs: {msg}", file=sys.stderr)
    sys.exit(2)


def find_nvmem():
    """The nvmem device for NODE; its number isn't fixed (pmu-alarm)."""
    if NVMEM:
        return NVMEM
    found = [d for d in sorted(glob.glob("/sys/bus/nvmem/devices/spmi_nvmem*"))
             if os.path.realpath(f"{d}/of_node").endswith(NODE)]
    if len(found) != 1:
        die(f"want one nvmem device for {NODE}, found {len(found)}")
    return f"{found[0]}/nvmem"


def cpus(mask):
    return ",".join(f"CPU{n}" for n in range(8) if mask >> n & 1) or "none"


def stage(s, observe=False):
    if observe and s in OBSERVE_STAGES:
        return OBSERVE_STAGES[s]
    if s in STAGES:
        return STAGES[s]
    if 0x21 <= s <= 0x27:
        cpu = ORDER[s - 0x21]
        return (f"6: releasing CPU{cpu}, the order's {s - 0x20} of 7 (1, 2, 3, 5, 6, 4, 7): the run stopped"
                " at that core's stop (a reset or a hang), or a later breadcrumb failed and CPU0 went on")
    return "unknown"


def counter():
    """CNTVCT and CNTFRQ, or None. Python has no mrs, so this runs the two
    instructions from an executable page: mrs x0, cntvct_el0 (or cntfrq_el0),
    ret. Linux lets EL0 read both (its vDSO does)."""
    if CNTVCT:
        if CNTVCT == "none":
            return None
        ticks, freq = CNTVCT.split()
        return int(ticks), int(freq)
    if os.uname().machine != "aarch64":
        return None
    try:
        import ctypes
        import mmap
        code = (0xd53be040, 0xd65f03c0, 0xd53be000, 0xd65f03c0)
        m = mmap.mmap(-1, mmap.PAGESIZE, prot=mmap.PROT_READ | mmap.PROT_WRITE | mmap.PROT_EXEC)
        m.write(b"".join(w.to_bytes(4, "little") for w in code))
        addr = ctypes.addressof(ctypes.c_char.from_buffer(m))
        fn = ctypes.CFUNCTYPE(ctypes.c_uint64)
        return fn(addr)(), fn(addr + 8)()
    except (OSError, ValueError):
        return None


def qto(q, ack=False):
    """pmgr_late's waits that timed out. ack: a cluster_ack=1 run, whose bits 2-5 are the cluster words' flags that stayed."""
    timed = [w for i, w in enumerate(WAITS) if q >> i & 1 and not (ack and CLUSTER_WAITS >> i & 1)]
    if ack:
        stuck = [n for i, n in ACK_WORDS.items() if q >> i & 1]
        return (f"0x{q:02x}: " + ("macOS's other waits were all met within 10 ms" if not timed else
                                 "macOS's waits that timed out after 10 ms: " + "; ".join(timed))
                + "; bits 2-5 (cluster_ack=1), the soc-cluster words whose up-done flag was still set at their wait's last read: "
                + (", ".join(stuck) or "none"))
    return f"0x{q:02x}: " + ("every one of macOS's waits was met within 10 ms" if not timed else
                            "macOS's waits that timed out after 10 ms: " + "; ".join(timed))


# wd1_mark=1 (run-floor --m1-mark; e1-hook/wd1_mark.h): bits 7:6 of fabric_up=1's byte, WD1 as read just before the commit.
# Both set, the marker stood, and the restart's time reads B2's progress: WD1's bite less its count if B2 never zeroed
# the count, WD2's bite if it did and the pair then stopped, WD1's bite if the pair finished.
WD1_STANDS = 0xc0
WD1_BITE_S, WD1_COUNT_S, WD2_BITE_S = 150, 60, 120
# probe=1 (e1-hook/probe; e1-hook/asc_probe.h has the bytes): not a run. Stage 0x0e, which no run sends, and at
# 0x6005-0x6007 what bit 1 of SIO's, the PMP's and ANS's ASC + 0x8000 read around the recipe's steps on them.
PROBE_STAGE = 0x0e
PROBE_MARK = 0x80
FAB_WAS = ("another value: neither 0x333 nor asked down to 1", "0x111: asked down to 1 by the kernel's suspend, and there",
           "asked down to 1 by the kernel's suspend, and not there yet", "0x333, as awake: this suspend hadn't lowered it")


# probe=1 look=1 (e1-hook/probe --look): its stage, and the groups of words it reads, by the number it leaves at
# 0x6010 before reading each (look.h's enum look_at), with LOOK_LOAD set by the look at the module's load.
LOOK_STAGE = 0x0f
LOOK_LOAD = 0x10
LOOK_AT = ("nothing marked",
           "the fabric's, 0x28e20c400 and DCS's p-state words",
           "six words of the engine's page, 0x2922c0000, that its sequences read",
           "the power words B2 switches off and polls",
           "six gate-status words",
           "fifteen clock generators' two words each",
           "two words of the engine's page that its sequences only write (+0x008, +0x024)",
           "every group read")
LOOK_DONE = len(LOOK_AT) - 1


# gate=1 (e1-hook/probe --gate): its steps, by the number it leaves at 0x6010 with GATE_PASS set (gate_test.h's enum
# gate_at), and the mark of its byte at 0x6005.
GATE_PASS = 0x20
GATE_NO_SNAP = 0x40  # in a mark from step 6 on: the write that carries the lane's three reads wasn't acked
GATE_MARK = 0x80
GATE_UNMADE = 0xe0  # the byte of a test that wasn't made
GATE_AT = ("nothing marked",
           "everything read as found",
           "the five UARTs written 0x200",
           "the gate polled, SIO's subtree all off",
           "AFNC2_LW1 written 0x1000030f, macOS's value",
           "the gate polled again",
           "AFNC2_LW1 written back as found",
           "the five UARTs written back as found",
           "every step taken: the byte written",
           "the test wasn't made: after noirq SIO read on, or a UART had a target of f, and nothing was written")
GATE_LANE_BACK, GATE_DONE, GATE_NOT_MADE = 6, 8, 9


def gate_word(p):
    """gate_test.h's gate_pack(): two bytes of a power word, read back into words."""
    lo, hi = p
    flags = [n for bit, n in ((0x20, "was power-gated"), (0x40, "was clock-gated"), (0x80, "BUSY")) if hi & bit]
    return (f"target {lo & 0xf:x}, actual state {lo >> 4:x}, auto-enable {'on' if hi & 0x10 else 'off'}, auto floor {hi & 0xf:x}"
            + (", " + ", ".join(flags) if flags else ""))


def gate_lines(at, v, pack):
    """gate=1's record: the step it was about to take when it last wrote 0x6010, its byte at 0x6005 if that landed, and
    the lane's three reads at 0x6011-0x6016, if the mark says they're this test's. The kernel log e1-hook/probe saves
    has every word in full."""
    n = at & ~(GATE_PASS | GATE_NO_SNAP)
    step = GATE_AT[n] if n <= GATE_NOT_MADE else "not a step's number"
    if n in (GATE_DONE, GATE_NOT_MADE):
        out = [f"0x6010 = 0x{at:02x}: the gate test, after both looks: {step}"]
    elif v & GATE_MARK:
        # The byte is zeroed when the test starts and written after its last step, write-backs and all: with it there, an
        # earlier mark is a later mark lost.
        out = [f"0x6010 = 0x{at:02x}: the gate test, after both looks. The last step it marked: {step}; but its byte landed, and that is"
               " written after the last step, so the test reached its end and a later mark didn't land (Pullfrog on #80)"]
    else:
        out = [f"0x6010 = 0x{at:02x}: THE GATE TEST BEGAN AND DIDN'T FINISH, after both looks. The last step it marked: {step}."
               " The Mac went down in that step, or after it and before the next mark"
               + (". From step 2 to step 7 a word it had changed may not have been written back: the restart since has put"
                  " every power word back where the boot leaves it" if 2 <= n <= 7 else "")]
    # The lane's three reads are written in one command with step 6's mark, so only that mark, or a later one that
    # doesn't say the command failed, makes 0x6011-0x6016 this test's: bytes left there from before are never read
    # as its own (Pullfrog on #80). The byte at 0x6005 is another command's, and has no say in this.
    if GATE_LANE_BACK <= n <= GATE_DONE and not at & GATE_NO_SNAP:
        if any(pack):
            out += ["0x6011-0x6016: AFNC2_LW1 (0x28e580160), read three times before anything was written back:",
                    f"  right before its write, SIO's subtree off: {gate_word(pack[0:2])}",
                    f"  after the write of macOS's 0x1000030f: {gate_word(pack[2:4])}",
                    f"  after the second poll of the gate: {gate_word(pack[4:6])}"]
        else:
            out.append("0x6011-0x6016 read 0 though the mark says their write was acked: nothing is read from them")
    else:
        why = ("the test wasn't made" if n == GATE_NOT_MADE else
               "the mark says the write that carries them wasn't acked" if GATE_LANE_BACK <= n <= GATE_DONE else
               "the last mark that landed is from before their write" if n < GATE_LANE_BACK else "the mark isn't a step's")
        if any(pack):
            out.append(f"0x6011-0x6016 hold {bytes(pack).hex(' ')}: NOT this test's reads of the lane ({why}): left from before, and"
                       " nothing is read from them")
        else:
            out.append(f"0x6011-0x6016 read 0: the lane's three reads weren't written ({why})")
    if n == GATE_NOT_MADE:
        return out + [f"0x6005 = 0x{v:02x}: " + ("the byte a test that wasn't made leaves" if v == GATE_UNMADE else
                                                "NOT the 0xe0 a test that wasn't made leaves: nothing is read from it"),
                      "  so: nothing was switched off, nothing had to be put back, and nothing is decided about the gate"]
    if not v & GATE_MARK:
        return out + [f"0x6005 = 0x{v:02x}: the test's byte didn't land (bit 7 clear), or the test stopped before it: nothing is read"
                      " from it"]
    off, c1, took, c2, gated, lback, uback = (bool(v >> i & 1) for i in range(7))
    out += [f"0x6005 = 0x{v:02x}: the gate test's byte:",
            "  the five UARTs: " + ("all read actual 0 within 10 ms of being written 0x200" if off else
                                    "did NOT all read actual 0 within 10 ms of being written 0x200, or the test wasn't made (SIO read on,"
                                    " or a UART was in use): the kernel log says which"),
            f"  bit 30 of 0x28e5a0050, the gate B2 polls after SIO's subtree, before the lane's write: {'SET' if c1 else 'clear'}"
            + (" (within 100 ms of the subtree going off, or at the read right before the write)" if c1 else
               ", through 100 ms and at the read right before the write"),
            f"  AFNC2_LW1, written macOS's 0x1000030f: {'took it' if took else 'did NOT take it'} within 10 ms"
            f"; its actual state after the second poll: {'0' if gated else 'not 0'}",
            f"  bit 30 of 0x28e5a0050 after that: {'SET' if c2 else 'clear'}" + ("" if c2 else ", through 100 ms"),
            f"  read as found with everything written back: AFNC2_LW1 {'yes' if lback else 'NOT within 10 ms'}; the UARTs"
            f" {'yes' if uback else 'NOT all within 10 ms'}"]
    if not off:
        out.append("  so: SIO's subtree wasn't all off, so neither poll was of the state B2 polls in: nothing decided about the gate")
    elif c1:
        out.append("  so: in Linux's suspended state the gate B2 waits on closes once SIO's subtree is all off, before the lane was"
                   " given macOS's value: this poll isn't where B2 stops in that state. The recipe's state is further on, and B2"
                   " polls after its own writes")
    elif took and c2:
        out.append("  so: the gate read open with SIO's subtree all off, up to the read right before the lane's write, and set within"
                   " 100 ms after the lane took macOS's value" + (", with the lane's actual state then 0" if gated else
                                                                " though the lane's actual state wasn't 0 then")
                   + ". Closed after it: one before and one after can't tell that from a gate that closes late by itself. If it's the"
                   " lane's floor, whether the recipe's own write of it takes is the next thing to read")
    elif c2:
        out.append("  so: the gate read open with SIO's subtree all off, and set at the second poll though the lane did NOT take"
                   " macOS's value: it closed late and by itself, or the write did something its read-back doesn't show. The"
                   " lane's three reads above, and the kernel log, have the words")
    elif took:
        out.append("  so: the gate stayed open with SIO's subtree all off and the lane at macOS's value: something else is behind it,"
                   + (" though the lane's actual state read 0" if gated else " and the lane's actual state didn't read 0"))
    else:
        out.append("  so: the gate stayed open with SIO's subtree all off, and the lane did NOT take macOS's value: the write that"
                   " ps_words=1 makes in every run doesn't land in this state. The lane's three reads above have what it read")
    return out


def look_lines(at):
    """look=1's record: which of its two looks, and the group it was about to read when it last wrote 0x6010. Its
    words are in the kernel log e1-hook/probe saves; the PMU has only how far it got."""
    load, n = bool(at & LOOK_LOAD), at & ~LOOK_LOAD
    group = LOOK_AT[n] if n <= LOOK_DONE else "not a group's number"
    if n == LOOK_DONE and not load:
        return [f"0x6010 = 0x{at:02x}: {group}: the look after noirq read all of them. What became of the suspend after it,"
                " this record doesn't say"]
    if n == LOOK_DONE:
        return [f"0x6010 = 0x{at:02x}: {group}, by the look at the module's load, whose marks weren't zeroed after it: that"
                " write didn't land, or the Mac went down right then. The look after noirq didn't begin"]
    return [f"0x6010 = 0x{at:02x}: THE LOOK BEGAN AND DIDN'T FINISH: the look {'at the module' + chr(39) + 's load' if load else 'after noirq'}."
            f" The last group it marked: {group}. A read in that group faulted, or the Mac went down in it or before the next mark"]


# probe=1's steps, by the number it leaves at 0x6010 before taking each (asc_probe.h's enum asc_at).
PROBE_AT = ("nothing marked",
            "prepare begun: SIO_CPU's table word written",
            "SIO's word read, its firmware running",
            "ANS's word read, its firmware shut down by the NVMe driver's suspend, ANS2 still on",
            "the PMP's word read, its firmware running",
            "SIO's idle pair",
            "SIO's word read after its idle pair",
            "SIO's RUN cleared",
            "SIO's word read after RUN was cleared",
            "prepare done: the kernel's noirq pass",
            "prepare_late begun: the power words read",
            "ANS2 raised",
            "ANS's word read",
            "ANS2 written back",
            "the PMP's word read before its idle pair",
            "the PMP's idle pair",
            "the PMP's word read after its idle pair",
            "the PMP's RUN cleared",
            "the PMP's word read after RUN was cleared",
            "SIO's parents and SIO_CPU raised",
            "SIO's word read",
            "every step taken: the three bytes written")
PROBE_DONE = len(PROBE_AT) - 1


def probe_final(who, b):
    """What a probe byte says bit 1 read in the state B2 finds: True set, False clear, None not read there (the byte
    didn't land, the domain didn't read actual f for that read, or the PMP's RUN wasn't cleared). asc_probe.h's
    asc_sio_final() and the two beside it, which the probe's own SUMMARY line goes by."""
    if not b & PROBE_MARK:
        return None
    if who == "SIO":
        return bool(b & 8) if b & 0x40 else None
    if who == "PMP":
        return bool(b & 8) if b & 0x40 and b & 0x20 else None
    return bool(b & 4) if b & 0x0a else None


def probe_at_line(at, landed):
    """0x6010, the step the probe was about to take when it last wrote there. landed: all three bytes did."""
    step = PROBE_AT[at] if at <= PROBE_DONE else "not a step's number"
    if landed:
        return f"0x6010 = 0x{at:02x}: {step}" + ("" if at == PROBE_DONE else ": NOT the last step's number, though the bytes landed")
    if at == PROBE_DONE:
        return f"0x6010 = 0x{at:02x}: every step was taken, and the write of the three bytes didn't land, or not all of it"
    return (f"0x6010 = 0x{at:02x}: THE PROBE BEGAN AND DIDN'T FINISH. The last step it marked: {step}. The Mac went down in that"
            " step, or after it and before the next was marked (a mark that didn't land looks the same)")


def probe_lines(sio, pmp, ans, at):
    """probe=1's record (e1-hook/asc_probe.h): the step it reached and its three bytes. The kernel log, which e1-hook/probe
    saves, has every word in full: this is what's left of it when the log didn't make it back."""
    def bit(v, n, made=None):
        """One step's bit. made: whether the byte says that read was made; None when it can't say, and then a 0 is
        "clear, or not read" (a word is read only while its domain reads actual f)."""
        if made is False:
            return "not read"
        return "SET" if v >> n & 1 else "clear" if made else "clear, or not read (the byte doesn't say which)"

    out = [probe_at_line(at, bool(sio & pmp & ans & PROBE_MARK))]
    final = {"SIO": probe_final("SIO", sio), "PMP": probe_final("PMP", pmp), "ANS": probe_final("ANS", ans)}
    if sio & PROBE_MARK:
        on = bool(sio & 0x40)
        out += [f"0x6005 = 0x{sio:02x}: SIO, bit 1 of its ASC + 0x8000 (0x39bc08000), which B2's op 51 waits for:",
                f"  at prepare, its firmware running: {bit(sio, 0)}",
                f"  after its idle pair, which {'returned 0' if sio & 0x10 else 'FAILED'}: {bit(sio, 1)}",
                "  after RUN was cleared: " + (bit(sio, 2) if sio & 0x10 else "not done, the idle pair having failed")
                + ("" if not sio & 0x10 or sio & 0x20 else " (RUN did NOT read 1 and then 0)"),
                "  after noirq, its parents and SIO_CPU raised again, the state B2's op 51 finds: "
                + (bit(sio, 3, True) if on else "not read, SIO_CPU not reading actual f")]
    else:
        out.append(f"0x6005 = 0x{sio:02x}: SIO's byte didn't land (bit 7 clear): not read")
    if pmp & PROBE_MARK:
        on = bool(pmp & 0x40)
        out += [f"0x6006 = 0x{pmp:02x}: the PMP, bit 1 of its ASC + 0x8000 (0x28ec08000), which B2's op 159 waits for"
                + ("" if on else "; ps_pmp did NOT read actual f for every read after noirq") + ":",
                f"  at prepare, its firmware running: {bit(pmp, 0)}",
                f"  after noirq, before its idle pair: {bit(pmp, 1, True if on else None)}",
                f"  after its idle pair, which {'returned 0' if pmp & 0x10 else 'FAILED'}: {bit(pmp, 2, True if on else None)}",
                "  after RUN was cleared, the state B2's op 159 finds: "
                + (bit(pmp, 3, on) if pmp & 0x20 else "not reached: RUN wasn't cleared (the idle pair failed, the PMP didn't read idle,"
                   " or RUN didn't read 1 and then 0)")]
    else:
        out.append(f"0x6006 = 0x{pmp:02x}: the PMP's byte didn't land (bit 7 clear): not read")
    if ans & PROBE_MARK:
        was_on, raised = bool(ans & 2), bool(ans & 8)
        out += [f"0x6007 = 0x{ans:02x}: ANS, bit 1 of its ASC + 0x8000 (0x38f408000), which B2's op 151 waits for:",
                f"  awake, at the module's load, its firmware running: {bit(ans, 4, bool(ans & 0x20))}",
                f"  at prepare, its firmware shut down by the NVMe driver's suspend, ANS2 still on: {bit(ans, 0)}",
                "  after noirq, " + ("ANS2 still on" if was_on else "ANS2 off, raised as B2's op 149 raises it" if raised else
                                     "ANS2 off, and the raise did NOT reach actual f")
                + ", the state B2's op 151 finds: " + bit(ans, 2, was_on or raised)]
        if not ans & 0x40:
            out.append("  ANS2's target and actual state did NOT read as found within 10 ms of being written back")
    else:
        out.append(f"0x6007 = 0x{ans:02x}: ANS's byte didn't land (bit 7 clear): not read")
    clear = [k for k, v in final.items() if v is False]
    unread = [k for k in ("SIO", "ANS", "PMP") if final.get(k) is None]
    if clear:
        out.append(f"  so: in the state the recipe leaves, bit 1 read CLEAR for {', '.join(clear)}, for 100 ms. That's a lead for where"
                   " B2 stops, not its location: B2 polls later, after its own raise. The next run leaves that coprocessor"
                   " differently and reads the marker"
                   + (f". Not read: {', '.join(unread)}" if unread else ""))
    elif unread:
        out.append("  so: " + ("nothing was read in the state the recipe leaves" if len(unread) == 3 else
                               "bit 1 read set where it was read in the state the recipe leaves")
                   + f"; not read for {', '.join(unread)}: nothing decided for " + ("any of them" if len(unread) == 3 else "those"))
    else:
        out.append("  so: bit 1 read SET for all three in the state the recipe leaves: that makes B2's three coprocessor waits less"
                   " likely to be where the pair stops, and doesn't exclude them (B2 polls later, after its own raises)")
    return out


def fab_lines(v, pre=FAB_PRE):
    """fabric_up=1: 0x6007 from stage 0x52 on (e1-hook/fabric_up.h has the layout). It says what the word read, and leaves
    the ending to the stage and wd2_bite=1's sample. pre: the run's stage before the commit: 0x52, gates_mark=1's 0x4b or sio_down=1's 0x3a."""
    was, took, kept = v >> 2 & 3, bool(v & 0x10), bool(v & 0x20)
    out = [f"0x6007 = 0x{v:02x}: fabric_up=1's byte, in place of the cores that held:"]
    if v & 2:
        # The bad case by design: step 7's byte, which this one replaces, has this bit set whenever CPU1 held.
        return out + ["  bit 1 is set: NOT all seven other cores wrote their stop bit and held; or this is still step 7's byte, the"
                      f" cores that held, where this bit is CPU1's, and stage 0x{pre:02x}'s command didn't put the run's byte in its place."
                      " Either way nothing more is read out of it: no fabric outcome, and no marker in WD1 is taken to stand"]
    out += ["  the other cores: all seven wrote their stop bit and held",
            f"  bit 0 (sio_on=1): ps_sio, UART_P and SPI_P {'all read actual f within 10 ms' if v & 1 else 'did NOT all read actual f within 10 ms'}",
            f"  the fabric's p-state word (0x28e20c000) before CPU0's write: {FAB_WAS[was]}",
            "  after the write of 3 to its low nibble: " + ("it read 0x333, not busy, within 10 ms" if took else "it did NOT read 0x333 within 10 ms")
            + "; at the end of step 5, after the ClkGen park and PLL-off: " + ("0x333" if kept else "NOT 0x333")]
    if not v:
        out.append("  so: 0x00 is also what a byte that didn't land reads, and it would otherwise say that nothing settled and no"
                   " marker stood: not a reading to lean on")
    elif took and kept:
        out.append("  so: the fabric was at 3 when the table went out and still there when step 5 ended, where macOS has it at its"
                   " commit" + (": the kernel had lowered it, and the write brought it back" if was in (1, 2) else
                                ". But it read 0x333 before the write too: this suspend hadn't lowered it, so the write changed nothing"
                                " and the fabric wasn't a difference from macOS in this run" if was == 3 else
                                ". Before the write it read neither 0x333 nor a word asked down to 1, which nothing predicted"))
    elif took:
        out.append("  so: the fabric came back to 3 after the write and was NOT there when step 5 ended: something in the table moved"
                   " it (the ClkGen park or PLL-off, most likely). The engine didn't find it where macOS leaves it")
    elif kept:
        out.append("  so: the fabric didn't read 0x333 within 10 ms of the write but did when step 5 ended: it settled late, and was"
                   " at 3 before the commit")
    else:
        out.append("  so: the fabric did NOT come back to 3, neither within 10 ms of the write nor by step 5's end. The run's one"
                   " change didn't take, and the ending says nothing about a fabric at 3")
    w = v & WD1_STANDS
    if w == WD1_STANDS:
        out.append(f"  bits 7:6 (wd1_mark=1): WD1 stood as the marker just before the commit: armed, its bite {WD1_BITE_S} s, its count"
                   f" past {WD1_COUNT_S} s and running. The restart's time is read against it below, as far as the stage and"
                   " wd2_bite=1's sample bear a reading out")
    elif w:
        out.append("  bits 7:6 (wd1_mark=1): the marker did NOT stand just before the commit: "
                   + (f"WD1 was armed with its {WD1_BITE_S} s bite, but its count didn't read past {WD1_COUNT_S} s, by up to 5 s: the"
                      " count write didn't take, or the count isn't running" if w == 0x40 else
                      f"WD1's count read past {WD1_COUNT_S} s, by up to 5 s, but it wasn't armed with the {WD1_BITE_S} s bite")
                   + ". The restart's time says nothing about B2, and a time that isn't WD2's may be WD1's")
    else:
        out.append("  bits 7:6 (wd1_mark=1): clear: no marker in WD1 stands in this record. In a run without wd1_mark=1 (the reading's"
                   " label and the load log say which this was) the restart's time is read against WD2 alone. In one with it, the"
                   " marker read back wrong in both respects, WD1 may still be armed some other way, and a time that isn't WD2's"
                   " may be WD1's")
    out.append("  (how the run ended is the stage's and wd2_bite=1's sample's to say; PLAN.md has how an ending reads with this)")
    return out


def fab_landed(b):
    """fabric_up=1: is 0x6007 the run's byte? Step 7 leaves the cores that held there (0xff as a rule), and stage 0x52's command
    puts the byte in its place, last of four. The steps' outcomes at 0x6012 go out right after that command and only if it
    didn't fail, so their marker at 0x6013 says the command landed whole. Without it the byte may still be step 7's."""
    return b[0x13] == K_MARK or b[0x13] & W_MARK == W_MARK


def mark_reading(x, s, v):
    """wd1_mark=1, the marker standing: what a restart x s after the commit (to a second either way) says, at stage s with
    wd2_bite=1's sample v (0x6005). The time names no watchdog by itself: each reading is the one that fits, and it's given
    only where the stage and the sample bear it out."""
    head = "  wd1_mark=1's marker: "
    unzeroed = WD1_BITE_S - WD1_COUNT_S
    if s in PRE_STAGES:
        return (f"{head}not read. Stage 0x{s:02x} is the last before the commit: nothing here records the commit, the release or WD2 after"
                f" it, so {x:.0f} s can't be read as B2's progress. WD1 has been armed since step 4, so a run that stopped anywhere"
                f" from there on restarts by itself about {unzeroed} s later, committed or not")
    if s in WD2_PEND:
        return (f"{head}not read. CPU0 had an exception pending after its reads (the stage) and likely never went down, and a core"
                f" left up holds the engine by itself: {x:.0f} s says nothing about a pair with every core down")
    code = v >> 6
    # live: WD2 seen armed, still armed after CPU0's write and counting, so that it fires unless something stops it. 0xfe is
    # the parked cores, which stage 0x52 leaves in this byte: not a sample.
    live = bool(v & 4 and v & 0x10 and v & 0x20 and v != 0xfe)
    moved = bool(live and v & 8)
    if abs(x - unzeroed) <= 4:
        return (f"{head}about {unzeroed} s is what WD1 gives with its count never zeroed: B2 didn't reach its op 224, and the stall is"
                " at B2's first poll, in the first handshake (A2's three steps of its own) or in B2's power-down. That's the"
                " reading that fits with nothing else assumed, not a proof of which watchdog fired: a pair that finished, with"
                " a later A sequence starting about 60 s after the commit and arming WD2 with its own 30 s, gives the same time")
    if abs(x - WD2_BITE_S) <= 4:
        if not moved:
            return (f"{head}about {WD2_BITE_S} s, but wd2_bite=1's sample, above, doesn't show WD2 armed and counting with CPU0's"
                    f" {WD2_BITE_S} s bite, so this record doesn't make the time WD2's. Not read as B2's progress")
        if code not in (1, 2):
            return (f"{head}about {WD2_BITE_S} s is WD2's moved bite, but PHASE didn't read 4 or 5, A2's before its last, in the sample"
                    " above: a later A sequence may have armed WD2, after a pair that finished. Not read as B2 stopping in its last ops")
        return (f"{head}about {WD2_BITE_S} s is WD2: B2 zeroed WD1's count, so B2's first poll passed, A2's three steps settled and"
                " B2's power-down ran; the pair then stopped in its last twenty-odd ops (the second handshake, the PMU command, the"
                " third handshake). One other reading isn't excluded by this run alone: a WD1 that can't reset the SoC in this"
                " state, which a run with WD1's bite below WD2's would show")
    if x >= WD1_BITE_S - 4:
        # WD1's bite counts from B2's zeroing, which comes however long B2's power-down takes after the commit.
        late = f", which then came about {x - WD1_BITE_S:.0f} s after the commit" if x > WD1_BITE_S + 4 else ""
        if not live:
            return (f"{head}{x:.0f} s is WD1's {WD1_BITE_S} s from a count that B2 zeroed{late}, but wd2_bite=1's sample, above,"
                    " doesn't show WD2 armed and counting: a WD2 that wouldn't have fired anyway says nothing by staying silent."
                    " Not read as a pair that finished")
        return (f"{head}{x:.0f} s is WD1's {WD1_BITE_S} s from a count that B2 zeroed{late}, with WD2, which the sample above saw"
                " armed and counting, stopped before it could fire: the entry pair FINISHED, and WD1 ended it as a dead-man")
    return (f"{head}{x:.0f} s is none of its times (about {unzeroed} s, about {WD2_BITE_S} s, {WD1_BITE_S} s or more): not read. Right"
            " only in the first boot after the run, like the time itself")


# gates_mark=1: the six gate words by their bit in its byte, gates_mark.h's order (look.h's), then bit 6, the fabric lane, and
# bit 7, always set.
GATE_WORDS = ("0x28e5a0050", "0x28e5a0064", "0x28e5a030c", "0x28e09c310", "0x28e09c338", "0x28e09c34c")
GATES_LANE, GATES_MARK = 0x40, 0x80


def alarm_res(b, s):
    """0x6016 as the alarm's result, or None at gates_mark=1's and sio_down=1's stages, whose byte it is there instead."""
    return None if s in GATES_STAGES + SIOD_STAGES else b[0x16]


def gates_lines(s, b, pmp):
    """gates_mark=1: 0x6016 at the run's stages (e1-hook/gates_mark.h has the layout), read only where the record says it's the
    gate byte: the stage has pmp_out=1's bit 7, the steps' outcomes, sent just before it, landed, and its own bit 7 is set."""
    v = b[0x16]
    if not pmp:
        return [f"0x6016 = 0x{v:02x}: not read. A gates_mark=1 run's stages always carry pmp_out=1's bit 7, and this one doesn't: not a"
                " record that run leaves"]
    if not fab_landed(b):
        return [f"0x6016 = 0x{v:02x}: not read. The gate byte goes out right after the steps' outcomes, and only if their command didn't"
                " fail, and their marker isn't at 0x6013: the byte isn't shown to have been sent"]
    if not v & GATES_MARK and s == GATES_PRE:
        return [f"0x6016 = 0x{v:02x}: THE GATE BYTE DIDN'T LAND (bit 7 clear), though stage 0x4b and the steps' outcomes did: CPU0 was"
                " reading the six gate words and the lane, or sending their byte, when the record stopped. A read that faulted (its"
                " SError panics the kernel: a restart about 10 s later, if the panic's restart works), a read that never returned"
                " (WD1's marker: a restart about 90 s after step 4), or the byte's own command failing, after which the run went on"
                " with nothing more recorded: this record doesn't tell them apart, and the restart's time, below, only in part"]
    if not v & GATES_MARK:
        return [f"0x6016 = 0x{v:02x}: bit 7 is clear, so the gate byte didn't survive the reset, or isn't the one sent: stage 0x{s:02x}"
                " went out after it, and a command that fails stops every one after it. Not read"]
    out = [f"0x6016 = 0x{v:02x}: gates_mark=1's byte, in place of the alarm's result: what CPU0 read in step 8, right before the"
           " commit and before B2's own writes:"]
    out += [f"  {w}: bit 30 {'SET, closed' if v >> i & 1 else 'clear, open'}" + (" (the gate B2 polls at op 140, after SIO's subtree)" if not i else "")
            for i, w in enumerate(GATE_WORDS)]
    out.append("  AFNC2_LW1 (0x28e580160), the fabric lane above SIO: " + ("read 0x1000030f, macOS's value" if v & GATES_LANE else
                                                                           "did NOT read 0x1000030f, macOS's value (the load log has it awake)"))
    if v & 1:
        out.append("  so: 0x28e5a0050 read closed in the recipe's state: B2's poll of it at op 140 is cleared, as far as a read before"
                   " B2's own writes can clear it, and a2_pre=1 is next (PLAN.md)")
    else:
        out.append("  so: 0x28e5a0050 read OPEN in the recipe's state too, as after Linux's own suspend. That doesn't place the stall:"
                   " the recipe leaves ps_sio, UART_P, SPI_P and SIO_CPU on, as macOS has them, and B2 switches them off itself"
                   " before its poll at op 140. Whether the gate closes then, this read can't say (RESEARCH.md, \"The gates read's"
                   " run\")")
    if s == GATES_PRE:
        out.append("  stage 0x4b, so nothing records the commit after this byte (0x54 or 0x55 comes after it): inconclusive about the"
                   " rest of the entry")
    return out


# sio_down=1's byte, sio_down.h's second layout (the first run's 0x96 had another: RESEARCH.md, "The `sio_down=1` run").
SIOD_CLOSED, SIOD_BACK_STATE, SIOD_BACK_AUTO, SIOD_BACK_GATE, SIOD_AT, SIOD_MARK = 0x01, 0x08, 0x10, 0x20, 0x40, 0x80
SIOD_AUTO_SHIFT = 1
SIOD_AUTO_EN_SET, SIOD_AUTO_OTHER, SIOD_AUTO_F, SIOD_AUTO_ZERO = range(4)
SIOD_AT_POLL, SIOD_AT_CLOSED = 62, 63
# The 43 words in B2's order, sio_down.h's SIOD_OFFS: a place in the byte is an index into this.
SIOD_WORDS = ((("SIO_CPU", 0x188),) + tuple((f"I2C{i}", 0x1a8 + 8 * i) for i in range(8)) + tuple((f"FPWM{i}", 0x190 + 8 * i) for i in range(3))
              + tuple((f"SIO_SPMI{i}", 0x218 + 8 * i) for i in range(3)) + (("AES", 0x2d0),) + tuple((f"SPI{i}", 0x1f0 + 8 * i) for i in range(5))
              + (("UART_N", 0x238),) + tuple((f"UART{i}", 0x240 + 8 * i) for i in range(5)) + (("UART6", 0x268), ("UART7", 0x270))
              + tuple((f"MCA{i}", 0x288 + 8 * i) for i in range(4)) + tuple((f"DPA{i}", 0x2a8 + 8 * i) for i in range(5))
              + (("SIO_ADMA", 0x280), ("SPI_P", 0x1e8), ("UART_P", 0x230), ("AUDIO_P", 0x278), ("SIO", 0x180)))
SIOD_AUTO_LINES = {
    SIOD_AUTO_ZERO: "all 0 in all 43: the 0 reads back whole",
    SIOD_AUTO_F: "auto-enable 0 in all 43; bits 27:24 f in one or more of SIO, SIO_CPU and SIO_SPMI0-2, 0 everywhere else: what those five"
                 " read after any switch-off on file, Linux's own included",
    SIOD_AUTO_OTHER: "auto-enable 0 in all 43, but bits 27:24 NOT as expected: something other than 0 outside SIO, SIO_CPU and SIO_SPMI0-2,"
                     " or other than 0 and f in one of those",
    SIOD_AUTO_EN_SET: "AN AUTO-ENABLE (bit 28) STILL READ SET in at least one word",
}


def siod_lines(s, b, pmp):
    """sio_down=1: 0x6016 at the run's stages (e1-hook/sio_down.h has the layouts), read only where the record says it's that
    byte: the stage has pmp_out=1's bit 7, the steps' outcomes, sent just before the switch-off, landed, and its own bit 7 is set."""
    v = b[0x16]
    if not pmp:
        return [f"0x6016 = 0x{v:02x}: not read. A sio_down=1 run's stages always carry pmp_out=1's bit 7, and this one doesn't: not a"
                " record that run leaves"]
    if not fab_landed(b):
        return [f"0x6016 = 0x{v:02x}: not read. sio_down=1's byte goes out after the steps' outcomes, and only if their command didn't"
                " fail, and their marker isn't at 0x6013: the byte isn't shown to have been sent"]
    if not v & SIOD_MARK and s == SIOD_PRE:
        return [f"0x6016 = 0x{v:02x}: SIO_DOWN'S BYTE DIDN'T LAND (bit 7 clear), though stage 0x3a and the steps' outcomes did: CPU0 was"
                " reading the 43 power words of SIO's subtree, writing them 0, polling them or the two gates, or sending the byte, when"
                " the record stopped. How many of the 43 were off by then isn't recorded, and nothing shows them written back. A"
                " read or a write that faulted (its SError panics the kernel: a restart about 10 s later, if the panic's restart"
                " works), one that never returned (WD1's marker: a restart about 90 s after step 4), or the byte's own command"
                " failing, after which the run went on with nothing more recorded: this record doesn't tell them apart, and the"
                " restart's time, below, only in part"]
    if not v & SIOD_MARK:
        return [f"0x6016 = 0x{v:02x}: bit 7 is clear, so sio_down=1's byte didn't survive the reset, or isn't the one sent: stage"
                f" 0x{s:02x} went out after it, and a command that fails stops every one after it. Not read"]
    out = [f"0x6016 = 0x{v:02x}: sio_down=1's byte, in place of the alarm's result: CPU0 was to write 0 to the 43 power words of SIO's"
           " subtree in step 8, as B2 does before its op 140, poll as B2 polls, and write them back before the commit:"]
    stopped = b[0x12] >> 6 == 3  # sio_stop=1's outcome, sent with the marker fab_landed() has just checked
    nostop = ("  so: INCONCLUSIVE: SIO's firmware isn't shown stopped (0x6012: " + SIO_CODES[b[0x12] >> 6] + "), so SIO_CPU was switched"
              " off and on under it: not the state this is for")
    late = ("  a poll that isn't met takes its 100 ms, so the commit came later than its time stamp, by up to about 5 s: a restart"
            " by WD2 would read that much later than it was, and one by WD1's marker, counting since step 4, isn't moved")
    pre = ("  stage 0x3a, so nothing records the commit after this byte (0x3b or 0x3c comes after it): inconclusive about the"
           " rest of the entry")
    if v & SIOD_AT:
        at = v & 0x3f
        if at == SIOD_AT_CLOSED:
            out.append("  0x28e5a0050 before the first write: ALREADY CLOSED, which it wasn't in --m1-gates' run or the first sio_down=1 run")
            out.append("  so: NOTHING WAS WRITTEN: the switch-off isn't made on a gate that's closed already. Something else differs in"
                       " this run, and that is the lead. The commit found SIO's subtree as the recipe leaves it")
        elif at == SIOD_AT_POLL:
            out.append("  the 43 words after the polls: all read target 0 and actual state 0")
            out.append("  B2's 42 polls for bit 11 clear: NOT all met within 100 ms each; which isn't recorded")
            out.append("  so: INCONCLUSIVE on the gate, whose reading isn't kept in this case: B2 waits for each of those polls, and one"
                       " that isn't met with a core up is its own lead" if stopped else nostop)
            out.append(late)
        elif at < len(SIOD_WORDS):
            name, off = SIOD_WORDS[at]
            out.append(f"  the 43 words after the polls: {name} (0x28e580{off:03x}), place {at} of 0 to 42 in B2's order, DIDN'T READ target 0 and"
                       " actual state 0. It's the first in that order that didn't; whether a later one didn't either, what it read, and"
                       " whether every poll was met aren't recorded")
            out.append(f"  so: SIO's subtree wasn't off, so the gate was bound to stay open and its reading isn't kept. What holds {name}"
                       " up after a 0 is the lead (PLAN.md)" if stopped else nostop)
            out.append("  if a poll wasn't met either, it took its 100 ms, and the commit came later than its time stamp, by up to about 5 s")
        else:
            return [f"0x6016 = 0x{v:02x}: bit 6 says a place follows, and {at} isn't one sio_down=1 sends (0 to 42, 62, 63). Not read"]
        if at != SIOD_AT_CLOSED:
            out.append("  written back: NOT RECORDED in this case, so the commit isn't shown to have found SIO's subtree as the recipe leaves"
                       " it: the restart's time doesn't compare with --m1-gates'")
        if s == SIOD_PRE:
            out.append(pre)
        return out
    auto = v >> SIOD_AUTO_SHIFT & 3
    closed = "closed" if v & SIOD_CLOSED else "open"
    out.append("  the 43 words after the polls: all read target 0 and actual state 0, and B2's 42 polls for bit 11 clear were all met:"
               " SIO's subtree was off")
    out.append("  0x28e5a0050 before the first write: open, as in every run so far")
    out.append("  the 43 words' auto fields after the 0: " + SIOD_AUTO_LINES[auto])
    out.append("  0x28e5a0050 (B2's op 140), after up to 100 ms for 0x28e5a0064 and 100 ms more for it: bit 30 "
               + ("SET, closed" if v & SIOD_CLOSED else "clear, OPEN"))
    if not v & (SIOD_BACK_STATE | SIOD_BACK_AUTO | SIOD_BACK_GATE):
        out.append("  written back: NOTHING CONFIRMED: none of the 43's target and actual state, their auto fields and the gate read as"
                   " before, or the run stopped in the write-back, before the byte's second send, or that send's command failed")
    else:
        out.append("  written back, target and actual state: " + ("all 43 read as found within 10 ms each" if v & SIOD_BACK_STATE else
                                                                  "NOT all 43 read as found within 10 ms of their write-back"))
        out.append("  written back, auto-enable and bits 27:24: " + ("all 43 read as found then" if v & SIOD_BACK_AUTO else
                                                                     "not all 43 read as found then"))
        out.append("  0x28e5a0050 after the write-back: " + ("open again within 100 ms" if v & SIOD_BACK_GATE else
                                                              "NOT open again within 100 ms"))
    aps = (" This is the AP's state before the commit, not B2's at op 140: the cores are up, and A2's DCS and fabric moves and B2's own"
           " raises haven't been made")
    asb2 = ("" if auto == SIOD_AUTO_ZERO else " Bits 27:24 read f after the 0 in some of the five words that read f after any switch-off:"
            " taken as how those words read with auto-enable clear, not as a setting the 0 missed, since B2 writes the same 0 to the"
            " same words (RESEARCH.md).")
    if not stopped:
        out.append(nostop + f" (0x28e5a0050 read {closed})")
    elif auto == SIOD_AUTO_EN_SET:
        out.append("  so: INCONCLUSIVE on the gate: an auto-enable survived the 0, so the subtree, though off, wasn't as B2's 0 is meant to"
                   f" leave it (0x28e5a0050 read {closed}). Which word, and why, comes before GPIO or a2_pre=1 (PLAN.md)")
    elif auto == SIOD_AUTO_OTHER:
        out.append("  so: INCONCLUSIVE on the gate: bits 27:24 read something after the 0 that no switch-off on file left, so the subtree,"
                   f" though off, isn't shown to be as B2's 0 leaves it (0x28e5a0050 read {closed}). Which word, and what it read, comes"
                   " before GPIO or a2_pre=1 (PLAN.md)")
    elif v & SIOD_CLOSED:
        out.append("  so: 0x28e5a0050 CLOSED once SIO's subtree was off: the gate can close in the recipe's state, so B2's poll at op 140"
                   " is less likely the stall, and a2_pre=1 is next (PLAN.md)." + asb2 + aps)
    else:
        out.append("  so: 0x28e5a0050 stayed OPEN with SIO's subtree off, B2's own words and values, in the recipe's state: a lead on"
                   " B2's poll at op 140, stronger than the gate test's. What else is behind that gate is the question, GPIO's power"
                   " word first (PLAN.md)." + asb2 + aps)
    if not (v & SIOD_BACK_STATE and v & SIOD_BACK_GATE):
        out.append("  without the words' target and actual state and the gate confirmed back, the commit may not have found SIO's subtree"
                   " as the recipe leaves it: the restart's time doesn't compare with --m1-gates'")
    elif not v & SIOD_BACK_AUTO:
        out.append("  the auto fields alone not reading as found doesn't say the commit found the subtree differently: under auto-enable,"
                   " bits 27:24 have followed the actual state in every read on file. The restart's time compares with --m1-gates'")
    if s == SIOD_PRE:
        out.append(pre)
    return out


def ack_lines(f, q, held):
    """cluster_ack=1: 0x6014's bits 4 and 5 with qto's bits 2-5 (e1_hook.c's m1 comment). f has bits 7 and 4 set; held is
    0x6007, sent in one command with qto: non-zero, it shows that command's last bytes landed. It says what the words
    read, and leaves the ending to the stage and wd2_bite=1's sample."""
    out = [f"0x6014 bit 4 (cluster_ack=1): step 5 wrote ANE0's, AFR's and AVEMSR's soc-cluster words (0x28e09800c, 0x28e098014,"
           " 0x28e098020) as 0x20, target 0 with a 1 to bit 5, their up-done flag, not the table's 0; the four cluster waits"
           " asked for the whole word to read 0"]
    rest = bool(f & F_ACK_REST)
    c = q & CLUSTER_WAITS
    stuck = [n for i, n in ACK_WORDS.items() if c >> i & 1]
    more = ("; and at least one of the four words had something else left too (0x6014 bit 5: bit 4, busy, the target or another"
            " bit), which word and which bit isn't recorded" if rest else "")
    if not held and not q:
        out.append("  so: 0x6006 and 0x6007 both read 0. That's also what bytes that didn't land read, and 0x6007 would otherwise say"
                   " no core held: whose flag stayed isn't known from this record. 0x6014, another command's, says "
                   + ("something other than a flag was left in at least one of the four words" if rest else
                      "nothing other than a flag was left in any of the four words"))
    elif c & ACK_WROTE:
        out.append(f"  so: the up-done flag STAYED SET, 10 ms after the write, in {', '.join(stuck)}: the 0x20 didn't clear it there"
                   f"{more}. With a flag left in a word this run wrote, the ending says nothing about cleared flags")
    elif c:
        out.append("  so: ANE0's, AFR's and AVEMSR's flags read clear after their 0x20, and the flag STAYED SET in DISPLAY's, 10 ms"
                   f" after the table's own 0x20, which the earlier runs wrote there too{more}. The three words this run"
                   " changed took the ack; DISPLAY's flag is new: no earlier run looked at it")
    elif rest:
        out.append("  so: no flag stayed: bit 5 read clear in all four words. But at least one of them didn't read 0 within 10 ms of"
                   " its write (0x6014 bit 5): bit 4, busy, the target or another bit was left, and which word and which bit"
                   " isn't recorded. The acks took; what was left is new")
    else:
        out.append("  so: each of the four words read 0 within 10 ms of its write, before the commit: target 0, not busy, and the"
                   " flag clear")
    out.append("  (how the run ended is the stage's and wd2_bite=1's sample's to say; PLAN.md has how an ending reads with this)")
    return out


def run_second(low, compare, now, res):
    """hold=1 from 0x5c on: the commit's whole second, if 0x6016 (res) says the run's 0x140c write was acked and
    the compare value fits it (its second + 3600, not later than now, with these low two bytes); else None.
    low 0 counts as lost."""
    whole = compare - ALARM_SECS
    return whole if res & 0x88 == 0x88 and low and 0 < whole <= now and whole & 0xffff == low else None


def alarm_byte(v):
    """alarm=1's 0x6016: how far the alarm's commands got."""
    if not v & 0x80:
        return (f"0x6016 = 0x{v:02x}: the alarm's commands left no result (bit 7 clear): they didn't run, or the"
                " byte didn't land or survive; so the alarm wasn't tested. A repeat, not a negative")
    if v in ALARM_ACKED:
        ev = "the event was set, and echoed" if v == 0xbf else "no event was set"
        return f"0x6016 = 0x{v:02x}: every alarm command was acked ({ev}): 0x140c, 0x14c2 = 0, then 0x1401 = 0x41"
    if v not in (0x80, 0x83, 0x85, 0x87, 0x8d, 0x8f, 0x9d, 0x9f):
        return f"0x6016 = 0x{v:02x}: not a value e1_hook writes; don't read it"
    steps = ((0, "0x14c0's read"), (2, "0x14c0's echo" if v & 2 else "no echo needed"), (3, "0x140c"),
             (4, "0x14c2 = 0"), (5, "0x1401 = 0x41"))
    done = [n for bit, n in steps if v >> bit & 1]
    stop = next(n for bit, n in steps if not v >> bit & 1)
    return (f"0x6016 = 0x{v:02x}: the alarm's commands STOPPED at {stop} (before it: {', '.join(done) or 'nothing'}"
            f"{'; the event was set' if v & 2 else ''}): so the alarm wasn't tested. A repeat, not a negative")


def alarm_lines(s, commit, alarm, now, res):
    """The alarm's registers at this boot, always; for an alarm=1 stage, what they say. alarm: 0x1401, the
    compare value, 0x14c0, 0x14c2; res: 0x6016, or None where it isn't the alarm's (alarm_res())."""
    c, when, ev, mask = alarm
    state = {0x01: "not armed", 0x03: "fired, latched"}.get(c)
    if c == 0x41:
        state = f"armed, fires in {when - now} s" if when > now else f"armed, {now - when} s past its time"
    out = [f"PMU alarm: 0x1401 = 0x{c:02x}{f' ({state})' if state else ''}, 0x140c = {when},"
           f" 0x14c0 event 0x{ev:02x}, 0x14c2 mask 0x{mask:02x}"]
    if s not in ALARM_STAGES:
        return out
    right = commit is not None and when == commit + ALARM_SECS
    recorded, acked = res is not None and bool(res & 0x80), res in ALARM_ACKED
    # gates_mark=1: the alarm's commands ran as ever, but their result isn't recorded.
    nores = "this run records no result for the alarm's commands (gates_mark=1's byte, or sio_down=1's, has 0x6016)"
    if commit is None:
        out.append("  the commit's second isn't known, so 0x140c can't be checked")
    elif right:
        out.append(f"  0x140c is the commit's second + {ALARM_SECS}, as the run wrote it")
    else:
        out.append(f"  0x140c is NOT the commit's second + {ALARM_SECS} ({commit + ALARM_SECS}): the alarm wasn't tested")
    if c in (0x41, 0x03):
        if (right and (acked or not recorded)) or (commit is None and acked):
            out.append(f"  the armed alarm survived the reset{' and has fired' if c == 0x03 else ''}")
        elif commit is None:
            out.append("  whether 0x1401 is this run's can't be told: the commit's second isn't known, and "
                       + (nores if res is None else "0x6016 doesn't say its write was acked"))
        else:
            out.append("  0x1401 isn't shown to be this run's: a value from before the run, or macOS's")
    elif c == 0x01 and right:
        if not acked:
            out.append("  0x140c landed, but " + (nores if res is None else "0x1401's write wasn't acked" if recorded else
                                                   "0x6016 recorded no result")
                       + ": nothing shows the enable was ever set")
        elif now < when:
            out.append("  0x1401 reads 0x01 before the alarm's time, with 0x140c right and 0x1401's write acked: the reset"
                       " or the boot firmware cleared the enable (new)")
        else:
            out.append("  0x1401 reads 0x01 past the alarm's time, with 0x140c right and 0x1401's write acked: it may have"
                       " fired (on T8103 a fired alarm reads 0x01), or the reset or the boot firmware cleared the enable;"
                       f" 0x14c0 is 0x{ev:02x}")
    return out


def ctrl(c):
    """A watchdog's control bits, as apple_wdt names them."""
    on = [n for bit, n in ((0, "IRQ_EN"), (1, "IRQ_STATUS"), (2, "RESET_EN")) if c >> bit & 1]
    return f"{c}" + (f" ({', '.join(on)})" if on else " (off)")


def decode(b, rtc, cnt=None, alarm=None):
    """b: 0x6000-0x601f; rtc: 6 bytes at 0x1406; cnt: (CNTVCT, CNTFRQ) or
    None; alarm: the RTC alarm's registers (alarm_lines()), or None. One line
    per fact."""
    if b[4] == LOOK_STAGE:
        # Not a run, and nothing was stopped or written but these marks.
        return [f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
                f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
                f"stage 0x6004 = 0x{b[4]:02x}: probe=1 look=1 (e1-hook/probe --look), not a run: nothing replayed, nothing was"
                " committed, nothing was stopped and "
                + ("the looks wrote no register; gate=1's test, after them, changes six power words and writes them back (--gate): how"
                   " far it got is below" if b[0x10] & GATE_PASS else "no register was written")
                + ". What it read is in the kernel log it saved, if the Mac was up to save it"
                ] + (gate_lines(b[0x10], b[5], b[0x11:0x17]) if b[0x10] & GATE_PASS else look_lines(b[0x10]))
    if b[4] == PROBE_STAGE:
        # Not a run: no commit, no alarm, no restart to time.
        return [f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
                f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
                f"stage 0x6004 = 0x{b[4]:02x}: probe=1 (e1-hook/probe), not a run: nothing replayed and nothing was committed. The"
                " step it reached and its three bytes follow; the kernel log it saved has every word in full, if the Mac came back"
                " to save it"
                ] + probe_lines(b[5], b[6], b[7], b[0x10])
    pmp = bool(b[4] & PMP_TAG)
    s = b[4] & 0x7f
    disp = s in DISP_STAGES  # disp_off=1: read as the position stage, with its own byte B
    if disp:
        s &= ~0x08
    hold = s in HOLD
    late = s in LATE or hold
    base = HOLD.get(s, LATE.get(s, s))  # the stage of runs 1 and 2 it stands for
    obs = base in OBSERVED
    # An observe=1 run, below CPU7's own stages. Not recfg_bite=1's or wd2_bite=1's stage: its 0x6005 is the sample.
    mark = s not in POSITION and s not in SAMPLE_STAGES and 0x10 <= base <= 0x60 and bool(b[5] & 1)
    text = HOLD_TEXT.get(s) or LATE_TEXT.get(s) or stage(base, mark)
    # cluster_ack=1's mark is in 0x6014, sent just before stage 0x4e. None: this record can't say whether it was such a
    # run (a stage one passes before that, or the byte lost). False: a stage, or a run without pmp_out=1, that isn't one's.
    if pmp and s in ACK_MARKED:
        ack = bool(b[0x14] & F_ACK) if b[0x14] & 0x80 else None
    else:
        ack = None if pmp and s in ACK_EARLY else False
    pre = SIOD_PRE if s in SIOD_STAGES else GATES_PRE if s in GATES_STAGES else FAB_PRE  # the run's stage before the commit, for fabric_up=1's byte
    ares = alarm_res(b, s)  # 0x6016 as the alarm's result, or None
    out = [
        f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
        f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
        f"boot stage 0x6001 = 0x{b[1]:02x} (0x30 after a boot); boot-error stage 0x6003 = 0x{b[3]:02x}"
        " (the stage the last unclean end found; sticky, so it says nothing about this boot by itself;"
        " this boot's journal says, macsmc-reboot's \"PMU logged N boot error(s)\")",
        f"stage 0x6004 = 0x{b[4]:02x}{' (pmp_out=1: bit 7' + ('; disp_off=1: bit 3' if disp else '') + ', so the stage is ' + hex(s) + ')' if pmp else ''}"
        f"{' (pmgr_late=1)' if late else ''}: {text}",
    ]
    if s:
        out.append("  (the last breadcrumb that reached the PMU: the run got at least that far)")
    if pmp:
        out.append(pmp_byte(b[0x15]))
    elif s == 2 and b[0x15] & 0x80:
        # K1 zeroes these and step 8 can't have run: this can only be K4's.
        out.append(pmp_byte(b[0x15]) + "; K4 finished, its stage write didn't land")
    if mark:
        out.append(f"  observe=1 (0x6005 bit 0): CPU7 was kept up for the observer, so it isn't in"
                   f" {'0x6007' if late else '0x6006 or 0x6007'} and PCPM1 wasn't checked")
    if obs:
        off = b[5]
        out.append(f"0x6005 = 0x{off:02x}: CPU0 {'read off' if off & 1 else 'did NOT read off'} within 500 ms of the"
                   f" hand-over; the E complex (ECPM) {'read off' if off & 0x80 else 'did NOT read off'} within 500 ms"
                   f" more; read off at their release: {cpus(off & 0x7e)}")
        w = b[6]
        wd1 = ctrl(w >> 4 & 7) + (": armed again after step 4 stopped it" if w & 0x40 else "")
        out.append(f"0x6006 = 0x{w:02x}: after the commit, WD2 control {ctrl(w & 7)}; WD1 control {wd1};"
                   f" WD0 {'ARMED again (K2 zeroed its control)' if w & 8 else 'not armed'} to reset; CPU0's last"
                   f" WFI {'HAD RETURNED (not power-gated then)' if w & 0x80 else 'had not returned'}")
        out.append(f"0x6007 = {b[7]}: " + ("no watchdog was armed to reset the SoC" if b[7] == 255 else
                                         f"{b[7]} s until the first armed watchdog's reset, as CPU7 read it"))
    elif base >= 0x10:
        if s in SAMPLE_STAGES:
            pass  # 0x6005 is the sample: recfg_lines() or wd2_lines(), below
        elif s in HOLD_AFTER and s not in SIO_STOP_STAGES:
            out.append(f"read off after the release (0x6005 = 0x{b[5]:02x}, up to 10 ms each): {cpus(b[5] & 0xfe)}")
            if s in POSITION:
                if disp:
                    out.append(f"0x6005 bit 0 (smc_idle=1): the SMC {'acked the AP idle notice within 200 ms' if b[5] & 1 else 'did NOT ack an AP idle notice, or this run sent none'}")
                else:
                    out.append(f"0x6005 bit 0: SIO_CPU's bits 27:24 {'read f' if b[5] & 1 else 'did not read f'} at entry 61's"
                               " wait, the reference for its class")
        else:
            out.append(f"parked (0x6005 = 0x{b[5]:02x}): {cpus(b[5] & 0xfe)}")
        if late and base >= 0x20:
            out.append(f"0x6006 = {qto(b[6], bool(ack))}")
            if ack is None:
                out.append("  (nothing here says whether this was a cluster_ack=1 run: its mark is 0x6014's bit 4, sent just before"
                           " stage 0x4e (0x52 with fabric_up=1, 0x4b with gates_mark=1, 0x3a with sio_down=1)" + (", and that byte didn't survive" if s in ACK_MARKED else "") + ". In one, bits 2-5 are"
                           " the cluster words whose flag stayed, not the waits on bit 4 that timed out)")
        if base >= 0x30:
            if not late:
                out.append(f"left their spin to stop (0x6006 = 0x{b[6]:02x}): {cpus(b[6])}")
            if not pmp and (s in POS_S2 or s == 0x43):
                pass  # sample 2's, or not decoded: position_lines()
            elif s in FAB_STAGES and not pmp:
                out.append(f"0x6007 = 0x{b[7]:02x}: not read. A fabric_up=1 run's stages always carry pmp_out=1's bit 7, and this one"
                           " doesn't: not a record that run leaves")
            elif s in FAB_STAGES and fab_landed(b):
                out += fab_lines(b[7], pre)
            elif s in FAB_STAGES:
                out.append(f"0x6007 = 0x{b[7]:02x}: not read. The steps' outcomes go out right after stage 0x{pre:02x}'s command, and only if"
                           " it didn't fail, and their marker isn't at 0x6013: that command isn't shown to have landed whole, and this"
                           " byte, its last, may still be the one step 7 leaves here, the cores that held (0xff as a rule). It isn't"
                           " read as fabric_up=1's byte, and no marker in WD1 is taken to stand")
            elif hold:
                out.append(f"wrote their stop bit and held (0x6007 = 0x{b[7]:02x}): {cpus(b[7] & 0xfe)}")
                # sio_on=1's bit, which only its own stages can read when clear: a plain pmp_out=1 run leaves it clear too.
                if pmp and (b[7] & 1 or s in POSITION or s in SIO_STOP_STAGES):
                    out.append(f"0x6007 bit 0 (sio_on=1): ps_sio, UART_P and SPI_P "
                               f"{'all read actual f within 10 ms' if b[7] & 1 else 'did NOT all read actual f within 10 ms'}")
            else:
                out.append(f"read off within 10 ms (0x6007 = 0x{b[7]:02x}): {cpus(b[7])}")
    now = int.from_bytes(rtc[2:6], "little")
    commit = None
    if base in SHORT or s in HOLD_AFTER:
        low = int.from_bytes(b[0x10:0x12], "little")
        whole = run_second(low, alarm[1], now, ares or 0) if s in HOLD_AFTER and alarm else None
        if whole is not None:
            commit = whole
            out.append(f"RTC second just before the commit, from its low two bytes and the run's alarm: {commit},"
                       f" {now - commit} s before now ({now})")
        elif low:
            commit = now - ((now - low) & 0xffff)
            out.append(f"RTC second just before the commit, from its low two bytes: {commit}, {now - commit} s before"
                       f" now ({now}); right if this read comes within 18 h of the commit")
        else:
            out.append("0x6010-0x6011 read 0: the commit's second was lost (or, 1 run in 65536, really ends in 0000);"
                       " no reset time")
    else:
        secs = int.from_bytes(b[0x10:0x14], "little")
        if base >= 0x01 and secs:
            when = "just before the commit" if base >= 0x50 else "the replay's start (K1)"
            out.append(f"RTC second at {when}: {secs}, {now - secs} s before now ({now})")
            if base >= 0x50:
                commit = secs
    if base >= 0x50:
        f = b[0x14]
        if f & 0x80:
            pend = "".join(n for bit, n in ((2, "A"), (1, "I"), (0, "F")) if f >> bit & 1) or "nothing"
            pcpm1 = "not checked (CPU7 kept up)" if base >= 0x60 or mark else "off" if f & 0x20 else "NOT off"
            pcpm0 = "off" if f & 0x10 else "NOT off"
            if s in SIO_STOP_STAGES:
                pcpm0 = pcpm1 = "not read (hold_nowatch=1: CPU0 doesn't watch them)"
            elif hold and s == 0x5c:
                pcpm0 = pcpm1 = "being rewritten: not decoded"
            elif hold and s not in HOLD_AFTER:
                pcpm0 = pcpm1 = "not read yet (hold=1: nothing goes down before the commit)"
            elif s in HOLD_AFTER:
                pcpm0 += " after the release"
                pcpm1 += " after the release"
            out.append(f"0x6014 = 0x{f:02x}: CPU0 had {pend} pending before the commit;"
                       f" PCPM0 {pcpm0}, PCPM1 {pcpm1};"
                       f" WD1 {'was running (stopped)' if f & 0x40 else 'was off'};"
                       f" K3's kernel-path write after slpa {'FAILED' if f & 0x08 else 'worked'}")
            if ack:
                out += ack_lines(f, b[6], b[7])
            elif s in SIO_STOP_STAGES and f & (F_ACK | F_ACK_REST):
                out.append("  0x6014's bits 4 and 5 are cluster_ack=1's alone in a sio_stop=1 run: bit 5 only with bit 4, and only at"
                           " that run's stages (0x4e, 0x56, 0x57, or fabric_up=1's 0x52, 0x51, 0x53, or gates_mark=1's 0x4b, 0x54, 0x55, or sio_down=1's 0x3a, 0x3b, 0x3c, with pmp_out=1's bit 7). Here they aren't"
                           " that: don't read them")
        else:
            cmd = ("its own one-byte command" if s in POSITION else
                   "the 3-byte command it went in (0x6012-0x6014)" if s in (0x5d, 0x5e) else
                   "whichever command wrote it last (0x6010-0x6016 or 0x6012-0x6014)" if s == 0x5c else
                   "the 7-byte command it went in (0x6010-0x6016)")
            out.append(f"0x6014 = 0x{f:02x}: bit 7 is clear, so {cmd} didn't survive the reset; don't read it")
    if base in FULL and late:
        # CPU7 sends 0x6012-0x6013 in one command and 0x6015-0x6016 in another;
        # each pair's second byte has bit 7 set, so a pair without it didn't
        # survive the reset (zeroed, say), and its first byte isn't read either.
        t, d = b[0x13], b[0x16]
        lost = "bit 7 is clear, so this byte didn't survive the reset; don't read it"
        if not t & 0x80:
            out.append(f"0x6012 = 0x{b[0x12]:02x}: sent in one command with 0x6013, which didn't survive the reset;"
                       " not read as the waits that timed out")
            out.append(f"0x6013 = 0x{t:02x}: {lost}")
        else:
            out.append(f"0x6012 = {qto(b[0x12])}")
            out.append(f"0x6013 = 0x{t:02x}: EACC's power-down {BUCKETS[t & 7]}; PACC0's {BUCKETS[t >> 3 & 7]};"
                       f" PACC0's was {'STILL PENDING' if t & 0x40 else 'done'} just before the commit (CPU0's read)")
        cl = b[0x15]
        if not d & 0x80:
            out.append(f"0x6015 = 0x{cl:02x}: sent in one command with 0x6016, which didn't survive the reset;"
                       " not read as the soc clusters")
            out.append(f"0x6016 = 0x{d:02x}: {lost}")
        else:
            busy = ",".join(n for i, n in enumerate(SOC) if cl >> i & 1) or "none"
            out.append(f"0x6015 = 0x{cl:02x}: soc clusters still busy at the end of CPU7's watch: {busy} (PACC1"
                       f" expected, CPU7 being up); SIO_CPU's actual state {'NOT off' if cl & 0x80 else 'off'}")
            at5 = (d & 0x1f) == 0x15 and not d & 0x20
            out.append(f"0x6016 = 0x{d:02x}: DCS's p-state at CPU0's last wait before the commit (after entry 50):"
                       f" actual {d & 0xf}, target {'5' if d & 0x10 else 'NOT 5'}, busy bit 31"
                       f" {'SET' if d & 0x20 else 'clear'} ({'settled at 5' if at5 else 'NOT settled at 5'}); SIO's"
                       f" actual state {'NOT off' if d & 0x40 else 'off'} after the commit")
            # The wait after 50 ends met or at its timeout, so a settled
            # 0x6016 means that wait was met: a DCS timeout was 49's.
            if at5 and t & 0x80 and b[0x12] & 1:
                out.append("  so DCS's timed-out wait (0x6012 bit 0) was the one after entry 49: the one after 50"
                           " settled")
    elif base in FULL:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}: the low bytes of the wdt page's +0x28 and +0x40"
                   " after the commit (T8103's S2R-engine progress registers, inferred; e1_hook's load log has"
                   " them awake)")
        cl = b[0x15]
        busy = ",".join(n for i, n in enumerate(SOC) if cl >> i & 1) or "none"
        out.append(f"0x6015 = 0x{cl:02x}: soc clusters still busy: {busy} (PACC1 expected, CPU7 being up);"
                   f" SIO_CPU's actual state {'NOT off' if cl & 0x80 else 'off'}")
        wk = b[0x16]
        if not wk & 0x80:
            out.append(f"0x6016 = 0x{wk:02x}: bit 7 is clear, so this byte didn't survive the reset; don't read it")
        else:
            words = ",".join(str(i) for i in range(7) if wk >> i & 1) or "none"
            out.append(f"0x6016 = 0x{wk:02x}: AP wake-status words with a bit set that wasn't just before the"
                       f" commit: {words}")
    elif base == 0x62:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}, 0x6015 0x6016 = {b[0x15]:02x} {b[0x16]:02x}: CPU0's"
                   " or CPU7's (it was rewriting them): not decoded")
    elif base >= 0x50:
        if s in SIO_STOP_STAGES:
            out += k_lines(b)
            if s in RECFG_STAGES:
                out += recfg_lines(b[5])
            elif s in WD2_STAGES:
                out += wd2_lines(b[5], s in WD2_PEND)
        elif s in POSITION:
            out += position_lines(s, b, pmp, disp)
        elif hold and s in HOLD_AFTER:
            if s == 0x5c:
                out.append("0x6012-0x6014: being rewritten when the breadcrumbs stopped: not decoded")
            elif b[0x14] & 0x80:
                out.append(f"0x6012 = 0x{b[0x12]:02x}: the cores that took the release: {cpus(b[0x12])}")
                out.append(f"0x6013 = 0x{b[0x13]:02x}: of those, the ones with an interrupt pending just before their"
                           f" deep WFI: {cpus(b[0x13])}")
            else:
                out.append("0x6012 0x6013: went in one command with 0x6014, whose bit 7 is clear: not decoded")
        # From 0x5c on, 0x6015 still comes from step 8's command; its marker there is the second's low bytes.
        if pmp or s in POS_S2 or s == 0x43:
            pass  # 0x6015 is the PMP's byte, or a sample's, already printed
        elif s in HOLD_AFTER and not b[0x10:0x12] == bytes(2) or s not in HOLD_AFTER and b[0x14] & 0x80:
            at = "at their stop request (hold=1)" if hold else "at their stop"
            out.append(f"0x6015 = 0x{b[0x15]:02x}: cores with an interrupt pending {at}: {cpus(b[0x15])}")
        elif s in HOLD_AFTER:
            out.append("0x6015: step 8's command, whose second's low two bytes read 0: not decoded")
        if s in GATES_STAGES:
            out += gates_lines(s, b, pmp)
        elif s in SIOD_STAGES:
            out += siod_lines(s, b, pmp)
        elif s in ALARM_STAGES:
            out.append(alarm_byte(b[0x16]))
            if s in (0x59, 0x5a, 0x4e, FAB_PRE) and b[0x16] in ALARM_ACKED:
                nxt = {0x59: "0x5f", 0x5a: "0x5b", 0x4e: "0x4f, or recfg_bite=1's 0x46 or 0x47, or wd2_bite=1's 0x56 or 0x57,",
                       FAB_PRE: "0x51 or 0x53"}[s]
                out.append(f"  stage 0x{s:02x}, so nothing records {'the commit' if s in (0x4e, FAB_PRE) else 'the two commit writes'} after those commands ("
                           f"{nxt} comes after them): inconclusive about the rest of the entry")
        elif b[0x14] & 0x80:
            out.append(f"0x6016 = {b[0x16]}: AIC events the cores took off their event registers")
    if commit is not None and cnt and cnt[1]:
        age = cnt[0] / cnt[1]
        x = now - age - commit
        out.append(f"the SoC restarted about {x:.0f} s after the commit ({x - 1:.1f} to {x + 1:.1f} s: the PMU's RTC"
                   f" counts whole seconds); its counter (CNTVCT) is {age:.1f} s old. Right only in the first boot"
                   " after the run")
        if s in FAB_STAGES and pmp and fab_landed(b) and b[7] & (WD1_STANDS | 2) == WD1_STANDS:
            out.append(mark_reading(x, s, b[5]))
    if alarm:
        out += alarm_lines(s, commit, alarm, now, ares)
    return out


def main():
    args = sys.argv[1:]
    if args not in ([], ["--clear"]):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)
    clear = args == ["--clear"]
    path = find_nvmem()
    try:
        fd = os.open(path, os.O_RDWR if clear else os.O_RDONLY)
        b = os.pread(fd, 0x20, 0x6000)
        rtc = os.pread(fd, 6, RTC)
        al = [os.pread(fd, n, off) for off, n in ((ALARM_CTRL, 1), (ALARM, 4), (ALARM_EVENT, 1), (ALARM_MASK, 1))]
    except OSError as e:
        die(f"{path}: {e}")
    if len(b) != 0x20 or len(rtc) != 6 or [len(x) for x in al] != [1, 4, 1, 1]:
        die(f"{path}: short read")
    alarm = (al[0][0], int.from_bytes(al[1], "little"), al[2][0], al[3][0])
    for line in decode(b, rtc, counter(), alarm):
        print(line)
    if clear:
        # The run's own alarm: its compare value is the commit's second +
        # 3600, or, with that second lost, 0x6016 says 0x1401's write was acked.
        secs = int.from_bytes(b[0x10:0x14], "little")
        st = b[4] & 0x7f  # pmp_out=1's bit 7 off
        if st in DISP_STAGES:  # and disp_off=1's bit 3
            st &= ~0x08
        res = alarm_res(b, st)  # None after gates_mark=1's and sio_down=1's stages: 0x6016 is that run's byte, never the alarm's result
        if st in HOLD_AFTER:  # hold=1: the second's upper bytes are rewritten; its low two bytes stay
            now_s = int.from_bytes(rtc[2:6], "little")
            low = int.from_bytes(b[0x10:0x12], "little")
            secs = run_second(low, alarm[1], now_s, res or 0) or (now_s - ((now_s - low) & 0xffff) if low else 0)
        mine = st in ALARM_STAGES and (alarm[1] == secs + ALARM_SECS if secs else res in ALARM_ACKED)
        try:
            # Before the crumbs, so that a failed disarm keeps the stage for another try.
            if mine and alarm[0] & 0x42:
                if os.pwrite(fd, b"\x01", ALARM_CTRL) != 1:
                    die("short write at 0x1401")
                back = os.pread(fd, 1, ALARM_CTRL)
                if len(back) != 1 or back[0] & 0x40:
                    die("0x1401 still reads armed; the breadcrumbs stay, so this can run again")
                print(f"disarmed: 0x1401 = 0x{back[0]:02x}")
            elif st in ALARM_STAGES and not secs and alarm[0] & 0x40:
                die(f"0x1401 reads armed (0x{alarm[0]:02x}) after an alarm stage, but the commit's second was lost and"
                    " 0x6016 doesn't say 0x1401's write was acked"
                    + (" (after gates_mark=1's and sio_down=1's stages it never does: it's that run's byte)" if res is None else "")
                    + ", so whose alarm this is can't be told. Nothing is"
                    " written: the breadcrumbs stay, and clearing it needs Corey's word")
            elif alarm[0] & 0x40:
                print(f"0x1401 reads armed (0x{alarm[0]:02x}) and was left alone: nothing shows this run armed it")
            # The stage's block last: a clear that stops halfway then leaves the stage, and the launchers, which go by a
            # zero stage, refuse (Pullfrog on #80: a run's bytes at 0x6011-0x6016 left under a zero stage).
            for off, n in reversed(CRUMBS):
                if os.pwrite(fd, bytes(n), off) != n:
                    die(f"short write at {off:#x}")
            after = [os.pread(fd, n, off) for off, n in CRUMBS]
        except OSError as e:
            die(f"{path}: {e}")
        if any(a != bytes(n) for a, (_, n) in zip(after, CRUMBS)):
            die("cleared, but they don't read back as zeros")
        print("cleared: 0x6004-0x6007 and 0x6010-0x6016 read back as zeros")
    return 0


if __name__ == "__main__":
    sys.exit(main())
