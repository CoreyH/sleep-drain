#!/usr/bin/python3 -I
"""e1-hook/m1-crumbs: the breadcrumbs an M1-recipe run (run-floor --m1,
--m1-observe or --m1-late, e1_hook m1=1, observe=1, pmgr_late=1) leaves in the
PMU, read and decoded, and cleared again.

  e1-hook/m1-crumbs               read them (no root needed)
  pkexec e1-hook/m1-crumbs --clear   zero them, after reading (root)

They're bytes of the PMU's legacy scratch that e1_hook writes through SPMI
(e1_hook.c, m1=1, says when): 0x6004-0x6007 and 0x6010-0x6016, which iBoot
and macOS are believed not to use (DeepIdle's notes; they read 0 here before
the first run), and 0x6001, the boot stage, which macsmc-reboot sets back to
0x30 at every boot. 0x6003, the boot-error stage, is the PMU's own record of
the stage an unclean end found. The PMU is reached through the kernel's nvmem
interface for the pmic@f node, as pmu-alarm does. --clear writes zeros to the
breadcrumb bytes and nothing else, so that the next run starts clean and no
stale byte stays in state that iBoot and macOS share.

After a run that reached the commit, it also says when the SoC restarted: the
SoC's counter (CNTVCT) restarts with it, so the PMU's RTC now, less the
counter's age, against the commit's RTC second. That holds only in the first
boot after the run, before anything else restarts the Mac. Exit status: 0, or
2 if it can't read (or clear) them.
"""
import glob
import os
import sys

NODE = "/soc/spmi@2920a1300/pmic@f"
# Tests point this at a fake nvmem file, and give the counter as "ticks freq".
NVMEM = os.environ.get("M1_CRUMBS_NVMEM")
CNTVCT = os.environ.get("M1_CRUMBS_CNTVCT")

RTC = 0x1406        # info-rtc: 6 bytes LE, the seconds in the upper four; the
                    # read must start here (pmu-alarm)
CRUMBS = ((0x6004, 4), (0x6010, 7))  # the only bytes --clear writes

# Each stage is the last breadcrumb that reached the PMU: the run got at least
# that far. Raw SPMI stops at its first error and CPU0 goes on without it, so
# a run may have gone further than its stage.
STAGES = {
    0x00: "none: no M1 run since the last clear, or the bytes didn't survive",
    0x01: "K1: the replay began (the PMU written through the kernel's SPMI path)",
    0x02: "K3: MBSE=slpa was accepted; nothing after it reached the PMU (not all 7 cores parked, or raw SPMI failed)",
    0x10: "4: all 7 other cores parked, raw SPMI working; step 5's writes came next under this stage (with"
          " pmgr_late, its 68 writes and 15 waits: a stall in any of them leaves 0x10)",
    0x20: "5: the 42 post-slpa writes done",
    0x30: "7: every parked core released",
    0x50: "8: the last SPMI command; next came nub-spmi0's acks, the commit x3, CPU0's deep WFI",
    # observe=1: CPU7's, after the commit
    0x60: "observe: CPU7 began watching after the commit; nothing it read reached the PMU (a hang or a"
          " reset in its first polls, or raw SPMI failed)",
    0x61: "observe: CPU7 recorded CPU0's and ECPM's power states and the watchdogs (0x6005-0x6007, in one"
          " command with this stage); it didn't begin to rewrite 0x6012-0x6016",
    0x62: "observe: CPU7 was rewriting 0x6012-0x6013 and 0x6015-0x6016 when its breadcrumbs stopped, so"
          " those bytes may be CPU0's or CPU7's",
    0x6e: "observe: CPU7 recorded everything, but had an interrupt or SError pending just before its own"
          " WFI, which ends a WFI: it likely never powered down",
    0x6f: "observe: CPU7 recorded everything, with nothing pending; next came nub-spmi0's acks and its own"
          " deep WFI",
}
# The run's own variants, when 0x6005 bit 0 marks it observe=1 (CPU0 never
# parks, so the bit is free below 0x61).
OBSERVE_STAGES = {
    0x10: "4: all 7 other cores parked, raw SPMI working (observe=1: CPU7 to stay up for the observer); step"
          " 5's writes came next under this stage (with pmgr_late, its 68 writes and 15 waits: a stall in any"
          " of them leaves 0x10)",
    0x30: "7: every parked core but CPU7 released (observe=1: CPU7 stays up through the commit)",
    0x50: "8: the last SPMI command; next came nub-spmi0's acks, the wake-status snapshot, CPU7's stop bit,"
          " the commit x3, the hand-over to CPU7 and CPU0's deep WFI. Nothing CPU7 sent after the commit"
          " landed: it never took the hand-over, or raw SPMI after the commit failed",
}
# pmgr_late=1 (run-floor --m1-late, M1 run 3): its stages, each with the stage
# of runs 1 and 2 it stands for. From 0x28 on, 0x6006 holds qto, the waits
# that timed out, where those have 0 or the cores that left their spin; and
# CPU7's 0x7e and 0x7f have 0x6012-0x6013 and 0x6016 of their own.
LATE = {0x28: 0x20, **{0x29 + i: 0x21 + i for i in range(7)}, 0x38: 0x30, 0x58: 0x50,
        0x70: 0x60, 0x71: 0x61, 0x72: 0x62, 0x7e: 0x6e, 0x7f: 0x6f}
LATE_TEXT = {
    0x28: "5: the 68 post-slpa writes done, with macOS's waits after 15 of them",
}
# qto, by bit: each of macOS's waits that was still unmet 10 ms after its write.
WAITS = ("DCS's p-state after entry 49 (to 7), after 50 (to 5), or both (its busy bit 31 clear, macOS's poll,"
         " and actual = target, e1_hook's own)", "AFR's power state (51)", "ANE0's power-down (55)",
         "AFR's power-down (57)", "DISPLAY's power-down (58)", "AVEMSR's power-down (60)",
         "SIO_CPU's power state (61)", "a ClkGen mux (62-66) or PLL-off (69, 72)")
# 0x6013's buckets: when CPU7 first read a power-down done after the hand-over.
BUCKETS = tuple(f"done {t} after the hand-over" for t in ("under 5 ms", "5-20 ms", "20-50 ms", "50-100 ms",
                                                         "100-200 ms", "200-500 ms", "500 ms or more")) + (
    "STILL PENDING at the end of CPU7's watch, about 500 ms after its ECPM poll ended",)
OBSERVED = (0x61, 0x62, 0x6e, 0x6f)  # 0x6005-0x6007 are CPU7's
FULL = (0x6e, 0x6f)  # 0x6012-0x6013 and 0x6015-0x6016 are CPU7's too
SHORT = (0x62, 0x6e, 0x6f)  # only 0x6010-0x6011 of the commit's second are sure
ORDER = (1, 2, 3, 5, 6, 4, 7)  # e1_hook's m1_order
SOC = ("EACC", "PACC0", "PACC1", "ANE0", "AFR", "DISPLAY", "AVEMSR")  # 0x6015 bits 0-6


def die(msg):
    print(f"m1-crumbs: {msg}", file=sys.stderr)
    sys.exit(2)


def find_nvmem():
    """The nvmem device for NODE; its number isn't fixed (pmu-alarm)."""
    if NVMEM:
        return NVMEM
    found = [d for d in sorted(glob.glob("/sys/bus/nvmem/devices/spmi_nvmem*"))
             if os.path.realpath(f"{d}/of_node").endswith(NODE)]
    if len(found) != 1:
        die(f"want one nvmem device for {NODE}, found {len(found)}")
    return f"{found[0]}/nvmem"


def cpus(mask):
    return ",".join(f"CPU{n}" for n in range(8) if mask >> n & 1) or "none"


def stage(s, observe=False):
    if observe and s in OBSERVE_STAGES:
        return OBSERVE_STAGES[s]
    if s in STAGES:
        return STAGES[s]
    if 0x21 <= s <= 0x27:
        cpu = ORDER[s - 0x21]
        return (f"6: releasing CPU{cpu}, the order's {s - 0x20} of 7 (1, 2, 3, 5, 6, 4, 7): the run stopped"
                " at that core's stop (a reset or a hang), or a later breadcrumb failed and CPU0 went on")
    return "unknown"


def counter():
    """CNTVCT and CNTFRQ, or None. Python has no mrs, so this runs the two
    instructions from an executable page: mrs x0, cntvct_el0 (or cntfrq_el0),
    ret. Linux lets EL0 read both (its vDSO does)."""
    if CNTVCT:
        if CNTVCT == "none":
            return None
        ticks, freq = CNTVCT.split()
        return int(ticks), int(freq)
    if os.uname().machine != "aarch64":
        return None
    try:
        import ctypes
        import mmap
        code = (0xd53be040, 0xd65f03c0, 0xd53be000, 0xd65f03c0)
        m = mmap.mmap(-1, mmap.PAGESIZE, prot=mmap.PROT_READ | mmap.PROT_WRITE | mmap.PROT_EXEC)
        m.write(b"".join(w.to_bytes(4, "little") for w in code))
        addr = ctypes.addressof(ctypes.c_char.from_buffer(m))
        fn = ctypes.CFUNCTYPE(ctypes.c_uint64)
        return fn(addr)(), fn(addr + 8)()
    except (OSError, ValueError):
        return None


def qto(q):
    """pmgr_late's waits that timed out."""
    timed = [w for i, w in enumerate(WAITS) if q >> i & 1]
    return f"0x{q:02x}: " + ("every one of macOS's waits was met within 10 ms" if not timed else
                            "macOS's waits that timed out after 10 ms: " + "; ".join(timed))


def ctrl(c):
    """A watchdog's control bits, as apple_wdt names them."""
    on = [n for bit, n in ((0, "IRQ_EN"), (1, "IRQ_STATUS"), (2, "RESET_EN")) if c >> bit & 1]
    return f"{c}" + (f" ({', '.join(on)})" if on else " (off)")


def decode(b, rtc, cnt=None):
    """b: 0x6000-0x601f; rtc: 6 bytes at 0x1406; cnt: (CNTVCT, CNTFRQ) or
    None. One line per fact."""
    s = b[4]
    late = s in LATE
    base = LATE.get(s, s)  # the stage of runs 1 and 2 it stands for
    obs = base in OBSERVED
    mark = 0x10 <= base <= 0x60 and bool(b[5] & 1)  # an observe=1 run, below CPU7's own stages
    text = LATE_TEXT.get(s) or stage(base, mark)
    out = [
        f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
        f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
        f"boot stage 0x6001 = 0x{b[1]:02x} (0x30 after a boot); boot-error stage 0x6003 = 0x{b[3]:02x}"
        " (0x50: an unclean end after the replay began)",
        f"stage 0x6004 = 0x{s:02x}{' (pmgr_late=1)' if late else ''}: {text}",
    ]
    if s:
        out.append("  (the last breadcrumb that reached the PMU: the run got at least that far)")
    if mark:
        out.append(f"  observe=1 (0x6005 bit 0): CPU7 was kept up for the observer, so it isn't in"
                   f" {'0x6007' if late else '0x6006 or 0x6007'} and PCPM1 wasn't checked")
    if obs:
        off = b[5]
        out.append(f"0x6005 = 0x{off:02x}: CPU0 {'read off' if off & 1 else 'did NOT read off'} within 500 ms of the"
                   f" hand-over; the E complex (ECPM) {'read off' if off & 0x80 else 'did NOT read off'} within 500 ms"
                   f" more; read off at their release: {cpus(off & 0x7e)}")
        w = b[6]
        wd1 = ctrl(w >> 4 & 7) + (": armed again after step 4 stopped it" if w & 0x40 else "")
        out.append(f"0x6006 = 0x{w:02x}: after the commit, WD2 control {ctrl(w & 7)}; WD1 control {wd1};"
                   f" WD0 {'ARMED again (K2 zeroed its control)' if w & 8 else 'not armed'} to reset; CPU0's last"
                   f" WFI {'HAD RETURNED (not power-gated then)' if w & 0x80 else 'had not returned'}")
        out.append(f"0x6007 = {b[7]}: " + ("no watchdog was armed to reset the SoC" if b[7] == 255 else
                                         f"{b[7]} s until the first armed watchdog's reset, as CPU7 read it"))
    elif base >= 0x10:
        out.append(f"parked (0x6005 = 0x{b[5]:02x}): {cpus(b[5] & 0xfe)}")
        if late and base >= 0x20:
            out.append(f"0x6006 = {qto(b[6])}")
        if base >= 0x30:
            if not late:
                out.append(f"left their spin to stop (0x6006 = 0x{b[6]:02x}): {cpus(b[6])}")
            out.append(f"read off within 10 ms (0x6007 = 0x{b[7]:02x}): {cpus(b[7])}")
    now = int.from_bytes(rtc[2:6], "little")
    commit = None
    if base in SHORT:
        low = int.from_bytes(b[0x10:0x12], "little")
        commit = now - ((now - low) & 0xffff)
        out.append(f"RTC second just before the commit, from its low two bytes: {commit}, {now - commit} s before"
                   f" now ({now}); right if this read comes within 18 h of the commit")
    else:
        secs = int.from_bytes(b[0x10:0x14], "little")
        if base >= 0x01 and secs:
            when = "just before the commit" if base >= 0x50 else "the replay's start (K1)"
            out.append(f"RTC second at {when}: {secs}, {now - secs} s before now ({now})")
            if base >= 0x50:
                commit = secs
    if base >= 0x50:
        f = b[0x14]
        pend = "".join(n for bit, n in ((2, "A"), (1, "I"), (0, "F")) if f >> bit & 1) or "nothing"
        pcpm1 = "not checked (CPU7 kept up)" if base >= 0x60 or mark else "off" if f & 0x20 else "NOT off"
        out.append(f"0x6014 = 0x{f:02x}: CPU0 had {pend} pending before the commit;"
                   f" PCPM0 {'off' if f & 0x10 else 'NOT off'}, PCPM1 {pcpm1};"
                   f" WD1 {'was running (stopped)' if f & 0x40 else 'was off'};"
                   f" K3's kernel-path write after slpa {'FAILED' if f & 0x08 else 'worked'}")
    if base in FULL and late:
        # CPU7 sends 0x6012-0x6013 in one command and 0x6015-0x6016 in another;
        # each pair's second byte has bit 7 set, so a pair without it didn't
        # survive the reset (zeroed, say), and its first byte isn't read either.
        t, d = b[0x13], b[0x16]
        lost = "bit 7 is clear, so this byte didn't survive the reset; don't read it"
        if not t & 0x80:
            out.append(f"0x6012 = 0x{b[0x12]:02x}: sent in one command with 0x6013, which didn't survive the reset;"
                       " not read as the waits that timed out")
            out.append(f"0x6013 = 0x{t:02x}: {lost}")
        else:
            out.append(f"0x6012 = {qto(b[0x12])}")
            out.append(f"0x6013 = 0x{t:02x}: EACC's power-down {BUCKETS[t & 7]}; PACC0's {BUCKETS[t >> 3 & 7]};"
                       f" PACC0's was {'STILL PENDING' if t & 0x40 else 'done'} just before the commit (CPU0's read)")
        cl = b[0x15]
        if not d & 0x80:
            out.append(f"0x6015 = 0x{cl:02x}: sent in one command with 0x6016, which didn't survive the reset;"
                       " not read as the soc clusters")
            out.append(f"0x6016 = 0x{d:02x}: {lost}")
        else:
            busy = ",".join(n for i, n in enumerate(SOC) if cl >> i & 1) or "none"
            out.append(f"0x6015 = 0x{cl:02x}: soc clusters still busy at the end of CPU7's watch: {busy} (PACC1"
                       f" expected, CPU7 being up); SIO_CPU's actual state {'NOT off' if cl & 0x80 else 'off'}")
            at5 = (d & 0x1f) == 0x15 and not d & 0x20
            out.append(f"0x6016 = 0x{d:02x}: DCS's p-state at CPU0's last wait before the commit (after entry 50):"
                       f" actual {d & 0xf}, target {'5' if d & 0x10 else 'NOT 5'}, busy bit 31"
                       f" {'SET' if d & 0x20 else 'clear'} ({'settled at 5' if at5 else 'NOT settled at 5'}); SIO's"
                       f" actual state {'NOT off' if d & 0x40 else 'off'} after the commit")
            # The wait after 50 ends met or at its timeout, so a settled
            # 0x6016 means that wait was met: a DCS timeout was 49's.
            if at5 and t & 0x80 and b[0x12] & 1:
                out.append("  so DCS's timed-out wait (0x6012 bit 0) was the one after entry 49: the one after 50"
                           " settled")
    elif base in FULL:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}: the low bytes of the wdt page's +0x28 and +0x40"
                   " after the commit (T8103's S2R-engine progress registers, inferred; e1_hook's load log has"
                   " them awake)")
        cl = b[0x15]
        busy = ",".join(n for i, n in enumerate(SOC) if cl >> i & 1) or "none"
        out.append(f"0x6015 = 0x{cl:02x}: soc clusters still busy: {busy} (PACC1 expected, CPU7 being up);"
                   f" SIO_CPU's actual state {'NOT off' if cl & 0x80 else 'off'}")
        wk = b[0x16]
        if not wk & 0x80:
            out.append(f"0x6016 = 0x{wk:02x}: bit 7 is clear, so this byte didn't survive the reset; don't read it")
        else:
            words = ",".join(str(i) for i in range(7) if wk >> i & 1) or "none"
            out.append(f"0x6016 = 0x{wk:02x}: AP wake-status words with a bit set that wasn't just before the"
                       f" commit: {words}")
    elif base == 0x62:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}, 0x6015 0x6016 = {b[0x15]:02x} {b[0x16]:02x}: CPU0's"
                   " or CPU7's (it was rewriting them): not decoded")
    elif base >= 0x50:
        out.append(f"0x6015 = 0x{b[0x15]:02x}: cores with an interrupt pending at their stop: {cpus(b[0x15])}")
        out.append(f"0x6016 = {b[0x16]}: AIC events the cores took off their event registers")
    if commit is not None and cnt and cnt[1]:
        age = cnt[0] / cnt[1]
        x = now - age - commit
        out.append(f"the SoC restarted about {x:.0f} s after the commit ({x - 1:.1f} to {x + 1:.1f} s: the PMU's RTC"
                   f" counts whole seconds); its counter (CNTVCT) is {age:.1f} s old. Right only in the first boot"
                   " after the run")
    return out


def main():
    args = sys.argv[1:]
    if args not in ([], ["--clear"]):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)
    clear = args == ["--clear"]
    path = find_nvmem()
    try:
        fd = os.open(path, os.O_RDWR if clear else os.O_RDONLY)
        b = os.pread(fd, 0x20, 0x6000)
        rtc = os.pread(fd, 6, RTC)
    except OSError as e:
        die(f"{path}: {e}")
    if len(b) != 0x20 or len(rtc) != 6:
        die(f"{path}: short read")
    for line in decode(b, rtc, counter()):
        print(line)
    if clear:
        try:
            for off, n in CRUMBS:
                if os.pwrite(fd, bytes(n), off) != n:
                    die(f"short write at {off:#x}")
            after = [os.pread(fd, n, off) for off, n in CRUMBS]
        except OSError as e:
            die(f"{path}: {e}")
        if any(a != bytes(n) for a, (_, n) in zip(after, CRUMBS)):
            die("cleared, but they don't read back as zeros")
        print("cleared: 0x6004-0x6007 and 0x6010-0x6016 read back as zeros")
    return 0


if __name__ == "__main__":
    sys.exit(main())
