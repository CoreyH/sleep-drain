#!/usr/bin/python3 -I
"""e1-hook/m1-crumbs: the breadcrumbs an M1-recipe run (run-floor --m1,
--m1-observe, --m1-late, --m1-alarm, --m1-hold, --m1-hold-nowatch, --m1-pmp,
--m1-pmp-idle, --m1-position, --m1-sio-pmp, --m1-disp-off, --m1-macos-end, --m1-sio-stop, --m1-power-words,
--m1-recfg-bite, --m1-wd2-bite, --m1-cluster-ack, --m1-fabric-up, --m1-mark, --m1-gates, --m1-sio-down, --m1-pcie-down, --m1-sio-steps, --m1-a2-pre, --m1-acc-last, --m1-last-look, --m1-last-look-wake and the later ones, --m1-wake-all, --m1-sep-pg, --m1-disp-hs and --m1-sep-ro among them; e1_hook m1=1, observe=1, pmgr_late=1,
alarm=1, hold=1, pmp_out=1, position=1, sio_on=1, disp_off=1, one_commit=1, smc_idle=1, sio_stop=1, ps_words=1, recfg_bite=1,
wd2_bite=1, cluster_ack=1, fabric_up=1, wd1_mark=1, gates_mark=1, sio_down=1, pcie_down=1, sio_steps=1, a2_pre=1, acc_last=1, last_look=1, ll_wake=1) leaves in the PMU, read and decoded, and cleared again. And the
three bytes e1-hook/probe (probe=1) leaves, which isn't a run: stage 0x0e.

  e1-hook/m1-crumbs               read them (no root needed)
  pkexec e1-hook/m1-crumbs --clear   zero them, after reading (root)

They're bytes of the PMU's legacy scratch that e1_hook writes through SPMI
(e1_hook.c, m1=1, says when): 0x6004-0x6007 and 0x6010-0x6016, which iBoot
and macOS are believed not to use (DeepIdle's notes; they read 0 here before
the first run), 0x6008-0x600e, which a last_look=1 run writes if CPU0's last
WFI returns (they read 0 in every log before it, with no Linux cell; Corey's
OK of 2026-11-16; --clear zeroes them only after one of that run's stages, an obs_gate=1 record, or a wake_all=1 or
sep_ro=1 byte or mark at 0x6008, a sep_pg=1 one at 0x6009 or disp_hs=1's four bytes or mark at 0x600a with zeros in the rest,
the other five that use them; every run's K1 zeroes them since wake_all=1), and 0x6001, the boot stage, which macsmc-reboot sets back to
0x30 at every boot. 0x6003, the boot-error stage, is the PMU's own record of
the stage an unclean end found. The PMU is reached through the kernel's nvmem
interface for the pmic@f node, as pmu-alarm does. --clear writes zeros to the
breadcrumb bytes, so that the next run starts clean and no stale byte stays in
state that iBoot and macOS share. After an alarm=1 run that armed the RTC alarm
(stage 0x59 or 0x5f, hold=1's 0x5a-0x5e, position=1's 0x40-0x45, pmp_out=1's the
same as hold=1's with bit 7 set, and the later runs' own, gates_mark=1's and
sio_down=1's among them; and 0x140c the commit's second + 3600,
so that the alarm is the run's), it first sets the alarm's control, 0x1401, back to 0x01, so
that the alarm can't power the Mac on an hour later. It writes nothing else;
in particular not 0x14c0, and not 0x1401 for an alarm that isn't the run's
(macOS's own wakes arm it).

After a run that reached the commit, it also says when the SoC restarted: the
SoC's counter (CNTVCT) restarts with it, so the PMU's RTC now, less the
counter's age, against the commit's RTC second. That holds only in the first
boot after the run, before anything else restarts the Mac. It also prints the
RTC alarm's registers, read-only, and after an alarm=1 run says whether the
alarm was written as the run meant and whether it survived the reset. And it
prints the PMU's register 0x0201, read-only: B2's ops 237-238 write 1 there,
and a boot shows 2. Exit
status: 0, or 2 if it can't read (or clear) them.
"""
import glob
import os
import sys

NODE = "/soc/spmi@2920a1300/pmic@f"
# Tests point this at a fake nvmem file, and give the counter as "ticks freq".
NVMEM = os.environ.get("M1_CRUMBS_NVMEM")
CNTVCT = os.environ.get("M1_CRUMBS_CNTVCT")

RTC = 0x1406        # info-rtc: 6 bytes LE, the seconds in the upper four; the
                    # read must start here (pmu-alarm)
CRUMBS = ((0x6004, 4), (0x6010, 7))  # the bytes --clear zeroes
LL_CRUMBS = (0x6008, 7)  # and these too, after a last_look=1 run (ll_retn=1's are such), an obs_gate=1 record, a wake_all=1 one, a sep_ro=1 one, a sep_pg=1 one or a disp_hs=1 one: no other run leaves anything there
# The RTC alarm: control (bit 6 enable, bit 1 latched when it fired), the
# compare value (4 bytes LE, the RTC's seconds), event, mask (pmu-alarm).
ALARM_CTRL, ALARM, ALARM_EVENT, ALARM_MASK = 0x1401, 0x140c, 0x14c0, 0x14c2
# The register B2's ops 237-238 write 1 to, near the entry pair's end (B0 writes 1 there too, B1, the wake's last, 0).
# A boot shows 2 here (read 2026-11-10 twice and 2026-11-16). Read-only.
R0201 = 0x0201
# position=1 (run-floor --m1-position): the stages after the commit. 0x6012-0x6013 hold
# sample 1 from 0x42 on, 0x6007 and 0x6015 sample 2 from 0x44 on. With pmp_out=1 (sio_on=1's run: the stages with
# bit 7), sample 1 alone: 0x6007 stays the cores that held, its bit 0 saying ps_sio, UART_P and SPI_P read on, and
# 0x6015 stays K4's byte. disp_off=1's stages are those with bit 3 set too: sample 1's byte B is then K3b's.
POSITION = (0x40, 0x41, 0x42, 0x43, 0x44, 0x45)
POS_S1 = (0x42, 0x43, 0x44, 0x45)
POS_S2 = (0x44, 0x45)
DISP_STAGES = (0x48, 0x49, 0x4a, 0x4c, 0x4d)  # disp_off=1: POSITION's with bit 3
# recfg_bite=1, in place of 0x4f and after the release: 0x6005 is the sample (e1_hook's M1_RECFG_STAGE_PEND and
# M1_RECFG_STAGE: with and without an exception pending on CPU0 after its reads)
RECFG_STAGES = (0x46, 0x47)
# fabric_up=1 (run-floor --m1-fabric-up; e1-hook/fabric_up.h has the stages and the byte): from step 8's command on the
# run has stages of its own, because 0x6007 changes meaning there: 0x52 for sio_stop=1's 0x4e, and 0x51 and 0x53 for
# wd2_bite=1's 0x56 and 0x57 (with and without an exception pending).
FAB_PRE = 0x52
FAB_WD2 = (0x51, 0x53)
# gates_mark=1 (run-floor --m1-gates; e1-hook/gates_mark.h has the words, the byte and the stages): wd1_mark=1's run with the six
# gate words B2 polls and the fabric lane read in step 8, right before the commit, and their byte at 0x6016 in place of the
# alarm's result. So from step 8's command on it has stages of its own, fabric_up=1's with that one difference: 0x4b for 0x52,
# and 0x54 and 0x55 for 0x51 and 0x53. 0x6007 is fabric_up.h's byte at both runs' stages.
GATES_PRE = 0x4b
GATES_WD2 = (0x54, 0x55)
GATES_STAGES = (GATES_PRE,) + GATES_WD2
# sio_down=1 (run-floor --m1-sio-down; e1-hook/sio_down.h has the words, the byte and the stages): gates_mark=1's run with B2's
# switch-off of SIO's subtree made by CPU0 in step 8, and put back, where the gate words' reads were. 0x6016 is its own byte,
# so its stages are its own again: 0x3d for 0x4b, and 0x3e and 0x3f for 0x54 and 0x55.
SIOD_PRE = 0x3d
# The same run's stages in its first form (b453922), when 0x6016 had another layout: one record exists, and it isn't read here.
SIOD1_STAGES = (0x3a, 0x3b, 0x3c)
SIOD_WD2 = (0x3e, 0x3f)
SIOD_STAGES = (SIOD_PRE,) + SIOD_WD2
# pcie_down=1 (run-floor --m1-pcie-down; e1-hook/pcie_down.h has the words, the byte and the stages): gates_mark=1's run with B2's
# switch-off of the PCIe power words made by CPU0 in step 8, and left, where the gate words' reads were. 0x6016 is its own
# byte, so its stages are its own: 0x1d for 0x4b, and 0x1e and 0x1f for 0x54 and 0x55.
PCD_PRE = 0x1d
PCD_WD2 = (0x1e, 0x1f)
PCD_STAGES = (PCD_PRE,) + PCD_WD2
# sio_steps=1 (run-floor --m1-sio-steps; e1-hook/sio_steps.h has the words, the byte and the stages): gates_mark=1's run with
# sio_down=1's switch-off made around B2's cycle of GPIO's power word, then the 22 words B2 writes first, the gate 0x28e5a0050
# polled after each, and the 43 put back. 0x6016 is its own byte, so its stages are its own: 0x15 for 0x4b, and 0x16 and 0x17
# for 0x54 and 0x55.
SST_PRE = 0x15
SST_WD2 = (0x16, 0x17)
SST_STAGES = (SST_PRE,) + SST_WD2
# a2_pre=1 (run-floor --m1-a2-pre; e1-hook/a2_pre.h has the words, the values, the byte and the stages): gates_mark=1's run with
# A2's three moves of its own made by CPU0 in step 8, and left, where the gate words' reads were, after a read of the five
# ClkGen muxes. 0x6016 is its own byte, so its stages are its own: 0x19 for 0x4b, and 0x1a and 0x1b for 0x54 and 0x55.
A2P_PRE = 0x19
A2P_WD2 = (0x1a, 0x1b)
A2P_STAGES = (A2P_PRE,) + A2P_WD2
# acc_last=1 (run-floor --m1-acc-last; e1-hook/acc_last.h has the entries, the time's code, the byte and the stages):
# gates_mark=1's run with the three CPU complexes' cluster words left out of step 5 and written right before the commit, a
# read of the five ClkGen muxes where the gate words' reads were, and the time from the cluster words to the run's last stage
# sent after it. 0x6016 is its own byte, so its stages are its own: 0x11 for 0x4b, and 0x12 and 0x13 for 0x54 and 0x55.
ACL_PRE = 0x11
ACL_WD2 = (0x12, 0x13)
ACL_STAGES = (ACL_PRE,) + ACL_WD2
# last_look=1 (run-floor --m1-last-look): fabric_up=1's stages under other numbers (e1-hook/last_look.h), for a run whose
# WD1 count is 80 s and which records CPU0's last WFI at 0x6008-0x600e; ll_wake=1's (--m1-last-look-wake) are the second set.
LL_PRE = 0x09
LL_WD2 = (0x0a, 0x0b)
LLW_PRE = 0x06
LLW_WD2 = (0x07, 0x08)
# ll_retn=1 (--m1-ll-retn) is an ll_wake=1 run with CPU0's last WFI taken with retention left on and the record at 0x6008-0x600e
# in a form of its own: the third set, by which that form is known (llr_lines()).
LLR_PRE = 0x14
LLR_WD2 = (0x18, 0x1c)
LLR_STAGES = (LLR_PRE,) + LLR_WD2
LLW_STAGES = (LLW_PRE,) + LLW_WD2 + LLR_STAGES  # every run with ll_wake=1's alarm, timer and light: its own stages, and ll_retn=1's
LL_STAGES = (LL_PRE,) + LL_WD2 + LLW_STAGES
PRE_STAGES = (FAB_PRE, GATES_PRE, SIOD_PRE, PCD_PRE, SST_PRE, A2P_PRE, ACL_PRE, LL_PRE, LLW_PRE, LLR_PRE)  # the last stage before the commit, from fabric_up=1 on
FAB_STAGES = (FAB_PRE,) + FAB_WD2 + GATES_STAGES + SIOD_STAGES + PCD_STAGES + SST_STAGES + A2P_STAGES + ACL_STAGES + LL_STAGES
# wd2_bite=1, the same way: 0x6005 is its own sample (e1_hook's M1_WD2_STAGE_PEND and M1_WD2_STAGE)
WD2_STAGES = (0x56, 0x57) + FAB_WD2 + GATES_WD2 + SIOD_WD2 + PCD_WD2 + SST_WD2 + A2P_WD2 + ACL_WD2 + LL_WD2 + LLW_WD2 + LLR_WD2
WD2_PEND = (0x56, FAB_WD2[0], GATES_WD2[0], SIOD_WD2[0], PCD_WD2[0], SST_WD2[0], A2P_WD2[0], ACL_WD2[0], LL_WD2[0], LLW_WD2[0], LLR_WD2[0])  # CPU0 had an exception pending after its reads
SAMPLE_STAGES = RECFG_STAGES + WD2_STAGES  # 0x6005 isn't the parked cores
SIO_STOP_STAGES = (0x4e, 0x4f) + PRE_STAGES + SAMPLE_STAGES  # sio_stop=1, in place of 0x5a and 0x5b: 0x6012 has the K steps' outcomes
# alarm=1 (0x59, 0x5f), hold=1 (0x5a-0x5e) and position=1: 0x6016 is the alarm's byte, and the alarm may be armed
ALARM_STAGES = (0x59, 0x5f, 0x5a, 0x5b, 0x5c, 0x5d, 0x5e) + POSITION + SIO_STOP_STAGES
ALARM_SECS = 3600  # e1_hook's M1_ALARM_SECS
LL_ALARM_SECS = 20  # last_look.h's, ll_wake=1
LL_TIMER_S = 25  # last_look.h's: CPU0's timer, ll_wake=1
LL_BLINK_BIT = 0x40  # 0x6016 in an ll_wake=1 run: step 8 made the keyboard PWM's three writes
LL_LOOKED = 0x08  # 0x6008, gate_look=1: 0x6009-0x600e are CPU0's own look before its last WFI (last_look.h)
LL_ARMED = 0x04  # 0x6008 as K1 leaves it with gate_look=1, until the look's first command
LL_LOOK_MS = 1000  # last_look.h's: the look, after the commit's last write
LLR_BOUND_S = LL_TIMER_S + 5  # last_look.h's, ll_retn=1: with nothing pending, the look is made at the first return this long after CPU0's first WFI
LLR_LANDED = 0x80  # 0x600c in ll_retn=1's record, the second command's last byte: its mark
LLR_AT_BOUND, LLR_WIDE = 0x80, 0x40  # 0x600b in ll_retn=1's record: the look was made at the time bound, with nothing pending; a word has a bit the bytes don't carry
# 0x6008's bits 3:2 in ll_retn=1's record, and in no other: the returns with nothing pending before the look (last_look.h's llr_empty_code())
LLR_E_SHIFT = 2
# A count of the returns after which the WFI was taken again, the look's own not among them: not a measure of how long the WFI held.
LLR_EMPTIES = ("none", "one to nine", "ten to 999", "a thousand or more")
# obs_gate=1 (last_look.h): the same seven bytes in observe=1's run, CPU7's look at the engine's gate words
OG_MARK, OG_ARMED, OG_LATER_MS = 0x80, 0x40, 500
OG_CLUS = 0x10  # 0x6008's bit 4: the record's second form, the complexes' own words (what e1_hook sends since 2026-11-19)
# The state word's values as the complexes' own sequences in the reconfig SRAM write them (0x28e09a000 + 4n)
OG_ST = {0x40: "the value an up sequence ends on", 0x1a: "the value a down sequence ends on",
         0x51: "a value both sequences write on the way: the down sequence's first, after its wait for bit 6 of the soc-cluster word",
         0x53: "a value both sequences write on the way", 0x5b: "a value both sequences write on the way",
         0x1b: "the down sequence's last value but one", 0x41: "the up sequence's last value but one"}
# The E complex's state word as ll_retn=1's look reads it: the sequences' values, and the one it has had awake
LLR_ST = {0x44: "what it has read awake since boot on this Mac, a complex the sequencer hasn't cycled", **OG_ST}
OG_STAGES = (0x61, 0x62, 0x6e, 0x6f, 0x71, 0x72, 0x7e, 0x7f)  # CPU7's stages from its first record on: the look follows that record
OG_WORDS = ("CPU0", "ECPM (the E complex)", "PCPM0 (P complex 0)", "PCPM1 (P complex 1, CPU7's own)")
# wake_all=1 (last_look.h): one byte at 0x6008, in a run of the gates_mark=1 family: step 7 writes 0xffffffff to all seven AP
# wake-mask words, and this is what they and the seven status words after them read right after; step 8 sends it
WA_ARMED = 0x20  # 0x6008 as K1 leaves it with wake_all=1, until the byte's command, after step 8's record
WA_MARK = 0xc0  # the byte's two top bits, both
WA_NAMED = 0x20  # under the mark: words 0 to 5 read back 0xffffffff, and word 6's bits 12:0 all set
WA_UNNAMED = 0x10  # under the mark: word 6's bits 31:13 read back all set too
WA_STAGES = GATES_STAGES + SIOD_STAGES + PCD_STAGES + SST_STAGES + A2P_STAGES + ACL_STAGES  # the gates_mark=1 family's: all sent after the byte
WA_STEP7 = 0x39  # step 7's own stage in that family (hold=1's), still the stage when the byte goes out: what stays if no later command lands
# sep_pg=1 (last_look.h): one byte at 0x6009, in a run of the same family, with wake_all=1's at 0x6008 or without it: step 7 clears
# bit 2 of the PMGR control word 0x28e0cc200 if it is set (Ante042's PMGR_WAIT_SEP_PG), and this is what CPU0 read around that
# write; step 8 sends it, after wake_all=1's. Its stages are wake_all=1's: WA_STAGES, WA_STEP7 and WA_EARLY
SP_ARMED = 0x02  # 0x6009 as K1 leaves it with sep_pg=1, until the byte's command, after step 8's record
SP_MARK = 0x80  # the byte's top bit
SP_FOUND = 0x40  # under the mark: the control word's bit 2 was set as found
SP_CLEAR = 0x20  # under the mark: read again, the word had bit 2 clear and every other bit as found
SP_SEP_OFF = 0x10  # under the mark: the SEP's power word (0x28e580c00) read actual state 0 then
# sep_ro=1 (last_look.h): one byte at 0x6008, in a sep_pg=1 run without wake_all=1 (in whose place it is): 0x2922c0044's low
# nibble as step 7 read it right before the write decision, the other side of the clear from 0x6009's nibble. Its stages are
# sep_pg=1's
SRO_ARMED = 0x10  # 0x6008 as K1 leaves it with sep_ro=1, until the byte's command, after step 8's record
SRO_MARK = 0x80  # the byte's top bit, with bits 6:4 clear: never wake_all=1's byte, which has bits 7:6 both
# disp_hs=1 (last_look.h): four bytes at 0x600a-0x600d, in a run of the same family with disp_off=1: K3b makes the reference's
# set-up and handshake on each stopped DCP's fabric block around its power-downs, and this is which tables were written,
# which handshakes were made, and what 0x2922c0044's low nibble read before K3b, right after each table and after each
# DCP's place in its loop (disp0's first)
DH_ARMED = 0x01  # 0x600a as K1 leaves it with disp_hs=1, until K3b's four bytes
DH_MARK = 0x80  # the top bit of the first, the third and the fourth byte; bit 4 of the first and the third is never set
DH_EXT = 0x40  # under the mark: dispext0's handshake was made (0x600a); its set-up table was written (0x600c)
DH_INT = 0x20  # under the mark: disp0's (0x600a, 0x600c)
DH_N = 4  # the record: 0x600a-0x600d. 0x600d is best effort: bytes there have been lost across a restart, and read 0


def alarm_secs(s):
    """How far past the commit's second the run at stage s armed the alarm."""
    return LL_ALARM_SECS if s in LLW_STAGES else ALARM_SECS
ALARM_ACKED = (0xbd, 0xbf)  # 0x6016 when every alarm command was acked, 0x1401's write among them
PMP_TAG = 0x80  # pmp_out=1: bit 7 of the stage byte, from K4 on: 0x6015 is the PMP's byte

# Each stage is the last breadcrumb that reached the PMU: the run got at least
# that far. Raw SPMI stops at its first error and CPU0 goes on without it, so
# a run may have gone further than its stage.
STAGES = {
    0x00: "none: no M1 run since the last clear, or the bytes didn't survive",
    0x01: "K1: the replay began (the PMU written through the kernel's SPMI path)",
    0x02: "K3: MBSE=slpa was accepted; nothing after it reached the PMU (not all 7 cores parked, or raw SPMI failed;"
          " in a pmp_out=1 run, instead: K4 didn't finish, CPU0 stalled or faulted in it, a fault restarting the"
          " Mac about 10 s later, or its kernel-path stage write failed; in a disp_off=1 run, K3b comes first: a"
          " stall or fault in it leaves this stage too, its 0x84 being written only at its end)",
    0x05: "K5 (smc_idle=1): the AP idle notice to the SMC is over (0x6005 bit 0 says if it was acked, in a position"
          " stage); nothing after it reached the PMU (not all 7 cores parked, or raw SPMI failed)",
    0x04: "K3b (disp_off=1): both DCPs and their domains were handled (sample 1's byte says how, if it landed); nothing"
          " after it reached the PMU (K4 didn't finish, or not all 7 cores parked, or raw SPMI failed)",
    0x03: "K4 (pmp_out=1): the PMP's idle pair and its stop are over (0x6015 says how); nothing after it reached the"
          " PMU (not all 7 cores parked, or raw SPMI failed)",
    0x10: "4: all 7 other cores parked, raw SPMI working; step 5's writes came next under this stage (with"
          " pmgr_late, its 68 writes and 15 waits: a stall in any of them leaves 0x10)",
    0x20: "5: the 42 post-slpa writes done",
    0x30: "7: every parked core released",
    0x50: "8: the last SPMI command; next came nub-spmi0's acks, the commit x3, CPU0's deep WFI",
    # observe=1: CPU7's, after the commit
    0x60: "observe: CPU7 began watching after the commit; nothing it read reached the PMU (a hang or a"
          " reset in its first polls, or raw SPMI failed)",
    0x61: "observe: CPU7 recorded CPU0's and ECPM's power states and the watchdogs (0x6005-0x6007, in one"
          " command with this stage); it didn't begin to rewrite 0x6012-0x6016",
    0x62: "observe: CPU7 was rewriting 0x6012-0x6013 and 0x6015-0x6016 when its breadcrumbs stopped, so"
          " those bytes may be CPU0's or CPU7's",
    0x6e: "observe: CPU7 recorded everything, but had an interrupt or SError pending just before its own"
          " WFI, which ends a WFI: it likely never powered down",
    0x6f: "observe: CPU7 recorded everything, with nothing pending; next came nub-spmi0's acks and its own"
          " deep WFI",
}
# The run's own variants, when 0x6005 bit 0 marks it observe=1 (CPU0 never
# parks, so the bit is free below 0x61).
OBSERVE_STAGES = {
    0x10: "4: all 7 other cores parked, raw SPMI working (observe=1: CPU7 to stay up for the observer); step"
          " 5's writes came next under this stage (with pmgr_late, its 68 writes and 15 waits: a stall in any"
          " of them leaves 0x10)",
    0x30: "7: every parked core but CPU7 released (observe=1: CPU7 stays up through the commit)",
    0x50: "8: the last SPMI command; next came nub-spmi0's acks, the wake-status snapshot, CPU7's stop bit,"
          " the commit x3, the hand-over to CPU7 and CPU0's deep WFI. Nothing CPU7 sent after the commit"
          " landed: it never took the hand-over, or raw SPMI after the commit failed",
}
# pmgr_late=1 (run-floor --m1-late, M1 run 3): its stages, each with the stage
# of runs 1 and 2 it stands for. From 0x28 on, 0x6006 holds qto, the waits
# that timed out, where those have 0 or the cores that left their spin; and
# CPU7's 0x7e and 0x7f have 0x6012-0x6013 and 0x6016 of their own.
LATE = {0x28: 0x20, **{0x29 + i: 0x21 + i for i in range(7)}, 0x38: 0x30, 0x58: 0x50, 0x59: 0x50, 0x5f: 0x50,
        0x70: 0x60, 0x71: 0x61, 0x72: 0x62, 0x7e: 0x6e, 0x7f: 0x6f}
LATE_TEXT = {
    0x28: "5: the 68 post-slpa writes done, with macOS's waits after 15 of them",
    0x59: "8 (alarm=1): the last SPMI command before the commit; next came nub-spmi0's acks, the first commit, the"
          " alarm's commands, the other two commits",
    0x5f: "alarm=1: the commit x3 and the alarm's commands done (0x6016 says how far); next came nub-spmi0's acks"
          " and CPU0's deep WFI",
