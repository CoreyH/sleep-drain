               "not a class e1_hook sends (6)", "not a class e1_hook sends (7)")


def sample_lines(n, addr_a, a, addr_b, b, disp=False):
    """position=1: one sample's two bytes, one line per word (m1_position.h has the layout). disp: disp_off=1's byte B."""
    phase = a & 0xf
    middle = (f"  display (K3b): internal DCP: {DCP_CODES[b & 3]}; external DCP: {DCP_CODES[b >> 2 & 3]}; the domains of the DCPs"
              f" that stopped: {'all read off' if b & 0x10 else 'NOT all read off, or none stopped'}") if disp else (
             f"  SIO_CPU: {SIO_CLASSES[b & 7]}; WD2 RESET_EN {'set' if b & 8 else 'clear'}; WD2's count"
             f" {'within' if b & 0x10 else 'NOT within'} 0.25 s of CPU0's time since the first commit write")
    return [f"position sample {n} (0x{addr_a:04x} = 0x{a:02x}, 0x{addr_b:04x} = 0x{b:02x}):",
            f"  PHASE {phase:#x} ({PHASES.get(phase, 'not a phase the sequences read so far write')}); HS_A bit 31"
            f" {'up' if a & 0x10 else 'down'}, bit 24 {'up' if a & 0x20 else 'clear'}; state word"
            f" {STATE_WORDS[a >> 6]}",
            middle,
            f"  gate words: 0x2922c0044 bit 2 {'set' if b & 0x20 else 'clear'}, bit 3 {'set' if b & 0x40 else 'clear'};"
            f" 0x2922c0040 bit 1 {'set' if b & 0x80 else 'clear'}"]


def recfg_lines(v):
    """recfg_bite=1, stages 0x46 and 0x47: 0x6005, what CPU0 read once it had let the others go (recfg_bite.h has the layout)."""
    cls, phase, armed, sram = v & 3, v >> 2 & 0xf, bool(v & 0x40), bool(v & 0x80)
    if cls == 1:
        so = ("the engine took WD2's bite from the changed word: the SRAM takes a write and the engine runs it. Feasibility shown,"
              " whenever the reset came")
        if not armed and phase in (0, 4, 5):
            so += (". But RESET_EN didn't show within 0.3 s: CPU0 looked inside A2's opening, or the word after the bite was"
                   " disturbed. Then WD2 never bites, and a Mac that stayed dark is that, not a completed entry")
        elif not armed:
            so += (f". RESET_EN didn't show within 0.3 s, with PHASE {phase:#x}, which isn't one A2 shows before its last (0, 4,"
                   " 5): every A sequence clears RESET_EN at its end, so A2 may have run to its end before CPU0 looked. A Mac that"
                   " then stayed dark may be a completed entry")
        if not sram:
            so += ". (Step 8's read of the word didn't show the new value, which doesn't fit a new bite in WD2: that read isn't to be trusted then)"
    elif cls == 2 and not sram:
        so = "the edit wasn't in place at the commit (the word didn't read the new value in step 8), so it wasn't tested. Not a negative"
    elif cls == 2 and phase in (4, 5) and armed:
        so = ("A2, before its last phase, armed WD2 with the old bite though the word read the new one: the engine didn't take the"
              " bite from this word. (A copy elsewhere isn't excluded: only the first 64 KiB of the SRAM has been read)")
    elif cls == 2 and phase in (4, 5):
        so = ("nothing decided: WD2 holds the old bite with A2 before its last phase, though the word read the new one, which"
              " points at the engine not taking the bite from this word. But RESET_EN didn't show within 0.3 s, and A2's opening"
              " sets it right after the bite: this isn't the state that opening leaves, so the record alone doesn't say")
    elif cls == 2:
        so = (f"nothing decided about the edit: with PHASE {phase:#x}, a later sequence's opening may have re-armed WD2 with its"
              " own 30 s before CPU0 looked")
    elif not sram:
        so = ("nothing decided, and the edit wasn't in place at the commit (the word didn't read the new value in step 8): the"
              " reset time says nothing about it either")
    elif cls == 3:
        so = ("nothing decided: WD2 showed RESET_EN with its awake bite, which no sequence read so far would leave" if armed else
              "nothing decided: nothing had armed WD2 within 0.3 s of the release. If the Mac then stayed dark, WD2 was never armed:"
              " not a completed entry, and the edit is the first suspect")
    else:
        so = "nothing decided: not a bite any sequence read so far writes. Unreadable, not a negative"
    if v == 0xfe:
        so += (". And 0xfe is what stage 0x4e leaves in this byte (the parked cores): if the stage's command landed without its"
               " second byte, this isn't a sample at all")
    if v == 0:
        so += ". And 0x00 is also what a byte that didn't land, or didn't survive the reset, reads: not a reading to lean on"
    what = "its awake value, or pair 0's" if phase == 0 else PHASES.get(phase, "not a phase the sequences read so far write")
    return [f"0x6005 = 0x{v:02x}: recfg_bite=1, after the commit, the alarm and the release (A2's bite word in the SRAM was changed"
            " to 45 s before the load):",
            f"  WD2's bite: {BITE_CLASSES[cls]}; WD2's control {'showed RESET_EN' if armed else 'did NOT show RESET_EN within 0.3 s'}",
            f"  PHASE {phase:#x} ({what}), read after the bite; A2's bite word in the SRAM, read in step 8 just before the commit:"
            f" {'the new value' if sram else 'NOT the new value'}",
            f"  so: {so}",
            "  (the reset time is a second fact, never the test: RESEARCH.md, \"A different approach\")"]


def wd2_lines(v, pend=False):
    """wd2_bite=1, stages 0x56 and 0x57: 0x6005, what CPU0 read around its one write to WD2's bite (wd2_bite.h has the layout).
    pend: the stage is 0x56, CPU0 had an exception pending after its reads."""
    pre, seen, post, still, counting, ph = v & 3, bool(v & 4), bool(v & 8), bool(v & 0x10), bool(v & 0x20), WD2_PHASES[v >> 6]
    if v == 0xfe:
        # Before anything is read out of it: this is the byte the stage before leaves here.
        so = ("0xfe is what stage 0x4e leaves in this byte (the parked cores): the stage's command most likely landed without its"
              " second byte, and then this isn't a sample at all. None of the three lines above is to be leaned on")
    elif not seen and post and pre != 2:
        so = ("an inconsistent record: CPU0 made no write, and the bite read 120 s after that though it didn't just before. Something"
              " else wrote it between the two reads, or the byte isn't the one CPU0 sent: not to be leaned on")
    elif not seen:
        so = ("CPU0 made no write: nothing had armed WD2 within 0.3 s of the release, so the bite wasn't moved and the reset's time"
              " says nothing about a moved bite. A Mac that then stayed dark isn't a completed entry by this record: WD2 was never seen"
              " armed")
        if post:
            so += (". The bite read 120 s before and after: wd2-bite's store from user space, still there, which also says no"
                   " sequence's opening had written its own 30 s")
    elif not post:
        so = ("CPU0 MADE ITS WRITE AND THE BITE DIDN'T READ 120 s AFTER IT: the register didn't keep the kernel's store (or"
              " something wrote it again at once). The bite wasn't moved, and the reset's time says nothing about a moved bite")
    elif not still:
        so = ("the bite reads 120 s, but RESET_EN didn't show after the write: WD2 wasn't armed any more (a sequence closing just"
              " then, or the write itself). An unarmed WD2 doesn't bite, so a Mac that then stayed dark is that as readily as a"
              " completed entry")
    elif not counting:
        so = ("the bite reads 120 s with RESET_EN set, but the count didn't change within 1 ms: WD2 may not be counting any more."
              " A Mac that then stayed dark may be that, and isn't a completed entry by this record")
    else:
        took = ("the write took, and" if pre != 2 else
                "the bite read 120 s before CPU0's write as after it, so this record doesn't show that write took;")
        who = "A2" if ph in (4, 5) else "the sequence that armed WD2"
        dark = ("no reset is a candidate for a completed entry" if not pend else
                "no reset isn't a candidate for a completed entry here, since CPU0 likely never went down (the stage)")
        so = (f"{took} WD2 was armed and counting with a 120 s bite. The reset's time is the result now: about 120 s"
              f" after the commit fits {who} arming last and never closing; {dark}; about 30 s,"
              " or another time T, fits a later sequence arming WD2 again, T - 30 s after the commit")
        if ph == 0:
            so += (". PHASE still read 0 after 10 ms, where A2 writes 4 a few ops after its opening: which sequence armed WD2 isn't"
                   " shown by this record")
        elif ph is None:
            so += (". PHASE read neither 4 nor 5, A2's before its last: A2 may have run to its end already and a later A sequence"
                   " armed WD2, each opening with the same 30 s. Then the entry had finished before CPU0's write, and the bite that"
                   " was moved is that sequence's")
    if seen and pre != 1 and v != 0xfe:
        so += (f". But the bite read {WD2_PRE[pre]} before the write, not the 30 s an A sequence's opening leaves, though RESET_EN"
               " showed: what armed WD2 isn't clear from this record")
    if pend and v != 0xfe and not (seen and post and still and counting):
        so += ". And CPU0 had an exception pending after its reads (the stage): it likely never went down"
    if v == 0:
        so += ". And 0x00 is also what a byte that didn't land, or didn't survive the reset, reads: not a reading to lean on"
    what = ("neither 0, 4 nor 5: A2's last, or a later sequence's" if ph is None else
            f"{ph:#x} ({'its awake value, or pair 0' + chr(39) + 's' if ph == 0 else PHASES[ph]})")
    return [f"0x6005 = 0x{v:02x}: wd2_bite=1, after the commit, the alarm and the release:",
            f"  WD2's bite before CPU0's write: {WD2_PRE[pre]}; WD2's control"
            f" {'showed RESET_EN, so CPU0 wrote the bite, 120 s' if seen else 'did NOT show RESET_EN within 0.3 s, so CPU0 wrote nothing'}",
            f"  read after that: the bite {'120 s' if post else 'NOT 120 s'}; RESET_EN {'set' if still else 'NOT set'}; the"
            f" count {'changing' if counting else 'NOT changing within 1 ms'}",
            f"  PHASE, read last: {what}",
            f"  so: {so}",
            "  (the readings, and why one run narrows the cases without deciding them: PLAN.md, \"The order after run 14\")"]


def k_lines(b):
    """sio_stop=1: 0x6012, the steps before the commit, if 0x6013 says it landed (e1_hook.c's m1 comment has the layout)."""
    k = b[0x12]
    m = b[0x13]
    words = m & W_MARK == W_MARK
    if m != K_MARK and not words:
        return [f"0x6012 0x6013 = {k:02x} {m:02x}: the steps' outcomes didn't land (0x6013 is neither their marker, 0x{K_MARK:02x}, nor"
                f" ps_words=1's, 0x{W_MARK:02x} and up): nothing here says how the DCPs, the SMC's notice, SIO or any power word went"]
    out = [f"0x6012 = 0x{k:02x}, the steps before the commit:",
            f"  internal DCP: {DCP_CODES[k & 3]}; external DCP: {DCP_CODES[k >> 2 & 3]}; the domains of the DCPs that stopped:"
            f" {'all read off' if k & 0x10 else 'NOT all read off, or none stopped'}",
            f"  SMC's AP idle notice: {'acked within 200 ms' if k & 0x20 else 'NOT acked'}; SIO's firmware: {SIO_CODES[k >> 6]}"]
    if words:
        out.append(f"0x6013 = 0x{m:02x}: ps_words=1 wrote the 20 power words, after the table:")
        out += [f"  {g}: " + ("read actual 0 within 10 ms each" if m >> i & 1 else "NOT all read actual 0 within 10 ms each") for i, g in enumerate(W_GROUPS)]
        out.append("  PCIE0_REF, APCIE_GP_SYS, AFNC1_LW2, AFNC2_LW1: target and auto fields "
                   + ("read back as written" if m & 0x20 else "NOT all read back as written"))
    return out


def position_lines(s, b, pmp=False, disp=False):
    """position=1, stages 0x40-0x45: which samples these bytes are, and what they say. pmp: sio_on=1's layout, one sample;
    disp: disp_off=1's byte B."""
    out = []
    if s in POS_S1:
        out += sample_lines(1, 0x6012, b[0x12], 0x6013, b[0x13], disp)
    elif s == 0x41:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}: step 8's second's upper bytes or sample 1's, its"
                   " bytes' stage didn't follow: not decoded")
    else:
        out.append("no sample recorded yet")
    if pmp:
        if s in POS_S1:
            out.append("  one sample by design (pmp_out=1 keeps 0x6015), about 1 s after the commit: it can't tell a stop from"
                       " slow progress" + ("" if s in POS_S2 else ", and only stages 0x44 and 0x45 say whether a read failed"))
    elif s in POS_S2:
        out += sample_lines(2, 0x6007, b[0x07], 0x6015, b[0x15])
    elif s == 0x43:
        out.append(f"0x6007 0x6015 = {b[0x07]:02x} {b[0x15]:02x}: held and step 8's byte, or sample 2's, the stage after"
                   " them didn't follow: not decoded")
    if not pmp and s in (0x42, 0x43):
        out.append("  sample 1 alone, about 1 s after the commit: only stages 0x44 and 0x45 say whether a read failed, and one"
                   " sample can't tell a stop from slow progress, so no rung from it")
    if s in POS_S1:
        out.append("  (compare each word with the awake pass, recfg-peek-*-p*/, or the load log's position line; a word still at its awake value says"
                   " nothing. PLAN.md has the reading guide)")
    return out


def die(msg):
    print(f"m1-crumbs: {msg}", file=sys.stderr)
    sys.exit(2)


def find_nvmem():
    """The nvmem device for NODE; its number isn't fixed (pmu-alarm)."""
    if NVMEM:
        return NVMEM
    found = [d for d in sorted(glob.glob("/sys/bus/nvmem/devices/spmi_nvmem*"))
             if os.path.realpath(f"{d}/of_node").endswith(NODE)]
    if len(found) != 1:
        die(f"want one nvmem device for {NODE}, found {len(found)}")
    return f"{found[0]}/nvmem"


def cpus(mask):
    return ",".join(f"CPU{n}" for n in range(8) if mask >> n & 1) or "none"


def stage(s, observe=False):
    if observe and s in OBSERVE_STAGES:
        return OBSERVE_STAGES[s]
    if s in STAGES:
        return STAGES[s]
    if 0x21 <= s <= 0x27:
        cpu = ORDER[s - 0x21]
        return (f"6: releasing CPU{cpu}, the order's {s - 0x20} of 7 (1, 2, 3, 5, 6, 4, 7): the run stopped"
                " at that core's stop (a reset or a hang), or a later breadcrumb failed and CPU0 went on")
    return "unknown"


def counter():
    """CNTVCT and CNTFRQ, or None. Python has no mrs, so this runs the two
    instructions from an executable page: mrs x0, cntvct_el0 (or cntfrq_el0),
    ret. Linux lets EL0 read both (its vDSO does)."""
    if CNTVCT:
        if CNTVCT == "none":
            return None
        ticks, freq = CNTVCT.split()
        return int(ticks), int(freq)
    if os.uname().machine != "aarch64":
        return None
    try:
        import ctypes
        import mmap
        code = (0xd53be040, 0xd65f03c0, 0xd53be000, 0xd65f03c0)
        m = mmap.mmap(-1, mmap.PAGESIZE, prot=mmap.PROT_READ | mmap.PROT_WRITE | mmap.PROT_EXEC)
        m.write(b"".join(w.to_bytes(4, "little") for w in code))
        addr = ctypes.addressof(ctypes.c_char.from_buffer(m))
        fn = ctypes.CFUNCTYPE(ctypes.c_uint64)
        return fn(addr)(), fn(addr + 8)()
    except (OSError, ValueError):
        return None


def qto(q, ack=False):
    """pmgr_late's waits that timed out. ack: a cluster_ack=1 run, whose bits 2-5 are the cluster words' flags that stayed."""
    timed = [w for i, w in enumerate(WAITS) if q >> i & 1 and not (ack and CLUSTER_WAITS >> i & 1)]
    if ack:
        stuck = [n for i, n in ACK_WORDS.items() if q >> i & 1]
        return (f"0x{q:02x}: " + ("macOS's other waits were all met within 10 ms" if not timed else
                                 "macOS's waits that timed out after 10 ms: " + "; ".join(timed))
                + "; bits 2-5 (cluster_ack=1), the soc-cluster words whose up-done flag was still set at their wait's last read: "
                + (", ".join(stuck) or "none"))
    return f"0x{q:02x}: " + ("every one of macOS's waits was met within 10 ms" if not timed else
                            "macOS's waits that timed out after 10 ms: " + "; ".join(timed))


# wd1_mark=1 (run-floor --m1-mark; e1-hook/wd1_mark.h): bits 7:6 of fabric_up=1's byte, WD1 as read just before the commit.
# Both set, the marker stood, and the restart's time reads B2's progress: WD1's bite less its count if B2 never zeroed
# the count, WD2's bite if it did and the pair then stopped, WD1's bite if the pair finished.
WD1_STANDS = 0xc0
WD1_BITE_S, WD1_COUNT_S, WD2_BITE_S = 150, 60, 120
FAB_WAS = ("another value: neither 0x333 nor asked down to 1", "0x111: asked down to 1 by the kernel's suspend, and there",
           "asked down to 1 by the kernel's suspend, and not there yet", "0x333, as awake: this suspend hadn't lowered it")


def fab_lines(v):
    """fabric_up=1: 0x6007 from stage 0x52 on (e1-hook/fabric_up.h has the layout). It says what the word read, and leaves
    the ending to the stage and wd2_bite=1's sample."""
    was, took, kept = v >> 2 & 3, bool(v & 0x10), bool(v & 0x20)
    out = [f"0x6007 = 0x{v:02x}: fabric_up=1's byte, in place of the cores that held:",
           "  the other cores: " + ("all seven wrote their stop bit and held" if v & 2 else
                                    "NOT all seven wrote their stop bit and held (stage 0x39's byte said which; this one replaced it)"),
           f"  bit 0 (sio_on=1): ps_sio, UART_P and SPI_P {'all read actual f within 10 ms' if v & 1 else 'did NOT all read actual f within 10 ms'}",
           f"  the fabric's p-state word (0x28e20c000) before CPU0's write: {FAB_WAS[was]}",
           "  after the write of 3 to its low nibble: " + ("it read 0x333, not busy, within 10 ms" if took else "it did NOT read 0x333 within 10 ms")
           + "; at the end of step 5, after the ClkGen park and PLL-off: " + ("0x333" if kept else "NOT 0x333")]
    if not v:
        out.append("  so: 0x00 is also what a byte that didn't land reads, and it would otherwise say that no core held and nothing"
                   " settled: not a reading to lean on")
    elif took and kept:
        out.append("  so: the fabric was at 3 when the table went out and still there when step 5 ended, where macOS has it at its"
                   " commit" + (": the kernel had lowered it, and the write brought it back" if was in (1, 2) else
                                ". But it read 0x333 before the write too: this suspend hadn't lowered it, the write changed nothing,"
                                " and the run is run 16 again" if was == 3 else
                                ". Before the write it read neither 0x333 nor a word asked down to 1, which nothing predicted"))
    elif took:
        out.append("  so: the fabric came back to 3 after the write and was NOT there when step 5 ended: something in the table moved"
                   " it (the ClkGen park or PLL-off, most likely). The engine didn't find it where macOS leaves it")
    elif kept:
        out.append("  so: the fabric didn't read 0x333 within 10 ms of the write but did when step 5 ended: it settled late, and was"
                   " at 3 before the commit")
    else:
        out.append("  so: the fabric did NOT come back to 3, neither within 10 ms of the write nor by step 5's end. The run's one"
                   " change didn't take, and the ending says nothing about a fabric at 3")
    w = v & WD1_STANDS
    if w == WD1_STANDS:
        out.append(f"  bits 7:6 (wd1_mark=1): WD1 stood as the marker just before the commit: armed, its bite {WD1_BITE_S} s, its count at"
                   f" {WD1_COUNT_S} s and running. The restart's time is read against it below, as far as the stage and wd2_bite=1's"
                   " sample bear a reading out")
    elif w:
        out.append("  bits 7:6 (wd1_mark=1): the marker did NOT stand just before the commit: "
                   + (f"WD1 was armed with its {WD1_BITE_S} s bite, but its count didn't read {WD1_COUNT_S} s (to 5 s more): the count"
                      " write didn't take as written" if w == 0x40 else
                      f"WD1's count read {WD1_COUNT_S} s (to 5 s more), but it wasn't armed with the {WD1_BITE_S} s bite")
                   + ". The restart's time says nothing about B2, and a time that isn't WD2's may be WD1's")
    else:
        out.append("  bits 7:6 (wd1_mark=1): clear: no marker in WD1 stands in this record (a run without wd1_mark=1, or one whose"
                   " marker read back wrong in both respects). The restart's time is read against WD2 alone")
    out.append("  (how the run ended is the stage's and wd2_bite=1's sample's to say; PLAN.md has how an ending reads with this)")
    return out


def fab_landed(b):
    """fabric_up=1: is 0x6007 the run's byte? Step 7 leaves the cores that held there (0xff as a rule), and stage 0x52's command
    puts the byte in its place, last of four. The steps' outcomes at 0x6012 go out right after that command and only if it
    didn't fail, so their marker at 0x6013 says the command landed whole. Without it the byte may still be step 7's."""
    return b[0x13] == K_MARK or b[0x13] & W_MARK == W_MARK


def mark_reading(x, s, v):
    """wd1_mark=1, the marker standing: what a restart x s after the commit (to a second either way) says, at stage s with
    wd2_bite=1's sample v (0x6005). The time names no watchdog by itself: each reading is the one that fits, and it's given
    only where the stage and the sample bear it out."""
    head = "  wd1_mark=1's marker: "
    if s == FAB_PRE:
        return (f"{head}not read. Stage 0x52 is the last before the commit: nothing here records the commit, the release or WD2 after"
                f" it, so {x:.0f} s can't be read as B2's progress")
    if s in WD2_PEND:
        return (f"{head}not read. CPU0 had an exception pending after its reads (the stage) and likely never went down, and a core"
                f" left up holds the engine by itself: {x:.0f} s says nothing about a pair with every core down")
    seen, code = bool(v & 4), v >> 6
    moved = bool(seen and v & 8 and v & 0x10 and v & 0x20 and v != 0xfe)
    t = next((t for t in (WD1_BITE_S - WD1_COUNT_S, WD2_BITE_S, WD1_BITE_S) if abs(x - t) <= 4), None)
    if t is None:
        return (f"{head}{x:.0f} s is none of its three times ({WD1_BITE_S - WD1_COUNT_S}, {WD2_BITE_S} and {WD1_BITE_S} s):"
                " not read. Right only in the first boot after the run, like the time itself")
    if t == WD1_BITE_S - WD1_COUNT_S:
        return (f"{head}about {t} s is what WD1 gives with its count never zeroed: B2 didn't reach its op 223, and the stall is at"
                " B2's first poll, in the first handshake (A2's three steps of its own) or in B2's power-down. That's the"
                " reading that fits with nothing else assumed, not a proof of which watchdog fired: a pair that finished, with"
                " a later A sequence starting about 60 s after the commit and arming WD2 with its own 30 s, gives the same time")
    if t == WD2_BITE_S:
        if not moved:
            return (f"{head}about {t} s, but wd2_bite=1's sample, above, doesn't show WD2 armed and counting with CPU0's {WD2_BITE_S} s"
                    " bite, so this record doesn't make the time WD2's. Not read as B2's progress")
        if code not in (1, 2):
            return (f"{head}about {t} s is WD2's moved bite, but PHASE didn't read 4 or 5, A2's before its last, in the sample above:"
                    " a later A sequence may have armed WD2, after a pair that finished. Not read as B2 stopping in its last ops")
        return (f"{head}about {t} s is WD2: B2 zeroed WD1's count, so B2's first poll passed, A2's three steps settled and B2's"
                " power-down ran; the pair then stopped in its last twenty-odd ops (the second handshake, the PMU command, the third"
                " handshake). One other reading isn't excluded by this run alone: a WD1 that can't reset the SoC in this state,"
                " which a run with WD1's bite below WD2's would show")
    if not seen:
        return (f"{head}about {t} s is WD1's bite from a count zeroed at about the commit, but WD2 was never seen armed in the sample"
                " above: nothing here shows the entry pair started. Not read as a pair that finished")
    return (f"{head}about {t} s is WD1 after B2 zeroed its count, with WD2, which the sample above saw armed, stopped before it"
            " could fire: the entry pair FINISHED, and WD1 ended it as a dead-man")


def ack_lines(f, q, held):
    """cluster_ack=1: 0x6014's bits 4 and 5 with qto's bits 2-5 (e1_hook.c's m1 comment). f has bits 7 and 4 set; held is
    0x6007, sent in one command with qto: non-zero, it shows that command's last bytes landed. It says what the words
    read, and leaves the ending to the stage and wd2_bite=1's sample."""
    out = [f"0x6014 bit 4 (cluster_ack=1): step 5 wrote ANE0's, AFR's and AVEMSR's soc-cluster words (0x28e09800c, 0x28e098014,"
           " 0x28e098020) as 0x20, target 0 with a 1 to bit 5, their up-done flag, not the table's 0; the four cluster waits"
           " asked for the whole word to read 0"]
    rest = bool(f & F_ACK_REST)
    c = q & CLUSTER_WAITS
    stuck = [n for i, n in ACK_WORDS.items() if c >> i & 1]
    more = ("; and at least one of the four words had something else left too (0x6014 bit 5: bit 4, busy, the target or another"
            " bit), which word and which bit isn't recorded" if rest else "")
    if not held and not q:
        out.append("  so: 0x6006 and 0x6007 both read 0. That's also what bytes that didn't land read, and 0x6007 would otherwise say"
                   " no core held: whose flag stayed isn't known from this record. 0x6014, another command's, says "
                   + ("something other than a flag was left in at least one of the four words" if rest else
                      "nothing other than a flag was left in any of the four words"))
    elif c & ACK_WROTE:
        out.append(f"  so: the up-done flag STAYED SET, 10 ms after the write, in {', '.join(stuck)}: the 0x20 didn't clear it there"
                   f"{more}. With a flag left in a word this run wrote, the ending says nothing about cleared flags")
    elif c:
        out.append("  so: ANE0's, AFR's and AVEMSR's flags read clear after their 0x20, and the flag STAYED SET in DISPLAY's, 10 ms"
                   f" after the table's own 0x20, which the earlier runs wrote there too{more}. The three words this run"
                   " changed took the ack; DISPLAY's flag is new: no earlier run looked at it")
    elif rest:
        out.append("  so: no flag stayed: bit 5 read clear in all four words. But at least one of them didn't read 0 within 10 ms of"
                   " its write (0x6014 bit 5): bit 4, busy, the target or another bit was left, and which word and which bit"
                   " isn't recorded. The acks took; what was left is new")
    else:
        out.append("  so: each of the four words read 0 within 10 ms of its write, before the commit: target 0, not busy, and the"
                   " flag clear")
    out.append("  (how the run ended is the stage's and wd2_bite=1's sample's to say; PLAN.md has how an ending reads with this)")
    return out


def run_second(low, compare, now, res):
    """hold=1 from 0x5c on: the commit's whole second, if 0x6016 (res) says the run's 0x140c write was acked and
    the compare value fits it (its second + 3600, not later than now, with these low two bytes); else None.
    low 0 counts as lost."""
    whole = compare - ALARM_SECS
    return whole if res & 0x88 == 0x88 and low and 0 < whole <= now and whole & 0xffff == low else None


def alarm_byte(v):
    """alarm=1's 0x6016: how far the alarm's commands got."""
    if not v & 0x80:
        return (f"0x6016 = 0x{v:02x}: the alarm's commands left no result (bit 7 clear): they didn't run, or the"
                " byte didn't land or survive; so the alarm wasn't tested. A repeat, not a negative")
    if v in ALARM_ACKED:
        ev = "the event was set, and echoed" if v == 0xbf else "no event was set"
        return f"0x6016 = 0x{v:02x}: every alarm command was acked ({ev}): 0x140c, 0x14c2 = 0, then 0x1401 = 0x41"
    if v not in (0x80, 0x83, 0x85, 0x87, 0x8d, 0x8f, 0x9d, 0x9f):
        return f"0x6016 = 0x{v:02x}: not a value e1_hook writes; don't read it"
    steps = ((0, "0x14c0's read"), (2, "0x14c0's echo" if v & 2 else "no echo needed"), (3, "0x140c"),
             (4, "0x14c2 = 0"), (5, "0x1401 = 0x41"))
    done = [n for bit, n in steps if v >> bit & 1]
    stop = next(n for bit, n in steps if not v >> bit & 1)
    return (f"0x6016 = 0x{v:02x}: the alarm's commands STOPPED at {stop} (before it: {', '.join(done) or 'nothing'}"
            f"{'; the event was set' if v & 2 else ''}): so the alarm wasn't tested. A repeat, not a negative")


def alarm_lines(s, commit, alarm, now, res):
    """The alarm's registers at this boot, always; for an alarm=1 stage, what they say. alarm: 0x1401, the
    compare value, 0x14c0, 0x14c2; res: 0x6016."""
    c, when, ev, mask = alarm
    state = {0x01: "not armed", 0x03: "fired, latched"}.get(c)
    if c == 0x41:
        state = f"armed, fires in {when - now} s" if when > now else f"armed, {now - when} s past its time"
    out = [f"PMU alarm: 0x1401 = 0x{c:02x}{f' ({state})' if state else ''}, 0x140c = {when},"
           f" 0x14c0 event 0x{ev:02x}, 0x14c2 mask 0x{mask:02x}"]
    if s not in ALARM_STAGES:
        return out
    right = commit is not None and when == commit + ALARM_SECS
    recorded, acked = bool(res & 0x80), res in ALARM_ACKED
    if commit is None:
        out.append("  the commit's second isn't known, so 0x140c can't be checked")
    elif right:
        out.append(f"  0x140c is the commit's second + {ALARM_SECS}, as the run wrote it")
    else:
        out.append(f"  0x140c is NOT the commit's second + {ALARM_SECS} ({commit + ALARM_SECS}): the alarm wasn't tested")
    if c in (0x41, 0x03):
        if (right and (acked or not recorded)) or (commit is None and acked):
            out.append(f"  the armed alarm survived the reset{' and has fired' if c == 0x03 else ''}")
        elif commit is None:
            out.append("  whether 0x1401 is this run's can't be told: the commit's second isn't known, and 0x6016 doesn't"
                       " say its write was acked")
        else:
            out.append("  0x1401 isn't shown to be this run's: a value from before the run, or macOS's")
    elif c == 0x01 and right:
        if not acked:
            out.append("  0x140c landed, but " + ("0x1401's write wasn't acked" if recorded else "0x6016 recorded no result")
                       + ": nothing shows the enable was ever set")
        elif now < when:
            out.append("  0x1401 reads 0x01 before the alarm's time, with 0x140c right and 0x1401's write acked: the reset"
                       " or the boot firmware cleared the enable (new)")
        else:
            out.append("  0x1401 reads 0x01 past the alarm's time, with 0x140c right and 0x1401's write acked: it may have"
                       " fired (on T8103 a fired alarm reads 0x01), or the reset or the boot firmware cleared the enable;"
                       f" 0x14c0 is 0x{ev:02x}")
    return out


def ctrl(c):
    """A watchdog's control bits, as apple_wdt names them."""
    on = [n for bit, n in ((0, "IRQ_EN"), (1, "IRQ_STATUS"), (2, "RESET_EN")) if c >> bit & 1]
    return f"{c}" + (f" ({', '.join(on)})" if on else " (off)")


def decode(b, rtc, cnt=None, alarm=None):
    """b: 0x6000-0x601f; rtc: 6 bytes at 0x1406; cnt: (CNTVCT, CNTFRQ) or
    None; alarm: the RTC alarm's registers (alarm_lines()), or None. One line
    per fact."""
    pmp = bool(b[4] & PMP_TAG)
    s = b[4] & 0x7f
    disp = s in DISP_STAGES  # disp_off=1: read as the position stage, with its own byte B
    if disp:
        s &= ~0x08
    hold = s in HOLD
    late = s in LATE or hold
    base = HOLD.get(s, LATE.get(s, s))  # the stage of runs 1 and 2 it stands for
    obs = base in OBSERVED
    # An observe=1 run, below CPU7's own stages. Not recfg_bite=1's or wd2_bite=1's stage: its 0x6005 is the sample.
    mark = s not in POSITION and s not in SAMPLE_STAGES and 0x10 <= base <= 0x60 and bool(b[5] & 1)
    text = HOLD_TEXT.get(s) or LATE_TEXT.get(s) or stage(base, mark)
    # cluster_ack=1's mark is in 0x6014, sent just before stage 0x4e. None: this record can't say whether it was such a
    # run (a stage one passes before that, or the byte lost). False: a stage, or a run without pmp_out=1, that isn't one's.
    if pmp and s in ACK_MARKED:
        ack = bool(b[0x14] & F_ACK) if b[0x14] & 0x80 else None
    else:
        ack = None if pmp and s in ACK_EARLY else False
    out = [
        f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
        f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
        f"boot stage 0x6001 = 0x{b[1]:02x} (0x30 after a boot); boot-error stage 0x6003 = 0x{b[3]:02x}"
        " (the stage the last unclean end found; sticky, so it says nothing about this boot by itself;"
        " this boot's journal says, macsmc-reboot's \"PMU logged N boot error(s)\")",
        f"stage 0x6004 = 0x{b[4]:02x}{' (pmp_out=1: bit 7' + ('; disp_off=1: bit 3' if disp else '') + ', so the stage is ' + hex(s) + ')' if pmp else ''}"
        f"{' (pmgr_late=1)' if late else ''}: {text}",
    ]
    if s:
        out.append("  (the last breadcrumb that reached the PMU: the run got at least that far)")
    if pmp:
        out.append(pmp_byte(b[0x15]))
    elif s == 2 and b[0x15] & 0x80:
        # K1 zeroes these and step 8 can't have run: this can only be K4's.
        out.append(pmp_byte(b[0x15]) + "; K4 finished, its stage write didn't land")
    if mark:
        out.append(f"  observe=1 (0x6005 bit 0): CPU7 was kept up for the observer, so it isn't in"
                   f" {'0x6007' if late else '0x6006 or 0x6007'} and PCPM1 wasn't checked")
    if obs:
        off = b[5]
        out.append(f"0x6005 = 0x{off:02x}: CPU0 {'read off' if off & 1 else 'did NOT read off'} within 500 ms of the"
                   f" hand-over; the E complex (ECPM) {'read off' if off & 0x80 else 'did NOT read off'} within 500 ms"
                   f" more; read off at their release: {cpus(off & 0x7e)}")
        w = b[6]
        wd1 = ctrl(w >> 4 & 7) + (": armed again after step 4 stopped it" if w & 0x40 else "")
        out.append(f"0x6006 = 0x{w:02x}: after the commit, WD2 control {ctrl(w & 7)}; WD1 control {wd1};"
                   f" WD0 {'ARMED again (K2 zeroed its control)' if w & 8 else 'not armed'} to reset; CPU0's last"
                   f" WFI {'HAD RETURNED (not power-gated then)' if w & 0x80 else 'had not returned'}")
        out.append(f"0x6007 = {b[7]}: " + ("no watchdog was armed to reset the SoC" if b[7] == 255 else
                                         f"{b[7]} s until the first armed watchdog's reset, as CPU7 read it"))
    elif base >= 0x10:
        if s in SAMPLE_STAGES:
            pass  # 0x6005 is the sample: recfg_lines() or wd2_lines(), below
        elif s in HOLD_AFTER and s not in SIO_STOP_STAGES:
            out.append(f"read off after the release (0x6005 = 0x{b[5]:02x}, up to 10 ms each): {cpus(b[5] & 0xfe)}")
            if s in POSITION:
                if disp:
                    out.append(f"0x6005 bit 0 (smc_idle=1): the SMC {'acked the AP idle notice within 200 ms' if b[5] & 1 else 'did NOT ack an AP idle notice, or this run sent none'}")
                else:
                    out.append(f"0x6005 bit 0: SIO_CPU's bits 27:24 {'read f' if b[5] & 1 else 'did not read f'} at entry 61's"
                               " wait, the reference for its class")
        else:
            out.append(f"parked (0x6005 = 0x{b[5]:02x}): {cpus(b[5] & 0xfe)}")
        if late and base >= 0x20:
            out.append(f"0x6006 = {qto(b[6], bool(ack))}")
            if ack is None:
                out.append("  (nothing here says whether this was a cluster_ack=1 run: its mark is 0x6014's bit 4, sent just before"
                           " stage 0x4e (0x52 with fabric_up=1)" + (", and that byte didn't survive" if s in ACK_MARKED else "") + ". In one, bits 2-5 are"
                           " the cluster words whose flag stayed, not the waits on bit 4 that timed out)")
        if base >= 0x30:
            if not late:
                out.append(f"left their spin to stop (0x6006 = 0x{b[6]:02x}): {cpus(b[6])}")
            if not pmp and (s in POS_S2 or s == 0x43):
                pass  # sample 2's, or not decoded: position_lines()
            elif s in FAB_STAGES and fab_landed(b):
                out += fab_lines(b[7])
            elif s in FAB_STAGES:
                out.append(f"0x6007 = 0x{b[7]:02x}: not read. The steps' outcomes go out right after stage 0x52's command, and only if"
                           " it didn't fail, and their marker isn't at 0x6013: that command isn't shown to have landed whole, and this"
                           " byte, its last, may still be the one step 7 leaves here, the cores that held (0xff as a rule). It isn't"
                           " read as fabric_up=1's byte, and no marker in WD1 is taken to stand")
            elif hold:
                out.append(f"wrote their stop bit and held (0x6007 = 0x{b[7]:02x}): {cpus(b[7] & 0xfe)}")
                # sio_on=1's bit, which only its own stages can read when clear: a plain pmp_out=1 run leaves it clear too.
                if pmp and (b[7] & 1 or s in POSITION or s in SIO_STOP_STAGES):
                    out.append(f"0x6007 bit 0 (sio_on=1): ps_sio, UART_P and SPI_P "
                               f"{'all read actual f within 10 ms' if b[7] & 1 else 'did NOT all read actual f within 10 ms'}")
            else:
                out.append(f"read off within 10 ms (0x6007 = 0x{b[7]:02x}): {cpus(b[7])}")
    now = int.from_bytes(rtc[2:6], "little")
    commit = None
    if base in SHORT or s in HOLD_AFTER:
        low = int.from_bytes(b[0x10:0x12], "little")
        whole = run_second(low, alarm[1], now, b[0x16]) if s in HOLD_AFTER and alarm else None
        if whole is not None:
            commit = whole
            out.append(f"RTC second just before the commit, from its low two bytes and the run's alarm: {commit},"
                       f" {now - commit} s before now ({now})")
        elif low:
            commit = now - ((now - low) & 0xffff)
            out.append(f"RTC second just before the commit, from its low two bytes: {commit}, {now - commit} s before"
                       f" now ({now}); right if this read comes within 18 h of the commit")
        else:
            out.append("0x6010-0x6011 read 0: the commit's second was lost (or, 1 run in 65536, really ends in 0000);"
                       " no reset time")
    else:
        secs = int.from_bytes(b[0x10:0x14], "little")
        if base >= 0x01 and secs:
            when = "just before the commit" if base >= 0x50 else "the replay's start (K1)"
            out.append(f"RTC second at {when}: {secs}, {now - secs} s before now ({now})")
            if base >= 0x50:
                commit = secs
    if base >= 0x50:
        f = b[0x14]
        if f & 0x80:
            pend = "".join(n for bit, n in ((2, "A"), (1, "I"), (0, "F")) if f >> bit & 1) or "nothing"
            pcpm1 = "not checked (CPU7 kept up)" if base >= 0x60 or mark else "off" if f & 0x20 else "NOT off"
            pcpm0 = "off" if f & 0x10 else "NOT off"
            if s in SIO_STOP_STAGES:
                pcpm0 = pcpm1 = "not read (hold_nowatch=1: CPU0 doesn't watch them)"
            elif hold and s == 0x5c:
                pcpm0 = pcpm1 = "being rewritten: not decoded"
            elif hold and s not in HOLD_AFTER:
                pcpm0 = pcpm1 = "not read yet (hold=1: nothing goes down before the commit)"
            elif s in HOLD_AFTER:
                pcpm0 += " after the release"
                pcpm1 += " after the release"
            out.append(f"0x6014 = 0x{f:02x}: CPU0 had {pend} pending before the commit;"
                       f" PCPM0 {pcpm0}, PCPM1 {pcpm1};"
                       f" WD1 {'was running (stopped)' if f & 0x40 else 'was off'};"
                       f" K3's kernel-path write after slpa {'FAILED' if f & 0x08 else 'worked'}")
            if ack:
                out += ack_lines(f, b[6], b[7])
            elif s in SIO_STOP_STAGES and f & (F_ACK | F_ACK_REST):
                out.append("  0x6014's bits 4 and 5 are cluster_ack=1's alone in a sio_stop=1 run: bit 5 only with bit 4, and only at"
                           " that run's stages (0x4e, 0x56, 0x57, or fabric_up=1's 0x52, 0x51, 0x53, with pmp_out=1's bit 7). Here they aren't"
                           " that: don't read them")
        else:
            cmd = ("its own one-byte command" if s in POSITION else
                   "the 3-byte command it went in (0x6012-0x6014)" if s in (0x5d, 0x5e) else
                   "whichever command wrote it last (0x6010-0x6016 or 0x6012-0x6014)" if s == 0x5c else
                   "the 7-byte command it went in (0x6010-0x6016)")
            out.append(f"0x6014 = 0x{f:02x}: bit 7 is clear, so {cmd} didn't survive the reset; don't read it")
    if base in FULL and late:
        # CPU7 sends 0x6012-0x6013 in one command and 0x6015-0x6016 in another;
        # each pair's second byte has bit 7 set, so a pair without it didn't
        # survive the reset (zeroed, say), and its first byte isn't read either.
        t, d = b[0x13], b[0x16]
        lost = "bit 7 is clear, so this byte didn't survive the reset; don't read it"
        if not t & 0x80:
            out.append(f"0x6012 = 0x{b[0x12]:02x}: sent in one command with 0x6013, which didn't survive the reset;"
                       " not read as the waits that timed out")
            out.append(f"0x6013 = 0x{t:02x}: {lost}")
        else:
            out.append(f"0x6012 = {qto(b[0x12])}")
            out.append(f"0x6013 = 0x{t:02x}: EACC's power-down {BUCKETS[t & 7]}; PACC0's {BUCKETS[t >> 3 & 7]};"
                       f" PACC0's was {'STILL PENDING' if t & 0x40 else 'done'} just before the commit (CPU0's read)")
        cl = b[0x15]
        if not d & 0x80:
            out.append(f"0x6015 = 0x{cl:02x}: sent in one command with 0x6016, which didn't survive the reset;"
                       " not read as the soc clusters")
            out.append(f"0x6016 = 0x{d:02x}: {lost}")
        else:
            busy = ",".join(n for i, n in enumerate(SOC) if cl >> i & 1) or "none"
            out.append(f"0x6015 = 0x{cl:02x}: soc clusters still busy at the end of CPU7's watch: {busy} (PACC1"
                       f" expected, CPU7 being up); SIO_CPU's actual state {'NOT off' if cl & 0x80 else 'off'}")
            at5 = (d & 0x1f) == 0x15 and not d & 0x20
            out.append(f"0x6016 = 0x{d:02x}: DCS's p-state at CPU0's last wait before the commit (after entry 50):"
                       f" actual {d & 0xf}, target {'5' if d & 0x10 else 'NOT 5'}, busy bit 31"
                       f" {'SET' if d & 0x20 else 'clear'} ({'settled at 5' if at5 else 'NOT settled at 5'}); SIO's"
                       f" actual state {'NOT off' if d & 0x40 else 'off'} after the commit")
            # The wait after 50 ends met or at its timeout, so a settled
            # 0x6016 means that wait was met: a DCS timeout was 49's.
            if at5 and t & 0x80 and b[0x12] & 1:
                out.append("  so DCS's timed-out wait (0x6012 bit 0) was the one after entry 49: the one after 50"
                           " settled")
    elif base in FULL:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}: the low bytes of the wdt page's +0x28 and +0x40"
                   " after the commit (T8103's S2R-engine progress registers, inferred; e1_hook's load log has"
                   " them awake)")
        cl = b[0x15]
        busy = ",".join(n for i, n in enumerate(SOC) if cl >> i & 1) or "none"
        out.append(f"0x6015 = 0x{cl:02x}: soc clusters still busy: {busy} (PACC1 expected, CPU7 being up);"
                   f" SIO_CPU's actual state {'NOT off' if cl & 0x80 else 'off'}")
        wk = b[0x16]
        if not wk & 0x80:
            out.append(f"0x6016 = 0x{wk:02x}: bit 7 is clear, so this byte didn't survive the reset; don't read it")
        else:
            words = ",".join(str(i) for i in range(7) if wk >> i & 1) or "none"
            out.append(f"0x6016 = 0x{wk:02x}: AP wake-status words with a bit set that wasn't just before the"
                       f" commit: {words}")
    elif base == 0x62:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}, 0x6015 0x6016 = {b[0x15]:02x} {b[0x16]:02x}: CPU0's"
                   " or CPU7's (it was rewriting them): not decoded")
    elif base >= 0x50:
        if s in SIO_STOP_STAGES:
            out += k_lines(b)
            if s in RECFG_STAGES:
                out += recfg_lines(b[5])
            elif s in WD2_STAGES:
                out += wd2_lines(b[5], s in WD2_PEND)
        elif s in POSITION:
            out += position_lines(s, b, pmp, disp)
        elif hold and s in HOLD_AFTER:
            if s == 0x5c:
                out.append("0x6012-0x6014: being rewritten when the breadcrumbs stopped: not decoded")
            elif b[0x14] & 0x80:
                out.append(f"0x6012 = 0x{b[0x12]:02x}: the cores that took the release: {cpus(b[0x12])}")
                out.append(f"0x6013 = 0x{b[0x13]:02x}: of those, the ones with an interrupt pending just before their"
                           f" deep WFI: {cpus(b[0x13])}")
            else:
                out.append("0x6012 0x6013: went in one command with 0x6014, whose bit 7 is clear: not decoded")
        # From 0x5c on, 0x6015 still comes from step 8's command; its marker there is the second's low bytes.
        if pmp or s in POS_S2 or s == 0x43:
            pass  # 0x6015 is the PMP's byte, or a sample's, already printed
        elif s in HOLD_AFTER and not b[0x10:0x12] == bytes(2) or s not in HOLD_AFTER and b[0x14] & 0x80:
            at = "at their stop request (hold=1)" if hold else "at their stop"
            out.append(f"0x6015 = 0x{b[0x15]:02x}: cores with an interrupt pending {at}: {cpus(b[0x15])}")
        elif s in HOLD_AFTER:
            out.append("0x6015: step 8's command, whose second's low two bytes read 0: not decoded")
        if s in ALARM_STAGES:
            out.append(alarm_byte(b[0x16]))
            if s in (0x59, 0x5a, 0x4e, FAB_PRE) and b[0x16] in ALARM_ACKED:
                nxt = {0x59: "0x5f", 0x5a: "0x5b", 0x4e: "0x4f, or recfg_bite=1's 0x46 or 0x47, or wd2_bite=1's 0x56 or 0x57,",
                       FAB_PRE: "0x51 or 0x53"}[s]
                out.append(f"  stage 0x{s:02x}, so nothing records {'the commit' if s in (0x4e, FAB_PRE) else 'the two commit writes'} after those commands ("
                           f"{nxt} comes after them): inconclusive about the rest of the entry")
        elif b[0x14] & 0x80:
            out.append(f"0x6016 = {b[0x16]}: AIC events the cores took off their event registers")
    if commit is not None and cnt and cnt[1]:
        age = cnt[0] / cnt[1]
        x = now - age - commit
        out.append(f"the SoC restarted about {x:.0f} s after the commit ({x - 1:.1f} to {x + 1:.1f} s: the PMU's RTC"
                   f" counts whole seconds); its counter (CNTVCT) is {age:.1f} s old. Right only in the first boot"
                   " after the run")
        if s in FAB_STAGES and fab_landed(b) and b[7] & WD1_STANDS == WD1_STANDS:
            out.append(mark_reading(x, s, b[5]))
    if alarm:
        out += alarm_lines(s, commit, alarm, now, b[0x16])
    return out


def main():
    args = sys.argv[1:]
    if args not in ([], ["--clear"]):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)
    clear = args == ["--clear"]
    path = find_nvmem()
    try:
        fd = os.open(path, os.O_RDWR if clear else os.O_RDONLY)
        b = os.pread(fd, 0x20, 0x6000)
        rtc = os.pread(fd, 6, RTC)
        al = [os.pread(fd, n, off) for off, n in ((ALARM_CTRL, 1), (ALARM, 4), (ALARM_EVENT, 1), (ALARM_MASK, 1))]
    except OSError as e:
        die(f"{path}: {e}")
    if len(b) != 0x20 or len(rtc) != 6 or [len(x) for x in al] != [1, 4, 1, 1]:
        die(f"{path}: short read")
    alarm = (al[0][0], int.from_bytes(al[1], "little"), al[2][0], al[3][0])
    for line in decode(b, rtc, counter(), alarm):
        print(line)
    if clear:
        # The run's own alarm: its compare value is the commit's second +
        # 3600, or, with that second lost, 0x6016 says 0x1401's write was acked.
        secs = int.from_bytes(b[0x10:0x14], "little")
        st = b[4] & 0x7f  # pmp_out=1's bit 7 off
        if st in DISP_STAGES:  # and disp_off=1's bit 3
            st &= ~0x08
        if st in HOLD_AFTER:  # hold=1: the second's upper bytes are rewritten; its low two bytes stay
            now_s = int.from_bytes(rtc[2:6], "little")
            low = int.from_bytes(b[0x10:0x12], "little")
            secs = run_second(low, alarm[1], now_s, b[0x16]) or (now_s - ((now_s - low) & 0xffff) if low else 0)
        mine = st in ALARM_STAGES and (alarm[1] == secs + ALARM_SECS if secs else b[0x16] in ALARM_ACKED)
        try:
            # Before the crumbs, so that a failed disarm keeps the stage for another try.
            if mine and alarm[0] & 0x42:
                if os.pwrite(fd, b"\x01", ALARM_CTRL) != 1:
                    die("short write at 0x1401")
                back = os.pread(fd, 1, ALARM_CTRL)
                if len(back) != 1 or back[0] & 0x40:
                    die("0x1401 still reads armed; the breadcrumbs stay, so this can run again")
                print(f"disarmed: 0x1401 = 0x{back[0]:02x}")
            elif st in ALARM_STAGES and not secs and alarm[0] & 0x40:
                die(f"0x1401 reads armed (0x{alarm[0]:02x}) after an alarm stage, but the commit's second was lost and"
                    " 0x6016 doesn't say 0x1401's write was acked, so whose alarm this is can't be told. Nothing is"
                    " written: the breadcrumbs stay, and clearing it needs Corey's word")
            elif alarm[0] & 0x40:
                print(f"0x1401 reads armed (0x{alarm[0]:02x}) and was left alone: nothing shows this run armed it")
            for off, n in CRUMBS:
                if os.pwrite(fd, bytes(n), off) != n:
                    die(f"short write at {off:#x}")
            after = [os.pread(fd, n, off) for off, n in CRUMBS]
        except OSError as e:
            die(f"{path}: {e}")
        if any(a != bytes(n) for a, (_, n) in zip(after, CRUMBS)):
            die("cleared, but they don't read back as zeros")
        print("cleared: 0x6004-0x6007 and 0x6010-0x6016 read back as zeros")
    return 0


if __name__ == "__main__":
    sys.exit(main())
