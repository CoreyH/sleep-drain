PWN_MARK = 0x80  # e1_hook's M1_PWN_MARK: atc_down=1's with pw_noread=1: the fabric group's four words written and not read, its bit (5) always clear
W_GROUPS = ("the five UARTs", "MSG", "ATC1-3_USB_AON", "ATC0-3_PCIE", "ATC1-3_COMMON")  # bits 0-4; e1_hook's M1_PW_*
ATC_GROUPS = {2: ", and ATC0_USB_AON and ATC0-3_USB (atc_down=1's)", 4: ", and ATC0_COMMON (atc_down=1's)"}  # m1_atc[]'s groups
BITE_CLASSES = ("another value", "the new value, 45 s", "the old value, 30 s", "its awake value")  # recfg_bite.h's M1_BITE_*
# wd2_bite.h's M1_WD2_PRE_*: 30 s is every A sequence's, and A2's only while PHASE reads 4 or 5
WD2_PRE = ("another value", "30 s, an A sequence's opening's", "the new value, 120 s", "the value it read awake at load")
WD2_PHASES = (0, 4, 5, None)  # wd2_bite.h's m1_wd2_phase(): None is any other value
DCP_CODES = ("its RTKit shutdown TIMED OUT", "its RTKit shutdown FAILED another way", "shut down, but RUN didn't read 1 then 0", "stopped")
SIO_CODES = ("its RTKit idle pair TIMED OUT", "its RTKit idle pair FAILED another way", "idle returned 0, but RUN didn't read 1 then 0", "stopped")
SIO_CLASSES = ("all ones: a failed read", "target 0, bit 11 set (B2 at op 91, inferred)",
               "target 0, bit 11 clear (past op 91, inferred)", "another target, bits 27:24 not f",
               "another target, bits 27:24 f, actual not f", "another target, bits 27:24 f, actual f",
               "not a class e1_hook sends (6)", "not a class e1_hook sends (7)")


def sample_lines(n, addr_a, a, addr_b, b, disp=False):
    """position=1: one sample's two bytes, one line per word (m1_position.h has the layout). disp: disp_off=1's byte B."""
    phase = a & 0xf
    middle = (f"  display (K3b): internal DCP: {DCP_CODES[b & 3]}; external DCP: {DCP_CODES[b >> 2 & 3]}; the domains of the DCPs"
              f" that stopped: {'all read off' if b & 0x10 else 'NOT all read off, or none stopped'}") if disp else (
             f"  SIO_CPU: {SIO_CLASSES[b & 7]}; WD2 RESET_EN {'set' if b & 8 else 'clear'}; WD2's count"
             f" {'within' if b & 0x10 else 'NOT within'} 0.25 s of CPU0's time since the first commit write")
    return [f"position sample {n} (0x{addr_a:04x} = 0x{a:02x}, 0x{addr_b:04x} = 0x{b:02x}):",
            f"  PHASE {phase:#x} ({PHASES.get(phase, 'not a phase the sequences read so far write')}); HS_A bit 31"
            f" {'up' if a & 0x10 else 'down'}, bit 24 {'up' if a & 0x20 else 'clear'}; state word"
            f" {STATE_WORDS[a >> 6]}",
            middle,
            f"  gate words: 0x2922c0044 bit 2 {'set' if b & 0x20 else 'clear'}, bit 3 {'set' if b & 0x40 else 'clear'};"
            f" 0x2922c0040 bit 1 {'set' if b & 0x80 else 'clear'}"]


def recfg_lines(v):
    """recfg_bite=1, stages 0x46 and 0x47: 0x6005, what CPU0 read once it had let the others go (recfg_bite.h has the layout)."""
    cls, phase, armed, sram = v & 3, v >> 2 & 0xf, bool(v & 0x40), bool(v & 0x80)
    if cls == 1:
        so = ("the engine took WD2's bite from the changed word: the SRAM takes a write and the engine runs it. Feasibility shown,"
              " whenever the reset came")
        if not armed and phase in (0, 4, 5):
            so += (". But RESET_EN didn't show within 0.3 s: CPU0 looked inside A2's opening, or the word after the bite was"
                   " disturbed. Then WD2 never bites, and a Mac that stayed dark is that, not a completed entry")
        elif not armed:
            so += (f". RESET_EN didn't show within 0.3 s, with PHASE {phase:#x}, which isn't one A2 shows before its last (0, 4,"
                   " 5): every A sequence clears RESET_EN at its end, so A2 may have run to its end before CPU0 looked. A Mac that"
                   " then stayed dark may be a completed entry")
        if not sram:
            so += ". (Step 8's read of the word didn't show the new value, which doesn't fit a new bite in WD2: that read isn't to be trusted then)"
    elif cls == 2 and not sram:
        so = "the edit wasn't in place at the commit (the word didn't read the new value in step 8), so it wasn't tested. Not a negative"
    elif cls == 2 and phase in (4, 5) and armed:
        so = ("A2, before its last phase, armed WD2 with the old bite though the word read the new one: the engine didn't take the"
              " bite from this word. (A copy elsewhere isn't excluded: only the first 64 KiB of the SRAM has been read)")
    elif cls == 2 and phase in (4, 5):
        so = ("nothing decided: WD2 holds the old bite with A2 before its last phase, though the word read the new one, which"
              " points at the engine not taking the bite from this word. But RESET_EN didn't show within 0.3 s, and A2's opening"
              " sets it right after the bite: this isn't the state that opening leaves, so the record alone doesn't say")
    elif cls == 2:
        so = (f"nothing decided about the edit: with PHASE {phase:#x}, a later sequence's opening may have re-armed WD2 with its"
              " own 30 s before CPU0 looked")
    elif not sram:
        so = ("nothing decided, and the edit wasn't in place at the commit (the word didn't read the new value in step 8): the"
              " reset time says nothing about it either")
    elif cls == 3:
        so = ("nothing decided: WD2 showed RESET_EN with its awake bite, which no sequence read so far would leave" if armed else
              "nothing decided: nothing had armed WD2 within 0.3 s of the release. If the Mac then stayed dark, WD2 was never armed:"
              " not a completed entry, and the edit is the first suspect")
    else:
        so = "nothing decided: not a bite any sequence read so far writes. Unreadable, not a negative"
    if v == 0xfe:
        so += (". And 0xfe is what stage 0x4e leaves in this byte (the parked cores): if the stage's command landed without its"
               " second byte, this isn't a sample at all")
    if v == 0:
        so += ". And 0x00 is also what a byte that didn't land, or didn't survive the reset, reads: not a reading to lean on"
    what = "its awake value, or pair 0's" if phase == 0 else PHASES.get(phase, "not a phase the sequences read so far write")
    return [f"0x6005 = 0x{v:02x}: recfg_bite=1, after the commit, the alarm and the release (A2's bite word in the SRAM was changed"
            " to 45 s before the load):",
            f"  WD2's bite: {BITE_CLASSES[cls]}; WD2's control {'showed RESET_EN' if armed else 'did NOT show RESET_EN within 0.3 s'}",
            f"  PHASE {phase:#x} ({what}), read after the bite; A2's bite word in the SRAM, read in step 8 just before the commit:"
            f" {'the new value' if sram else 'NOT the new value'}",
            f"  so: {so}",
            "  (the reset time is a second fact, never the test: RESEARCH.md, \"A different approach\")"]


def wd2_lines(v, pend=False):
    """wd2_bite=1, stages 0x56 and 0x57: 0x6005, what CPU0 read around its one write to WD2's bite (wd2_bite.h has the layout).
    pend: the stage is 0x56, CPU0 had an exception pending after its reads."""
    pre, seen, post, still, counting, ph = v & 3, bool(v & 4), bool(v & 8), bool(v & 0x10), bool(v & 0x20), WD2_PHASES[v >> 6]
    if v == 0xfe:
        # Before anything is read out of it: this is the byte the stage before leaves here.
        so = ("0xfe is what stage 0x4e leaves in this byte (the parked cores): the stage's command most likely landed without its"
              " second byte, and then this isn't a sample at all. None of the three lines above is to be leaned on")
    elif not seen and post and pre != 2:
        so = ("an inconsistent record: CPU0 made no write, and the bite read 120 s after that though it didn't just before. Something"
              " else wrote it between the two reads, or the byte isn't the one CPU0 sent: not to be leaned on")
    elif not seen:
        so = ("CPU0 made no write: nothing had armed WD2 within 0.3 s of the release, so the bite wasn't moved and the reset's time"
              " says nothing about a moved bite. A Mac that then stayed dark isn't a completed entry by this record: WD2 was never seen"
              " armed")
        if post:
            so += (". The bite read 120 s before and after: wd2-bite's store from user space, still there, which also says no"
                   " sequence's opening had written its own 30 s")
    elif not post:
        so = ("CPU0 MADE ITS WRITE AND THE BITE DIDN'T READ 120 s AFTER IT: the register didn't keep the kernel's store (or"
              " something wrote it again at once). The bite wasn't moved, and the reset's time says nothing about a moved bite")
    elif not still:
        so = ("the bite reads 120 s, but RESET_EN didn't show after the write: WD2 wasn't armed any more (a sequence closing just"
              " then, or the write itself). An unarmed WD2 doesn't bite, so a Mac that then stayed dark is that as readily as a"
              " completed entry")
    elif not counting:
        so = ("the bite reads 120 s with RESET_EN set, but the count didn't change within 1 ms: WD2 may not be counting any more."
              " A Mac that then stayed dark may be that, and isn't a completed entry by this record")
    else:
        took = ("the write took, and" if pre != 2 else
                "the bite read 120 s before CPU0's write as after it, so this record doesn't show that write took;")
        who = "A2" if ph in (4, 5) else "the sequence that armed WD2"
        dark = ("no reset is a candidate for a completed entry" if not pend else
                "no reset isn't a candidate for a completed entry here, since CPU0 likely never went down (the stage)")
        so = (f"{took} WD2 was armed and counting with a 120 s bite. The reset's time is the result now: about 120 s"
              f" after the commit fits {who} arming last and never closing; {dark}; about 30 s,"
              " or another time T, fits a later sequence arming WD2 again, T - 30 s after the commit")
        if ph == 0:
            so += (". PHASE still read 0 after 10 ms, where A2 writes 4 a few ops after its opening: which sequence armed WD2 isn't"
                   " shown by this record")
        elif ph is None:
            so += (". PHASE read neither 4 nor 5, A2's before its last: A2 may have run to its end already and a later A sequence"
                   " armed WD2, each opening with the same 30 s. Then the entry had finished before CPU0's write, and the bite that"
                   " was moved is that sequence's")
    if seen and pre != 1 and v != 0xfe:
        so += (f". But the bite read {WD2_PRE[pre]} before the write, not the 30 s an A sequence's opening leaves, though RESET_EN"
               " showed: what armed WD2 isn't clear from this record")
    if pend and v != 0xfe and not (seen and post and still and counting):
        so += ". And CPU0 had an exception pending after its reads (the stage): it likely never went down"
    if v == 0:
        so += ". And 0x00 is also what a byte that didn't land, or didn't survive the reset, reads: not a reading to lean on"
    what = ("neither 0, 4 nor 5: A2's last, or a later sequence's" if ph is None else
            f"{ph:#x} ({'its awake value, or pair 0' + chr(39) + 's' if ph == 0 else PHASES[ph]})")
    return [f"0x6005 = 0x{v:02x}: wd2_bite=1, after the commit, the alarm and the release:",
            f"  WD2's bite before CPU0's write: {WD2_PRE[pre]}; WD2's control"
            f" {'showed RESET_EN, so CPU0 wrote the bite, 120 s' if seen else 'did NOT show RESET_EN within 0.3 s, so CPU0 wrote nothing'}",
            f"  read after that: the bite {'120 s' if post else 'NOT 120 s'}; RESET_EN {'set' if still else 'NOT set'}; the"
            f" count {'changing' if counting else 'NOT changing within 1 ms'}",
            f"  PHASE, read last: {what}",
            f"  so: {so}",
            "  (the readings, and why one run narrows the cases without deciding them: PLAN.md, \"The order after run 14\")"]


def pwn(m):
    """Whether 0x6013 is a pw_noread=1 run's: its top two bits 0x80 with bit 5, the fabric group's, clear. Never K_MARK, which
    has bit 5 set."""
    return m & 0xe0 == PWN_MARK


def k_lines(b):
    """sio_stop=1: 0x6012, the steps before the commit, if 0x6013 says it landed (e1_hook.c's m1 comment has the layout)."""
    k = b[0x12]
    m = b[0x13]
    noread = pwn(m)
    atc = m & W_MARK == ATC_MARK or noread
    words = m & W_MARK == W_MARK or atc
    if m != K_MARK and not words:
        return [f"0x6012 0x6013 = {k:02x} {m:02x}: the steps' outcomes didn't land (0x6013 is neither their marker, 0x{K_MARK:02x}, nor"
                f" ps_words=1's, 0x{W_MARK:02x} and up, nor atc_down=1's, 0x{ATC_MARK:02x} to 0x{ATC_MARK | 0x3f:02x}, nor pw_noread=1's,"
                f" 0x{PWN_MARK:02x} to 0x{PWN_MARK | 0x1f:02x}): nothing here says how the DCPs, the SMC's notice, SIO or any power word went"]
    out = [f"0x6012 = 0x{k:02x}, the steps before the commit:",
            f"  internal DCP: {DCP_CODES[k & 3]}; external DCP: {DCP_CODES[k >> 2 & 3]}; the domains of the DCPs that stopped:"
            f" {'all read off' if k & 0x10 else 'NOT all read off, or none stopped'}",
            f"  SMC's AP idle notice: {'acked within 200 ms' if k & 0x20 else 'NOT acked'}; SIO's firmware: {SIO_CODES[k >> 6]}"]
    if words:
        out.append(f"0x6013 = 0x{m:02x}: ps_words=1 wrote the 20 power words, after the table"
                   + (", and atc_down=1 its six around them (ATC0_USB to ATC3_USB and ATC0_USB_AON before, ATC0_COMMON after):" if atc else ":"))
        groups = tuple(g + ATC_GROUPS.get(i, "") for i, g in enumerate(W_GROUPS)) if atc else W_GROUPS
        out += [f"  {g}: " + ("read actual 0 within 10 ms each" if m >> i & 1 else "NOT all read actual 0 within 10 ms each") for i, g in enumerate(groups)]
        out.append("  PCIE0_REF, APCIE_GP_SYS, AFNC1_LW2, AFNC2_LW1: target and auto fields "
                   + ("not read (pw_noread=1): the four were written, and none was read back, so nothing here says whether they took"
                      if noread else "read back as written" if m & 0x20 else "NOT all read back as written"))
    return out


def position_lines(s, b, pmp=False, disp=False):
    """position=1, stages 0x40-0x45: which samples these bytes are, and what they say. pmp: sio_on=1's layout, one sample;
    disp: disp_off=1's byte B."""
    out = []
    if s in POS_S1:
        out += sample_lines(1, 0x6012, b[0x12], 0x6013, b[0x13], disp)
    elif s == 0x41:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}: step 8's second's upper bytes or sample 1's, its"
                   " bytes' stage didn't follow: not decoded")
    else:
        out.append("no sample recorded yet")
    if pmp:
        if s in POS_S1:
            out.append("  one sample by design (pmp_out=1 keeps 0x6015), about 1 s after the commit: it can't tell a stop from"
                       " slow progress" + ("" if s in POS_S2 else ", and only stages 0x44 and 0x45 say whether a read failed"))
    elif s in POS_S2:
        out += sample_lines(2, 0x6007, b[0x07], 0x6015, b[0x15])
    elif s == 0x43:
        out.append(f"0x6007 0x6015 = {b[0x07]:02x} {b[0x15]:02x}: held and step 8's byte, or sample 2's, the stage after"
                   " them didn't follow: not decoded")
    if not pmp and s in (0x42, 0x43):
        out.append("  sample 1 alone, about 1 s after the commit: only stages 0x44 and 0x45 say whether a read failed, and one"
                   " sample can't tell a stop from slow progress, so no rung from it")
    if s in POS_S1:
        out.append("  (compare each word with the awake pass, recfg-peek-*-p*/, or the load log's position line; a word still at its awake value says"
                   " nothing. PLAN.md has the reading guide)")
    return out


def die(msg):
    print(f"m1-crumbs: {msg}", file=sys.stderr)
    sys.exit(2)


def find_nvmem():
    """The nvmem device for NODE; its number isn't fixed (pmu-alarm)."""
    if NVMEM:
        return NVMEM
    found = [d for d in sorted(glob.glob("/sys/bus/nvmem/devices/spmi_nvmem*"))
             if os.path.realpath(f"{d}/of_node").endswith(NODE)]
    if len(found) != 1:
        die(f"want one nvmem device for {NODE}, found {len(found)}")
    return f"{found[0]}/nvmem"


def cpus(mask):
    return ",".join(f"CPU{n}" for n in range(8) if mask >> n & 1) or "none"


def stage(s, observe=False):
    if observe and s in OBSERVE_STAGES:
        return OBSERVE_STAGES[s]
    if s in STAGES:
        return STAGES[s]
    if 0x21 <= s <= 0x27:
        cpu = ORDER[s - 0x21]
        return (f"6: releasing CPU{cpu}, the order's {s - 0x20} of 7 (1, 2, 3, 5, 6, 4, 7): the run stopped"
                " at that core's stop (a reset or a hang), or a later breadcrumb failed and CPU0 went on")
    return "unknown"


def counter():
    """CNTVCT and CNTFRQ, or None. Python has no mrs, so this runs the two
    instructions from an executable page: mrs x0, cntvct_el0 (or cntfrq_el0),
    ret. Linux lets EL0 read both (its vDSO does)."""
    if CNTVCT:
        if CNTVCT == "none":
            return None
        ticks, freq = CNTVCT.split()
        return int(ticks), int(freq)
    if os.uname().machine != "aarch64":
        return None
    try:
        import ctypes
        import mmap
        code = (0xd53be040, 0xd65f03c0, 0xd53be000, 0xd65f03c0)
        m = mmap.mmap(-1, mmap.PAGESIZE, prot=mmap.PROT_READ | mmap.PROT_WRITE | mmap.PROT_EXEC)
        m.write(b"".join(w.to_bytes(4, "little") for w in code))
        addr = ctypes.addressof(ctypes.c_char.from_buffer(m))
        fn = ctypes.CFUNCTYPE(ctypes.c_uint64)
        return fn(addr)(), fn(addr + 8)()
    except (OSError, ValueError):
        return None


def qto(q, ack=False):
    """pmgr_late's waits that timed out. ack: a cluster_ack=1 run, whose bits 2-5 are the cluster words' flags that stayed."""
    timed = [w for i, w in enumerate(WAITS) if q >> i & 1 and not (ack and CLUSTER_WAITS >> i & 1)]
    if ack:
        stuck = [n for i, n in ACK_WORDS.items() if q >> i & 1]
        return (f"0x{q:02x}: " + ("macOS's other waits were all met within 10 ms" if not timed else
                                 "macOS's waits that timed out after 10 ms: " + "; ".join(timed))
                + "; bits 2-5 (cluster_ack=1), the soc-cluster words whose up-done flag was still set at their wait's last read: "
                + (", ".join(stuck) or "none"))
    return f"0x{q:02x}: " + ("every one of macOS's waits was met within 10 ms" if not timed else
                            "macOS's waits that timed out after 10 ms: " + "; ".join(timed))


# wd1_mark=1 (run-floor --m1-mark; e1-hook/wd1_mark.h): bits 7:6 of fabric_up=1's byte, WD1 as read just before the commit.
# Both set, the marker stood, and the restart's time reads B2's progress: WD1's bite less its count if B2 never zeroed
# the count, WD2's bite if it did and the pair then stopped, WD1's bite if the pair finished.
WD1_STANDS = 0xc0
WD1_BITE_S, WD1_COUNT_S, WD2_BITE_S = 150, 60, 120
LL_WD1_COUNT_S = 80  # last_look.h's LL_WD1_COUNT


def wd1_count_s(s):
    """The count the run at stage s wrote to WD1 as its marker, in seconds."""
    return LL_WD1_COUNT_S if s in LL_STAGES else WD1_COUNT_S
# probe=1 (e1-hook/probe; e1-hook/asc_probe.h has the bytes): not a run. Stage 0x0e, which no run sends, and at
# 0x6005-0x6007 what bit 1 of SIO's, the PMP's and ANS's ASC + 0x8000 read around the recipe's steps on them.
PROBE_STAGE = 0x0e
PROBE_MARK = 0x80
FAB_WAS = ("another value: neither 0x333 nor asked down to 1", "0x111: asked down to 1 by the kernel's suspend, and there",
           "asked down to 1 by the kernel's suspend, and not there yet", "0x333, as awake: this suspend hadn't lowered it")


# probe=1 look=1 (e1-hook/probe --look): its stage, and the groups of words it reads, by the number it leaves at
# 0x6010 before reading each (look.h's enum look_at), with LOOK_LOAD set by the look at the module's load. 7 is the
# last mark of a look, as it was when the look read 98 words (results/look-20261110/); 8 to 10, added with the 22
# words B2 writes first, are marked before it.
LOOK_STAGE = 0x0f
LOOK_LOAD = 0x10
LOOK_AT = ("nothing marked",
           "the fabric's, 0x28e20c400 and DCS's p-state words",
           "six words of the engine's page, 0x2922c0000, that its sequences read",
           "the power words B2 switches off and polls",
           "six gate-status words",
           "fifteen clock generators' two words each",
           "two words of the engine's page that its sequences only write (+0x008, +0x024)",
           "every group read",
           "0x28e03801c, which B2's op 8 writes",
           "0x28e0a0004 to 0x28e0a001c, which B2's ops 9 to 15 write: a page not read before this look",
           "0x28e5b0004 to 0x28e5b0038, which B2's ops 16 to 29 write: a page not read before this look")
LOOK_DONE = 7


# gate=1 (e1-hook/probe --gate): its steps, by the number it leaves at 0x6010 with GATE_PASS set (gate_test.h's enum
# gate_at), and the mark of its byte at 0x6005.
GATE_PASS = 0x20
GATE_NO_SNAP = 0x40  # in a mark from step 6 on: the write that carries the lane's three reads wasn't acked
GATE_MARK = 0x80
GATE_UNMADE = 0xe0  # the byte of a test that wasn't made
GATE_AT = ("nothing marked",
           "everything read as found",
           "the five UARTs written 0x200",
           "the gate polled, SIO's subtree all off",
           "AFNC2_LW1 written 0x1000030f, macOS's value",
           "the gate polled again",
           "AFNC2_LW1 written back as found",
           "the five UARTs written back as found",
           "every step taken: the byte written",
           "the test wasn't made: after noirq SIO read on, or a UART had a target of f, and nothing was written")
GATE_LANE_BACK, GATE_DONE, GATE_NOT_MADE = 6, 8, 9


def gate_word(p):
    """gate_test.h's gate_pack(): two bytes of a power word, read back into words."""
    lo, hi = p
    flags = [n for bit, n in ((0x20, "was power-gated"), (0x40, "was clock-gated"), (0x80, "BUSY")) if hi & bit]
    return (f"target {lo & 0xf:x}, actual state {lo >> 4:x}, auto-enable {'on' if hi & 0x10 else 'off'}, auto floor {hi & 0xf:x}"
            + (", " + ", ".join(flags) if flags else ""))


def gate_lines(at, v, pack):
    """gate=1's record: the step it was about to take when it last wrote 0x6010, its byte at 0x6005 if that landed, and
    the lane's three reads at 0x6011-0x6016, if the mark says they're this test's. The kernel log e1-hook/probe saves
    has every word in full."""
    n = at & ~(GATE_PASS | GATE_NO_SNAP)
    step = GATE_AT[n] if n <= GATE_NOT_MADE else "not a step's number"
    if n in (GATE_DONE, GATE_NOT_MADE):
        out = [f"0x6010 = 0x{at:02x}: the gate test, after both looks: {step}"]
    elif v & GATE_MARK:
        # The byte is zeroed when the test starts and written after its last step, write-backs and all: with it there, an
        # earlier mark is a later mark lost.
        out = [f"0x6010 = 0x{at:02x}: the gate test, after both looks. The last step it marked: {step}; but its byte landed, and that is"
               " written after the last step, so the test reached its end and a later mark didn't land (Pullfrog on #80)"]
    else:
        out = [f"0x6010 = 0x{at:02x}: THE GATE TEST BEGAN AND DIDN'T FINISH, after both looks. The last step it marked: {step}."
               " The Mac went down in that step, or after it and before the next mark"
               + (". From step 2 to step 7 a word it had changed may not have been written back: the restart since has put"
                  " every power word back where the boot leaves it" if 2 <= n <= 7 else "")]
    # The lane's three reads are written in one command with step 6's mark, so only that mark, or a later one that
    # doesn't say the command failed, makes 0x6011-0x6016 this test's: bytes left there from before are never read
    # as its own (Pullfrog on #80). The byte at 0x6005 is another command's, and has no say in this.
    if GATE_LANE_BACK <= n <= GATE_DONE and not at & GATE_NO_SNAP:
        if any(pack):
            out += ["0x6011-0x6016: AFNC2_LW1 (0x28e580160), read three times before anything was written back:",
                    f"  right before its write, SIO's subtree off: {gate_word(pack[0:2])}",
                    f"  after the write of macOS's 0x1000030f: {gate_word(pack[2:4])}",
                    f"  after the second poll of the gate: {gate_word(pack[4:6])}"]
        else:
            out.append("0x6011-0x6016 read 0 though the mark says their write was acked: nothing is read from them")
    else:
        why = ("the test wasn't made" if n == GATE_NOT_MADE else
               "the mark says the write that carries them wasn't acked" if GATE_LANE_BACK <= n <= GATE_DONE else
               "the last mark that landed is from before their write" if n < GATE_LANE_BACK else "the mark isn't a step's")
        if any(pack):
            out.append(f"0x6011-0x6016 hold {bytes(pack).hex(' ')}: NOT this test's reads of the lane ({why}): left from before, and"
                       " nothing is read from them")
        else:
            out.append(f"0x6011-0x6016 read 0: the lane's three reads weren't written ({why})")
    if n == GATE_NOT_MADE:
        return out + [f"0x6005 = 0x{v:02x}: " + ("the byte a test that wasn't made leaves" if v == GATE_UNMADE else
                                                "NOT the 0xe0 a test that wasn't made leaves: nothing is read from it"),
                      "  so: nothing was switched off, nothing had to be put back, and nothing is decided about the gate"]
    if not v & GATE_MARK:
        return out + [f"0x6005 = 0x{v:02x}: the test's byte didn't land (bit 7 clear), or the test stopped before it: nothing is read"
                      " from it"]
    off, c1, took, c2, gated, lback, uback = (bool(v >> i & 1) for i in range(7))
    out += [f"0x6005 = 0x{v:02x}: the gate test's byte:",
            "  the five UARTs: " + ("all read actual 0 within 10 ms of being written 0x200" if off else
                                    "did NOT all read actual 0 within 10 ms of being written 0x200, or the test wasn't made (SIO read on,"
                                    " or a UART was in use): the kernel log says which"),
            f"  bit 30 of 0x28e5a0050, the gate B2 polls after SIO's subtree, before the lane's write: {'SET' if c1 else 'clear'}"
            + (" (within 100 ms of the subtree going off, or at the read right before the write)" if c1 else
               ", through 100 ms and at the read right before the write"),
            f"  AFNC2_LW1, written macOS's 0x1000030f: {'took it' if took else 'did NOT take it'} within 10 ms"
            f"; its actual state after the second poll: {'0' if gated else 'not 0'}",
            f"  bit 30 of 0x28e5a0050 after that: {'SET' if c2 else 'clear'}" + ("" if c2 else ", through 100 ms"),
            f"  read as found with everything written back: AFNC2_LW1 {'yes' if lback else 'NOT within 10 ms'}; the UARTs"
            f" {'yes' if uback else 'NOT all within 10 ms'}"]
    if not off:
        out.append("  so: SIO's subtree wasn't all off, so neither poll was of the state B2 polls in: nothing decided about the gate")
    elif c1:
        out.append("  so: in Linux's suspended state the gate B2 waits on closes once SIO's subtree is all off, before the lane was"
                   " given macOS's value: this poll isn't where B2 stops in that state. The recipe's state is further on, and B2"
                   " polls after its own writes")
    elif took and c2:
        out.append("  so: the gate read open with SIO's subtree all off, up to the read right before the lane's write, and set within"
                   " 100 ms after the lane took macOS's value" + (", with the lane's actual state then 0" if gated else
                                                                " though the lane's actual state wasn't 0 then")
                   + ". Closed after it: one before and one after can't tell that from a gate that closes late by itself. If it's the"
                   " lane's floor, whether the recipe's own write of it takes is the next thing to read")
    elif c2:
        out.append("  so: the gate read open with SIO's subtree all off, and set at the second poll though the lane did NOT take"
                   " macOS's value: it closed late and by itself, or the write did something its read-back doesn't show. The"
                   " lane's three reads above, and the kernel log, have the words")
    elif took:
        out.append("  so: the gate stayed open with SIO's subtree all off and the lane at macOS's value: something else is behind it,"
                   + (" though the lane's actual state read 0" if gated else " and the lane's actual state didn't read 0"))
    else:
        out.append("  so: the gate stayed open with SIO's subtree all off, and the lane did NOT take macOS's value: the write that"
                   " ps_words=1 makes in every run doesn't land in this state. The lane's three reads above have what it read")
    return out


# pre_test=1 (e1-hook/probe --pre): its steps, by the number it leaves at 0x6010 with PRT_PASS set (pre_test.h's enum
# prt_at), its six bytes at 0x6011-0x6016 (prt_pack()) and its byte at 0x6005 (prt_byte()).
PRT_PASS = 0x80
PRT_NO_SNAP = 0x40  # in a mark from step 7 on: the write that carries the six bytes wasn't acked
PRT_MARK, PRT_CLK_BACK, PRT_MORE = 0x80, 0x40, 0x20
PRT_AT = ("nothing marked",
          "the + 0 words of the two pages (0x28e0a0000, 0x28e5b0000) read",
          "the 22 and the gates read as found",
          "0x28e03801c written 0x80101100",
          "the seven from 0x28e0a0004 written 1",
          "the fourteen from 0x28e5b0004 written 1",
          "100 ms waited, and everything read again",
          "0x28e03801c written back as found",
          "the seven written back as found",
          "the fourteen written back as found",
          "every step taken: the byte written")
PRT_BACK, PRT_DONE = 7, 10
PRT_WORDS = (0x28e03801c,) + tuple(0x28e0a0004 + 4 * i for i in range(7)) + tuple(0x28e5b0004 + 4 * i for i in range(14))
PRT_CODE = ("something else: neither as written nor as found", "as written", "as found: the write didn't take",
            "as written with more bits set")


def prt_lines(at, v, pack):
    """pre_test=1's record: the step it was about to take when it last wrote 0x6010, what the 22 read after B2's
    writes (0x6011-0x6016, if the mark says they're this test's), and what came back (0x6005). The kernel log
    e1-hook/probe saves has every word in full."""
    load, n = bool(at & LOOK_LOAD), at & ~(PRT_PASS | PRT_NO_SNAP | LOOK_LOAD)
    step = PRT_AT[n] if n <= PRT_DONE else "not a step's number"
    if load:
        return [f"0x6010 = 0x{at:02x}: the 22 words' test, at the module's load: {step}. That read, awake, is all it does there, and"
                " its mark is zeroed after it: the Mac went down in that read or before the zeroing, or the zeroing didn't land."
                " Nothing was written"]
    if n == PRT_DONE:
        out = [f"0x6010 = 0x{at:02x}: the 22 words' test, after both looks: {step}"]
    elif v & PRT_MARK:
        out = [f"0x6010 = 0x{at:02x}: the 22 words' test, after both looks. The last step it marked: {step}; but its byte landed, and that"
               " is written after the last step, so the test reached its end and a later mark didn't land"]
    else:
        out = [f"0x6010 = 0x{at:02x}: THE 22 WORDS' TEST BEGAN AND DIDN'T FINISH, after both looks. The last step it marked: {step}."
               " The Mac went down in that step, or after it and before the next mark"
               + (". From step 3 to step 9 a word it had changed may not have been written back: the restart since has put"
                  " every one back where the boot leaves it" if 3 <= n <= 9 else "")]
    if not (PRT_BACK <= n <= PRT_DONE and not at & PRT_NO_SNAP):
        why = ("the mark says the write that carries them wasn't acked" if PRT_BACK <= n <= PRT_DONE else
               "the last mark that landed is from before their write" if n < PRT_BACK else "the mark isn't a step's")
        out.append((f"0x6011-0x6016 hold {bytes(pack).hex(' ')}: NOT this test's reads ({why}): nothing is read from them" if any(pack)
                    else f"0x6011-0x6016 read 0: the test's reads weren't written ({why})"))
    elif not any(pack):
        out.append("0x6011-0x6016 read 0 though the mark says their write was acked: the write didn't land, or not one of the 22 read"
                   " as written or as found. Nothing is read from them; the kernel log, if it was saved, has the words")
    else:
        bits = int.from_bytes(bytes(pack), "little")
        code = [None] + [bits >> 2 * i & 3 for i in range(21)]
        poll, late, same, pend = bits >> 42 & 3, bits >> 44 & 3, bits >> 46 & 1, bits >> 47 & 1
        clk = ("as written, bit 30 clear" if poll == 1 else "as written but with bit 30, pending, still SET" if poll == 3 else PRT_CODE[poll])
        clk2 = ("as written, bit 30 clear" if late == 1 else "as written but with bit 30, pending, still SET" if late == 3 else PRT_CODE[late])
        out += ["0x6011-0x6016: the 22 after B2's writes, before anything was written back:",
                f"  0x28e03801c, written 0x80101100: bit 30 {'SET' if pend else 'clear'} at the read right after the write; at the end of"
                f" up to 100 ms it read {clk}; 100 ms after the last write it read {clk2}"]
        for c in (1, 2, 3, 0):
            words = [f"0x{PRT_WORDS[i]:x}" for i in range(1, 22) if code[i] == c]
            if words:
                out.append(f"  of the 21 written 1, 100 ms after: {len(words)} read {PRT_CODE[c]}" + ("" if c == 1 else ": " + " ".join(words)))
        out.append("  each of the 21 read the same right after its group's writes as 100 ms later" if same else
                   "  NOT every one of the 21 read the same right after its group's writes as 100 ms later: the kernel log has both")
        ok21 = all(c == 1 for c in code[1:])
        # What sio_steps=1 judged: the 21 at once, 0x28e03801c within 100 ms and before the 21 were written. Only a record
        # that passes the same reads puts that run's "no" down to the recipe's state (the adversarial review of #97).
        if not ok21:
            out.append("  so: NOT ALL OF THE 21 READ 1 after the AP's write, with the cores up: the words named above. Why, this doesn't"
                       " say; a poll that waits on them may not be one the AP can clear")
        elif late == 1 and poll == 1 and same:
            out.append("  so: ALL 22 READ AS B2 WRITES THEM in Linux's state after noirq, with every core up, at once and 100 ms on"
                       " (0x28e5b0034 and 0x28e5b0038 read 1 before any write in both looks, and show nothing: 19 of the 21 are shown)."
                       " In the sio_steps=1 run it was then the recipe's state, or that run's order, that kept them from reading back:"
                       " that run again, with a record that names the word")
        elif late == 1:
            why = ([] if poll == 1 else ["0x28e03801c didn't read as written, bit 30 clear, by the end of its 100 ms, which ended before"
                                         " the 21 were written (it came later, or once they were in: this can't tell)"]) \
                + ([] if same else ["a select read otherwise right after its group's writes"])
            out.append("  so: all 22 read as B2 writes them 100 ms after the last write, but NOT AT FIRST: " + "; ".join(why)
                       + ". sio_steps=1 read the 21 at once and gave 0x28e03801c 100 ms before them, so this alone may be that run's"
                       " 'no': that run again with its reads after a wait, before the recipe's state is blamed")
        elif late == 3:
            out.append("  so: the 21 read 1; 0x28e03801c has B2's value but its bit 30, pending, was still set 100 ms after the last"
                       " write: that word's write doesn't finish with a core up as it does for B1. sio_steps=1's bit 4 would read no"
                       " for this alone")
        else:
            out.append("  so: the 21 read 1; 0x28e03801c did NOT hold B2's value 100 ms after the last write"
                       + (", though it read as written at the end of its own 100 ms: it changed once the 21 were written" if poll == 1 else
                          ", and read as written with bit 30 set at the end of its own 100 ms" if poll == 3 else "")
                       + ": the 21 alone are what the AP is shown to make")
    if not v & PRT_MARK:
        return out + [f"0x6005 = 0x{v:02x}: the test's byte didn't land (bit 7 clear), or the test stopped before it: whether the 22 were"
                      " put back isn't recorded"]
    bad = v & 0x1f
    out.append(f"0x6005 = 0x{v:02x}: with everything written back: 0x28e03801c "
               + ("read as found" if v & PRT_CLK_BACK else "did NOT read as found")
               + ("; all 21 read as found within 100 ms" if not bad and not v & PRT_MORE else
                  f"; 0x{PRT_WORDS[bad]:x} did NOT read as found within 100 ms" + (", and it isn't the only one" if v & PRT_MORE else "")
                  if 1 <= bad <= 21 else "; the byte's low bits aren't a word's number: nothing is read from them"))
    return out


def look_lines(at):
    """look=1's record: which of its two looks, and the group it was about to read when it last wrote 0x6010. Its
    words are in the kernel log e1-hook/probe saves; the PMU has only how far it got."""
    load, n = bool(at & LOOK_LOAD), at & ~LOOK_LOAD
    group = LOOK_AT[n] if n < len(LOOK_AT) else "not a group's number"
    if n == LOOK_DONE and not load:
        return [f"0x6010 = 0x{at:02x}: {group}: the look after noirq read all of them. What became of the suspend after it,"
                " this record doesn't say"]
    if n == LOOK_DONE:
        return [f"0x6010 = 0x{at:02x}: {group}, by the look at the module's load, whose marks weren't zeroed after it: that"
                " write didn't land, or the Mac went down right then. The look after noirq didn't begin"]
    return [f"0x6010 = 0x{at:02x}: THE LOOK BEGAN AND DIDN'T FINISH: the look {'at the module' + chr(39) + 's load' if load else 'after noirq'}."
            f" The last group it marked: {group}. A read in that group faulted, or the Mac went down in it or before the next mark"]


# probe=1's steps, by the number it leaves at 0x6010 before taking each (asc_probe.h's enum asc_at).
PROBE_AT = ("nothing marked",
            "prepare begun: SIO_CPU's table word written",
            "SIO's word read, its firmware running",
            "ANS's word read, its firmware shut down by the NVMe driver's suspend, ANS2 still on",
            "the PMP's word read, its firmware running",
            "SIO's idle pair",
            "SIO's word read after its idle pair",
            "SIO's RUN cleared",
            "SIO's word read after RUN was cleared",
            "prepare done: the kernel's noirq pass",
            "prepare_late begun: the power words read",
            "ANS2 raised",
            "ANS's word read",
            "ANS2 written back",
            "the PMP's word read before its idle pair",
            "the PMP's idle pair",
            "the PMP's word read after its idle pair",
            "the PMP's RUN cleared",
            "the PMP's word read after RUN was cleared",
            "SIO's parents and SIO_CPU raised",
            "SIO's word read",
            "every step taken: the three bytes written")
PROBE_DONE = len(PROBE_AT) - 1


def probe_final(who, b):
    """What a probe byte says bit 1 read in the state B2 finds: True set, False clear, None not read there (the byte
    didn't land, the domain didn't read actual f for that read, or the PMP's RUN wasn't cleared). asc_probe.h's
    asc_sio_final() and the two beside it, which the probe's own SUMMARY line goes by."""
    if not b & PROBE_MARK:
        return None
    if who == "SIO":
        return bool(b & 8) if b & 0x40 else None
    if who == "PMP":
        return bool(b & 8) if b & 0x40 and b & 0x20 else None
    return bool(b & 4) if b & 0x0a else None


def probe_at_line(at, landed):
    """0x6010, the step the probe was about to take when it last wrote there. landed: all three bytes did."""
    step = PROBE_AT[at] if at <= PROBE_DONE else "not a step's number"
    if landed:
        return f"0x6010 = 0x{at:02x}: {step}" + ("" if at == PROBE_DONE else ": NOT the last step's number, though the bytes landed")
    if at == PROBE_DONE:
        return f"0x6010 = 0x{at:02x}: every step was taken, and the write of the three bytes didn't land, or not all of it"
    return (f"0x6010 = 0x{at:02x}: THE PROBE BEGAN AND DIDN'T FINISH. The last step it marked: {step}. The Mac went down in that"
            " step, or after it and before the next was marked (a mark that didn't land looks the same)")


def probe_lines(sio, pmp, ans, at):
    """probe=1's record (e1-hook/asc_probe.h): the step it reached and its three bytes. The kernel log, which e1-hook/probe
    saves, has every word in full: this is what's left of it when the log didn't make it back."""
    def bit(v, n, made=None):
        """One step's bit. made: whether the byte says that read was made; None when it can't say, and then a 0 is
        "clear, or not read" (a word is read only while its domain reads actual f)."""
        if made is False:
            return "not read"
        return "SET" if v >> n & 1 else "clear" if made else "clear, or not read (the byte doesn't say which)"

    out = [probe_at_line(at, bool(sio & pmp & ans & PROBE_MARK))]
    final = {"SIO": probe_final("SIO", sio), "PMP": probe_final("PMP", pmp), "ANS": probe_final("ANS", ans)}
    if sio & PROBE_MARK:
        on = bool(sio & 0x40)
        out += [f"0x6005 = 0x{sio:02x}: SIO, bit 1 of its ASC + 0x8000 (0x39bc08000), which B2's op 51 waits for:",
                f"  at prepare, its firmware running: {bit(sio, 0)}",
                f"  after its idle pair, which {'returned 0' if sio & 0x10 else 'FAILED'}: {bit(sio, 1)}",
                "  after RUN was cleared: " + (bit(sio, 2) if sio & 0x10 else "not done, the idle pair having failed")
                + ("" if not sio & 0x10 or sio & 0x20 else " (RUN did NOT read 1 and then 0)"),
                "  after noirq, its parents and SIO_CPU raised again, the state B2's op 51 finds: "
                + (bit(sio, 3, True) if on else "not read, SIO_CPU not reading actual f")]
    else:
        out.append(f"0x6005 = 0x{sio:02x}: SIO's byte didn't land (bit 7 clear): not read")
    if pmp & PROBE_MARK:
        on = bool(pmp & 0x40)
        out += [f"0x6006 = 0x{pmp:02x}: the PMP, bit 1 of its ASC + 0x8000 (0x28ec08000), which B2's op 159 waits for"
                + ("" if on else "; ps_pmp did NOT read actual f for every read after noirq") + ":",
                f"  at prepare, its firmware running: {bit(pmp, 0)}",
                f"  after noirq, before its idle pair: {bit(pmp, 1, True if on else None)}",
                f"  after its idle pair, which {'returned 0' if pmp & 0x10 else 'FAILED'}: {bit(pmp, 2, True if on else None)}",
                "  after RUN was cleared, the state B2's op 159 finds: "
                + (bit(pmp, 3, on) if pmp & 0x20 else "not reached: RUN wasn't cleared (the idle pair failed, the PMP didn't read idle,"
                   " or RUN didn't read 1 and then 0)")]
    else:
        out.append(f"0x6006 = 0x{pmp:02x}: the PMP's byte didn't land (bit 7 clear): not read")
    if ans & PROBE_MARK:
        was_on, raised = bool(ans & 2), bool(ans & 8)
        out += [f"0x6007 = 0x{ans:02x}: ANS, bit 1 of its ASC + 0x8000 (0x38f408000), which B2's op 151 waits for:",
                f"  awake, at the module's load, its firmware running: {bit(ans, 4, bool(ans & 0x20))}",
                f"  at prepare, its firmware shut down by the NVMe driver's suspend, ANS2 still on: {bit(ans, 0)}",
                "  after noirq, " + ("ANS2 still on" if was_on else "ANS2 off, raised as B2's op 149 raises it" if raised else
                                     "ANS2 off, and the raise did NOT reach actual f")
                + ", the state B2's op 151 finds: " + bit(ans, 2, was_on or raised)]
        if not ans & 0x40:
            out.append("  ANS2's target and actual state did NOT read as found within 10 ms of being written back")
    else:
        out.append(f"0x6007 = 0x{ans:02x}: ANS's byte didn't land (bit 7 clear): not read")
    clear = [k for k, v in final.items() if v is False]
    unread = [k for k in ("SIO", "ANS", "PMP") if final.get(k) is None]
    if clear:
        out.append(f"  so: in the state the recipe leaves, bit 1 read CLEAR for {', '.join(clear)}, for 100 ms. That's a lead for where"
                   " B2 stops, not its location: B2 polls later, after its own raise. The next run leaves that coprocessor"
                   " differently and reads the marker"
                   + (f". Not read: {', '.join(unread)}" if unread else ""))
    elif unread:
        out.append("  so: " + ("nothing was read in the state the recipe leaves" if len(unread) == 3 else
                               "bit 1 read set where it was read in the state the recipe leaves")
                   + f"; not read for {', '.join(unread)}: nothing decided for " + ("any of them" if len(unread) == 3 else "those"))
    else:
        out.append("  so: bit 1 read SET for all three in the state the recipe leaves: that makes B2's three coprocessor waits less"
                   " likely to be where the pair stops, and doesn't exclude them (B2 polls later, after its own raises)")
    return out


def fab_lines(v, pre=FAB_PRE):
    """fabric_up=1: 0x6007 from stage 0x52 on (e1-hook/fabric_up.h has the layout). It says what the word read, and leaves
    the ending to the stage and wd2_bite=1's sample. pre: the run's stage before the commit: 0x52, gates_mark=1's 0x4b or sio_down=1's 0x3d."""
    was, took, kept = v >> 2 & 3, bool(v & 0x10), bool(v & 0x20)
    out = [f"0x6007 = 0x{v:02x}: fabric_up=1's byte, in place of the cores that held:"]
    if v & 2:
        # The bad case by design: step 7's byte, which this one replaces, has this bit set whenever CPU1 held.
        return out + ["  bit 1 is set: NOT all seven other cores wrote their stop bit and held; or this is still step 7's byte, the"
                      f" cores that held, where this bit is CPU1's, and stage 0x{pre:02x}'s command didn't put the run's byte in its place."
                      " Either way nothing more is read out of it: no fabric outcome, and no marker in WD1 is taken to stand"]
    out += ["  the other cores: all seven wrote their stop bit and held",
            f"  bit 0 (sio_on=1): ps_sio, UART_P and SPI_P {'all read actual f within 10 ms' if v & 1 else 'did NOT all read actual f within 10 ms'}",
            f"  the fabric's p-state word (0x28e20c000) before CPU0's write: {FAB_WAS[was]}",
            "  after the write of 3 to its low nibble: " + ("it read 0x333, not busy, within 10 ms" if took else "it did NOT read 0x333 within 10 ms")
            + "; at the end of step 5, after the ClkGen park and PLL-off: " + ("0x333" if kept else "NOT 0x333")]
    if not v:
        out.append("  so: 0x00 is also what a byte that didn't land reads, and it would otherwise say that nothing settled and no"
                   " marker stood: not a reading to lean on")
    elif took and kept:
        out.append("  so: the fabric was at 3 when the table went out and still there when step 5 ended, where macOS has it at its"
                   " commit" + (": the kernel had lowered it, and the write brought it back" if was in (1, 2) else
                                ". But it read 0x333 before the write too: this suspend hadn't lowered it, so the write changed nothing"
                                " and the fabric wasn't a difference from macOS in this run" if was == 3 else
                                ". Before the write it read neither 0x333 nor a word asked down to 1, which nothing predicted"))
    elif took:
        out.append("  so: the fabric came back to 3 after the write and was NOT there when step 5 ended: something in the table moved"
                   " it (the ClkGen park or PLL-off, most likely). The engine didn't find it where macOS leaves it")
    elif kept:
        out.append("  so: the fabric didn't read 0x333 within 10 ms of the write but did when step 5 ended: it settled late, and was"
                   " at 3 before the commit")
    else:
        out.append("  so: the fabric did NOT come back to 3, neither within 10 ms of the write nor by step 5's end. The run's one"
                   " change didn't take, and the ending says nothing about a fabric at 3")
    w = v & WD1_STANDS
    if w == WD1_STANDS:
        out.append(f"  bits 7:6 (wd1_mark=1): WD1 stood as the marker just before the commit: armed, its bite {WD1_BITE_S} s, its count"
                   f" past {wd1_count_s(pre)} s and running. The restart's time is read against it below, as far as the stage and"
                   " wd2_bite=1's sample bear a reading out")
    elif w:
        out.append("  bits 7:6 (wd1_mark=1): the marker did NOT stand just before the commit: "
                   + (f"WD1 was armed with its {WD1_BITE_S} s bite, but its count didn't read past {wd1_count_s(pre)} s, by up to 5 s: the"
                      " count write didn't take, or the count isn't running" if w == 0x40 else
                      f"WD1's count read past {wd1_count_s(pre)} s, by up to 5 s, but it wasn't armed with the {WD1_BITE_S} s bite")
                   + ". The restart's time says nothing about B2, and a time that isn't WD2's may be WD1's")
    else:
        out.append("  bits 7:6 (wd1_mark=1): clear: no marker in WD1 stands in this record. In a run without wd1_mark=1 (the reading's"
                   " label and the load log say which this was) the restart's time is read against WD2 alone. In one with it, the"
                   " marker read back wrong in both respects, WD1 may still be armed some other way, and a time that isn't WD2's"
                   " may be WD1's")
    out.append("  (how the run ended is the stage's and wd2_bite=1's sample's to say; PLAN.md has how an ending reads with this)")
    return out


def fab_landed(b):
    """fabric_up=1: is 0x6007 the run's byte? Step 7 leaves the cores that held there (0xff as a rule), and stage 0x52's command
    puts the byte in its place, last of four. The steps' outcomes at 0x6012 go out right after that command and only if it
    didn't fail, so their marker at 0x6013 says the command landed whole. Without it the byte may still be step 7's."""
    return b[0x13] == K_MARK or b[0x13] & W_MARK in (W_MARK, ATC_MARK) or pwn(b[0x13])


def mark_reading(x, s, v):
    """wd1_mark=1, the marker standing: what a restart x s after the commit (to a second either way) says, at stage s with
    wd2_bite=1's sample v (0x6005). The time names no watchdog by itself: each reading is the one that fits, and it's given
    only where the stage and the sample bear it out."""
    head = "  wd1_mark=1's marker: "
    unzeroed = WD1_BITE_S - wd1_count_s(s)
    if s in PRE_STAGES:
        return (f"{head}not read. Stage 0x{s:02x} is the last before the commit: nothing here records the commit, the release or WD2 after"
                f" it, so {x:.0f} s can't be read as B2's progress. WD1 has been armed since step 4, so a run that stopped anywhere"
                f" from there on restarts by itself about {unzeroed} s later, committed or not")
    if s in WD2_PEND:
        return (f"{head}not read. CPU0 had an exception pending after its reads (the stage) and likely never went down, and a core"
                f" left up holds the engine by itself: {x:.0f} s says nothing about a pair with every core down")
    code = v >> 6
    # live: WD2 seen armed, still armed after CPU0's write and counting, so that it fires unless something stops it. 0xfe is
    # the parked cores, which stage 0x52 leaves in this byte: not a sample.
    live = bool(v & 4 and v & 0x10 and v & 0x20 and v != 0xfe)
    moved = bool(live and v & 8)
    if abs(x - unzeroed) <= 4:
        return (f"{head}about {unzeroed} s is what WD1 gives with its count never zeroed: B2 didn't reach its op 224, and the stall is"
                " at B2's first poll, in the first handshake (A2's three steps of its own) or in B2's power-down. That's the"
                " reading that fits with nothing else assumed, not a proof of which watchdog fired"
                + (": a pair that finished, with a later A sequence starting about 60 s after the commit and arming WD2 with its own"
                   " 30 s, gives the same time" if unzeroed == 90 else
                   f". The marker was set to {unzeroed} s in this run where the earlier runs had 90 s: a restart that moved with it is"
                   " WD1's, which the 90 s alone couldn't say"))
    if abs(x - WD2_BITE_S) <= 4:
        if not moved:
            return (f"{head}about {WD2_BITE_S} s, but wd2_bite=1's sample, above, doesn't show WD2 armed and counting with CPU0's"
                    f" {WD2_BITE_S} s bite, so this record doesn't make the time WD2's. Not read as B2's progress")
        if code not in (1, 2):
            return (f"{head}about {WD2_BITE_S} s is WD2's moved bite, but PHASE didn't read 4 or 5, A2's before its last, in the sample"
                    " above: a later A sequence may have armed WD2, after a pair that finished. Not read as B2 stopping in its last ops")
        return (f"{head}about {WD2_BITE_S} s is WD2: B2 zeroed WD1's count, so B2's first poll passed, A2's three steps settled and"
                " B2's power-down ran; the pair then stopped in its last twenty-odd ops (the second handshake, the PMU command, the"
                " third handshake). One other reading isn't excluded by this run alone: a WD1 that can't reset the SoC in this"
                " state, which a run with WD1's bite below WD2's would show")
    if x >= WD1_BITE_S - 4:
        # WD1's bite counts from B2's zeroing, which comes however long B2's power-down takes after the commit.
        late = f", which then came about {x - WD1_BITE_S:.0f} s after the commit" if x > WD1_BITE_S + 4 else ""
        if not live:
            return (f"{head}{x:.0f} s is WD1's {WD1_BITE_S} s from a count that B2 zeroed{late}, but wd2_bite=1's sample, above,"
                    " doesn't show WD2 armed and counting: a WD2 that wouldn't have fired anyway says nothing by staying silent."
                    " Not read as a pair that finished")
        return (f"{head}{x:.0f} s is WD1's {WD1_BITE_S} s from a count that B2 zeroed{late}, with WD2, which the sample above saw"
                " armed and counting, stopped before it could fire: the entry pair FINISHED, and WD1 ended it as a dead-man")
    if s in LL_STAGES and x < unzeroed - 4:
        # Naeem Malik's M1 restarts about 5 s after an entry that got through its gates, not by a watchdog (RESEARCH.md,
        # "After the review"): an early restart is an ending of its own here, not a marker's.
        wake = (f" The alarm was set {LL_ALARM_SECS} s after the commit's second and CPU0's timer {LL_TIMER_S} s after its last"
                " step: a restart near the first is what an SoC that slept and woke through the boot loader would give" if s in LLW_STAGES else "")
        return (f"{head}{x:.0f} s is well before the marker's {unzeroed} s: NOT WD1's marker and not WD2's {WD2_BITE_S} s. Something"
                " else restarted the SoC first, which no run here has shown before. The PMU's 0x0201, below, says whether B2"
                f" reached its PMU command.{wake}")
    return (f"{head}{x:.0f} s is none of its times (about {unzeroed} s, about {WD2_BITE_S} s, {WD1_BITE_S} s or more): not read. Right"
            " only in the first boot after the run, like the time itself")


# gates_mark=1: the six gate words by their bit in its byte, gates_mark.h's order (look.h's), then bit 6, the fabric lane, and
# bit 7, always set.
GATE_WORDS = ("0x28e5a0050", "0x28e5a0064", "0x28e5a030c", "0x28e09c310", "0x28e09c338", "0x28e09c34c")
GATES_LANE, GATES_MARK = 0x40, 0x80


LL_T = ("under 10 ms", "10 to 100 ms", "0.1 to 1 s", "1 to 5 s", "5 to 15 s", "15 to 22 s", "22 to 30 s", "30 s or more")  # last_look.h's LL_T_MS
LL_COUNT = (None, "once", "twice or more, under a hundred times", "a hundred times or more")
LL_PCIE = ("APCIE_ST_SYS", "APCIE_ST1_SYS", "APCIE_GP_SYS", "APCIE_ST", "APCIE_GP")  # pcie_down.h's order


def og_record(s, r):
    """Whether 0x6008-0x600e hold obs_gate=1's record, or K1's mark for it: never under one of last_look=1's stages."""
    return s not in LL_STAGES and (r[0] == OG_ARMED or (s in OG_STAGES and bool(r[0] & OG_MARK)))


def wa_record(s, r):
    """Whether 0x6008-0x600e hold wake_all=1's byte, or K1's mark for it. The mark: under any stage that is neither last_look=1's
    nor one of an observer's own (wa_lines() says which of those stages such a run can be at). The byte: only under a stage
    of the gates_mark=1 family, the runs wake_all=1 loads with, or under step 7's own stage, which is what the record keeps
    if the byte lands and nothing after it does."""
    return (s not in LL_STAGES and s not in OG_STAGES and r[0] == WA_ARMED) or ((s in WA_STAGES or s == WA_STEP7) and r[0] & WA_MARK == WA_MARK)


def sp_record(s, r):
    """Whether 0x6009 holds sep_pg=1's byte, or K1's mark for it, by the rules wa_record() has for 0x6008. The mark: under any
    stage that is neither last_look=1's nor one of an observer's own (sp_lines() says which of those stages such a run can
    be at). The byte: only under a stage of the gates_mark=1 family, the runs sep_pg=1 loads with, or under step 7's own."""
    return (s not in LL_STAGES and s not in OG_STAGES and r[1] == SP_ARMED) or ((s in WA_STAGES or s == WA_STEP7) and bool(r[1] & SP_MARK))


def sro_record(s, r):
    """Whether 0x6008 holds sep_ro=1's byte, or K1's mark for it, by the rules sp_record() has for 0x6009: the mark under any
    stage that is neither last_look=1's nor one of an observer's own; the byte, bit 7 with bits 6:4 clear, only under a stage
    of the gates_mark=1 family or step 7's own. Never wake_all=1's byte, whose bits 7:6 are both set, nor its mark."""
    return (s not in LL_STAGES and s not in OG_STAGES and r[0] == SRO_ARMED) or ((s in WA_STAGES or s == WA_STEP7) and r[0] & 0xf0 == SRO_MARK)


def dh_record(s, r):
    """Whether 0x600a-0x600d hold disp_hs=1's four bytes, or K1's mark for them (0x01 and three zeros). The mark: under any
    stage that is neither last_look=1's nor one of an observer's own (dh_lines() says which of those stages such a run can
    be at). The four bytes: only under a stage the run can be at once K3b has sent them, DH_STAGES."""
    return (s not in LL_STAGES and s not in OG_STAGES and r[2:6] == bytes((DH_ARMED, 0, 0, 0))) or (s in DH_STAGES and bool(r[2] & DH_MARK))


def dh_form(d):
    """Whether four bytes are a record as e1_hook makes it (last_look.h's dh_b0() to dh_b3()): the first and the third with
    bit 7 set and bit 4 clear; the third's nibble 0 without dispext0's set-up flag; the fourth bit 7 and a nibble, 0 without
    disp0's flag, or 0x00 whole: a byte that didn't outlast the restart, as bytes at 0x600d have not before."""
    return (d[0] & 0x90 == DH_MARK and d[2] & 0x90 == DH_MARK and (d[2] & DH_EXT or not d[2] & 0xf)
            and (not d[3] or (d[3] & 0xf0 == DH_MARK and (d[2] & DH_INT or not d[3] & 0xf))))


def fam_record(s, r):
    """Whether 0x6008-0x600e hold what a run of the gates_mark=1 family leaves there: wake_all=1's byte or mark at 0x6008, or
    sep_ro=1's there in its place, sep_pg=1's at 0x6009, disp_hs=1's four bytes or mark at 0x600a, or any of them together.
    The fields are apart, and each is told by itself."""
    return wa_record(s, r) or sro_record(s, r) or sp_record(s, r) or dh_record(s, r)


def fam_parts(s, r):
    """0x6008-0x600e field by field, for a run of that family: whether 0x6008 is wake_all=1's as e1_hook writes it (its byte
    with bit 3 clear, or K1's mark) or sep_ro=1's (its byte or K1's mark), 0x6009 sep_pg=1's and 0x600a-0x600d disp_hs=1's
    (four bytes of its form, dh_form(), or K1's mark); and, by field, what holds something a run of the family can't have left
    there, as text."""
    wa, sp = (wa_record(s, r) and not r[0] & 0x08) or sro_record(s, r), sp_record(s, r)
    dh = dh_record(s, r) and (r[2] == DH_ARMED or dh_form(r[2:6]))
    other = {}
    if r[0] and not wa:
        other["wa"] = f"0x6008 = 0x{r[0]:02x}"
    if r[1] and not sp:
        other["sp"] = f"0x6009 = 0x{r[1]:02x}"
    if any(r[2:6]) and not dh:
        other["dh"] = f"0x600a-0x600d = {r[2:6].hex(' ')}"
    if r[6]:
        other["rest"] = f"0x600e = 0x{r[6]:02x}"
    return wa, sp, dh, other


def fam_clear(s, r):
    """Whether --clear may take 0x6008-0x600e for such a run's and zero them: at least one of the three fields is its
    option's (fam_parts()), each of the others is its option's too or 0, and 0x600e is 0, which such a run never
    writes. One field by itself doesn't vouch for what is in the others."""
    wa, sp, dh, other = fam_parts(s, r)
    return (wa or sp or dh) and not other


def wa_lines(s, r, others=None):
    """wake_all=1: 0x6008, what CPU0 read in step 7 right after it wrote 0xffffffff to all seven AP wake-mask words, sent
    after step 8's record (e1-hook/last_look.h has the byte). Fields as read, each named; what they say about the stall is
    PLAN.md's to say. others: None if no other option's bytes are there: 0x6009-0x600e are then what this run never writes,
    as before those options. Otherwise the fields beside this byte that hold something no run of the family leaves
    (fam_parts()), as text."""
    b0 = r[0]
    if others is None:
        junk, alone = ([f"0x6009-0x600e = {r[1:].hex(' ')}"] if any(r[1:]) else []), "this run sends 0x6008 alone"
    else:
        junk, alone = others, "a run sends its options' bytes alone"
    if b0 == WA_ARMED and s not in WA_EARLY and s not in WA_STAGES:
        # K1 zeroes these bytes in every run, so a mark under another run's stage can only have been left before that K1 existed,
        # or isn't e1_hook's. Whichever: not this stage's run's.
        return [f"0x6008-0x600e = {r.hex(' ')}: K1's mark for wake_all=1 (0x{WA_ARMED:02x} at 0x6008), under a stage no such run is at:",
                f"  NOT READ: stage 0x{s:02x} isn't this mark's run's. A wake_all=1 run is at one of K1's to step 7's stages before its byte"
                " goes out and at one of the gates_mark=1 family's after it: the mark was left by an earlier run"]
    out = [f"0x6008-0x600e = {r.hex(' ')}: wake_all=1's record: step 7 writes 0xffffffff to all seven AP wake-mask words"
           " (0x292004008-0x292004020) and reads them back and the seven words after them, and step 8 sends the byte after its own"
           " record:"]
    if b0 == WA_ARMED:
        # A command that fails stops every later one (m1_crumb()), and the family's stages are all sent after the byte.
        if s in WA_STAGES:
            how = (f"Stage 0x{s:02x} is a later command's, and a command that fails stops every later one: the byte's command was acked"
                   " and the byte didn't land")
        else:
            how = (f"Stage 0x{s:02x} is as far as the record goes: the run stopped before the byte's command, or that command failed,"
                   " which stops every later one")
            if s == WA_STEP7:
                how += (". Step 7's reads of the masks and the status words come between this stage and the byte: a read that faulted"
                        " there panics, and the Mac restarts about 10 s later")
        return out + [f"  0x6008 = 0x{b0:02x}: wake_all=1 was set and its byte never landed: K1 writes this, and the byte's command, after"
                      f" step 8's record, writes over it. {how}"
                      + (f"; {' and '.join(junk)} are not what e1_hook writes: NOT READ" if junk else "")]
    if junk:
        return out + [f"  {' and '.join(junk)}: not what e1_hook writes (K1 zeroes them, and {alone}): NOT READ"]
    if b0 & 0x08:
        return out + [f"  0x6008 = 0x{b0:02x}: not what e1_hook writes (its bit 3 is never set): NOT READ"]
    n = b0 & 7
    if s == WA_STEP7:
        out.append(f"  the stage, 0x{s:02x}, is step 7's own, still the stage when the byte goes out: this byte landed and no later command did")
    return out + [
        f"  0x6008 = 0x{b0:02x}, bit 5: the masks read back "
        + ("0xffffffff in words 0 to 5 and all set in word 6's low 13 bits: every source with a name is masked" if b0 & WA_NAMED else
           "NOT all 0xffffffff in words 0 to 5 and all set in word 6's low 13 bits: a source with a name isn't shown masked (which isn't recorded)"),
        "  bit 4: the ids with no name (0xcd to 0xdf, word 6's bits 31:13) "
        + ("took the mask: they read back all set" if b0 & WA_UNNAMED else
           "did NOT all read back set: macOS's value leaves them clear, and whether they exist isn't known"),
        "  bits 2:0: " + (f"{n} of the seven words inferred to be the AP's wake status read non-zero after the masks: which isn't recorded" if n else
                          "none of the seven words inferred to be the AP's wake status read non-zero after the masks")]


def sro_lines(s, r, nearby):
    """sep_ro=1: 0x6008, 0x2922c0044's low nibble as CPU0 read it in step 7 right before sep_pg=1's write decision, sent after
    step 8's record and before sep_pg=1's byte (e1-hook/last_look.h has the byte). The sample as read; sp_lines() sets it
    nearby the one after the read-back. nearby: the fields nearby this byte that hold something no run of the family
    leaves (fam_parts()), as text."""
    b0 = r[0]
    if b0 == SRO_ARMED and s not in WA_EARLY and s not in WA_STAGES:
        # As for the other marks: K1 zeroes these bytes in every run, so this one isn't this stage's run's.
        return [f"0x6008-0x600e = {r.hex(' ')}: K1's mark for sep_ro=1 (0x{SRO_ARMED:02x} at 0x6008), under a stage no such run is at:",
                f"  NOT READ: stage 0x{s:02x} isn't this mark's run's. A sep_ro=1 run is at one of K1's to step 7's stages before its byte"
                " goes out and at one of the gates_mark=1 family's after it: the mark was left by an earlier run"]
    out = [f"0x6008-0x600e = {r.hex(' ')}: sep_ro=1's record: a sep_pg=1 run made with the SEP's driver loaded, its store read-only. Step 7"
           " reads 0x2922c0044 right before it decides whether to write the PMGR control word, and step 8 sends that nibble after its"
           " own record and before sep_pg=1's byte:"]
    if b0 == SRO_ARMED:
        # A command that fails stops every later one (m1_crumb()), and the family's stages are all sent after the byte.
        if s in WA_STAGES:
            how = (f"Stage 0x{s:02x} is a later command's, and a command that fails stops every later one: the byte's command was acked"
                   " and the byte didn't land")
        else:
            how = (f"Stage 0x{s:02x} is as far as the record goes: the run stopped before the byte's command, or that command failed,"
                   " which stops every later one")
        return out + [f"  0x6008 = 0x{b0:02x}: sep_ro=1 was set and its byte never landed: K1 writes this, and the byte's command, after"
                      f" step 8's record, writes over it. {how}"
                      + (f"; {' and '.join(nearby)}: not what e1_hook writes in such a run: NOT READ" if nearby else "")]
    if nearby:
        return out + [f"  {' and '.join(nearby)}: not what e1_hook writes in such a run (K1 zeroes the seven, and a run sends its options' bytes"
                      " alone): NOT READ"]
    if s == WA_STEP7:
        out.append(f"  the stage, 0x{s:02x}, is step 7's own, still the stage when the byte goes out: this byte landed and no later command did")
    n = b0 & 0xf
    return out + [f"  0x6008 = 0x{b0:02x}, bits 3:0: 0x2922c0044's low nibble read 0x{n:x} in step 7 right before the write decision, with CPU0 up"
                  f" and interrupts off. Bit 2 (the engine's first poll) {'set' if n & 4 else 'clear'}; bit 3"
                  f" {'set, as it reads awake' if n & 8 else 'clear (awake it reads set)'}"]


def sp_lines(s, r, beside, pre=None):
    """sep_pg=1: 0x6009, what CPU0 read in step 7 around its one write to the PMGR control word 0x28e0cc200, sent after step
    8's record and after wake_all=1's byte (e1-hook/last_look.h has the byte). Fields as read, each named; what they say
    about the stall is PLAN.md's to say. beside: the fields beside this byte that hold something no run of the family
    leaves (fam_parts()), as text. pre: None, or 0x6008 if it is sep_ro=1's (its byte or K1's mark): the same word's sample
    from right before the write decision, set beside this byte's, from right after the read-back. One thing is concluded
    from the two, and only if both landed, the write was made and the clear read back. A write that wasn't made, or isn't
    shown to have taken, is said to be no test of the wait bit."""
    b1 = r[1]
    if b1 == SP_ARMED and s not in WA_EARLY and s not in WA_STAGES:
        # As for wake_all=1's mark: K1 zeroes these bytes in every run, so this one isn't this stage's run's.
        return [f"0x6008-0x600e = {r.hex(' ')}: K1's mark for sep_pg=1 (0x{SP_ARMED:02x} at 0x6009), under a stage no such run is at:",
                f"  NOT READ: stage 0x{s:02x} isn't this mark's run's. A sep_pg=1 run is at one of K1's to step 7's stages before its byte"
                " goes out and at one of the gates_mark=1 family's after it: the mark was left by an earlier run"]
    out = [f"0x6008-0x600e = {r.hex(' ')}: sep_pg=1's record: step 7 reads the PMGR control word 0x28e0cc200 and the SEP's power word"
           " (0x28e580c00), writes the control word back with bit 2 clear (the bit that makes the S2R sequencer wait for the SEP to"
           " power-gate) if that bit is set and the SEP's power word reads off, and reads it again, then 0x2922c0044, and step 8 sends"
           " the byte after its own record:"]
    if b1 == SP_ARMED:
        # A command that fails stops every later one (m1_crumb()), and the family's stages are all sent after the byte.
        if s in WA_STAGES:
            how = (f"Stage 0x{s:02x} is a later command's, and a command that fails stops every later one: the byte's command was acked"
                   " and the byte didn't land")
        else:
            how = (f"Stage 0x{s:02x} is as far as the record goes: the run stopped before the byte's command, or that command failed,"
                   " which stops every later one")
            if s == WA_STEP7:
                how += (". Step 7's reads of the control word, the SEP's power word and 0x2922c0044 and its write to the control word"
                        " come between this stage and the byte: an access that faulted there panics, and the Mac restarts about 10 s later")
        return out + [f"  0x6009 = 0x{b1:02x}: sep_pg=1 was set and its byte never landed: K1 writes this, and the byte's command, after"
                      f" step 8's record, writes over it. {how}"
                      + (f"; {' and '.join(beside)}: not what e1_hook writes in such a run: NOT READ" if beside else "")]
    if beside:
        return out + [f"  {' and '.join(beside)}: not what e1_hook writes in such a run (K1 zeroes the seven, and a run sends its options' bytes"
                      " alone): NOT READ"]
    if s == WA_STEP7:
        out.append(f"  the stage, 0x{s:02x}, is step 7's own, still the stage when the byte goes out: this byte landed and no later command did")
    found, off, clear, n = bool(b1 & SP_FOUND), bool(b1 & SP_SEP_OFF), bool(b1 & SP_CLEAR), b1 & 0xf
    if found and off:
        did = "was set as found, and the SEP's power word read off: step 7 wrote the word back with it clear"
        back = ("read again after the write, the control word had bit 2 clear and every other bit as found" if clear else
                "read again after the write, the control word had NOT bit 2 clear and every other bit as found: the write isn't shown to have taken")
    elif found:
        # Never cleared while the enclave reads powered (last_look.h's sp_writes()).
        did = "was set as found, and the SEP's power word read powered: the write was not made"
        back = ("read again, with no write made, the control word had bit 2 clear and every other bit as found: it changed with no write of"
                " this run's between the two reads" if clear else
                "read again, with no write made, the control word had a value other than the word as found less bit 2: unchanged, "
                "as it should be with no write, or changed some other way (the byte can't tell which)")
    else:
        did = "was already clear as found: step 7 wrote nothing"
        back = ("read again, the control word had every bit as found, bit 2 clear" if clear else
                "read again, the control word had NOT every bit as found: it changed between two reads with no write of this run's between them")
    out += [
        f"  0x6009 = 0x{b1:02x}, bit 6: the control word's bit 2 {did}",
        f"  bit 5: {back}",
        "  bit 4: the SEP's power word, read before any write, had " + ("actual state 0 (its bits 7:4)" if off else
                                                                         "an actual state that is NOT 0 (its bits 7:4): the enclave read powered"),
        f"  bits 3:0: 0x2922c0044's low nibble read 0x{n:x} in step 7, with CPU0 up: the last sample of that word before the commit. Bit 2 (the"
        f" engine's first poll) {'set' if n & 4 else 'clear'}; bit 3 {'set, as it reads awake' if n & 8 else 'clear (awake it reads set)'}"]
    # What the run can't be taken for: a clear that was skipped, or one that isn't shown to have taken, tests nothing.
    if found and not off:
        out.append("  so: the wait bit was LEFT as it was, since the enclave read powered: this run is no test of the wait bit, and says"
                   " nothing about it")
    elif found and not clear:
        out.append("  so: the write was made and the bit isn't shown clear after it: this run is no test of the wait bit, and says nothing"
                   " about it")
    if pre is None:
        return out
    if pre == SRO_ARMED:
        return out + [f"  sep_ro=1's sample of 0x2922c0044 from before the write decision didn't land (0x6008 still has K1's mark, 0x{SRO_ARMED:02x}):"
                      " the one sample here is the one after the read-back, and nothing is concluded from it"]
    p = pre & 0xf
    out.append(f"  0x2922c0044 on either side of the write decision, both samples in step 7's one interrupts-off stretch: 0x{p:x} right before it"
               f" (0x6008), bit 2 {'set' if p & 4 else 'clear'}; 0x{n:x} right after the control word's read-back (0x6009), bit 2"
               f" {'set' if n & 4 else 'clear'}")
    if found and off and clear and not p & 4 and n & 4:
        out.append("  bit 2 clear before the write and set after it")
    return out


def dh_lines(s, r, around, step7=None, pre7=None):
    """disp_hs=1: 0x600a-0x600d, which set-up tables K3b wrote and which handshakes it made on the two displays' fabric blocks,
    and what 0x2922c0044's low nibble read before it, right after each table and after each DCP's place in its loop
    (e1-hook/last_look.h has the bytes). Fields as read, each named; the samples in the order they were taken, and in which
    of them bit 2 first read set: no more than that, since no sample says which write moved the bit or how long it stayed.
    around: the fields beside these four bytes that hold something no run of the family leaves (fam_parts()), as text.
    step7: the same word's nibble in sep_pg=1's byte, if that byte is there to read: one more sample, the last. pre7: the
    one in sep_ro=1's byte, if that is there to read: the sample before it, from right before step 7's write decision."""
    d = r[2:6]
    mark = d == bytes((DH_ARMED, 0, 0, 0))
    if mark and s not in DH_BEFORE and s not in DH_STAGES:
        # As for the other two marks: K1 zeroes these bytes in every run, so this one isn't this stage's run's.
        return [f"0x6008-0x600e = {r.hex(' ')}: K1's mark for disp_hs=1 (0x{DH_ARMED:02x} at 0x600a), under a stage no such run is at:",
                f"  NOT READ: stage 0x{s:02x} isn't this mark's run's. A disp_hs=1 run is at K1's or K3's stage before K3b sends its four bytes"
                " and at K3b's, a later step's or one of the gates_mark=1 family's after it: the mark was left by an earlier run"]
    out = [f"0x6008-0x600e = {r.hex(' ')}: disp_hs=1's record: K3b, for each DCP that stopped, writes the reference's set-up table to the"
           " display's fabric block if its FE power word reads powered, lowers its CPU0 word, makes the handshake on the block (+0x8014 := 1,"
           " +0x82bc := 1, 2, 4) if the FE word still reads powered, and lowers the FE word; it reads 0x2922c0044 before, after each table"
           " and after each DCP, and sends four bytes before its own stage:"]
    if mark:
        if s in DH_BEFORE:
            how = (f"Stage 0x{s:02x} is as far as the record goes: the run stopped before K3b's command for the four bytes, or that command"
                   " failed and K3b's own stage after it didn't land either")
            if s == DH_K3:
                how += (". K3b's writes to the two fabric blocks come between this stage and the bytes, with no watchdog armed and the"
                        " keyboard's light not yet on: a write to a block that had lost its power faults there and the kernel panics, and"
                        " one that stalls, or a panic whose restart fails, leaves the Mac dark with no light ever having blinked")
        else:
            # K3b sends them through the kernel's path, where a command that fails doesn't stop the ones after it.
            how = (f"Stage 0x{s:02x} is K3b's own or a later one, so K3b ran to its end: its command for the four bytes, through the kernel's"
                   " path, failed or didn't land, and a failure there doesn't stop the commands after it")
        return out + [f"  0x600a = 0x{d[0]:02x}: disp_hs=1 was set and its four bytes never landed: K1 writes this, and K3b's command writes over"
                      f" it. {how}"
                      + (f"; {' and '.join(around)}: not what e1_hook writes in such a run: NOT READ" if around else "")]
    if around:
        return out + [f"  {' and '.join(around)}: not what e1_hook writes in such a run (K1 zeroes the seven, and a run sends its options' bytes"
                      " alone): these four bytes are NOT READ"]
    if not dh_form(d):
        return out + [f"  0x600a-0x600d = {d.hex(' ')}: not what e1_hook writes (the first and the third byte have bit 7 and never bit 4; the"
                      " fourth is bit 7 and a nibble, or 0x00 if it was lost; a nibble is 0 without its table's flag): NOT READ"]
    if s == DH_K3:
        out.append(f"  the stage, 0x{s:02x}, is K3's, still the stage when the four bytes go out: they landed and K3b's own stage didn't")
    no_shake = ("was NOT made: its DCP didn't stop, its CPU0 word didn't read off, or its FE word didn't read powered then (which isn't"
                " recorded). Its block may still have been written: the set-up flag says")
    no_table = "was NOT written: its DCP didn't stop, or its FE word didn't read powered then (which isn't recorded)"
    out += [f"  0x600a = 0x{d[0]:02x}, bit 5: disp0's handshake (the internal display's block, 0x38c000000) " + ("was made" if d[0] & DH_INT else no_shake),
            "  bit 6: dispext0's handshake (the external's block, 0x28a000000) " + ("was made" if d[0] & DH_EXT else no_shake),
            f"  0x600c = 0x{d[2]:02x}, bit 5: disp0's set-up table (65 writes, the handshake's own four among them) " + ("was written" if d[2] & DH_INT else no_table),
            "  bit 6: dispext0's set-up table " + ("was written" if d[2] & DH_EXT else no_table)]
    # The samples of the gate word, in the order K3b took them: (where, where it is kept, the nibble or why there is none).
    samples = [("at K3b's start", "0x600a bits 3:0", d[0] & 0xf),
               ("after disp0's set-up table", "0x600d bits 3:0",
                "no sample: the table wasn't written" if not d[2] & DH_INT else
                "not kept: 0x600d reads 0x00, and bytes there have been lost across a restart before" if not d[3] else d[3] & 0xf),
               ("after disp0's place in K3b's loop, the first", "0x600b bits 3:0", d[1] & 0xf),
               ("after dispext0's set-up table", "0x600c bits 3:0", d[2] & 0xf if d[2] & DH_EXT else "no sample: the table wasn't written"),
               ("after dispext0's place, the second", "0x600b bits 7:4", d[1] >> 4)]
    if pre7 is not None:
        samples.append(("in step 7, right before sep_pg=1's write decision", "sep_ro=1's byte, 0x6008 bits 3:0", pre7))
    if step7 is not None:
        samples.append(("in step 7, the last before the commit", "sep_pg=1's byte, 0x6009 bits 3:0", step7))
    out.append("  0x2922c0044's low nibble, sample by sample in the order they were taken (bit 2 is the engine's first poll):")
    for where, at, v in samples:
        out.append(f"    {where} ({at}): " + (f"0x{v:x}, bit 2 {'set' if v & 4 else 'clear'}" if isinstance(v, int) else v))
    first = next((where for where, _, v in samples if isinstance(v, int) and v & 4), None)
    return out + [f"  the first of these samples in which bit 2 read set: {first}" if first else "  bit 2 read set in none of these samples"]


def fam_lines(s, r):
    """0x6008-0x600e after a run of the gates_mark=1 family: wake_all=1's byte or mark at 0x6008, or sep_ro=1's in its place,
    sep_pg=1's at 0x6009, disp_hs=1's four bytes or mark at 0x600a, each read by itself (wa_lines(), sro_lines(), sp_lines(),
    dh_lines()) and none read if another field holds what no such run leaves. Without sep_ro=1's, sep_pg=1's and disp_hs=1's,
    the reading is wake_all=1's as it was before those options, 0x6009-0x600e the six bytes such a run never writes."""
    wa, sro, sp, dh = wa_record(s, r), sro_record(s, r), sp_record(s, r), dh_record(s, r)
    if not sro and not sp and not dh:
        return wa_lines(s, r)
    other = fam_parts(s, r)[3]
    # sep_pg=1's byte has one more sample of the word disp_hs=1's record samples, if it landed and is read; sep_ro=1's another.
    step7 = r[1] & 0xf if sp and r[1] & SP_MARK and not other else None
    pre7 = r[0] & 0xf if sro and r[0] != SRO_ARMED and not other else None
    return ((wa_lines(s, r, [v for k, v in other.items() if k != "wa"]) if wa else [])
            + (sro_lines(s, r, [v for k, v in other.items() if k != "wa"]) if sro else [])
            + (sp_lines(s, r, [v for k, v in other.items() if k != "sp"], r[0] if sro else None) if sp else [])
            + (dh_lines(s, r, [v for k, v in other.items() if k != "dh"], step7, pre7) if dh else []))


def og_clus_lines(r, words):
    """obs_gate=1's second form (last_look.h): EACC's and PACC0's soc-cluster words and the E complex's and P complex 0's state
    words, read by CPU7 with CPU0 and its complex gone. Fields as read; what they add up to is PLAN.md's to say."""
    def state(v):
        return f"0x{v:02x}, {OG_ST.get(v, 'not a value either sequence writes')}; bit 5 {'set' if v & 0x20 else 'clear'}"

    def acc(v):
        return (f"target 0x{v & 0xf:x}, bit 4 {'set' if v & 0x10 else 'clear'} (a change asked for and not finished), bit 5"
                f" {'set' if v & 0x20 else 'clear'} (the up-done flag), bit 6 {'set' if v & 0x40 else 'clear'} (what a down sequence waits for first,"
                " with no timeout)")

    if not r[1] & OG_MARK:
        return [f"  0x6008 0x6009 = {r[0]:02x} {r[1]:02x}: the first command didn't land whole (bit 7 of 0x6009, its last byte): neither is"
                " read, and nothing after them"]
    out = [f"  0x6008 = 0x{r[0]:02x}: the power words, read right before the words below: {words(r[0])}",
           f"  0x6009 = 0x{r[1]:02x}: EACC's soc-cluster word (0x28e098000), bits 6:0 = 0x{r[1] & 0x7f:02x}: {acc(r[1])}. Awake it reads 0x0f"]
    if r[6] & OG_MARK:
        out += [f"  0x600d = 0x{r[5]:02x}: the E complex's state word (0x28e09a000), low byte, right then: {state(r[5])}",
                f"  0x600e = 0x{r[6]:02x}: with it: PACC0's soc-cluster word, bits 6:4 = {r[6] >> 4 & 7:03b}; 0x2922c0044's low nibble = {r[6] & 0xf:04b}"]
    else:
        out.append(f"  0x600d 0x600e = {r[5]:02x} {r[6]:02x}: the second command, the E complex's state word right then, didn't land whole or didn't"
                   " outlast the restart (bit 7 of 0x600e): not read. These two bytes were lost in both earlier runs that wrote them")
    if not r[4] & OG_MARK:
        return out + [f"  0x600a-0x600c = {r[2:5].hex(' ')}: the third command, {OG_LATER_MS} ms on, didn't land whole (bit 7 of 0x600c, its last byte): the"
                      " state words as they were then aren't read here. Whether a read of them hung or a command failed isn't shown"]
    same = "the same value" if r[2] == r[3] else "NOT the same value"
    return out + [f"  0x600a = 0x{r[2]:02x}: the E complex's state word {OG_LATER_MS} ms later: {state(r[2])}",
                  f"  0x600b = 0x{r[3]:02x}: P complex 0's (0x28e09a004) then, the complex that reads off, to compare: {state(r[3])}. {same} as the E"
                  " complex's",
                  f"  0x600c = 0x{r[4]:02x}: then: EACC's bits 6:4 = {r[4] >> 3 & 7:03b} (at first {r[1] >> 4 & 7:03b}); 0x2922c0044's bits 2:0 ="
                  f" {r[4] & 7:03b} (bit 2, B2's first poll, {'SET' if r[4] & 4 else 'clear'}; the first form's run read 001 in this state)"
                  + ("; ONE OF THE FOUR WORDS HAS A BIT ABOVE WHAT ITS BYTE CARRIES (bit 6): the bytes aren't the whole words" if r[4] & 0x40 else "")]


def og_lines(s, r):
    """obs_gate=1: 0x6008-0x600e, what CPU7, the observer, read of the engine's gate words and the four CPU power words after its
    polls of CPU0's and the E complex's (e1-hook/last_look.h has the bytes). Fields as read, each named."""
    def words(v):
        return ", ".join(f"{n} {'off' if v >> i & 1 else 'on'}" for i, n in enumerate(OG_WORDS))

    def gate44(v):
        return (f"bit 0 {'set' if v & 1 else 'clear'}, bit 1 {'set' if v & 2 else 'clear'}, bit 2 {'set' if v & 4 else 'clear'} (B2's first poll,"
                f" op 1, waits for it set), bit 3 {'set' if v & 8 else 'clear'} (op 3 waits for it clear)")

    b0 = r[0]
    clus = b0 != OG_ARMED and b0 & 0x70 == OG_CLUS
    out = [f"0x6008-0x600e = {r.hex(' ')}: obs_gate=1's record: "
           + ("the complexes' own words" if clus else "the engine's gate words") + " read by CPU7, the observer, after its polls of"
           " CPU0's and the E complex's power words:"]
    if b0 == OG_ARMED:
        # Every observer's run zeroes these bytes at K1, so under one of CPU7's stages the mark is this run's. Under any other
        # stage it may be an earlier run's, left uncleared: no other run zeroes them (Pullfrog on #116).
        whose = ("obs_gate=1 was set and CPU7's look never landed" if s in OG_STAGES else
                 "the mark of an obs_gate=1 run whose look never landed. This run's if it was one, which stage"
                 f" 0x{s:02x} doesn't say; otherwise an earlier run's, left uncleared")
        return out + [f"  0x6008 = 0x{b0:02x}: {whose}: K1 writes this byte, and the look's first command"
                      " would have written over it (CPU7 didn't get that far, or the command failed)"
                      + (f"; 0x6009-0x600e = {r[1:].hex(' ')} aren't shown to be this run's: NOT READ" if any(r[1:]) else "")]
    if s not in OG_STAGES:
        return out + [f"  NOT READ: stage 0x{s:02x} isn't one CPU7 sends from its first record on, and the look follows that record"]
    if clus:
        return out + og_clus_lines(r, words)
    if not b0 & OG_MARK or b0 & 0x70 or r[1] & 7:
        return out + [f"  0x6008 0x6009 = {b0:02x} {r[1]:02x}: not values e1_hook writes here (bit 7 of the first with bits 6:4 clear; bits 2:0 of"
                      " the second clear): NOT READ"]
    if not r[4] & 0x80:
        return out + [f"  0x6008-0x600c = {r[:5].hex(' ')}: the first command didn't land whole (bit 7 of 0x600c, its last byte): none of the"
                      " five is read, and nothing after them"]
    out.append(f"  0x6008 = 0x{b0:02x}: the power words, read right before the words below: {words(b0)}")
    out.append(f"  0x6009 = 0x{r[1]:02x}: HS_A bit 31 = {r[1] >> 3 & 1} (A2's raise for its first handshake), bit 24 = {r[1] >> 4 & 1} (the answer A2"
               f" waits for); HS_B bits 0, 1, 31 = {r[1] >> 5 & 1}, {r[1] >> 6 & 1}, {r[1] >> 7 & 1}")
    out.append(f"  0x600a = 0x{r[2]:02x}: 0x2922c0040's low byte (bit 1 {'set' if r[2] & 2 else 'clear: B2 clears it at its ops 4 to 6'})")
    out.append(f"  0x600b = 0x{r[3]:02x}: 0x2922c0044's low byte: {gate44(r[3])}. Awake it reads 0x08; with CPU0 awake and the two P complexes"
               " off, 1 s after the commit, it read 0x0b (the gate-look run of 2026-11-18)")
    out.append(f"  0x600c = 0x{r[4]:02x}: PHASE's low seven bits 0x{r[4] & 0x7f:x} ({PHASES.get(r[4] & 0x7f, 'not a phase on file')})")
    if not r[6] & 0x80 or r[6] & 4:
        return out + [f"  0x600d 0x600e = {r[5]:02x} {r[6]:02x}: the second command, {OG_LATER_MS} ms after the first, didn't land whole or isn't"
                      " e1_hook's (bit 7 of 0x600e set, its bit 2 clear): not read"]
    out.append(f"  0x600d = 0x{r[5]:02x}: 0x2922c0044's low byte {OG_LATER_MS} ms later: {gate44(r[5])}")
    out.append(f"  0x600e = 0x{r[6]:02x}: then: {words(r[6] >> 3)}; 0x2922c0040's bits 1:0 = {r[6] & 3}")
    return out


def ll_power_lines(r):
    """0x600d and 0x600e, the third command of last_look=1's record and of ll_retn=1's: how many of B2's power words read off."""
    out = []
    if not (r[5] & 0x80 and r[6] & 0x80):
        return [f"  0x600d 0x600e = {r[5]:02x} {r[6]:02x}: the third command, B2's power words, didn't land whole (bit 7 of each): not read"]
    n = r[5] & 0x3f
    out.append(f"  0x600d = 0x{r[5]:02x}: {n} of the 43 power words of SIO's subtree read off (actual state 0)"
               + (": NOT A COUNT e1_hook can send" if n > 43 else "; B2 switches them off from its op 35 on, and the suspend leaves"
                  " some off before the commit, so the count awake, in the load log, is what to compare with")
               + f"; FPWM0's own, the tenth B2 writes, read {'off' if r[5] & 0x40 else 'on'}")
    pc = [n for i, n in enumerate(LL_PCIE) if r[6] >> i & 1]
    out.append(f"  0x600e = 0x{r[6]:02x}: read off: of the five PCIe words, {', '.join(pc) or 'none'}; ANS2 {'off' if r[6] & 0x20 else 'on'};"
               f" the PMP's word {'off' if r[6] & 0x40 else 'on'}")
    return out


def llr_lines(s, r):
    """ll_retn=1: 0x6008-0x600e under that run's stages (e1-hook/last_look.h has the form): what CPU0 sent at its look, the first
    return of its last WFI, taken with retention left on, that found something pending or its timer firing, or the first past the
    time bound that found neither. 0x6008's bits 3:2 are the empty returns' code here, by the stage, and never gate_look=1's two
    bits: a count, from which nothing is concluded about how long the WFI held.
    Fields as read, each named; what they add up to is PLAN.md's to say."""
    out = [f"0x6008-0x600e = {r.hex(' ')}: ll_retn=1's record: CPU0's last WFI taken with retention left on (CYC_OVRD's bit 0 clear, its"
           f" timer {LL_TIMER_S} s out), and its look, at the first return with something pending or the first past the time bound:"]
    if s == LLR_PRE:
        if any(r):
            return out + [f"  NOT READ: stage 0x{s:02x} is the last before the commit, and these bytes are only sent after CPU0's WFI,"
                          " which comes after the later stage: the stage's command after the commit didn't land, or the bytes aren't this run's"]
        return out + ["  all 0, and the stage is the last before the commit: the run isn't shown to have reached CPU0's WFI"]
    if not any(r):
        return out + ["  all 0: CPU0's WFI didn't return, or the first command failed. As far as this record goes CPU0 never came back to"
                      f" make its look: it went down, it stayed in its WFI for good, or it returned only with nothing pending and the"
                      f" restart came before the time bound, {LLR_BOUND_S} s after the WFI was first taken (such returns send nothing"
                      f" until then). Not a proof that the core was powered off. Its own timer was set"
                      f" {LL_TIMER_S} s out, unmasked: a core still powered would have come back for it, unless the restart came first"
                      " (the restart's time, above)"]
    b0, b1 = r[0], r[1]
    if not b0 & 0x80 or not b0 & 3:
        return out + [f"  0x6008 = 0x{b0:02x}: not a value e1_hook writes in this run (bit 7 set, a count in bits 1:0): NOT READ"]
    out.append(f"  0x6008 = 0x{b0:02x}: CPU0'S LAST WFI RETURNED and its look was made, {LL_T[b0 >> 4 & 7]} after the commit's last write;"
               f" {LL_COUNT[b0 & 3]} by the last time it was counted, the look's return as the first (returns with nothing pending"
               " before it aren't in the count). CPU0 is up when it reads the words below: whether it, or its complex, had been down"
               " in between isn't in this byte"
               + f". Bits 3:2: returns with nothing pending before the look, each followed by another WFI: {LLR_EMPTIES[b0 >> LLR_E_SHIFT & 3]}"
               + (". That count doesn't say how long the WFI held between returns: the time of the look's return and the words"
                  " below are read on their own" if b0 >> LLR_E_SHIFT & 3 else "")
               + (". A count past one is a return after the look, when retention was off again (CYC_OVRD's bit 0 set, as in every"
                  " other run). It can be the look's own doing: a read of the look's that faulted leaves an SError pending, masked,"
                  " and every later WFI then returns at once, which takes the count to two and to a hundred within milliseconds"
                  if b0 & 3 > 1 else ""))
    # The second command's last byte carries bit 7 here too: without it the four aren't shown to have landed whole, and none is read.
    if not r[4] & LLR_LANDED:
        return out + [f"  0x6009-0x600c = {r[1:5].hex(' ')}: the second command, the handshake, the engine's page and the two new reads, didn't"
                      " land whole (bit 7 of 0x600c, its last byte: a read that hung, a restart, or SPMI): none of the four is read, and"
                      " nothing after them. Its last two reads, the E complex's state word and EACC's soc-cluster word, are the ones"
                      " CPU0 hadn't made in this state"]
    pend = [n for bit, n in ((1, "an FIQ"), (2, "an IRQ"), (4, "an SError")) if b1 & bit]
    out.append(f"  0x6009 = 0x{b1:02x}: pending at the look (ISR_EL1): {', '.join(pend) or 'nothing'}; CPU0's own timer "
               + ("was firing" if b1 & 8 else "was not firing") + f" (set {LL_TIMER_S} s out in this run)"
               + f"; HS_A bit 24 = {b1 >> 4 & 1}; HS_B bits 0, 1, 31 = {b1 >> 5 & 1}, {b1 >> 6 & 1}, {b1 >> 7 & 1}")
    out.append(f"  0x600a = 0x{r[2]:02x}: the E complex's state word (0x28e09a000), low byte: {LLR_ST.get(r[2], 'not a value on file')}")
    g44, g40 = r[3] & 0xf, r[3] >> 4 & 3
    out.append(f"  0x600b = 0x{r[3]:02x}: 0x2922c0044's low nibble {g44:04b}: bit 0 {'set' if g44 & 1 else 'clear'}, bit 1"
               f" {'set' if g44 & 2 else 'clear'}, bit 2 {'set' if g44 & 4 else 'clear'} (B2's first poll, op 1, waits for it set), bit 3"
               f" {'set' if g44 & 8 else 'clear'} (op 3 waits for it clear); 0x2922c0040's bits 1:0 = {g40} ("
               + ("as awake: B2's ops 4 to 6 haven't run" if g40 == 3 else
                  "bit 1 set, bit 0 clear: not a value on file" if g40 == 2 else "bit 1 clear: B2 clears it at its ops 4 to 6") + ")")
    out.append("  0x600b bit 7: " + (f"THE LOOK WAS MADE AT THE TIME BOUND, WITH NOTHING PENDING AND THE TIMER NOT FIRING, not for a pending"
                                    f" interrupt: at the first return {LLR_BOUND_S} s or more after the WFI was first taken, ISR_EL1 read 0"
                                    f" and CPU0's timer, {LL_TIMER_S} s out, didn't read as firing" if r[3] & LLR_AT_BOUND else
                                    f"clear: the look wasn't made at the time bound ({LLR_BOUND_S} s after the WFI was first taken, with"
                                    " nothing pending), but at a return that found ISR_EL1 non-zero or CPU0's timer firing")
               + ("; bit 6: ONE OF THE WORDS HAS A BIT ABOVE WHAT THESE BYTES CARRY (the state word above bit 7, 0x2922c0040 above bit 1,"
                  " 0x2922c0044 above bit 3, PHASE above bit 3 or EACC's word above bit 6): the bytes aren't the whole words"
                  if r[3] & LLR_WIDE else
                  "; bit 6 clear: the state word, 0x2922c0040, 0x2922c0044, PHASE and EACC's word had no bit above what these bytes carry"))
    acc, ph = r[4] >> 4 & 7, r[4] & 0xf
    out.append(f"  0x600c = 0x{r[4]:02x}: EACC's soc-cluster word (0x28e098000), bits 6:4 = {acc:03b}: bit 4 {'set' if acc & 1 else 'clear'} (a"
               f" change asked for and not finished), bit 5 {'set' if acc & 2 else 'clear'} (the up-done flag), bit 6"
               f" {'set' if acc & 4 else 'clear'} (what a down sequence waits for first, with no timeout); its low nibble isn't sent."
               f" PHASE's low nibble 0x{ph:x} ({PHASES.get(ph, 'not a phase on file')})")
    return out + ll_power_lines(r)


def ll_lines(s, b):
    """last_look=1: 0x6008-0x600e, what CPU0 sent if its own last WFI returned, or with gate_look=1 what it sent itself before
    that WFI (e1-hook/last_look.h has the bytes). Fields as read, each named; what they add up to is PLAN.md's to say."""
    r = b[8:0x0f]
    # wake_all=1's byte is in the first of them, in the gates_mark=1 family's runs: its two top bits under one of those stages, or
    # K1's mark for it. Neither is obs_gate=1's (0x40 alone, or bit 7 under one of CPU7's stages). sep_pg=1's is in the second,
    # in the same runs: its top bit under one of those stages, or K1's mark for it. disp_hs=1's four are the third to the sixth.
    if fam_record(s, r):
        return fam_lines(s, r)
    # obs_gate=1's record is in the same bytes, in observe=1's runs: its mark or K1's in 0x6008 under one of that run's stages.
    if og_record(s, r):
        return og_lines(s, r)
    out = [f"0x6008-0x600e = {r.hex(' ')}: last_look=1's record of CPU0's own last WFI:"]
    if s not in LL_STAGES:
        return out + ["  NOT READ: the stage isn't one of last_look=1's, and the bytes are neither an obs_gate=1 record nor a wake_all=1, sep_ro=1, sep_pg=1 or disp_hs=1 one. They read 0 in"
                      " every log before 2026-11-16: something else wrote them, or an older record is still there"]
    blink = []
    if s in LLW_STAGES:
        blink = [f"  0x6016 bit 6: step 8 {'made' if b[0x16] & LL_BLINK_BIT else 'did NOT make'} the keyboard PWM's three writes"
                 + ("" if b[0x16] & LL_BLINK_BIT else " (FPWM0 didn't read on within 10 ms, or the alarm's byte, which carries the bit"
                    " and goes out after the first commit write, didn't land): a blink may not have been there to see, and its absence"
                    " says nothing about B2")]
    # ll_retn=1's stages: the record has that run's own form, and none of what follows is applied to it.
    if s in LLR_STAGES:
        return llr_lines(s, r) + blink
    if s in (LL_PRE, LLW_PRE):
        if r == bytes((LL_ARMED,)) + bytes(6):
            return out + [f"  0x6008 = 0x{LL_ARMED:02x} and six zeros, and the stage is the last before the commit: gate_look=1 was set (K1 writes"
                          " this byte), and the run isn't shown to have reached CPU0's look or its WFI"] + blink
        if any(r):
            return out + [f"  NOT READ: stage 0x{s:02x} is the last before the commit, and these bytes are only sent after CPU0's WFI,"
                          " which comes after the later stage: the stage's command after the commit didn't land, or the bytes aren't this run's"] + blink
        return out + ["  all 0, and the stage is the last before the commit: the run isn't shown to have reached CPU0's WFI"] + blink
    if not any(r):
        return out + ["  all 0: CPU0's WFI didn't return, as far as this record goes: CPU0 never came back to send them (it went down,"
                      " or it stayed in its WFI for good), or its first command failed. Not a proof that the core was powered off"
                      + (f". Its own timer was set {LL_TIMER_S} s out, unmasked: a core still powered would have come back for it, unless"
                         " the restart came first (the restart's time, above)" if s in LLW_STAGES else "")] + blink
    b0, b1 = r[0], r[1]
    # gate_look=1: K1 leaves 0x6008 as LL_ARMED; the look's first command, sent before CPU0's WFI, writes LL_LOOKED there with
    # 0x6009-0x600c; a WFI that returns after it sends 0x6008 again with the bit kept, and leaves the look's six bytes.
    looked, ret = bool(b0 & LL_LOOKED), b0 & ~LL_LOOKED
    if b0 == LL_ARMED:
        return out + [f"  0x6008 = 0x{b0:02x}: gate_look=1 was set and its look never landed: K1 writes this byte, and the look's first command,"
                      f" {LL_LOOK_MS // 1000} s after the commit's last write, would have written 0x{LL_LOOKED:02x} over it (CPU0 didn't get that"
                      " far, or the command failed). Nothing here says whether CPU0's WFI returned"
                      + (f"; 0x6009-0x600e = {r[1:].hex(' ')} aren't shown to be this run's: NOT READ" if any(r[1:]) else "")] + blink
    if looked and not ret:
        # The look comes before the timer and the WFI: only a look that landed whole shows CPU0 got through it, and nothing
        # here shows the timer set or the WFI entered (Pullfrog on #114: a power word's read that hung ends CPU0 in the look).
        whole = bool(r[4] & 0x80 and r[5] & 0x80 and r[6] & 0x80)
        tmr = f"sets its own timer, {LL_TIMER_S} s out and unmasked, and " if s in LLW_STAGES else ""
        out.append(f"  0x6008 = 0x{b0:02x}: gate_look=1's look was sent, and no return of CPU0's WFI was recorded after it. "
                   + (f"The look landed whole (below); CPU0 then {tmr}takes its WFI, which nothing here records. If it did, it never"
                      " came back to send this byte again (it went down, or it stayed in its WFI for good), or that command failed. Not a"
                      " proof that the core was powered off" if whole else
                      f"The look did NOT land whole (below), so CPU0 isn't shown to have got through it: a read of the look's that"
                      f" hung would have kept CPU0 from the rest of step 10, where it {tmr}takes its WFI. That would be an ending of the"
                      " look's own making: the restart's time, above, isn't then run B's stall"))
    elif not ret & 0x80 or not ret & 3 or ret & 0x04:
        return out + [f"  0x6008 = 0x{b0:02x}: not a value e1_hook writes (bit 7 set, bit 2 clear, a count in bits 1:0; bit 3 with gate_look=1's"
                      " look): NOT READ"] + blink
    else:
        out.append(f"  0x6008 = 0x{b0:02x}: CPU0'S LAST WFI RETURNED, first {LL_T[b0 >> 4 & 7]} after the commit's last write; {LL_COUNT[b0 & 3]} by"
                   " the last time it was counted. A core that is up again holds the engine; whether it had been down in between isn't"
                   " shown (Linux's own deep idle on this chip comes back at the next instruction too)"
                   + (". A count past one can be the look's own doing: a read of its that faulted leaves an SError pending, masked,"
                      " and every later WFI returns for it" if b0 & 3 > 1 else "")
                   + (". Bit 3: the bytes below are gate_look=1's look, made before that WFI, not the return's" if looked else ""))
    if looked:
        out.append(f"  0x6009-0x600e: gate_look=1's look, read {LL_LOOK_MS // 1000} s after the commit's last write with CPU0 still up, before its last"
                   " WFI. A reading with a core up, which may itself hold B2's first poll: not the stall's own state after the WFI. Runs 6"
                   " to 10 read, this way under an earlier recipe: 0x2922c0044's bit 2 clear and bit 3 set, 0x2922c0040's bit 1 set, HS_A's"
                   " bit 31 up and bit 24 clear")
    # The second command's last byte carries bit 7: without it the four aren't shown to have landed whole, and none is read.
    if not r[4] & 0x80:
        return out + [f"  0x6009-0x600c = {r[1:5].hex(' ')}: the second command, the engine's page and the handshake, didn't land whole (bit 7"
                      " of 0x600c, its last byte: a read that hung, a restart, or SPMI): none of the four is read, and nothing after them"] + blink
    pend = [n for i, n in enumerate(("an FIQ", "an IRQ", "an SError")) if b1 >> i & 1]
    if looked:
        out.append(f"  0x6009 = 0x{b1:02x}: pending at the look (ISR_EL1): {', '.join(pend) or 'nothing'}; HS_A bit 31 = {b1 >> 3 & 1} (A2's raise"
                   f" for its first handshake), bit 24 = {b1 >> 4 & 1} (the answer A2 waits for);"
                   f" HS_B bits 0, 1, 31 = {b1 >> 5 & 1}, {b1 >> 6 & 1}, {b1 >> 7 & 1}")
    else:
        out.append(f"  0x6009 = 0x{b1:02x}: pending at the return (ISR_EL1): {', '.join(pend) or 'nothing'}; CPU0's own timer "
                   + ("was firing" if b1 & 8 else "was not firing")
                   + (f" (set {LL_TIMER_S} s out in this run)" if s in LLW_STAGES else " (this run sets none)")
                   + f"; HS_A bit 24 = {b1 >> 4 & 1}; HS_B bits 0, 1, 31 = {b1 >> 5 & 1}, {b1 >> 6 & 1}, {b1 >> 7 & 1}")
    out.append(f"  0x600a = 0x{r[2]:02x}: 0x2922c0040's low byte (bit 1 {'set' if r[2] & 2 else 'clear: B2 clears it at its ops 4 to 6'})")
    out.append(f"  0x600b = 0x{r[3]:02x}: 0x2922c0044's low byte: bit 2 {'set' if r[3] & 4 else 'clear'} (B2's first poll, op 1, waits for it"
               f" set), bit 3 {'set' if r[3] & 8 else 'clear'} (op 3 waits for it clear)")
    out.append(f"  0x600c = 0x{r[4]:02x}: PHASE's low seven bits 0x{r[4] & 0x7f:x} ({PHASES.get(r[4] & 0x7f, 'not a phase on file')})")
    return out + ll_power_lines(r) + blink


def r0201_line(v):
    """The PMU's register 0x0201 at this boot."""
    what = {2: "what every boot here has shown: no sign that B2 reached its PMU command (ops 237-238), if the engine's 1 outlasts"
               " a restart, as it does on Naeem Malik's M1; whether it does here isn't known",
            1: "THE VALUE B2 WRITES at its ops 237-238, near the entry pair's end, and B0 at the wake's start: never read here"
               " before. Don't clear anything yet: tell Claude",
            0: "the value B1, the wake's last sequence, writes: never read here before. Don't clear anything yet: tell Claude"}
    return f"PMU 0x0201 = 0x{v:02x}: " + what.get(v, "not a value read here before (a boot shows 2; the engine writes 1 and 0): tell Claude")


def alarm_res(b, s):
    """0x6016 as the alarm's result, or None at gates_mark=1's, sio_down=1's, pcie_down=1's, sio_steps=1's, a2_pre=1's and acc_last=1's stages, whose byte it is there instead."""
    if s in LLW_STAGES:
        return b[0x16] & ~LL_BLINK_BIT  # ll_wake=1: bit 6 is the keyboard light's (ll_lines())
    return None if s in GATES_STAGES + SIOD_STAGES + PCD_STAGES + SST_STAGES + A2P_STAGES + ACL_STAGES else b[0x16]


def gates_lines(s, b, pmp):
    """gates_mark=1: 0x6016 at the run's stages (e1-hook/gates_mark.h has the layout), read only where the record says it's the
    gate byte: the stage has pmp_out=1's bit 7, the steps' outcomes, sent just before it, landed, and its own bit 7 is set."""
    v = b[0x16]
    if not pmp:
        return [f"0x6016 = 0x{v:02x}: not read. A gates_mark=1 run's stages always carry pmp_out=1's bit 7, and this one doesn't: not a"
                " record that run leaves"]
    if not fab_landed(b):
        return [f"0x6016 = 0x{v:02x}: not read. The gate byte goes out right after the steps' outcomes, and only if their command didn't"
                " fail, and their marker isn't at 0x6013: the byte isn't shown to have been sent"]
    if not v & GATES_MARK and s == GATES_PRE:
        return [f"0x6016 = 0x{v:02x}: THE GATE BYTE DIDN'T LAND (bit 7 clear), though stage 0x4b and the steps' outcomes did: CPU0 was"
                " reading the six gate words and the lane, or sending their byte, when the record stopped. A read that faulted (its"
                " SError panics the kernel: a restart about 10 s later, if the panic's restart works), a read that never returned"
                " (WD1's marker: a restart about 90 s after step 4), or the byte's own command failing, after which the run went on"
                " with nothing more recorded: this record doesn't tell them apart, and the restart's time, below, only in part"]
    if not v & GATES_MARK:
        return [f"0x6016 = 0x{v:02x}: bit 7 is clear, so the gate byte didn't survive the reset, or isn't the one sent: stage 0x{s:02x}"
                " went out after it, and a command that fails stops every one after it. Not read"]
    out = [f"0x6016 = 0x{v:02x}: gates_mark=1's byte, in place of the alarm's result: what CPU0 read in step 8, right before the"
           " commit and before B2's own writes:"]
    out += [f"  {w}: bit 30 {'SET, closed' if v >> i & 1 else 'clear, open'}" + (" (the gate B2 polls at op 140, after SIO's subtree)" if not i else "")
            for i, w in enumerate(GATE_WORDS)]
    if pwn(b[0x13]):
        # The lane is one of the fabric group's power words: such a run doesn't read it in step 8, and sends the bit clear.
        out.append("  AFNC2_LW1 (0x28e580160), the fabric lane above SIO: not read (pw_noread=1, by 0x6013's mark: step 8 leaves out the"
                   " read of that power word, and bit 6 says nothing here)"
                   + ("; bit 6 is SET all the same, which such a run never sends: not read as the lane's value" if v & GATES_LANE else ""))
    else:
        out.append("  AFNC2_LW1 (0x28e580160), the fabric lane above SIO: " + ("read 0x1000030f, macOS's value" if v & GATES_LANE else
                                                                               "did NOT read 0x1000030f, macOS's value (the load log has it awake)"))
    if v & 1:
        out.append("  so: 0x28e5a0050 read closed in the recipe's state: B2's poll of it at op 140 is cleared, as far as a read before"
                   " B2's own writes can clear it, and a2_pre=1 is next (PLAN.md)")
    else:
        out.append("  so: 0x28e5a0050 read OPEN in the recipe's state too, as after Linux's own suspend. That doesn't place the stall:"
                   " the recipe leaves ps_sio, UART_P, SPI_P and SIO_CPU on, as macOS has them, and B2 switches them off itself"
                   " before its poll at op 140. Whether the gate closes then, this read can't say (RESEARCH.md, \"The gates read's"
                   " run\")")
    if s == GATES_PRE:
        out.append("  stage 0x4b, so nothing records the commit after this byte (0x54 or 0x55 comes after it): inconclusive about the"
                   " rest of the entry")
    return out


# sio_down=1's byte, sio_down.h's second layout (the first run's 0x96 had another: RESEARCH.md, "The `sio_down=1` run").
SIOD_CLOSED, SIOD_BACK_STATE, SIOD_BACK_EN, SIOD_BACK_GATE, SIOD_AT, SIOD_MARK = 0x01, 0x08, 0x10, 0x20, 0x40, 0x80
SIOD_BACK_ALL = SIOD_BACK_STATE | SIOD_BACK_EN | SIOD_BACK_GATE
SIOD_AUTO_SHIFT = 1
SIOD_AUTO_EN_SET, SIOD_AUTO_OTHER, SIOD_AUTO_F, SIOD_AUTO_ZERO = range(4)
SIOD_AT_POLL, SIOD_AT_CLOSED = 62, 63
# The 43 words in B2's order, sio_down.h's SIOD_OFFS: a place in the byte is an index into this.
SIOD_WORDS = ((("SIO_CPU", 0x188),) + tuple((f"I2C{i}", 0x1a8 + 8 * i) for i in range(8)) + tuple((f"FPWM{i}", 0x190 + 8 * i) for i in range(3))
              + tuple((f"SIO_SPMI{i}", 0x218 + 8 * i) for i in range(3)) + (("AES", 0x2d0),) + tuple((f"SPI{i}", 0x1f0 + 8 * i) for i in range(5))
              + (("UART_N", 0x238),) + tuple((f"UART{i}", 0x240 + 8 * i) for i in range(5)) + (("UART6", 0x268), ("UART7", 0x270))
              + tuple((f"MCA{i}", 0x288 + 8 * i) for i in range(4)) + tuple((f"DPA{i}", 0x2a8 + 8 * i) for i in range(5))
              + (("SIO_ADMA", 0x280), ("SPI_P", 0x1e8), ("UART_P", 0x230), ("AUDIO_P", 0x278), ("SIO", 0x180)))
SIOD_AUTO_LINES = {
    SIOD_AUTO_ZERO: "all 0 in all 43: the 0 reads back whole",
    SIOD_AUTO_F: "auto-enable 0 in all 43; bits 27:24 f in one or more of SIO, SIO_CPU and SIO_SPMI0-2, 0 everywhere else: what those five"
                 " read after any switch-off on file, Linux's own included",
    SIOD_AUTO_OTHER: "auto-enable 0 in all 43, but bits 27:24 NOT as expected: something other than 0 outside SIO, SIO_CPU and SIO_SPMI0-2,"
                     " or other than 0 and f in one of those",
    SIOD_AUTO_EN_SET: "AN AUTO-ENABLE (bit 28) STILL READ SET in at least one word",
}


def siod_lines(s, b, pmp):
    """sio_down=1: 0x6016 at the run's stages (e1-hook/sio_down.h has the layouts), read only where the record says it's that
    byte: the stage has pmp_out=1's bit 7, the steps' outcomes, sent just before the switch-off, landed, and its own bit 7 is set."""
    v = b[0x16]
    if not pmp:
        return [f"0x6016 = 0x{v:02x}: not read. A sio_down=1 run's stages always carry pmp_out=1's bit 7, and this one doesn't: not a"
                " record that run leaves"]
    if not fab_landed(b):
        return [f"0x6016 = 0x{v:02x}: not read. sio_down=1's byte goes out after the steps' outcomes, and only if their command didn't"
                " fail, and their marker isn't at 0x6013: the byte isn't shown to have been sent"]
    if not v & SIOD_MARK and s == SIOD_PRE:
        return [f"0x6016 = 0x{v:02x}: SIO_DOWN'S BYTE DIDN'T LAND (bit 7 clear), though stage 0x3d and the steps' outcomes did: CPU0 was"
                " reading the 43 power words of SIO's subtree, writing them 0, polling them or the two gates, or sending the byte, when"
                " the record stopped. How many of the 43 were off by then isn't recorded, and nothing shows them written back. A"
                " read or a write that faulted (its SError panics the kernel: a restart about 10 s later, if the panic's restart"
                " works), one that never returned (WD1's marker: a restart about 90 s after step 4), or the byte's own command"
                " failing, after which the run went on with nothing more recorded: this record doesn't tell them apart, and the"
                " restart's time, below, only in part"]
    if not v & SIOD_MARK:
        return [f"0x6016 = 0x{v:02x}: bit 7 is clear, so sio_down=1's byte didn't survive the reset, or isn't the one sent: stage"
                f" 0x{s:02x} went out after it, and a command that fails stops every one after it. Not read"]
    out = [f"0x6016 = 0x{v:02x}: sio_down=1's byte, in place of the alarm's result: CPU0 was to write 0 to the 43 power words of SIO's"
           " subtree in step 8, as B2 does before its op 140, poll as B2 polls, and write them back before the commit:"]
    stopped = b[0x12] >> 6 == 3  # sio_stop=1's outcome, sent with the marker fab_landed() has just checked
    nostop = ("  so: INCONCLUSIVE: SIO's firmware isn't shown stopped (0x6012: " + SIO_CODES[b[0x12] >> 6] + "), so SIO_CPU was switched"
              " off and on under it: not the state this is for")
    late = ("  a poll that isn't met takes its 100 ms, so the commit came later than its time stamp, by up to about 5 s: a restart"
            " by WD2 would read that much later than it was, and one by WD1's marker, counting since step 4, isn't moved")
    pre = ("  stage 0x3d, so nothing records the commit after this byte (0x3e or 0x3f comes after it): inconclusive about the"
           " rest of the entry")
    if v & SIOD_AT:
        at = v & 0x3f
        if at == SIOD_AT_CLOSED:
            out.append("  0x28e5a0050 before the first write: ALREADY CLOSED, which it wasn't in --m1-gates' run or the first sio_down=1 run")
            out.append("  so: NOTHING WAS WRITTEN: the switch-off isn't made on a gate that's closed already. Something else differs in"
                       " this run, and that is the lead. The commit found SIO's subtree as the recipe leaves it")
        elif at == SIOD_AT_POLL:
            out.append("  the 43 words after the polls: all read target 0 and actual state 0")
            out.append("  B2's 42 polls for bit 11 clear: NOT all met within 100 ms each; which isn't recorded")
            out.append("  so: INCONCLUSIVE on the gate, whose reading isn't kept in this case: B2 waits for each of those polls, and one"
                       " that isn't met with a core up is its own lead" if stopped else nostop)
            out.append(late)
        elif at < len(SIOD_WORDS):
            name, off = SIOD_WORDS[at]
            out.append(f"  the 43 words after the polls: {name} (0x28e580{off:03x}), place {at} of 0 to 42 in B2's order, DIDN'T READ target 0 and"
                       " actual state 0. It's the first in that order that didn't; whether a later one didn't either, what it read, and"
                       " whether every poll was met aren't recorded")
            out.append(f"  so: SIO's subtree wasn't off, so the gate was bound to stay open and its reading isn't kept. What holds {name}"
                       " up after a 0 is the lead (PLAN.md)" if stopped else nostop)
            out.append("  if a poll wasn't met either, it took its 100 ms, and the commit came later than its time stamp, by up to about 5 s")
        else:
            return [f"0x6016 = 0x{v:02x}: bit 6 says a place follows, and {at} isn't one sio_down=1 sends (0 to 42, 62, 63). Not read"]
        if at != SIOD_AT_CLOSED:
            out.append("  written back: NOT RECORDED in this case, so the commit isn't shown to have found SIO's subtree as the recipe leaves"
                       " it: the restart's time doesn't compare with --m1-gates'")
        if s == SIOD_PRE:
            out.append(pre)
        return out
    auto = v >> SIOD_AUTO_SHIFT & 3
    closed = "closed" if v & SIOD_CLOSED else "open"
    out.append("  the 43 words after the polls: all read target 0 and actual state 0, and B2's 42 polls for bit 11 clear were all met:"
               " SIO's subtree was off")
    out.append("  0x28e5a0050 before the first write: open, as in every run so far")
    out.append("  the 43 words' auto fields after the 0: " + SIOD_AUTO_LINES[auto])
    out.append("  0x28e5a0050 (B2's op 140), after up to 100 ms for 0x28e5a0064 and 100 ms more for it: bit 30 "
               + ("SET, closed" if v & SIOD_CLOSED else "clear, OPEN"))
    if not v & (SIOD_BACK_STATE | SIOD_BACK_EN | SIOD_BACK_GATE):
        out.append("  written back: NOTHING CONFIRMED: none of the 43's target and actual state, their auto-enable and the gate read as"
                   " before, or the run stopped in the write-back, before the byte's second send, or that send's command failed")
    else:
        out.append("  written back, target and actual state: " + ("all 43 read as found within 10 ms each" if v & SIOD_BACK_STATE else
                                                                  "NOT all 43 read as found within 10 ms of their write-back"))
        out.append("  written back, auto-enable (bit 28): " + ("all 43 read as found then" if v & SIOD_BACK_EN else
                                                               "NOT all 43 read as found then") + "; bits 27:24 aren't compared")
        out.append("  0x28e5a0050 after the write-back: " + ("open again within 100 ms" if v & SIOD_BACK_GATE else
                                                              "NOT open again within 100 ms"))
    aps = (" This is the AP's state before the commit, not B2's at op 140: the cores are up, and A2's DCS and fabric moves and B2's own"
           " raises haven't been made")
    asb2 = ("" if auto == SIOD_AUTO_ZERO else " Bits 27:24 read f after the 0 in some of the five words that read f after any switch-off:"
            " taken as how those words read with auto-enable clear, not as a setting the 0 missed, since B2 writes the same 0 to the"
            " same words (RESEARCH.md).")
    if not stopped:
        out.append(nostop + f" (0x28e5a0050 read {closed})")
    elif auto == SIOD_AUTO_EN_SET:
        out.append("  so: INCONCLUSIVE on the gate: an auto-enable survived the 0, so the subtree, though off, wasn't as B2's 0 is meant to"
                   f" leave it (0x28e5a0050 read {closed}). Which word, and why, comes before GPIO or a2_pre=1 (PLAN.md)")
    elif auto == SIOD_AUTO_OTHER:
        out.append("  so: INCONCLUSIVE on the gate: bits 27:24 read something after the 0 that no switch-off on file left, so the subtree,"
                   f" though off, isn't shown to be as B2's 0 leaves it (0x28e5a0050 read {closed}). Which word, and what it read, comes"
                   " before GPIO or a2_pre=1 (PLAN.md)")
    elif v & SIOD_CLOSED:
        out.append("  so: 0x28e5a0050 CLOSED once SIO's subtree was off: the gate can close in the recipe's state, so B2's poll at op 140"
                   " is less likely the stall, and a2_pre=1 is next (PLAN.md)." + asb2 + aps)
    else:
        out.append("  so: 0x28e5a0050 stayed OPEN with SIO's subtree off, B2's own words and values, in the recipe's state: a lead on"
                   " B2's poll at op 140, stronger than the gate test's. What else is behind that gate is the question, GPIO's power"
                   " word first (PLAN.md)." + asb2 + aps)
    if v & SIOD_BACK_ALL != SIOD_BACK_ALL:
        out.append("  without the words' target and actual state, their auto-enable and the gate all confirmed back, the commit may not"
                   " have found SIO's subtree as the recipe leaves it: the restart's time doesn't compare with --m1-gates'")
    if s == SIOD_PRE:
        out.append(pre)
    return out


# sio_steps=1's byte, sio_steps.h's: the second layout's bits, and the first's own.
SST_G1, SST_G2, SST_SUB, SST_GPIO_OK, SST_PRE_OK, SST_BACK, SST_FINAL, SST_MARK = 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80
SST_GO_AT_LO, SST_GO_AT_HI, SST_GO_CLOSED = 0x02, 0x10, 0x20
SST_GROUP_NAMES = ("0x28e03801c (B2's op 8)", "the seven words 0x28e0a0004 to 0x28e0a001c (B2's ops 9 to 15)",
                   "the fourteen words 0x28e5b0004 to 0x28e5b0038 (B2's ops 16 to 29)")


def sst_lines(s, b, pmp):
    """sio_steps=1: 0x6016 at the run's stages (e1-hook/sio_steps.h has the layouts), read only where the record says it's that
    byte: the stage has pmp_out=1's bit 7, the steps' outcomes, sent just before the pass, landed, and its own bit 7 is set."""
    v = b[0x16]
    if not pmp:
        return [f"0x6016 = 0x{v:02x}: not read. A sio_steps=1 run's stages always carry pmp_out=1's bit 7, and this one doesn't: not a"
                " record that run leaves"]
    if not fab_landed(b):
        return [f"0x6016 = 0x{v:02x}: not read. sio_steps=1's byte goes out after the steps' outcomes, and only if their command didn't"
                " fail, and their marker isn't at 0x6013: the byte isn't shown to have been sent"]
    if not v & SST_MARK and s == SST_PRE:
        return [f"0x6016 = 0x{v:02x}: SIO_STEPS' BYTE DIDN'T LAND (bit 7 clear), though stage 0x15 and the steps' outcomes did: CPU0 was"
                " raising GPIO's power word, writing 0 to the 43 of SIO's subtree or to GPIO's, polling them or the two gates, or"
                " sending the byte, when the record stopped. Nothing shows the 43 written back. A read or a write that faulted (its"
                " SError panics the kernel: a restart about 10 s later, if the panic's restart works), one that never returned"
                " (WD1's marker: a restart about 90 s after step 4), or the byte's own command failing, after which the run went on"
                " with nothing more recorded: this record doesn't tell them apart, and the restart's time, below, only in part"]
    if not v & SST_MARK:
        return [f"0x6016 = 0x{v:02x}: bit 7 is clear, so sio_steps=1's byte didn't survive the reset, or isn't the one sent: stage"
                f" 0x{s:02x} went out after it, and a command that fails stops every one after it. Not read"]
    out = [f"0x6016 = 0x{v:02x}: sio_steps=1's byte, in place of the alarm's result: CPU0 was to switch SIO's subtree off in step 8 as B2"
           " does, with B2's cycle of GPIO's power word inside it, poll the gate 0x28e5a0050 (B2's op 140), write the 22 words B2"
           " writes first if it was still open and poll it again, and write the 43 back before the commit:"]
    stopped = (b[0x12] >> 6) == 3  # sio_stop=1's outcome, sent with the marker fab_landed() has just checked
    nostop = ("  so: INCONCLUSIVE: SIO's firmware isn't shown stopped (0x6012: " + SIO_CODES[b[0x12] >> 6] + "), so SIO_CPU was switched"
              " off and on under it: not the state this is for")
    aps = (" This is the AP's state before the commit, not B2's at op 140: the cores are up, and A2's DCS and fabric moves and B2's own"
           " raise of SIO_CPU haven't been made")
    sub = ("  the 43 words of SIO's subtree after the polls: " + ("all read target 0 and actual state 0, B2's 42 polls for bit 11"
           " clear were all met, and the auto fields read as B2's 0 leaves them: the subtree was off" if v & SST_SUB else "NOT all"
           " off, or a bit-11 poll of theirs unmet within 100 ms, or an auto-enable left or an auto field that no switch-off on file"
           " left; which isn't recorded (sio_down=1's byte names it)"))
    gpio = ("  GPIO's power word (0x28e080120; B2's ops 47 and 90): " + ("read actual state f within 100 ms of 0x8000000f, its bit-11"
            " poll after the 0 was met, and it read off and idle after the gates' polls: the cycle was made" if v & SST_GPIO_OK else
            "THE CYCLE ISN'T SHOWN MADE: it didn't read actual state f within 100 ms of 0x8000000f, or its bit-11 poll after the 0"
            " wasn't met, or it didn't read off and idle after the gates' polls; which isn't recorded"))
    g1 = ("  0x28e5a0050 after that, with up to 100 ms for 0x28e5a0064 and 100 ms more for it: bit 30 "
          + ("SET, closed" if v & SST_G1 else "clear, OPEN"))
    if not v & SST_FINAL:
        n = (1 if v & SST_GO_AT_LO else 0) | (2 if v & SST_GO_AT_HI else 0)
        if v == SST_MARK | SST_GO_CLOSED:
            out.append("  0x28e5a0050 before the first write: ALREADY CLOSED, which it wasn't in any run before")
            out.append("  so: NOTHING WAS WRITTEN: the pass isn't made on a gate that's closed already. Something else differs in this"
                       " run, and that is the lead. SIO's subtree, GPIO and the 22 words were left as the recipe leaves them")
            if s == SST_PRE:
                out.append("  stage 0x15, so nothing records the commit after this byte (0x16 or 0x17 comes after it): inconclusive about"
                           " the rest of the entry")
            return out
        second = (v & (SST_SUB | SST_G1)) == SST_SUB
        if v & SST_GO_CLOSED or s != SST_PRE or (n and not second):
            return [f"0x6016 = 0x{v:02x}: bit 6 is clear, the byte's first layout, and this isn't one sio_steps=1 sends in it"
                    + (f" at stage 0x{s:02x}: the second layout, or 0xa0, is the last before the commit" if s != SST_PRE and
                       not v & SST_GO_CLOSED and (not n or second) else "") + ". Not read"]
        out += [sub, gpio, g1]
        if not second:
            out.append("  the 22 words: not written (they are only after a switch-off that took, with the gate still open)")
            out.append("  so: THE RECORD STOPS BEFORE THE BYTE'S SECOND LAYOUT, which goes out right after this one when the 22 aren't"
                       " written: that command failed, or the run stopped between the two. Nothing shows the 43 written back")
        else:
            out.append(f"  the 22 words: {n} of their three groups written and read back when the record stops"
                       + ("" if n == 3 else "; next was " + SST_GROUP_NAMES[n]))
            out.append("  so: THE RUN STOPPED " + ("IN THE GATE'S SECOND POLL or the send after it, with all 22 written" if n == 3 else
                       "AT " + SST_GROUP_NAMES[n] + ": in its writes, its read-back or the byte after"
                       " it. Some of these words may select something a running core needs, and the engine moves them with every"
                       " core down: that group is the lead, to be left out or made last (PLAN.md)")
                       + ". Or the byte's command failed and the run went on unrecorded. Nothing shows the 43 written back")
        out.append("  stage 0x15, so nothing records the commit after this byte: the restart's time, below, tells a panic (about 10 s)"
                   " from the rest. A write that never returned ends at WD1's marker (about 90 s after step 4). A byte whose command"
                   " failed stops the record, not the run: the pass, the write-back and the commit went on unrecorded, to whatever"
                   " ending the entry then had (WD1's marker at about 90 s in every run so far; later, or no restart, if B2 got"
                   " further). So a restart at about 90 s fits both, and this record doesn't tell them apart")
        return out
    second = (v & (SST_SUB | SST_G1)) == SST_SUB
    if (v & SST_G1 and v & SST_G2) or (not second and v & (SST_G2 | SST_PRE_OK)):
        return [f"0x6016 = 0x{v:02x}: bit 6 is set, the byte's second layout, and this isn't one sio_steps=1 sends in it: the 22 are"
                " written, and the gate polled again, only after a switch-off that took with the gate still open. Not read"]
    out += [sub, gpio, g1]
    if second:
        out.append("  the 22 words (0x28e03801c := 0x80101100; 1 to the seven and the fourteen), written after that: "
                   + ("all read back as written" if v & SST_PRE_OK else "NOT all read back as written (0x28e03801c with bit 30, pending, clear"
                      " within 100 ms); which isn't recorded"))
        out.append("  0x28e5a0050 after them, with up to 100 ms more: bit 30 " + ("SET, closed" if v & SST_G2 else "clear, OPEN"))
    else:
        out.append("  the 22 words: not written (" + ("the gate had closed" if v & SST_SUB else "the subtree wasn't off") + ")")
    out.append("  written back: " + ("all 43 read as found in target, actual state and auto-enable within 100 ms each, and 0x28e5a0050"
               " read open again" if v & SST_BACK else "NOT CONFIRMED: not all 43 read as found within 100 ms of their write-back, or"
               " the gate didn't read open again, or the run stopped in the write-back, before the byte's last send"))
    if not stopped:
        out.append(nostop)
    elif not v & SST_SUB:
        out.append("  so: INCONCLUSIVE on the gate: SIO's subtree wasn't off, or a poll B2 waits for wasn't met, or its auto fields weren't as"
                   " B2's 0 leaves them, so the gate's reading says nothing. It went off cleanly in the second sio_down=1 run: what"
                   " differs here is the lead, GPIO's raise first")
    elif v & SST_G1 and v & SST_GPIO_OK:
        out.append("  so: 0x28e5a0050 CLOSED with GPIO's cycle made inside the switch-off, where it stayed open twice without it"
                   " (sio_down=1): the gate follows GPIO's pass through on-with-reset. B2 makes that cycle itself, so its poll at op"
                   " 140 is cleared as far as the AP can clear it, and a2_pre=1 is next (PLAN.md)." + aps)
    elif v & SST_G1:
        out.append("  so: 0x28e5a0050 CLOSED after the switch-off, where it stayed open twice (sio_down=1), but GPIO's cycle isn't shown"
                   " made as meant: what closed it is between GPIO's raise and something else that differs in this run. A lead, not"
                   " an answer." + aps)
    elif v & SST_G2:
        out.append("  so: 0x28e5a0050 CLOSED ONCE THE 22 WORDS WERE WRITTEN, and not before"
                   + ("" if v & SST_GPIO_OK else " (GPIO's cycle isn't shown made, so that the cycle doesn't close it isn't shown)")
                   + (": the gate follows them, or some of them" if v & SST_PRE_OK else ", though they didn't all read back as written:"
                      " which of them it follows isn't known")
                   + ", or it closes by itself later than the first poll waits: the second comes some hundreds of ms after it, and no"
                   " run has watched the gate that long with the subtree off. Either way B2, which writes them first thing and"
                   " polls longer, would find it closed: its poll at op 140 is cleared as far as the AP can clear it, and a2_pre=1"
                   " is next (PLAN.md)." + aps)
    elif v & SST_GPIO_OK and v & SST_PRE_OK:
        out.append("  so: 0x28e5a0050 stayed OPEN with SIO's subtree off, GPIO cycled as B2 cycles it and the 22 words as B2 writes them:"
                   " neither is what the gate follows, as the AP can make them (the 22 went in after the switch-off here, before it"
                   " in B2). The lead on B2's poll at op 140 stands: something else behind that gate is still on, or it only"
                   " closes in B2's own state (PLAN.md)." + aps)
    else:
        out.append("  so: 0x28e5a0050 stayed OPEN, but "
                   + (" and ".join(([] if v & SST_GPIO_OK else ["GPIO's cycle isn't shown made"])
                                   + ([] if v & SST_PRE_OK else ["the 22 didn't all read back as written"])))
                   + ": the part that didn't take isn't ruled out as what the gate follows." + aps)
    if not v & SST_BACK:
        out.append("  without the 43 and the gate confirmed back, the commit may not have found SIO's subtree as the recipe leaves it: the"
                   " restart's time doesn't compare with --m1-gates'")
    else:
        asb2 = bool(v & SST_GPIO_OK) and (not second or bool(v & SST_PRE_OK))
        out.append("  the commit found SIO's subtree as the recipe leaves it, "
                   + ("GPIO at B2's 0" if v & SST_GPIO_OK else "GPIO NOT SHOWN OFF AND IDLE")
                   + ("" if not second else " and the 22 as B2 writes them" if v & SST_PRE_OK else " and THE 22 NOT ALL AS B2 WRITES THEM")
                   + (", which B2 writes there itself: the restart's time is read as --m1-gates' is" if asb2 else
                      ": the restart's time doesn't compare with --m1-gates' cleanly"))
    out.append("  a poll that isn't met takes its 100 ms, so the commit came later than its time stamp, by up to about 9.5 s: a restart"
               " by WD2 would read that much later than it was, and one by WD1's marker, counting since step 4, isn't moved")
    if s == SST_PRE:
        out.append("  stage 0x15, so nothing records the commit after this byte (0x16 or 0x17 comes after it): inconclusive about the"
                   " rest of the entry")
    return out

# acc_last=1's byte, acc_last.h's: bits 4:0 the muxes, in the table's order; bits 7:5 the time's code.
ACL_MUXES = ("0x28e038164", "0x28e03816c", "0x28e038168", "0x28e03815c", "0x28e038170")
ACL_T_PRE, ACL_T_LATE = 7, 6
ACL_T_MS = (5, 10, 20, 50, 100)  # codes 1 to 5: under each
ACL_T8103_MS = 52  # the span T8103 was shown to allow (Naeem Malik's second driver)
ACL_UNDER_MS = 20  # a span under this is called under that figure: the span leaves out the byte's own command, the acks and CPU0's WFI


def acl_lines(s, b, pmp):
    """acc_last=1: 0x6016 at the run's stages (e1-hook/acc_last.h has the layout), read only where the record says it's that
    byte: the stage has pmp_out=1's bit 7, the steps' outcomes, sent just before it, landed, and its code isn't 0."""
    v = b[0x16]
    code = v >> 5
    if not pmp:
        return [f"0x6016 = 0x{v:02x}: not read. An acc_last=1 run's stages always carry pmp_out=1's bit 7, and this one doesn't: not"
                " a record that run leaves"]
    if not fab_landed(b):
        return [f"0x6016 = 0x{v:02x}: not read. acc_last=1's byte goes out after the steps' outcomes, and only if their command"
                " didn't fail, and their marker isn't at 0x6013: the byte isn't shown to have been sent"]
    if not code and s == ACL_PRE:
        return [f"0x6016 = 0x{v:02x}: ACC_LAST'S BYTE DIDN'T LAND (bits 7:5 are 0), though stage 0x11 and the steps' outcomes did:"
                " CPU0 was reading the five ClkGen muxes or sending the byte when the record stopped, before the cluster words"
                " and the commit. A read that faulted (its SError panics the kernel: a restart about 10 s later, if the panic's"
                " restart works), one that never returned (WD1's marker: a restart about 90 s after step 4), or the byte's own"
                " command failing, after which the run went on with nothing more recorded: this record doesn't tell them"
                " apart, and the restart's time, below, only in part"]
    if not code:
        return [f"0x6016 = 0x{v:02x}: bits 7:5 are 0, so acc_last=1's byte didn't survive the reset, or isn't the one sent: stage"
                f" 0x{s:02x} went out after it, and a command that fails stops every one after it. Not read"]
    parked = [bool(v >> i & 1) for i in range(5)]
    out = [f"0x6016 = 0x{v:02x}: acc_last=1's byte, in place of the alarm's result: step 5 was to leave the three CPU complexes'"
           " cluster words out, and CPU0 to read the five ClkGen muxes in step 8, write the three (0x28e098000 := 0,"
           " 0x28e098004 := 0x20, 0x28e098008 := 0x20) right before the commit, and time the run from before the first of"
           " them to after its last stage:",
           "  the five ClkGen muxes the table parked, each read once after the table: "
           + ("all five read 0x80100000, as the table wrote them" if all(parked) else
              "NONE OF THE FIVE READ 0x80100000, the table's value: the park didn't take, or didn't stay, on any of them" if not any(parked) else
              "read 0x80100000, the table's value: " + ", ".join(m for m, p_ in zip(ACL_MUXES, parked) if p_)
              + "; DIDN'T: " + ", ".join(m for m, p_ in zip(ACL_MUXES, parked) if not p_))
           + ("" if all(parked) else " (what a mux that didn't read it did read isn't in the byte: the load's log has all five awake)")]
    if not b[0x12] >> 6 == 3:
        out.append("  (SIO's firmware isn't shown stopped, 0x6012: " + SIO_CODES[b[0x12] >> 6] + ": this run's writes don't depend on"
                   " it, but the recipe's state does)")
    if s == ACL_PRE:
        out.append("  stage 0x11, so nothing records the cluster words or the commit after this byte (0x12 or 0x13 comes after"
                   " them): " + ("the time's code is 7, \"not yet\", as that send has it" if code == ACL_T_PRE else
                                f"the time's code is {code}, which only the send after stage 0x12 or 0x13 carries: that stage's"
                                " command didn't land though a later one did, which this run's commands can't do. Not read as a time")
                   + ". Inconclusive about the rest of the entry")
        return out
    if code == ACL_T_PRE:
        out.append("  the time: NOT RECORDED. The code is still 7, \"not yet\": the stage went out and the command after it,"
                   " with the time, didn't land, or CPU0 stopped between the two. The cluster words were written right before"
                   " the commit all the same (the stage is sent after both); how long the run took from them isn't known")
        return out
    span = (f"under {ACL_T_MS[code - 1]} ms" + (f" ({ACL_T_MS[code - 2]} ms or more)" if code > 1 else "") if code < ACL_T_LATE else
            f"{ACL_T_MS[-1]} ms OR MORE")
    out.append(f"  the time, code {code}: {span} from CPU0's read of the clock before the first cluster word to its read after"
               " this stage went out: the three writes, the commit, the alarm's commands, the release of the other cores, the"
               " waits for WD2 to be armed, for its count to move and for PHASE, the bite's write and the stage's command. Not"
               " in it: this byte's own command, the acks and CPU0's WFI. Nothing records that the other cores left their hold"
               " (hold_nowatch=1): the span bounds their way to their WFI only if they did")
    if s == ACL_WD2[0]:
        out.append("  so: NOT A TEST OF THE LIMIT, whatever the span: CPU0 had an exception pending after the commit and likely"
                   " never went down, so every core wasn't in its wait. The restart's time isn't read (below)")
        return out
    # Only the clean last stage gets here, and has the restart read against the marker (below).
    time = (" The restart's time is read below, against WD1's marker, as far as the marker and WD2's sample bear a reading out:"
            " about 120 s (WD2's bite) in place of 90 s, or 150 s or more, is what B2 getting past its op 224 would give")
    if code < ACL_T_LATE and ACL_T_MS[code - 1] <= ACL_UNDER_MS:
        out.append(f"  so: THE CLUSTER WORDS WERE WRITTEN LAST, AND THE RUN'S LAST STAGE WAS OUT {span.upper()} AFTER THEM: well under"
                   f" the {ACL_T8103_MS} ms T8103 was shown to allow between its first cluster word and every core's wait, as far"
                   " as the span covers it. The tail it leaves out isn't timed: this byte's own command, which was answered, since"
                   " the byte is here (the same command, the alarm's last, is inside the span), the acks and CPU0's WFI. If the"
                   " restart still comes at 90 s, a limit of that size is unlikely to be what ends the runs; that isn't shown,"
                   " and a shorter one on T6000 isn't excluded. An ending that"
                   " changes says the three writes' place matters, not yet that it's the time: they now also come after the"
                   " table's later entries, the power words and the stop requests." + time)
    elif code < ACL_T_LATE and ACL_T_MS[code - 1] <= ACL_T8103_MS:
        out.append(f"  so: THE CLUSTER WORDS WERE WRITTEN LAST, AND THE RUN'S LAST STAGE WAS OUT {span.upper()} AFTER THEM: TOO CLOSE TO"
                   f" CALL against the {ACL_T8103_MS} ms T8103 was shown to allow: the span leaves out this byte's own command, the"
                   " acks and CPU0's WFI, which aren't timed. A restart at 90 s after this neither tests that limit nor clears"
                   " it." + time)
    else:
        out.append(f"  so: THE CLUSTER WORDS WERE WRITTEN LAST, BUT THE RUN TOOK {span.upper()} FROM THEM TO ITS LAST STAGE: not under"
                   f" the {ACL_T8103_MS} ms T8103 was shown to allow. A restart at 90 s after this doesn't test that limit: what"
                   " took the time (the wait for WD2's arming is the long bound, up to 300 ms) is to be cut first. The other"
                   " cores were released inside the span, earlier than its end; how much earlier isn't recorded." + time)
    return out


# a2_pre=1's byte, a2_pre.h's.
A2P_MUX_BAD, A2P_MARK = 0x01, 0x80
A2P_MOVES = (("DCS's p-state word (0x28e20c800) := 2", "asked for 2", "bits 11:8 at 2 with bit 31 clear"),
             ("the fabric's (0x28e20c000) := 2", "asked for 2", "bits 11:8 at 2 with bit 31 clear"),
             ("0x28e20c400 := 0", "asked for 0", "bits 10:8 at 0 with bit 31 clear"))


def a2p_lines(s, b, pmp):
    """a2_pre=1: 0x6016 at the run's stages (e1-hook/a2_pre.h has the layout), read only where the record says it's that byte:
    the stage has pmp_out=1's bit 7, the steps' outcomes, sent just before the moves, landed, and its own bit 7 is set."""
    v = b[0x16]
    if not pmp:
        return [f"0x6016 = 0x{v:02x}: not read. An a2_pre=1 run's stages always carry pmp_out=1's bit 7, and this one doesn't: not a"
                " record that run leaves"]
    if not fab_landed(b):
        return [f"0x6016 = 0x{v:02x}: not read. a2_pre=1's byte goes out after the steps' outcomes, and only if their command didn't"
                " fail, and their marker isn't at 0x6013: the byte isn't shown to have been sent"]
    if not v & A2P_MARK and s == A2P_PRE:
        return [f"0x6016 = 0x{v:02x}: A2_PRE'S BYTE DIDN'T LAND (bit 7 clear), though stage 0x19 and the steps' outcomes did: CPU0 was"
                " reading the five ClkGen muxes or sending the byte when the record stopped, before any of the three writes. A"
                " read that faulted (its SError panics the kernel: a restart about 10 s later, if the panic's restart works),"
                " one that never returned (WD1's marker: a restart about 90 s after step 4), or the byte's own command failing,"
                " after which the run went on with nothing more recorded: this record doesn't tell them apart, and the"
                " restart's time, below, only in part"]
    if not v & A2P_MARK:
        return [f"0x6016 = 0x{v:02x}: bit 7 is clear, so a2_pre=1's byte didn't survive the reset, or isn't the one sent: stage"
                f" 0x{s:02x} went out after it, and a command that fails stops every one after it. Not read"]
    last = s != A2P_PRE  # after the commit: the byte is the last send, whole
    took = [bool(v >> (1 + 2 * i) & 1) for i in range(3)]
    settled = [bool(v >> (2 + 2 * i) & 1) for i in range(3)]
    out = [f"0x6016 = 0x{v:02x}: a2_pre=1's byte, in place of the alarm's result: CPU0 was to read the five ClkGen muxes, then make"
           " A2's three moves in step 8, as A2 makes them at its ops 11 to 16, each with up to 100 ms for A2's condition, and"
           " leave them for the commit:",
           "  the five ClkGen muxes the table parked (0x28e03815c to 0x28e038170), read after the table for the first time: "
           + ("NOT ALL FIVE READ 0x80100000, the table's value: a park didn't take, or didn't stay (which, how many, and what"
              " they read, isn't in the bit)" if v & A2P_MUX_BAD else
              "all five read 0x80100000, as the table wrote them: the AP's writes take in that page, in the recipe's state")]
    for i, (what, asked, cond) in enumerate(A2P_MOVES):
        if last or took[i] or settled[i] or any(took[i + 1:]) or any(settled[i + 1:]):
            out.append(f"  {what}: " + (f"read {asked}" if took[i] else f"DIDN'T READ {asked.upper()}") + "; "
                       + (f"read as A2 waits for it ({cond})" if settled[i] else f"NOT AS A2 WAITS FOR IT ({cond})")
                       + (", at the last read before the commit" if last else ", at the last send's read of it")
                       + (" (what it read before the write isn't recorded in this run: 0x222 awake and after noirq)" if i == 2 and took[i] else ""))
        else:
            out.append(f"  {what}: neither of its bits is set, and none of a later move's: not made by this send, or made and"
                       " neither read")
    out.append("  (fabric_up=1's lines above are about step 5: this run then asks the fabric, and DCS, down to 2 before the commit)")
    if not b[0x12] >> 6 == 3:
        out.append("  (SIO's firmware isn't shown stopped, 0x6012: " + SIO_CODES[b[0x12] >> 6] + ": this run's writes don't depend on"
                   " it, but the recipe's state does)")
    if not last:
        n = max([i + 1 for i in range(3) if took[i] or settled[i]], default=0)
        out.append("  stage 0x19, so nothing records the commit after this byte (0x1a or 0x1b comes after it): "
                   + ("the byte has no move's bits, which is one of three things this record can't tell apart: CPU0 stopped in"
                      " DCS's move (the write, its wait or the read after it); the send after it failed, after which the run"
                      " went on with nothing more recorded; or no write took and the commit's stage didn't land"
                      if not n else
                      "all three moves show in it, so the run stopped at or after the last send, or a later command failed"
                      if n == 3 else
                      f"the last move that shows is {A2P_MOVES[n - 1][0]}, so CPU0 stopped in the move after it ({A2P_MOVES[n][0]}),"
                      " or the send after that move failed and the run went on unrecorded, or that move and any after it neither"
                      " took nor settled and the commit's stage didn't land")
                   + ". A move CPU0 doesn't come through can't be made with a core running, and says no more than that; this"
                   " record alone doesn't show that it was one. Inconclusive about the rest of the entry")
        return out
    # What the time can add. Only the clean last stage has it read against the marker (below).
    time = (" The restart's time is read below, against WD1's marker, as far as the marker and WD2's sample bear a reading out:"
            " about 120 s (WD2's bite) in place of 90 s is what B2 getting past its op 224 would give" if s == A2P_WD2[1] else
            " CPU0 had an exception pending after the commit, so the restart's time isn't read (below)")
    if all(took) and all(settled):
        out.append("  so: ALL THREE MOVES TOOK AND SETTLED before the commit, with CPU0 up: the engine finds A2's own steps made. If"
                   " the restart still comes at 90 s, A2's three waits are less likely to be where the pair stops (not excluded:"
                   " A2 makes them later, with every core down, between its own writes to PHASE and 0x2925c4004)." + time)
    elif not any(took) and not any(settled):
        out.append("  so: NONE OF THE THREE READ AS WRITTEN OR AS A2 WAITS FOR IT. What they did read isn't in the byte: the AP's"
                   " writes were refused, changed back or taken as another value in the recipe's state (the PMP owns DCS under"
                   " Linux), and that says nothing about A2's own." + time)
    else:
        for i, (what, asked, cond) in enumerate(A2P_MOVES):
            if took[i] and not settled[i]:
                out.append(f"  so: A CANDIDATE: {what} TOOK AND DIDN'T SETTLE: the word read {asked} and not {cond} at the last read"
                           " before the commit. That is what A2's own write would meet, and A2 waits on it with no bound. It"
                           " isn't proof that A2 waits there for ever: the AP gave it 100 ms and a little more, with the cores"
                           " as the recipe leaves them, and A2 makes the move with every core down, inside its own handshake.")
            elif not took[i] and settled[i]:
                out.append(f"  so: {what}: THE VALUE DIDN'T READ BACK (not {asked}), though the word read as A2 waits for it"
                           f" ({cond}). The byte doesn't say what bits 3:0 read, nor whether the write changed anything: what"
                           " the word read just before it isn't recorded. A2's own wait would be met by a word that reads so.")
            elif not took[i]:
                out.append(f"  so: {what} DIDN'T TAKE (it read neither {asked} nor as A2 waits for it): the AP's write was"
                           " refused, changed back or taken as another value, and the byte doesn't say which. That says"
                           " nothing about A2's own.")
        out[-1] += time
    return out


# pcie_down=1's byte, pcie_down.h's.
PCD_FOUND_UP, PCD_FOUND_BUSY, PCD_POLL, PCD_DOWN, PCD_ST_OK, PCD_PARENTS, PCD_CLOSED, PCD_MARK = 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80


def pcd_lines(s, b, pmp):
    """pcie_down=1: 0x6016 at the run's stages (e1-hook/pcie_down.h has the layout), read only where the record says it's that
    byte: the stage has pmp_out=1's bit 7, the steps' outcomes, sent just before the switch-off, landed, and its own bit 7 is set."""
    v = b[0x16]
    if not pmp:
        return [f"0x6016 = 0x{v:02x}: not read. A pcie_down=1 run's stages always carry pmp_out=1's bit 7, and this one doesn't: not a"
                " record that run leaves"]
    if not fab_landed(b):
        return [f"0x6016 = 0x{v:02x}: not read. pcie_down=1's byte goes out after the steps' outcomes, and only if their command didn't"
                " fail, and their marker isn't at 0x6013: the byte isn't shown to have been sent"]
    if not v & PCD_MARK and s == PCD_PRE:
        return [f"0x6016 = 0x{v:02x}: PCIE_DOWN'S BYTE DIDN'T LAND (bit 7 clear), though stage 0x1d and the steps' outcomes did: CPU0 was"
                " reading APCIE_GP_SYS, writing 0 to the three _SYS words, polling them, or sending the byte, when the record"
                " stopped. Which of the three were off by then isn't recorded. A read or a write that faulted (its SError panics"
                " the kernel: a restart about 10 s later, if the panic's restart works), one that never returned (WD1's marker: a"
                " restart about 90 s after step 4), or the byte's own command failing, after which the run went on with nothing"
                " more recorded: this record doesn't tell them apart, and the restart's time, below, only in part"]
    if not v & PCD_MARK:
        return [f"0x6016 = 0x{v:02x}: bit 7 is clear, so pcie_down=1's byte didn't survive the reset, or isn't the one sent: stage"
                f" 0x{s:02x} went out after it, and a command that fails stops every one after it. Not read"]
    first = s == PCD_PRE and not v & (PCD_PARENTS | PCD_CLOSED)
    out = [f"0x6016 = 0x{v:02x}: pcie_down=1's byte, in place of the alarm's result: CPU0 was to write 0 to the five PCIe power words"
           " in step 8, as B2 does at its ops 141 to 148, poll as B2 polls, and leave them off for the commit:",
           "  APCIE_GP_SYS (0x28e080320) as found, before any 0: actual state "
           + ("not 0: up, as both looks had it" if v & PCD_FOUND_UP else "0: ALREADY DOWN OR GATED, which no look has seen")
           + ("; BIT 11 ALREADY SET, before B2's 0 or this one" if v & PCD_FOUND_BUSY else "; bit 11 clear"),
           "  APCIE_GP_SYS after its 0 (B2's op 143), polled as B2's op 146 polls it: bit 11 "
           + ("read clear within 100 ms" if v & PCD_POLL else "STAYED SET for 100 ms"),
           "  APCIE_GP_SYS at this send's last read: " + ("target 0, actual state 0, bit 11 clear: off and idle" if v & PCD_DOWN else
                                                       "NOT OFF AND IDLE (its target, its actual state or bit 11)"),
           "  APCIE_ST_SYS and APCIE_ST1_SYS (0x28e0802e8, 0x28e0802f0; B2's ops 141, 142, 144, 145): "
           + ("both polls met, both off and idle" if v & PCD_ST_OK else "A POLL UNMET, OR ONE NOT OFF AND IDLE")]
    if first:
        out.append("  APCIE_ST, APCIE_GP and the gate 0x28e09c34c: not in this byte. Stage 0x1d with neither of its last two bits is the"
                   " first send, or a second send in which neither came out as meant: this record can't tell which")
    else:
        out.append("  APCIE_ST and APCIE_GP (0x28e080148, 0x28e080150; B2's ops 147, 148) within 100 ms of their 0: "
                   + ("both read target 0 and actual state 0" if v & PCD_PARENTS else "NOT both off (B2 doesn't wait for them)"))
        out.append("  0x28e09c34c (B2's op 156) within 100 ms after that: bit 30 "
                   + ("SET, closed" if v & PCD_CLOSED else "clear, open (which may only say that the 21 words B2 sets to 1 first"
                      " weren't moved: RESEARCH.md)"))
    if not b[0x12] >> 6 == 3:
        out.append("  (SIO's firmware isn't shown stopped, 0x6012: " + SIO_CODES[b[0x12] >> 6] + ": this run's writes don't depend on"
                   " it, but the recipe's state does)")
    # What the time can add. Only the clean last stage has it read against the marker (below).
    time = (" The restart's time, below, says how far B2 got all the same: about 120 s (WD2's bite) in place of 90 s (WD1's marker)"
            " means B2 got past its op 224" if s == PCD_WD2[1] else
            " CPU0 had an exception pending after the commit, so the restart's time isn't read (below)" if s == PCD_WD2[0] else "")
    if v & PCD_FOUND_BUSY:
        out.append("  so: BIT 11 WAS SET ON APCIE_GP_SYS BEFORE ANYTHING HERE WROTE IT: the recipe itself leaves the word B2 polls at its"
                   " op 146 with the bit B2 waits on set. ps_words=1's write of 0x1000030f is the one write the recipe makes to it"
                   " (PLAN.md)." + time)
    elif not v & PCD_DOWN:
        out.append("  so: A LEAD ON B2's OP 146: APCIE_GP_SYS DIDN'T READ OFF AND IDLE after the 0, "
                   + ("with the PCIe ports live behind it" if v & PCD_FOUND_UP else "though it was found down or gated already")
                   + (", at the last read before the commit" if not first else ", at the first send's read")
                   + ("; its bit-11 poll wasn't met either" if not v & PCD_POLL else "; its bit-11 poll was met, so it is the power"
                      " state that stayed up, or bit 11 came back")
                   + ". That is what B2's own 0 would meet at its ops 143 and 146. It isn't proof that B2 waits there for good: the"
                   " AP gave it 100 ms and a little more, and the engine's wait is its own. If the restart comes at 90 s, the ports'"
                   " stop before the 0, as T8140's and the M4 Pro's drivers make it, is the next build (PLAN.md)." + time)
    elif not v & PCD_POLL:
        out.append("  so: SLOW, NOT STUCK: bit 11 of APCIE_GP_SYS stayed set past the AP's 100 ms, and the word read off and idle"
                   + (" at the last read before the commit" if not first else " at the first send's read")
                   + ". Whether B2's own poll at op 146 would have outlasted that isn't known; here B2 meets a word that is"
                   " already off." + time)
    elif not v & PCD_FOUND_UP:
        out.append("  so: INCONCLUSIVE: APCIE_GP_SYS was down or gated before the 0, which no look has seen, so the 0 met no live"
                   " port and this run doesn't test B2's op 143 against one. Why the word was down there comes first (PLAN.md)")
    elif not v & PCD_ST_OK:
        out.append("  so: APCIE_GP_SYS went off cleanly, but one of the two storage words didn't, which Linux's suspend leaves off"
                   " already: unexpected, and to be read before anything else (PLAN.md)")
    else:
        out.append("  so: APCIE_GP_SYS went off cleanly with B2's own 0, bit 11 clear, in the recipe's state: B2's PCIe step passes as"
                   " the AP makes it"
                   + ("" if first else ", and all five read off before the commit" if v & PCD_PARENTS else
                      "; APCIE_ST or APCIE_GP didn't read off, which B2 doesn't wait for: the three polled words were off before"
                      " the commit, not all five")
                   + "." + time)
    if s == PCD_PRE:
        out.append("  stage 0x1d, so nothing records the commit after this byte (0x1e or 0x1f comes after it): inconclusive about the"
                   " rest of the entry")
    return out


def ack_lines(f, q, held):
    """cluster_ack=1: 0x6014's bits 4 and 5 with qto's bits 2-5 (e1_hook.c's m1 comment). f has bits 7 and 4 set; held is
    0x6007, sent in one command with qto: non-zero, it shows that command's last bytes landed. It says what the words
    read, and leaves the ending to the stage and wd2_bite=1's sample."""
    out = [f"0x6014 bit 4 (cluster_ack=1): step 5 wrote ANE0's, AFR's and AVEMSR's soc-cluster words (0x28e09800c, 0x28e098014,"
           " 0x28e098020) as 0x20, target 0 with a 1 to bit 5, their up-done flag, not the table's 0; the four cluster waits"
           " asked for the whole word to read 0"]
    rest = bool(f & F_ACK_REST)
    c = q & CLUSTER_WAITS
    stuck = [n for i, n in ACK_WORDS.items() if c >> i & 1]
    more = ("; and at least one of the four words had something else left too (0x6014 bit 5: bit 4, busy, the target or another"
            " bit), which word and which bit isn't recorded" if rest else "")
    if not held and not q:
        out.append("  so: 0x6006 and 0x6007 both read 0. That's also what bytes that didn't land read, and 0x6007 would otherwise say"
                   " no core held: whose flag stayed isn't known from this record. 0x6014, another command's, says "
                   + ("something other than a flag was left in at least one of the four words" if rest else
                      "nothing other than a flag was left in any of the four words"))
    elif c & ACK_WROTE:
        out.append(f"  so: the up-done flag STAYED SET, 10 ms after the write, in {', '.join(stuck)}: the 0x20 didn't clear it there"
                   f"{more}. With a flag left in a word this run wrote, the ending says nothing about cleared flags")
    elif c:
        out.append("  so: ANE0's, AFR's and AVEMSR's flags read clear after their 0x20, and the flag STAYED SET in DISPLAY's, 10 ms"
                   f" after the table's own 0x20, which the earlier runs wrote there too{more}. The three words this run"
                   " changed took the ack; DISPLAY's flag is new: no earlier run looked at it")
    elif rest:
        out.append("  so: no flag stayed: bit 5 read clear in all four words. But at least one of them didn't read 0 within 10 ms of"
                   " its write (0x6014 bit 5): bit 4, busy, the target or another bit was left, and which word and which bit"
                   " isn't recorded. The acks took; what was left is new")
    else:
        out.append("  so: each of the four words read 0 within 10 ms of its write, before the commit: target 0, not busy, and the"
                   " flag clear")
    out.append("  (how the run ended is the stage's and wd2_bite=1's sample's to say; PLAN.md has how an ending reads with this)")
    return out


def run_second(low, compare, now, res, secs=ALARM_SECS):
    """hold=1 from 0x5c on: the commit's whole second, if 0x6016 (res) says the run's 0x140c write was acked and
    the compare value fits it (its second + secs, 3600 but for ll_wake=1's 20, not later than now, with these low two
    bytes); else None. low 0 counts as lost."""
    whole = compare - secs
    return whole if res & 0x88 == 0x88 and low and 0 < whole <= now and whole & 0xffff == low else None


def alarm_byte(v):
    """alarm=1's 0x6016: how far the alarm's commands got."""
    if not v & 0x80:
        return (f"0x6016 = 0x{v:02x}: the alarm's commands left no result (bit 7 clear): they didn't run, or the"
                " byte didn't land or survive; so the alarm wasn't tested. A repeat, not a negative")
    if v in ALARM_ACKED:
        ev = "the event was set, and echoed" if v == 0xbf else "no event was set"
        return f"0x6016 = 0x{v:02x}: every alarm command was acked ({ev}): 0x140c, 0x14c2 = 0, then 0x1401 = 0x41"
    if v not in (0x80, 0x83, 0x85, 0x87, 0x8d, 0x8f, 0x9d, 0x9f):
        return f"0x6016 = 0x{v:02x}: not a value e1_hook writes; don't read it"
    steps = ((0, "0x14c0's read"), (2, "0x14c0's echo" if v & 2 else "no echo needed"), (3, "0x140c"),
             (4, "0x14c2 = 0"), (5, "0x1401 = 0x41"))
    done = [n for bit, n in steps if v >> bit & 1]
    stop = next(n for bit, n in steps if not v >> bit & 1)
    return (f"0x6016 = 0x{v:02x}: the alarm's commands STOPPED at {stop} (before it: {', '.join(done) or 'nothing'}"
            f"{'; the event was set' if v & 2 else ''}): so the alarm wasn't tested. A repeat, not a negative")


def alarm_lines(s, commit, alarm, now, res):
    """The alarm's registers at this boot, always; for an alarm=1 stage, what they say. alarm: 0x1401, the
    compare value, 0x14c0, 0x14c2; res: 0x6016, or None where it isn't the alarm's (alarm_res())."""
    c, when, ev, mask = alarm
    state = {0x01: "not armed", 0x03: "fired, latched"}.get(c)
    if c == 0x41:
        state = f"armed, fires in {when - now} s" if when > now else f"armed, {now - when} s past its time"
    out = [f"PMU alarm: 0x1401 = 0x{c:02x}{f' ({state})' if state else ''}, 0x140c = {when},"
           f" 0x14c0 event 0x{ev:02x}, 0x14c2 mask 0x{mask:02x}"]
    if s not in ALARM_STAGES:
        return out
    right = commit is not None and when == commit + alarm_secs(s)
    recorded, acked = res is not None and bool(res & 0x80), res in ALARM_ACKED
    # gates_mark=1: the alarm's commands ran as ever, but their result isn't recorded.
    nores = "this run records no result for the alarm's commands (gates_mark=1's byte, or sio_down=1's, pcie_down=1's, sio_steps=1's, a2_pre=1's or acc_last=1's, has 0x6016)"
    if commit is None:
        out.append("  the commit's second isn't known, so 0x140c can't be checked")
    elif right:
        out.append(f"  0x140c is the commit's second + {alarm_secs(s)}, as the run wrote it")
    else:
        out.append(f"  0x140c is NOT the commit's second + {alarm_secs(s)} ({commit + alarm_secs(s)}): the alarm wasn't tested")
    if c in (0x41, 0x03):
        if (right and (acked or not recorded)) or (commit is None and acked):
            out.append(f"  the armed alarm survived the reset{' and has fired' if c == 0x03 else ''}")
        elif commit is None:
            out.append("  whether 0x1401 is this run's can't be told: the commit's second isn't known, and "
                       + (nores if res is None else "0x6016 doesn't say its write was acked"))
        else:
            out.append("  0x1401 isn't shown to be this run's: a value from before the run, or macOS's")
    elif c == 0x01 and right:
        if not acked:
            out.append("  0x140c landed, but " + (nores if res is None else "0x1401's write wasn't acked" if recorded else
                                                   "0x6016 recorded no result")
                       + ": nothing shows the enable was ever set")
        elif now < when:
            out.append("  0x1401 reads 0x01 before the alarm's time, with 0x140c right and 0x1401's write acked: the reset"
                       " or the boot firmware cleared the enable (new)")
        else:
            out.append("  0x1401 reads 0x01 past the alarm's time, with 0x140c right and 0x1401's write acked: it may have"
                       " fired (on T8103 a fired alarm reads 0x01), or the reset or the boot firmware cleared the enable;"
                       f" 0x14c0 is 0x{ev:02x}")
    return out


def ctrl(c):
    """A watchdog's control bits, as apple_wdt names them."""
    on = [n for bit, n in ((0, "IRQ_EN"), (1, "IRQ_STATUS"), (2, "RESET_EN")) if c >> bit & 1]
    return f"{c}" + (f" ({', '.join(on)})" if on else " (off)")


def decode(b, rtc, cnt=None, alarm=None, r0201=None):
    """b: 0x6000-0x601f; rtc: 6 bytes at 0x1406; cnt: (CNTVCT, CNTFRQ) or
    None; alarm: the RTC alarm's registers (alarm_lines()), or None; r0201: the
    PMU's register 0x0201, or None. One line per fact."""
    if b[4] == LOOK_STAGE:
        # Not a run, and nothing was stopped or written but these marks.
        return [f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
                f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
                f"stage 0x6004 = 0x{b[4]:02x}: probe=1 look=1 (e1-hook/probe --look), not a run: nothing replayed, nothing was"
                " committed, nothing was stopped and "
                + ("the looks wrote no register; pre_test=1's test, after them, writes the 22 words B2 writes first and writes them"
                   " back (--pre): how far it got is below" if b[0x10] & PRT_PASS else
                   "the looks wrote no register; gate=1's test, after them, changes six power words and writes them back (--gate): how"
                   " far it got is below" if b[0x10] & GATE_PASS else "no register was written")
                + ". What it read is in the kernel log it saved, if the Mac was up to save it"
                ] + (prt_lines(b[0x10], b[5], b[0x11:0x17]) if b[0x10] & PRT_PASS else
                     gate_lines(b[0x10], b[5], b[0x11:0x17]) if b[0x10] & GATE_PASS else look_lines(b[0x10]))
    if b[4] == PROBE_STAGE:
        # Not a run: no commit, no alarm, no restart to time.
        return [f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
                f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
                f"stage 0x6004 = 0x{b[4]:02x}: probe=1 (e1-hook/probe), not a run: nothing replayed and nothing was committed. The"
                " step it reached and its three bytes follow; the kernel log it saved has every word in full, if the Mac came back"
                " to save it"
                ] + probe_lines(b[5], b[6], b[7], b[0x10])
    if b[4] & 0x7f in SIOD1_STAGES:
        # Read by the second form's rules it would say things that run didn't record (Pullfrog on #86).
        return [f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
                f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
                f"stage 0x6004 = 0x{b[4]:02x}: one of sio_down=1's stages in its first form (0xba, 0xbb, 0xbc; b453922), whose byte at"
                " 0x6016 had another layout than the one this version writes and reads. NOT READ. The one run that left such a"
                " record is on file as it was read then: results/sio-down-20261111/crumbs.txt, and RESEARCH.md, \"The `sio_down=1` run\""]
    pmp = bool(b[4] & PMP_TAG)
    s = b[4] & 0x7f
    disp = s in DISP_STAGES  # disp_off=1: read as the position stage, with its own byte B
    if disp:
        s &= ~0x08
    hold = s in HOLD
    late = s in LATE or hold
    base = HOLD.get(s, LATE.get(s, s))  # the stage of runs 1 and 2 it stands for
    obs = base in OBSERVED
    # An observe=1 run, below CPU7's own stages. Not recfg_bite=1's or wd2_bite=1's stage: its 0x6005 is the sample.
    mark = s not in POSITION and s not in SAMPLE_STAGES and 0x10 <= base <= 0x60 and bool(b[5] & 1)
    text = HOLD_TEXT.get(s) or LATE_TEXT.get(s) or stage(base, mark)
    # cluster_ack=1's mark is in 0x6014, sent just before stage 0x4e. None: this record can't say whether it was such a
    # run (a stage one passes before that, or the byte lost). False: a stage, or a run without pmp_out=1, that isn't one's.
    if pmp and s in ACK_MARKED:
        ack = bool(b[0x14] & F_ACK) if b[0x14] & 0x80 else None
    else:
        ack = None if pmp and s in ACK_EARLY else False
    pre = LLR_PRE if s in LLR_STAGES else LLW_PRE if s in LLW_STAGES else LL_PRE if s in LL_STAGES else ACL_PRE if s in ACL_STAGES else A2P_PRE if s in A2P_STAGES else SST_PRE if s in SST_STAGES else PCD_PRE if s in PCD_STAGES else SIOD_PRE if s in SIOD_STAGES else GATES_PRE if s in GATES_STAGES else FAB_PRE  # the run's stage before the commit, for fabric_up=1's byte
    ares = alarm_res(b, s)  # 0x6016 as the alarm's result, or None
    out = [
        f"0x6000: {b[0x00:0x08].hex(' ')}  {b[0x08:0x10].hex(' ')}",
        f"0x6010: {b[0x10:0x18].hex(' ')}  {b[0x18:0x20].hex(' ')}",
        f"boot stage 0x6001 = 0x{b[1]:02x} (0x30 after a boot); boot-error stage 0x6003 = 0x{b[3]:02x}"
        " (the stage the last unclean end found; sticky, so it says nothing about this boot by itself;"
        " this boot's journal says, macsmc-reboot's \"PMU logged N boot error(s)\")",
        f"stage 0x6004 = 0x{b[4]:02x}{' (pmp_out=1: bit 7' + ('; disp_off=1: bit 3' if disp else '') + ', so the stage is ' + hex(s) + ')' if pmp else ''}"
        f"{' (pmgr_late=1)' if late else ''}: {text}",
    ]
    if s:
        out.append("  (the last breadcrumb that reached the PMU: the run got at least that far)")
    if pmp:
        out.append(pmp_byte(b[0x15]))
    elif s == 2 and b[0x15] & 0x80:
        # K1 zeroes these and step 8 can't have run: this can only be K4's.
        out.append(pmp_byte(b[0x15]) + "; K4 finished, its stage write didn't land")
    if mark:
        out.append(f"  observe=1 (0x6005 bit 0): CPU7 was kept up for the observer, so it isn't in"
                   f" {'0x6007' if late else '0x6006 or 0x6007'} and PCPM1 wasn't checked")
    if obs:
        off = b[5]
        out.append(f"0x6005 = 0x{off:02x}: CPU0 {'read off' if off & 1 else 'did NOT read off'} within 500 ms of the"
                   f" hand-over; the E complex (ECPM) {'read off' if off & 0x80 else 'did NOT read off'} within 500 ms"
                   f" more; read off at their release: {cpus(off & 0x7e)}")
        w = b[6]
        wd1 = ctrl(w >> 4 & 7) + (": armed again after step 4 stopped it" if w & 0x40 else "")
        out.append(f"0x6006 = 0x{w:02x}: after the commit, WD2 control {ctrl(w & 7)}; WD1 control {wd1};"
                   f" WD0 {'ARMED again (K2 zeroed its control)' if w & 8 else 'not armed'} to reset; CPU0's last"
                   f" WFI {'HAD RETURNED (not power-gated then)' if w & 0x80 else 'had not returned'}")
        out.append(f"0x6007 = {b[7]}: " + ("no watchdog was armed to reset the SoC" if b[7] == 255 else
                                         f"{b[7]} s until the first armed watchdog's reset, as CPU7 read it"))
    elif base >= 0x10:
        if s in SAMPLE_STAGES:
            pass  # 0x6005 is the sample: recfg_lines() or wd2_lines(), below
        elif s in HOLD_AFTER and s not in SIO_STOP_STAGES:
            out.append(f"read off after the release (0x6005 = 0x{b[5]:02x}, up to 10 ms each): {cpus(b[5] & 0xfe)}")
            if s in POSITION:
                if disp:
                    out.append(f"0x6005 bit 0 (smc_idle=1): the SMC {'acked the AP idle notice within 200 ms' if b[5] & 1 else 'did NOT ack an AP idle notice, or this run sent none'}")
                else:
                    out.append(f"0x6005 bit 0: SIO_CPU's bits 27:24 {'read f' if b[5] & 1 else 'did not read f'} at entry 61's"
                               " wait, the reference for its class")
        else:
            out.append(f"parked (0x6005 = 0x{b[5]:02x}): {cpus(b[5] & 0xfe)}")
        if late and base >= 0x20:
            out.append(f"0x6006 = {qto(b[6], bool(ack))}")
            if ack is None:
                out.append("  (nothing here says whether this was a cluster_ack=1 run: its mark is 0x6014's bit 4, sent just before"
                           " stage 0x4e (0x52 with fabric_up=1, 0x4b with gates_mark=1, 0x3d with sio_down=1, 0x1d with pcie_down=1, 0x15 with sio_steps=1, 0x19 with a2_pre=1, 0x11 with acc_last=1)" + (", and that byte didn't survive" if s in ACK_MARKED else "") + ". In one, bits 2-5 are"
                           " the cluster words whose flag stayed, not the waits on bit 4 that timed out)")
        if base >= 0x30:
            if not late:
                out.append(f"left their spin to stop (0x6006 = 0x{b[6]:02x}): {cpus(b[6])}")
            if not pmp and (s in POS_S2 or s == 0x43):
                pass  # sample 2's, or not decoded: position_lines()
            elif s in FAB_STAGES and not pmp:
                out.append(f"0x6007 = 0x{b[7]:02x}: not read. A fabric_up=1 run's stages always carry pmp_out=1's bit 7, and this one"
                           " doesn't: not a record that run leaves")
            elif s in FAB_STAGES and fab_landed(b):
                out += fab_lines(b[7], pre)
            elif s in FAB_STAGES:
                out.append(f"0x6007 = 0x{b[7]:02x}: not read. The steps' outcomes go out right after stage 0x{pre:02x}'s command, and only if"
                           " it didn't fail, and their marker isn't at 0x6013: that command isn't shown to have landed whole, and this"
                           " byte, its last, may still be the one step 7 leaves here, the cores that held (0xff as a rule). It isn't"
                           " read as fabric_up=1's byte, and no marker in WD1 is taken to stand")
            elif hold:
                out.append(f"wrote their stop bit and held (0x6007 = 0x{b[7]:02x}): {cpus(b[7] & 0xfe)}")
                # sio_on=1's bit, which only its own stages can read when clear: a plain pmp_out=1 run leaves it clear too.
                if pmp and (b[7] & 1 or s in POSITION or s in SIO_STOP_STAGES):
                    out.append(f"0x6007 bit 0 (sio_on=1): ps_sio, UART_P and SPI_P "
                               f"{'all read actual f within 10 ms' if b[7] & 1 else 'did NOT all read actual f within 10 ms'}")
            else:
                out.append(f"read off within 10 ms (0x6007 = 0x{b[7]:02x}): {cpus(b[7])}")
    now = int.from_bytes(rtc[2:6], "little")
    commit = None
    if base in SHORT or s in HOLD_AFTER:
        low = int.from_bytes(b[0x10:0x12], "little")
        whole = run_second(low, alarm[1], now, ares or 0, alarm_secs(s)) if s in HOLD_AFTER and alarm else None
        if whole is not None:
            commit = whole
            out.append(f"RTC second just before the commit, from its low two bytes and the run's alarm: {commit},"
                       f" {now - commit} s before now ({now})")
        elif low:
            commit = now - ((now - low) & 0xffff)
            out.append(f"RTC second just before the commit, from its low two bytes: {commit}, {now - commit} s before"
                       f" now ({now}); right if this read comes within 18 h of the commit")
        else:
            out.append("0x6010-0x6011 read 0: the commit's second was lost (or, 1 run in 65536, really ends in 0000);"
                       " no reset time")
    else:
        secs = int.from_bytes(b[0x10:0x14], "little")
        if base >= 0x01 and secs:
            when = "just before the commit" if base >= 0x50 else "the replay's start (K1)"
            out.append(f"RTC second at {when}: {secs}, {now - secs} s before now ({now})")
            if base >= 0x50:
                commit = secs
    if base >= 0x50:
        f = b[0x14]
        if f & 0x80:
            pend = "".join(n for bit, n in ((2, "A"), (1, "I"), (0, "F")) if f >> bit & 1) or "nothing"
            pcpm1 = "not checked (CPU7 kept up)" if base >= 0x60 or mark else "off" if f & 0x20 else "NOT off"
            pcpm0 = "off" if f & 0x10 else "NOT off"
            if s in SIO_STOP_STAGES:
                pcpm0 = pcpm1 = "not read (hold_nowatch=1: CPU0 doesn't watch them)"
            elif hold and s == 0x5c:
                pcpm0 = pcpm1 = "being rewritten: not decoded"
            elif hold and s not in HOLD_AFTER:
                pcpm0 = pcpm1 = "not read yet (hold=1: nothing goes down before the commit)"
            elif s in HOLD_AFTER:
                pcpm0 += " after the release"
                pcpm1 += " after the release"
            out.append(f"0x6014 = 0x{f:02x}: CPU0 had {pend} pending before the commit;"
                       f" PCPM0 {pcpm0}, PCPM1 {pcpm1};"
                       f" WD1 {'was running (stopped)' if f & 0x40 else 'was off'};"
                       f" K3's kernel-path write after slpa {'FAILED' if f & 0x08 else 'worked'}")
            if ack:
                out += ack_lines(f, b[6], b[7])
            elif s in SIO_STOP_STAGES and f & (F_ACK | F_ACK_REST):
                out.append("  0x6014's bits 4 and 5 are cluster_ack=1's alone in a sio_stop=1 run: bit 5 only with bit 4, and only at"
                           " that run's stages (0x4e, 0x56, 0x57, or fabric_up=1's 0x52, 0x51, 0x53, or gates_mark=1's 0x4b, 0x54, 0x55, or sio_down=1's 0x3d, 0x3e, 0x3f, or pcie_down=1's 0x1d, 0x1e, 0x1f, or sio_steps=1's 0x15, 0x16, 0x17, or a2_pre=1's 0x19, 0x1a, 0x1b, or acc_last=1's 0x11, 0x12, 0x13, with pmp_out=1's bit 7). Here they aren't"
                           " that: don't read them")
        else:
            cmd = ("its own one-byte command" if s in POSITION else
                   "the 3-byte command it went in (0x6012-0x6014)" if s in (0x5d, 0x5e) else
                   "whichever command wrote it last (0x6010-0x6016 or 0x6012-0x6014)" if s == 0x5c else
                   "the 7-byte command it went in (0x6010-0x6016)")
            out.append(f"0x6014 = 0x{f:02x}: bit 7 is clear, so {cmd} didn't survive the reset; don't read it")
    if base in FULL and late:
        # CPU7 sends 0x6012-0x6013 in one command and 0x6015-0x6016 in another;
        # each pair's second byte has bit 7 set, so a pair without it didn't
        # survive the reset (zeroed, say), and its first byte isn't read either.
        t, d = b[0x13], b[0x16]
        lost = "bit 7 is clear, so this byte didn't survive the reset; don't read it"
        if not t & 0x80:
            out.append(f"0x6012 = 0x{b[0x12]:02x}: sent in one command with 0x6013, which didn't survive the reset;"
                       " not read as the waits that timed out")
            out.append(f"0x6013 = 0x{t:02x}: {lost}")
        else:
            out.append(f"0x6012 = {qto(b[0x12])}")
            out.append(f"0x6013 = 0x{t:02x}: EACC's power-down {BUCKETS[t & 7]}; PACC0's {BUCKETS[t >> 3 & 7]};"
                       f" PACC0's was {'STILL PENDING' if t & 0x40 else 'done'} just before the commit (CPU0's read)")
        cl = b[0x15]
        if not d & 0x80:
            out.append(f"0x6015 = 0x{cl:02x}: sent in one command with 0x6016, which didn't survive the reset;"
                       " not read as the soc clusters")
            out.append(f"0x6016 = 0x{d:02x}: {lost}")
        else:
            busy = ",".join(n for i, n in enumerate(SOC) if cl >> i & 1) or "none"
            out.append(f"0x6015 = 0x{cl:02x}: soc clusters still busy at the end of CPU7's watch: {busy} (PACC1"
                       f" expected, CPU7 being up); SIO_CPU's actual state {'NOT off' if cl & 0x80 else 'off'}")
            at5 = (d & 0x1f) == 0x15 and not d & 0x20
            out.append(f"0x6016 = 0x{d:02x}: DCS's p-state at CPU0's last wait before the commit (after entry 50):"
                       f" actual {d & 0xf}, target {'5' if d & 0x10 else 'NOT 5'}, busy bit 31"
                       f" {'SET' if d & 0x20 else 'clear'} ({'settled at 5' if at5 else 'NOT settled at 5'}); SIO's"
                       f" actual state {'NOT off' if d & 0x40 else 'off'} after the commit")
            # The wait after 50 ends met or at its timeout, so a settled
            # 0x6016 means that wait was met: a DCS timeout was 49's.
            if at5 and t & 0x80 and b[0x12] & 1:
                out.append("  so DCS's timed-out wait (0x6012 bit 0) was the one after entry 49: the one after 50"
                           " settled")
    elif base in FULL:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}: the low bytes of the wdt page's +0x28 and +0x40"
                   " after the commit (T8103's S2R-engine progress registers, inferred; e1_hook's load log has"
                   " them awake)")
        cl = b[0x15]
        busy = ",".join(n for i, n in enumerate(SOC) if cl >> i & 1) or "none"
        out.append(f"0x6015 = 0x{cl:02x}: soc clusters still busy: {busy} (PACC1 expected, CPU7 being up);"
                   f" SIO_CPU's actual state {'NOT off' if cl & 0x80 else 'off'}")
        wk = b[0x16]
        if not wk & 0x80:
            out.append(f"0x6016 = 0x{wk:02x}: bit 7 is clear, so this byte didn't survive the reset; don't read it")
        else:
            words = ",".join(str(i) for i in range(7) if wk >> i & 1) or "none"
            out.append(f"0x6016 = 0x{wk:02x}: AP wake-status words with a bit set that wasn't just before the"
                       f" commit: {words}")
    elif base == 0x62:
        out.append(f"0x6012 0x6013 = {b[0x12]:02x} {b[0x13]:02x}, 0x6015 0x6016 = {b[0x15]:02x} {b[0x16]:02x}: CPU0's"
                   " or CPU7's (it was rewriting them): not decoded")
    elif base >= 0x50:
        if s in SIO_STOP_STAGES:
            out += k_lines(b)
            if s in RECFG_STAGES:
                out += recfg_lines(b[5])
            elif s in WD2_STAGES:
                out += wd2_lines(b[5], s in WD2_PEND)
        elif s in POSITION:
            out += position_lines(s, b, pmp, disp)
        elif hold and s in HOLD_AFTER:
            if s == 0x5c:
                out.append("0x6012-0x6014: being rewritten when the breadcrumbs stopped: not decoded")
            elif b[0x14] & 0x80:
                out.append(f"0x6012 = 0x{b[0x12]:02x}: the cores that took the release: {cpus(b[0x12])}")
                out.append(f"0x6013 = 0x{b[0x13]:02x}: of those, the ones with an interrupt pending just before their"
                           f" deep WFI: {cpus(b[0x13])}")
            else:
                out.append("0x6012 0x6013: went in one command with 0x6014, whose bit 7 is clear: not decoded")
        # From 0x5c on, 0x6015 still comes from step 8's command; its marker there is the second's low bytes.
        if pmp or s in POS_S2 or s == 0x43:
            pass  # 0x6015 is the PMP's byte, or a sample's, already printed
        elif s in HOLD_AFTER and not b[0x10:0x12] == bytes(2) or s not in HOLD_AFTER and b[0x14] & 0x80:
            at = "at their stop request (hold=1)" if hold else "at their stop"
            out.append(f"0x6015 = 0x{b[0x15]:02x}: cores with an interrupt pending {at}: {cpus(b[0x15])}")
        elif s in HOLD_AFTER:
            out.append("0x6015: step 8's command, whose second's low two bytes read 0: not decoded")
        if s in GATES_STAGES:
            out += gates_lines(s, b, pmp)
        elif s in SIOD_STAGES:
            out += siod_lines(s, b, pmp)
        elif s in PCD_STAGES:
            out += pcd_lines(s, b, pmp)
        elif s in SST_STAGES:
            out += sst_lines(s, b, pmp)
        elif s in A2P_STAGES:
            out += a2p_lines(s, b, pmp)
        elif s in ACL_STAGES:
            out += acl_lines(s, b, pmp)
        elif s in ALARM_STAGES:
            if s in LLW_STAGES and b[0x16] & LL_BLINK_BIT:
                # ll_wake=1: bit 6 is the keyboard light's; the alarm's result is the byte without it, and the byte is shown whole.
                out.append(alarm_byte(b[0x16] & ~LL_BLINK_BIT).replace(f"0x6016 = 0x{b[0x16] & ~LL_BLINK_BIT:02x}:",
                                                                      f"0x6016 = 0x{b[0x16]:02x} (bit 6 is the keyboard light's, below; without it"
                                                                      f" 0x{b[0x16] & ~LL_BLINK_BIT:02x}):", 1))
            else:
                out.append(alarm_byte(b[0x16]))
            if s in (0x59, 0x5a, 0x4e, FAB_PRE, LL_PRE, LLW_PRE, LLR_PRE) and ares in ALARM_ACKED:
                nxt = {0x59: "0x5f", 0x5a: "0x5b", 0x4e: "0x4f, or recfg_bite=1's 0x46 or 0x47, or wd2_bite=1's 0x56 or 0x57,",
                       FAB_PRE: "0x51 or 0x53", LL_PRE: "0x0a or 0x0b", LLW_PRE: "0x07 or 0x08", LLR_PRE: "0x18 or 0x1c"}[s]
                out.append(f"  stage 0x{s:02x}, so nothing records {'the commit' if s in (0x4e, FAB_PRE, LL_PRE, LLW_PRE, LLR_PRE) else 'the two commit writes'} after those commands ("
                           f"{nxt} comes after them): inconclusive about the rest of the entry")
        elif b[0x14] & 0x80:
            out.append(f"0x6016 = {b[0x16]}: AIC events the cores took off their event registers")
    if commit is not None and cnt and cnt[1]:
        age = cnt[0] / cnt[1]
        x = now - age - commit
        out.append(f"the SoC restarted about {x:.0f} s after the commit ({x - 1:.1f} to {x + 1:.1f} s: the PMU's RTC"
                   f" counts whole seconds); its counter (CNTVCT) is {age:.1f} s old. Right only in the first boot"
                   " after the run")
        if s in FAB_STAGES and pmp and fab_landed(b) and b[7] & (WD1_STANDS | 2) == WD1_STANDS:
            out.append(mark_reading(x, s, b[5]))
    if s in LL_STAGES or any(b[8:0x0f]):
        out += ll_lines(s, b)
    if alarm:
        out += alarm_lines(s, commit, alarm, now, ares)
    out.append(r0201_line(r0201) if r0201 is not None else "PMU 0x0201: not read")
    return out


def main():
    args = sys.argv[1:]
    if args not in ([], ["--clear"]):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)
    clear = args == ["--clear"]
    path = find_nvmem()
    try:
        fd = os.open(path, os.O_RDWR if clear else os.O_RDONLY)
        b = os.pread(fd, 0x20, 0x6000)
        rtc = os.pread(fd, 6, RTC)
        al = [os.pread(fd, n, off) for off, n in ((ALARM_CTRL, 1), (ALARM, 4), (ALARM_EVENT, 1), (ALARM_MASK, 1))]
    except OSError as e:
        die(f"{path}: {e}")
    if len(b) != 0x20 or len(rtc) != 6 or [len(x) for x in al] != [1, 4, 1, 1]:
        die(f"{path}: short read")
    # 0x0201 is an extra: a read of it that fails mustn't keep the record from being read or cleared.
    try:
        r0201 = os.pread(fd, 1, R0201)
    except OSError:
        r0201 = b""
    alarm = (al[0][0], int.from_bytes(al[1], "little"), al[2][0], al[3][0])
    for line in decode(b, rtc, counter(), alarm, r0201[0] if len(r0201) == 1 else None):
        print(line)
    if clear:
        # The run's own alarm: its compare value is the commit's second +
        # 3600, or, with that second lost, 0x6016 says 0x1401's write was acked.
        secs = int.from_bytes(b[0x10:0x14], "little")
        st = b[4] & 0x7f  # pmp_out=1's bit 7 off
        if st in DISP_STAGES:  # and disp_off=1's bit 3
            st &= ~0x08
        res = alarm_res(b, st)  # None after gates_mark=1's and sio_down=1's stages: 0x6016 is that run's byte, never the alarm's result
        if st in HOLD_AFTER:  # hold=1: the second's upper bytes are rewritten; its low two bytes stay
            now_s = int.from_bytes(rtc[2:6], "little")
            low = int.from_bytes(b[0x10:0x12], "little")
            secs = run_second(low, alarm[1], now_s, res or 0, alarm_secs(st)) or (now_s - ((now_s - low) & 0xffff) if low else 0)
        mine = st in ALARM_STAGES and (alarm[1] == secs + alarm_secs(st) if secs else res in ALARM_ACKED)
        try:
            # Before the crumbs, so that a failed disarm keeps the stage for another try.
            if mine and alarm[0] & 0x42:
                if os.pwrite(fd, b"\x01", ALARM_CTRL) != 1:
                    die("short write at 0x1401")
                back = os.pread(fd, 1, ALARM_CTRL)
                if len(back) != 1 or back[0] & 0x40:
                    die("0x1401 still reads armed; the breadcrumbs stay, so this can run again")
                print(f"disarmed: 0x1401 = 0x{back[0]:02x}")
            elif st in ALARM_STAGES and not secs and alarm[0] & 0x40:
                die(f"0x1401 reads armed (0x{alarm[0]:02x}) after an alarm stage, but the commit's second was lost and"
                    " 0x6016 doesn't say 0x1401's write was acked"
                    + (" (after gates_mark=1's, sio_down=1's, pcie_down=1's, sio_steps=1's, a2_pre=1's and acc_last=1's stages it never does: it's that run's byte)" if res is None else "")
                    + ", so whose alarm this is can't be told. Nothing is"
                    " written: the breadcrumbs stay, and clearing it needs Corey's word")
            elif alarm[0] & 0x40:
                print(f"0x1401 reads armed (0x{alarm[0]:02x}) and was left alone: nothing shows this run armed it")
            # The stage's block last: a clear that stops halfway then leaves the stage, and the launchers, which go by a
            # zero stage, refuse (Pullfrog on #80: a run's bytes at 0x6011-0x6016 left under a zero stage).
            # last_look=1's bytes go only after one of its own stages: under any other, whatever is there isn't a run's.
            # obs_gate=1's record, or K1's mark for it, is a run's too, and so is wake_all=1's byte or its mark at 0x6008 (sep_ro=1's too),
            # sep_pg=1's at 0x6009 and disp_hs=1's four bytes or mark at 0x600a, with nothing else in the seven: with anything
            # else there, one field doesn't say whose the others are, and they stay.
            seven = st in LL_STAGES or og_record(st, b[8:0x0f]) or fam_clear(st, b[8:0x0f])
            crumbs = (CRUMBS[0], LL_CRUMBS) + CRUMBS[1:] if seven else CRUMBS
            for off, n in reversed(crumbs):
                if os.pwrite(fd, bytes(n), off) != n:
                    die(f"short write at {off:#x}")
            after = [os.pread(fd, n, off) for off, n in crumbs]
        except OSError as e:
            die(f"{path}: {e}")
        if any(a != bytes(n) for a, (_, n) in zip(after, crumbs)):
            die("cleared, but they don't read back as zeros")
        print(f"cleared: 0x6004-0x{'600e' if seven else '6007'} and 0x6010-0x6016 read back as zeros")
        if not seven and any(b[8:0x0f]):
            print("0x6008-0x600e aren't all 0 and weren't zeroed: no last_look=1 stage, no obs_gate=1 record and no wake_all=1, sep_ro=1,"
                  " sep_pg=1 or disp_hs=1 bytes or mark with zeros in the rest says they're a run's")
    return 0


if __name__ == "__main__":
    sys.exit(main())
