#!/usr/bin/python3 -I
"""e1-hook/m1-crumbs: the breadcrumbs an M1-recipe run (run-floor --m1,
--m1-observe, --m1-late, --m1-alarm, --m1-hold, --m1-hold-nowatch, --m1-pmp,
--m1-pmp-idle, --m1-position, --m1-sio-pmp, --m1-disp-off, --m1-macos-end, --m1-sio-stop, --m1-power-words,
--m1-recfg-bite, --m1-wd2-bite, --m1-cluster-ack, --m1-fabric-up, --m1-mark, --m1-gates or --m1-sio-down; e1_hook m1=1, observe=1, pmgr_late=1,
alarm=1, hold=1, pmp_out=1, position=1, sio_on=1, disp_off=1, one_commit=1, smc_idle=1, sio_stop=1, ps_words=1, recfg_bite=1,
wd2_bite=1, cluster_ack=1, fabric_up=1, wd1_mark=1, gates_mark=1, sio_down=1) leaves in the PMU, read and decoded, and cleared again. And the
three bytes e1-hook/probe (probe=1) leaves, which isn't a run: stage 0x0e.

  e1-hook/m1-crumbs               read them (no root needed)
  pkexec e1-hook/m1-crumbs --clear   zero them, after reading (root)

They're bytes of the PMU's legacy scratch that e1_hook writes through SPMI
(e1_hook.c, m1=1, says when): 0x6004-0x6007 and 0x6010-0x6016, which iBoot
and macOS are believed not to use (DeepIdle's notes; they read 0 here before
the first run), and 0x6001, the boot stage, which macsmc-reboot sets back to
0x30 at every boot. 0x6003, the boot-error stage, is the PMU's own record of
the stage an unclean end found. The PMU is reached through the kernel's nvmem
interface for the pmic@f node, as pmu-alarm does. --clear writes zeros to the
breadcrumb bytes, so that the next run starts clean and no stale byte stays in
state that iBoot and macOS share. After an alarm=1 run that armed the RTC alarm
(stage 0x59 or 0x5f, hold=1's 0x5a-0x5e, position=1's 0x40-0x45, pmp_out=1's the
same as hold=1's with bit 7 set, and the later runs' own, gates_mark=1's and
sio_down=1's among them; and 0x140c the commit's second + 3600,
so that the alarm is the run's), it first sets the alarm's control, 0x1401, back to 0x01, so
that the alarm can't power the Mac on an hour later. It writes nothing else;
in particular not 0x14c0, and not 0x1401 for an alarm that isn't the run's
(macOS's own wakes arm it).

After a run that reached the commit, it also says when the SoC restarted: the
SoC's counter (CNTVCT) restarts with it, so the PMU's RTC now, less the
counter's age, against the commit's RTC second. That holds only in the first
boot after the run, before anything else restarts the Mac. It also prints the
RTC alarm's registers, read-only, and after an alarm=1 run says whether the
alarm was written as the run meant and whether it survived the reset. Exit
status: 0, or 2 if it can't read (or clear) them.
"""
import glob
import os
import sys

NODE = "/soc/spmi@2920a1300/pmic@f"
# Tests point this at a fake nvmem file, and give the counter as "ticks freq".
NVMEM = os.environ.get("M1_CRUMBS_NVMEM")
CNTVCT = os.environ.get("M1_CRUMBS_CNTVCT")

RTC = 0x1406        # info-rtc: 6 bytes LE, the seconds in the upper four; the
                    # read must start here (pmu-alarm)
CRUMBS = ((0x6004, 4), (0x6010, 7))  # the bytes --clear zeroes
# The RTC alarm: control (bit 6 enable, bit 1 latched when it fired), the
# compare value (4 bytes LE, the RTC's seconds), event, mask (pmu-alarm).
ALARM_CTRL, ALARM, ALARM_EVENT, ALARM_MASK = 0x1401, 0x140c, 0x14c0, 0x14c2
# position=1 (run-floor --m1-position): the stages after the commit. 0x6012-0x6013 hold
# sample 1 from 0x42 on, 0x6007 and 0x6015 sample 2 from 0x44 on. With pmp_out=1 (sio_on=1's run: the stages with
# bit 7), sample 1 alone: 0x6007 stays the cores that held, its bit 0 saying ps_sio, UART_P and SPI_P read on, and
# 0x6015 stays K4's byte. disp_off=1's stages are those with bit 3 set too: sample 1's byte B is then K3b's.
POSITION = (0x40, 0x41, 0x42, 0x43, 0x44, 0x45)
POS_S1 = (0x42, 0x43, 0x44, 0x45)
POS_S2 = (0x44, 0x45)
DISP_STAGES = (0x48, 0x49, 0x4a, 0x4c, 0x4d)  # disp_off=1: POSITION's with bit 3
# recfg_bite=1, in place of 0x4f and after the release: 0x6005 is the sample (e1_hook's M1_RECFG_STAGE_PEND and
# M1_RECFG_STAGE: with and without an exception pending on CPU0 after its reads)
RECFG_STAGES = (0x46, 0x47)
# fabric_up=1 (run-floor --m1-fabric-up; e1-hook/fabric_up.h has the stages and the byte): from step 8's command on the
# run has stages of its own, because 0x6007 changes meaning there: 0x52 for sio_stop=1's 0x4e, and 0x51 and 0x53 for
# wd2_bite=1's 0x56 and 0x57 (with and without an exception pending).
FAB_PRE = 0x52
FAB_WD2 = (0x51, 0x53)
# gates_mark=1 (run-floor --m1-gates; e1-hook/gates_mark.h has the words, the byte and the stages): wd1_mark=1's run with the six
# gate words B2 polls and the fabric lane read in step 8, right before the commit, and their byte at 0x6016 in place of the
# alarm's result. So from step 8's command on it has stages of its own, fabric_up=1's with that one difference: 0x4b for 0x52,
# and 0x54 and 0x55 for 0x51 and 0x53. 0x6007 is fabric_up.h's byte at both runs' stages.
GATES_PRE = 0x4b
GATES_WD2 = (0x54, 0x55)
GATES_STAGES = (GATES_PRE,) + GATES_WD2
# sio_down=1 (run-floor --m1-sio-down; e1-hook/sio_down.h has the words, the byte and the stages): gates_mark=1's run with B2's
# switch-off of SIO's subtree made by CPU0 in step 8, and put back, where the gate words' reads were. 0x6016 is its own byte,
# so its stages are its own again: 0x3a for 0x4b, and 0x3b and 0x3c for 0x54 and 0x55.
SIOD_PRE = 0x3a
SIOD_WD2 = (0x3b, 0x3c)
SIOD_STAGES = (SIOD_PRE,) + SIOD_WD2
PRE_STAGES = (FAB_PRE, GATES_PRE, SIOD_PRE)  # the last stage before the commit, from fabric_up=1 on
FAB_STAGES = (FAB_PRE,) + FAB_WD2 + GATES_STAGES + SIOD_STAGES
# wd2_bite=1, the same way: 0x6005 is its own sample (e1_hook's M1_WD2_STAGE_PEND and M1_WD2_STAGE)
WD2_STAGES = (0x56, 0x57) + FAB_WD2 + GATES_WD2 + SIOD_WD2
WD2_PEND = (0x56, FAB_WD2[0], GATES_WD2[0], SIOD_WD2[0])  # CPU0 had an exception pending after its reads
SAMPLE_STAGES = RECFG_STAGES + WD2_STAGES  # 0x6005 isn't the parked cores
SIO_STOP_STAGES = (0x4e, 0x4f) + PRE_STAGES + SAMPLE_STAGES  # sio_stop=1, in place of 0x5a and 0x5b: 0x6012 has the K steps' outcomes
# alarm=1 (0x59, 0x5f), hold=1 (0x5a-0x5e) and position=1: 0x6016 is the alarm's byte, and the alarm may be armed
ALARM_STAGES = (0x59, 0x5f, 0x5a, 0x5b, 0x5c, 0x5d, 0x5e) + POSITION + SIO_STOP_STAGES
ALARM_SECS = 3600  # e1_hook's M1_ALARM_SECS
ALARM_ACKED = (0xbd, 0xbf)  # 0x6016 when every alarm command was acked, 0x1401's write among them
PMP_TAG = 0x80  # pmp_out=1: bit 7 of the stage byte, from K4 on: 0x6015 is the PMP's byte

# Each stage is the last breadcrumb that reached the PMU: the run got at least
# that far. Raw SPMI stops at its first error and CPU0 goes on without it, so
# a run may have gone further than its stage.
