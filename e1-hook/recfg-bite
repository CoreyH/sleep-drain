#!/bin/bash
# e1-hook/recfg-bite: A2's WD2 bite word in the AON engine's reconfig SRAM, for the
# feasibility run (PLAN.md; RESEARCH.md, "A different approach"), as root:
#
#   pkexec /home/corey/src/sleep-drain/e1-hook/recfg-bite            in a safe boot: the check, then the write
#   pkexec /home/corey/src/sleep-drain/e1-hook/recfg-bite --restore  in a safe boot: the old value back
#   pkexec /home/corey/src/sleep-drain/e1-hook/recfg-bite --after    in the first regular boot after the run
#
# Corey's OK of 2026-11-09: one word, 0x292f02010, from 30 s to 45 s, and a read of it
# in the boot after the run. run-floor --m1-recfg-bite runs the first form itself.
#
# The check is recfg_peek's stage 6, read-only: the ten words that say where the bite
# is (the table offset register's analogue and its lock, table A's entry 2, A2's first
# six words), all read before, on 2026-11-08. Its output, and a line that says the write
# comes next, are saved to the boot partition (sleep-drain-safe save) before anything is
# written, so a crash at the write keeps them. The write is recfg_poke patch: it reads
# the ten words again, writes only if they're as expected with the bite at 30 s, and
# reads the word back. Its output is saved too. From the write on, every way out but a
# write that read back and was saved puts the old value back (recfg_poke restore), and
# says so, or says that it couldn't: a log or a save that fails, a signal (bash runs the
# trap once the writer has returned), a writer that fails. A run whose record can't be
# kept isn't made.
#
# --after is the one read outside a safe boot, as recfg-peek --position-after is: stage
# 6 once more, to see whether a restart brought the old value back. It refuses in a
# safe boot, and unless the newest check on record read all ten words (its collected
# log has the verdict line). It writes nothing.
#
# Each step has a directory of its own, /var/log/sleep-drain/recfg-bite-<time>-<step>/,
# never changed after its save (sleep-drain-safe collect keeps the first copy of a
# directory and stops on one that differs).
#
# Exit status: 0, done (the word reads what was asked for, or --after read it); 3, the
# ten words aren't as expected, and nothing was written; 5, the write was made and the
# word didn't read back as written; 1, anything else.
set -u

die() { echo "recfg-bite: $*" >&2; exit 1; }

HERE=$(dirname "$(realpath "$0")")
PEEK=${BITE_PEEK:-$HERE/recfg_peek}
PEEK_SRC=${BITE_PEEK_SRC:-$HERE/recfg_peek.c}
POKE=${BITE_POKE:-$HERE/recfg_poke}
POKE_SRC=${BITE_POKE_SRC:-$HERE/recfg_poke.c}
HEADER=${BITE_HEADER:-$HERE/recfg_bite.h}
SAFE_FLAG=${BITE_SAFE_FLAG:-/run/sleep-drain-safe/active}
SAVE=${BITE_SAVE:-/usr/local/bin/sleep-drain-safe}
LOG_ROOT=${BITE_LOG_ROOT:-/var/log/sleep-drain}

mode=patch
if (($# == 1)) && [[ $1 == --restore ]]; then
  mode=restore
elif (($# == 1)) && [[ $1 == --after ]]; then
  mode=after
elif (($# != 0)); then
  die "usage: recfg-bite [--restore | --after]"
fi

[[ $EUID -eq 0 ]] || die "run as root (pkexec)"
if [[ $mode == after ]]; then
  [[ ! -f $SAFE_FLAG ]] || die "--after is for the regular boot right after the run, not a safe boot"
  shopt -s nullglob
  checks=("$LOG_ROOT"/recfg-bite-*-check)
  shopt -u nullglob
  ((${#checks[@]})) || die "no safe boot's check is on record here (no $LOG_ROOT/recfg-bite-*-check): pkexec /usr/local/bin/sleep-drain-safe collect first"
  # The names sort by time, so the last is the newest. An older check's verdict won't do: a newer one may have stopped at one of these words.
  grep -q "^A2's WD2 bite word, " "${checks[-1]}/log.txt" 2> /dev/null ||
    die "the newest check on record, ${checks[-1]##*/}, never reached its verdict: these addresses haven't been shown safe to read"
else
  [[ -f $SAFE_FLAG ]] || die "this runs in a safe boot only: pkexec sleep-drain-safe boot, then restart"
fi
# Both tools are built from the header too.
built() { [[ -x $1 ]] && [[ $1 -nt $2 ]] && [[ $1 -nt $HEADER ]]; }
if [[ $mode != restore ]]; then
  built "$PEEK" "$PEEK_SRC" || die "$PEEK is missing or older than its source: cc -O2 -Wall -o $PEEK $PEEK_SRC"
fi
if [[ $mode != after ]]; then
  built "$POKE" "$POKE_SRC" || die "$POKE is missing or older than its source: cc -O2 -Wall -o $POKE $POKE_SRC"
fi

now=$(date +%Y%m%dT%H%M%S)

# A step's output is on the disk, or in the boot partition's save, before the next step.
keep() {
  if [[ $mode == after ]]; then
    sync -f "$1"
  else
    sync -f "$1"
    "$SAVE" save > /dev/null
  fi
}

# dir NAME: a step's own directory. Sets out and log.
dir() {
  out=$LOG_ROOT/recfg-bite-$now-$1
  mkdir -p "$out" || die "couldn't make $out"
  log=$out/log.txt
}

# run PROGRAM ARGS...: its output shown, and appended to $log. Sets rc.
run() {
  local st
  "$@" 2>&1 | tee -a "$log"
  st=("${PIPESTATUS[@]}")
  rc=${st[0]}
  if ((st[1] != 0)); then
    keep "$log" > /dev/null 2>&1
    die "couldn't write $log (tee exit ${st[1]}); ${1##*/} exited $rc"
  fi
}

case $mode in
after)
  dir after
  run "$PEEK" 6 "$out"
  keep "$log" || die "couldn't sync $log"
  ((rc == 0 || rc == 3)) || die "the read failed (exit $rc)"
  echo "recfg-bite: read (the verdict is the last line above); nothing was written."
  exit "$rc"
  ;;
restore)
  dir restore
  run "$POKE" restore
  keep "$log" > /dev/null 2>&1 || echo "recfg-bite: couldn't save the restore's record" >&2
  ((rc != 0)) || echo "recfg-bite: the old value is there."
  exit "$rc"
  ;;
esac

# From the write on: the old value back on every way out but a finished, saved patch.
written=0
undo() {
  ((written)) || return 0
  written=0
  if "$POKE" restore > /dev/null 2>&1; then
    echo "recfg-bite: the old value is back (recfg_poke restore)" >&2
  else
    echo "recfg-bite: THE OLD VALUE MAY NOT BE BACK (recfg_poke restore failed): recfg-bite --restore, or restart the Mac" >&2
  fi
}
trap undo EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

echo "recfg-bite: saving under $LOG_ROOT/recfg-bite-$now-*/"
dir check
run "$PEEK" 6 "$out"
if ((rc == 3)); then
  keep "$log" > /dev/null 2>&1
  echo "recfg-bite: the SRAM isn't as expected (above): nothing written. That's a result." >&2
  exit 3
fi
if ((rc != 0)); then
  echo "the check failed (exit $rc); nothing written" | tee -a "$log"
  keep "$log" > /dev/null 2>&1
  die "the check failed (exit $rc); nothing written"
fi
echo "next: recfg_poke patch, one write, 0x292f02010 := 0x405f7e00 (45 s), if the check above still holds" | tee -a "$log"
keep "$log" || die "couldn't save the check; nothing written"

dir write
written=1
run "$POKE" patch
keep "$log" || die "couldn't save the write's record"
case $rc in
0)
  written=0
  echo "recfg-bite: done: A2's WD2 bite word reads 45 s. Until a restart, or recfg-bite --restore."
  ;;
3)
  # The writer read the ten words again and refused: nothing to put back.
  written=0
  echo "recfg-bite: the SRAM changed between the check and the write: nothing written." >&2
  ;;
5)
  echo "recfg-bite: THE WRITE DIDN'T READ BACK (above). That's a result: this SRAM didn't take the write from here." >&2
  ;;
*)
  echo "recfg-bite: recfg_poke failed (exit $rc)" >&2
  rc=1
  ;;
esac
exit "$rc"
