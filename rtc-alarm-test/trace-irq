#!/bin/bash
# Trace the PMU alarm's interrupt on J314s while awake (PLAN.md, B1: why does an
# awake alarm raise its IRQ several times when a sleep raises it once?).
#
#   pkexec rtc-alarm-test/trace-irq [--zero-fraction] [ALARMS]
#
# ALARMS defaults to 3, and it needs rtc-alarm-test/load on this boot.
#
# --zero-fraction: for the run, clear the sub-second part of the PMU's RTC tick
# offset (0x1411). That makes the RTC up to 0.5 s slow, as it was after the PMU
# lost power and the offset was 0. The original six bytes are restored and
# checked on exit, whatever happens. rtc-phase explains why it matters.
#
# For each alarm (4 s ahead, awake) it records, with kprobes and the IRQ
# tracepoint, timestamped:
# - irq_handler_entry for the alarm's IRQ: each edge the SPMI controller dispatched;
# - apple_spmi_irq_handler: each time nub-spmi0's AIC interrupt ran the chained
#   handler (SPMI replies and the PMU's interrupt messages);
# - spmi_raw_cmd, with its opcode, register and return: each SPMI transaction;
# - macsmc_rtc_alarm_irq (the threaded handler) and its return (1 = handled).
# It writes results/trace-irq-<time>.txt, owned by the pkexec user. Every probe
# and event is removed again on exit, and the alarm disarmed.
set -euo pipefail

T=/sys/kernel/tracing
DIR=$(cd "$(dirname "$0")/.." && pwd)
zero=0
if [[ ${1:-} == --zero-fraction ]]; then zero=1; shift; fi
alarms=${1:-3}

die() { echo "trace-irq: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "run as root (pkexec)"
[[ $alarms =~ ^[1-9]$ ]] || die "ALARMS must be 1-9"
[[ -d /sys/module/rtc_macsmc_alarm && -d /sys/module/spmi_apple_wake ]] ||
  die "run rtc-alarm-test/load first"
rtc=
for r in /sys/class/rtc/rtc*; do
  [[ -e $r/wakealarm && $(readlink -f "$r/device") == "$(readlink -f /sys/bus/platform/devices/macsmc-rtc)" ]] && rtc=$r
done
[[ -n $rtc ]] || die "no PMU alarm RTC"
irq=$(awk -F: '/macsmc-rtc/ { gsub(/ /, "", $1); print $1 }' /proc/interrupts)
[[ -n $irq ]] || die "no macsmc-rtc interrupt"
[[ -z $(cat $T/kprobe_events) ]] || die "kprobe_events isn't empty; not touching someone else's probes"
nv=
for d in /sys/bus/nvmem/devices/spmi_nvmem*; do
  [[ $(readlink -f "$d/of_node") == */firmware/devicetree/base/soc/spmi@2920a1300/pmic@f ]] && nv=$d/nvmem
done
[[ -n $nv ]] || die "no nvmem device for the PMU"
# The tick offset: six bytes, read and written in one call each.
offset_get() { python3 -I -c 'import os, sys; fd = os.open(sys.argv[1], os.O_RDONLY); print(os.pread(fd, 6, 0x1411).hex())' "$nv"; }
offset_put() { python3 -I -c 'import os, sys; fd = os.open(sys.argv[1], os.O_WRONLY); assert os.pwrite(fd, bytes.fromhex(sys.argv[2]), 0x1411) == 6' "$nv" "$1"; }
saved=

out=$DIR/results/trace-irq-$(date +%Y%m%dT%H%M%S).txt
owner=${PKEXEC_UID:-0}
count() { awk '/macsmc-rtc/ { s = 0; for (i = 2; i < NF - 3; i++) s += $i; print s }' /proc/interrupts; }
cleanup() {
  if [[ -n $saved ]]; then
    offset_put "$saved" || true
    if [[ $(offset_get) == "$saved" ]]; then
      echo "restored the tick offset ($saved)" | tee -a "$out"
    else
      echo "trace-irq: COULDN'T RESTORE the tick offset $saved: run hwclock --systohc" | tee -a "$out" >&2
    fi
  fi
  echo 0 > $T/tracing_on || true
  echo 0 > $T/events/irq/irq_handler_entry/enable || true
  echo 0 > $T/events/irq/irq_handler_entry/filter || true
  [[ -d $T/events/b1 ]] && { echo 0 > $T/events/b1/enable || true; }
  echo > $T/kprobe_events || true
  echo 0 > "$rtc/wakealarm" || true
  [[ -f $out ]] && chown "$owner" "$out"
}
trap cleanup EXIT

{
  echo 'p:b1/chained spmi_apple_wake:apple_spmi_irq_handler'
  echo 'p:b1/spmi spmi_apple_wake:spmi_raw_cmd opc=%x1:x8 reg=%x3:x16 wlen=%x5:u64 rlen=%x7:u64'
  echo 'r:b1/spmi_ret spmi_apple_wake:spmi_raw_cmd ret=$retval:s32'
  echo 'p:b1/thread rtc_macsmc_alarm:macsmc_rtc_alarm_irq'
  echo 'r:b1/thread_ret rtc_macsmc_alarm:macsmc_rtc_alarm_irq ret=$retval:s32'
} > $T/kprobe_events
echo "irq == $irq" > $T/events/irq/irq_handler_entry/filter
echo 1 > $T/events/irq/irq_handler_entry/enable
echo 1 > $T/events/b1/enable

echo "trace-irq $(date -Is) on $(uname -r): ${rtc##*/}, IRQ $irq, $alarms alarm(s), zero-fraction $zero" | tee "$out"
python3 -I "$DIR/rtc-alarm-test/rtc-phase" 2 | tee -a "$out"
if ((zero)); then
  saved=$(offset_get)
  zeroed=$(python3 -I -c 'import sys; b = bytes.fromhex(sys.argv[1]); v = int.from_bytes(b, "little") & ~0x7fff; print(v.to_bytes(6, "little").hex())' "$saved")
  offset_put "$zeroed"
  echo "tick offset $saved -> $zeroed (fraction cleared)" | tee -a "$out"
  python3 -I "$DIR/rtc-alarm-test/rtc-phase" 2 | tee -a "$out"
fi
for ((n = 1; n <= alarms; n++)); do
  echo 0 > "$rtc/wakealarm"
  echo 0 > $T/tracing_on
  echo > $T/trace
  c0=$(count)
  echo 1 > $T/tracing_on
  echo +4 > "$rtc/wakealarm"
  sleep 8
  echo 0 > $T/tracing_on
  c1=$(count)
  echo "== alarm $n: IRQ $irq count $c0 -> $c1 ($((c1 - c0)))" | tee -a "$out"
  grep -v '^#' $T/trace >> "$out" || true
  sleep 1
done
echo "done: $out"
