#!/bin/bash
# Swap the PMU RTC alarm test into the running kernel on J314s (aurora9),
# without a restart and without writing anything to disk:
#
#   make -C rtc-alarm-test && pkexec rtc-alarm-test/load
#
# 1. Unload rtc_macsmc and macsmc_reboot, which hold the PMU's nvmem cells, and
#    spmi_apple_controller, which takes the PMU's nvmem device with it.
# 2. pmu-alarm-dt.ko describes the alarm in the live device tree.
# 3. spmi-apple-wake.ko probes nub-spmi0 again, now as an interrupt
#    controller, and the PMU's nvmem device comes back with the alarm's cells.
# 4. macsmc_reboot goes back in, and rtc-macsmc-alarm.ko becomes the RTC.
#
# If a step fails, the stock modules go back in where nothing stands in for
# them. A restart undoes all of it: the tree change lives only in memory.
set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)
SPMI_DT=/proc/device-tree/soc/spmi@2920a1300
PMIC=/soc/spmi@2920a1300/pmic@f

die() { echo "load: $*" >&2; exit 1; }
loaded() { [[ -d /sys/module/$1 ]]; }

[[ $EUID -eq 0 ]] || die "run as root (pkexec)"
tr '\0' '\n' < /proc/device-tree/compatible | grep -qx 'apple,j314s' || die "this isn't a J314s"
for ko in pmu-alarm-dt spmi-apple-wake rtc-macsmc-alarm; do
  [[ -f $DIR/$ko.ko ]] || die "no $ko.ko: run make -C $DIR first"
  [[ $(modinfo -F vermagic "$DIR/$ko.ko" | cut -d' ' -f1) == "$(uname -r)" ]] ||
    die "$ko.ko isn't built for $(uname -r): run make -C $DIR again"
done
if [[ -e $SPMI_DT/interrupt-controller ]]; then
  die "the alarm is described already (loaded before this boot?); restart to start over"
fi
for m in rtc_macsmc macsmc_reboot spmi_apple_controller apple_nvmem_spmi; do
  loaded "$m" || die "$m isn't loaded; this expects the stock drivers"
done

restore() {
  echo "load: failed; putting stock modules back where nothing stands in for them" >&2
  set +e
  loaded spmi_apple_wake || loaded spmi_apple_controller || modprobe spmi_apple_controller
  loaded macsmc_reboot || modprobe macsmc_reboot
  loaded rtc_macsmc_alarm || loaded rtc_macsmc || modprobe rtc_macsmc
}
trap restore ERR

echo "1. unloading rtc_macsmc, macsmc_reboot, spmi_apple_controller"
rmmod rtc_macsmc
rmmod macsmc_reboot
rmmod spmi_apple_controller

echo "2. describing the alarm in the live device tree"
insmod "$DIR/pmu-alarm-dt.ko"
[[ -e $SPMI_DT/interrupt-controller ]] || false

echo "3. probing nub-spmi0 with spmi-apple-wake"
insmod "$DIR/spmi-apple-wake.ko"
nvmem=
for _ in $(seq 50); do
  for d in /sys/bus/nvmem/devices/*; do
    if [[ $(readlink -f "$d/of_node" 2>/dev/null) == */firmware/devicetree/base$PMIC ]]; then
      nvmem=$d
    fi
  done
  if [[ -n $nvmem ]]; then break; fi
  sleep 0.1
done
[[ -n $nvmem ]] || { echo "load: the PMU's nvmem device didn't come back" >&2; false; }
echo "   PMU nvmem: ${nvmem##*/}"

echo "4. macsmc_reboot, and rtc-macsmc-alarm"
modprobe macsmc_reboot
insmod "$DIR/rtc-macsmc-alarm.ko"
trap - ERR

rtc=
for r in /sys/class/rtc/rtc*; do
  if [[ $(basename "$(readlink -f "$r/device/driver/module")") == rtc_macsmc_alarm ]]; then
    rtc=$r
  fi
done
[[ -n $rtc ]] || die "rtc-macsmc-alarm loaded, but no RTC is bound to it (see dmesg)"
echo "done: ${rtc##*/}, wakealarm $([[ -e $rtc/wakealarm ]] && echo present || echo MISSING)," \
  "wakeup $(cat "$rtc/device/power/wakeup" 2>/dev/null || echo n/a)"
grep -E 'spmi|macsmc-rtc' /proc/interrupts || echo "no SPMI interrupt in /proc/interrupts"
