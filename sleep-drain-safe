#!/bin/bash
# sleep-drain's safe boot (PLAN.md, A5): one boot in which nothing can write
# the disk, for experiments that may hang or crash the Mac.
#
#   sleep-drain-safe boot [--no-sep]  the next restart only is a safe boot (root)
#   sleep-drain-safe status         is this boot safe, and is the next one?
#   sleep-drain-safe save [PATH..]  in a safe boot: keep results (root)
#   sleep-drain-safe collect        in the next regular boot: put them in place (root)
#   sleep-drain-safe remove         remove the image and the GRUB entry (root)
#
# A safe boot is the regular kernel with its own initramfs, which has the
# sleepdrain-safe hook (safe-boot/): the opened LUKS device is read-only at the
# block layer, and /, /home and /var/log are RAM overlays on read-only mounts.
# The session works as usual; whatever it writes is gone at restart, and a
# crash or hard reset can't damage the filesystem. /boot isn't mounted.
#
# "save" never makes the disk writable. It writes what the boot added to the
# sleep log and snapshots, its journal and any PATH given as one tar to the
# boot partition, mounted just for that. "collect" puts it in place after the
# next regular boot.
#
# The regular initramfs and boot entry stay as they are. The GRUB entry is
# never the default: "boot" selects it for one restart with grub-reboot.
#
# "boot --no-sep" selects a second entry, the same but with apple_sep on the
# kernel's module blacklist, so the Secure Enclave's driver can't load in that
# boot by any path: Linux then never starts the enclave, and nothing can
# service a write to its store (xART: an APFS extent the driver writes
# directly, which the read-only root doesn't cover). For a run that lets the
# SoC go down around the enclave (e1-hook's sep_pg=1). Touch ID doesn't work
# in that boot; the password does. Both entries are always in grub.cfg, each
# with its own id, so choosing one never changes what an earlier "boot" queued.
set -euo pipefail

GRUB_CFG=/boot/grub/grub.cfg
SCRIPT=/etc/grub.d/44_sleep_drain_safe
IMAGE_DIR=/boot/sleep-drain-safe
IMAGE=$IMAGE_DIR/initramfs.img
ENTRY=sleep-drain-safe
ENTRY_NOSEP=sleep-drain-safe-nosep
RUN=/run/sleep-drain-safe
# The kernel's own module blacklist (readable by root alone), and its command line.
KPARAM=/sys/module/kernel/parameters/module_blacklist
PROC_CMDLINE=/proc/cmdline

die() { echo "sleep-drain-safe: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "run as root (pkexec)"; }
is_safe() { [[ -f $RUN/active ]]; }

# The release of the regular linux-aurora: the module tree whose pkgbase file
# says so (test-kernel's trees have none).
regular_release() {
  local d found=
  for d in /usr/lib/modules/*/; do
    [[ -f $d/pkgbase && $(< "$d/pkgbase") == linux-aurora ]] || continue
    [[ -z $found ]] || die "more than one linux-aurora module tree"
    found=$(basename "$d")
  done
  [[ -n $found ]] || die "no linux-aurora module tree"
  echo "$found"
}

# As in test-kernel: grub.cfg without one /etc/grub.d script's section, and a
# regenerated grub.cfg taken only when it differs from the current one in that
# section alone.
without_section() {
  awk -v begin="### BEGIN $2 ###" -v end="### END $2 ###" '
    skip { if ($0 == end) skip = 0; next }
    $0 == begin { skip = 1; if (held && prev == "") held = 0; next }
    { if (held) print prev; prev = $0; held = 1 }
    END { if (held) print prev }' "$1"
}

regen_grub() {
  local new=$GRUB_CFG.sleep-drain-safe.new
  rm -f "$new"
  if ! grub-mkconfig -o "$new" > /dev/null 2>&1; then
    rm -f "$new"
    echo "sleep-drain-safe: grub-mkconfig failed; grub.cfg left as it is" >&2
    return 1
  fi
  if ! cmp -s <(without_section "$new" "$SCRIPT") <(without_section "$GRUB_CFG" "$SCRIPT"); then
    echo "sleep-drain-safe: grub-mkconfig would change more than the safe entries; grub.cfg left as it is:" >&2
    diff <(without_section "$GRUB_CFG" "$SCRIPT") <(without_section "$new" "$SCRIPT") >&2 || true
    rm -f "$new"
    return 1
  fi
  # regen_grub CHECK: CHECK is called with the candidate and must pass before it replaces the live grub.cfg.
  if [[ -n ${1:-} ]] && ! "$1" "$new"; then
    echo "sleep-drain-safe: the regenerated grub.cfg doesn't have the safe entries as written; grub.cfg left as it is" >&2
    rm -f "$new"
    return 1
  fi
  if ! cp "$GRUB_CFG" "$GRUB_CFG.sleep-drain-safe.bak"; then
    rm -f "$new"
    echo "sleep-drain-safe: couldn't back up grub.cfg; left as it is" >&2
    return 1
  fi
  if ! sync "$new" || ! mv -f "$new" "$GRUB_CFG"; then
    rm -f "$new"
    echo "sleep-drain-safe: couldn't put the new grub.cfg in place; the old one stays" >&2
    return 1
  fi
}

# The list of the last module blacklist argument of a kernel command line. The
# kernel keeps the last one it is given, not the sum of them, and takes
# module-blacklist= for the same parameter (it reads - and _ alike in names).
# What follows a "--" isn't the kernel's: it goes to init, and sets nothing.
last_blacklist() {
  local a last=
  for a in $1; do
    [[ $a != -- ]] || break
    [[ $a != module_blacklist=* && $a != module-blacklist=* ]] || last=${a#*=}
  done
  echo "$last"
}

# Whether apple_sep is in that list.
sep_blacklisted() {
  [[ ,$(last_blacklist "$1"), == *,apple_sep,* ]]
}

# A command line with apple_sep added to its module blacklist: one more
# module_blacklist= at the end that repeats the last one's list, since a second
# argument replaces the first and would let that one's modules load again.
# A line whose last list has apple_sep already is left as it is, not made
# longer. Only for a line blacklist_unsure() passes: see there.
no_sep_cmdline() {
  local last
  if sep_blacklisted "$1"; then
    echo "$1"
    return
  fi
  last=$(last_blacklist "$1")
  echo "$1 module_blacklist=${last:+$last,}apple_sep"
}

# Whether a command line has a "--" word, after which nothing is the kernel's,
# or could have one once GRUB has read it: GRUB takes quotes and backslashes
# off, so "--", '--', -"-" and \-\- all reach the kernel as a bare --. Judged
# with those characters taken out: a -- inside a quoted argument with spaces
# is taken for one too, which refuses a line that would have been fine.
has_separator() {
  local a t=${1//[\"\'\\]/}
  local -a w
  read -ra w <<< "$t"
  for a in "${w[@]}"; do
    [[ $a != -- ]] || return 0
  done
  return 1
}

# A command line whose blacklist this script can't work out by splitting at
# spaces: a blacklist argument somewhere, and quoting or a backslash anywhere.
# GRUB takes quotes off before the kernel sees the line, so a later quoted
# blacklist would win unseen. "boot" refuses such a line, in both modes, before
# it writes anything: an entry is never published on a guess.
blacklist_unsure() {
  [[ $1 =~ module[-_]blacklist && $1 == *[\"\'\\]* ]]
}

# Whether an entry's linux line fits the kernel's command line: arm64's buffer
# is 2048 bytes with its NUL, GRUB puts BOOT_IMAGE= and the kernel's path
# first, and what doesn't fit is cut off at the end, which is where the hook's
# flag is: a boot without it isn't read-only. Counted in bytes. A line with
# quoting or a backslash reaches the kernel in another form than it has here
# (GRUB takes quotes off and puts its own on, with escapes), so such a line is
# taken only at under half the limit, which that can't double past.
CMDLINE_MAX=2048
# param_set_charp()'s limit for a string parameter such as module_blacklist.
BLACKLIST_MAX=1024
bytes() {
  local LC_ALL=C
  echo ${#1}
}
fits() {
  local LC_ALL=C full="BOOT_IMAGE=/vmlinuz-linux-aurora ${1#linux /vmlinuz-linux-aurora }"
  if [[ $full == *[\"\'\\]* ]]; then
    ((2 * ${#full} < CMDLINE_MAX))
  else
    ((${#full} < CMDLINE_MAX))
  fi
}

# have_entry CFG ID LINE: CFG's menu entry ID has exactly LINE as its linux line.
have_entry() {
  # Through the environment: awk -v would read backslashes in the line as escapes.
  SDS_ID="--id $2 " SDS_WANT=$3 awk '
    BEGIN { id = ENVIRON["SDS_ID"]; want = ENVIRON["SDS_WANT"] }
    index($0, id) { inside = 1; next }
    inside && $1 == "linux" { sub(/^[ \t]+/, ""); if ($0 == want) found = 1; inside = 0 }
    inside && $0 ~ /^}/ { inside = 0 }
    END { exit !found }' "$1"
}

cmd_boot() {
  local nosep=0
  if [[ ${1:-} == --no-sep ]]; then
    nosep=1
    shift
  fi
  (($# == 0)) || die "usage: sleep-drain-safe boot [--no-sep]"
  need_root
  ! is_safe || die "this is a safe boot already; restart first"
  local release cmdline boot_uuid want plain_line nosep_line id line old
  release=$(regular_release)
  [[ -f /etc/initcpio/hooks/sleepdrain-safe && -f /etc/initcpio/install/sleepdrain-safe ]] ||
    die "the sleepdrain-safe hook isn't installed: run install.sh"

  # The regular entry's command line, so the safe boot opens the same root
  # the same way, plus the flag the hook looks for.
  # From grub.cfg without this script's own section: a safe entry is never the line to copy.
  regular_cmdline() {
    # No exit at the match: awk reads to the end, or without_section would die of SIGPIPE on a long grub.cfg.
    without_section "$GRUB_CFG" "$SCRIPT" |
      awk '!found && $1 == "linux" && $2 == "/vmlinuz-linux-aurora" { $1 = $2 = ""; sub(/^ +/, ""); print; found = 1 }'
  }
  cmdline=$(regular_cmdline)
  [[ -n $cmdline ]] || die "no /vmlinuz-linux-aurora entry in $GRUB_CFG to copy the command line from"
  boot_uuid=$(grub-probe --target=fs_uuid /boot)
  # Refusals first, before the image, the script or grub.cfg is touched: what an
  # earlier "boot" queued stays what it was, image included.
  [[ $cmdline != *'$'* ]] ||
    die "the regular command line has a GRUB variable in it, so what the kernel gets is only known at boot; nothing written, nothing selected: $cmdline"
  ! blacklist_unsure "$cmdline" ||
    die "the regular command line has a module blacklist and quoting, so what the kernel would end up blocking can't be worked out here; nothing written, nothing selected: $cmdline"
  # The flag and the blacklist are added at the line's end, and what follows a "--" goes to init, not the kernel.
  ! has_separator "$cmdline" ||
    die "the regular command line has a -- in it, or what GRUB could make one of: what is added after it goes to init and the kernel never sees it, the module blacklist included; nothing written, nothing selected: $cmdline"
  plain_line="linux /vmlinuz-linux-aurora $cmdline sleepdrain.safe"
  nosep_line="linux /vmlinuz-linux-aurora $(no_sep_cmdline "$cmdline") sleepdrain.safe"
  sep_blacklisted "${nosep_line#linux /vmlinuz-linux-aurora }" || die "couldn't put apple_sep on the module blacklist of: $cmdline"
  # The kernel drops a string parameter over 1024 bytes, and with it the whole list.
  local list
  list=$(last_blacklist "${nosep_line#linux /vmlinuz-linux-aurora }")
  (($(bytes "$list") <= BLACKLIST_MAX)) ||
    die "the module blacklist with apple_sep on it would be $(bytes "$list") bytes, and the kernel drops one over $BLACKLIST_MAX; nothing written, nothing selected"
  fits "$plain_line" && fits "$nosep_line" ||
    die "a safe entry's command line could pass the kernel's $CMDLINE_MAX bytes and lose its end, where the read-only flag is; nothing written, nothing selected"

  # Built fresh every time, so it always matches the installed kernel.
  mkdir -p "$IMAGE_DIR"
  mkinitcpio -k "$release" -A sleepdrain-safe -g "$IMAGE.new" > "$IMAGE_DIR/mkinitcpio.log" 2>&1 ||
    { rm -f "$IMAGE.new"; die "mkinitcpio failed; see $IMAGE_DIR/mkinitcpio.log"; }
  lsinitcpio -a "$IMAGE.new" 2> /dev/null | grep 'sleepdrain-safe' > /dev/null ||
    { rm -f "$IMAGE.new"; die "the new image has no sleepdrain-safe hook"; }
  # The build takes a while: the line the checks above passed must still be the regular entry's.
  [[ $(regular_cmdline) == "$cmdline" ]] ||
    { rm -f "$IMAGE.new"; die "the regular entry's command line changed while the image was built; the old image and entries stay, nothing selected: run it again"; }
  mv -f "$IMAGE.new" "$IMAGE"

  # Two entries with ids of their own, both always there, so that selecting
  # one never rewrites the entry an earlier "boot" has queued.
  want=$(cat <<EOF
#!/bin/sh
# Written by sleep-drain-safe for linux-aurora; remove with: sleep-drain-safe remove
cat <<'MENU'
menuentry 'Safe boot for sleep experiments (disk read-only)' --class omarchy --class gnu-linux --id $ENTRY {
    load_video
    set gfxpayload=keep
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root $boot_uuid
    $plain_line
    initrd /sleep-drain-safe/initramfs.img
}
menuentry 'Safe boot for sleep experiments (disk read-only, no Secure Enclave driver)' --class omarchy --class gnu-linux --id $ENTRY_NOSEP {
    load_video
    set gfxpayload=keep
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root $boot_uuid
    $nosep_line
    initrd /sleep-drain-safe/initramfs.img
}
MENU
EOF
)
  entries_ok() { have_entry "$1" "$ENTRY" "$plain_line" && have_entry "$1" "$ENTRY_NOSEP" "$nosep_line"; }
  # By what grub.cfg has now, not by whether the script was written before: a
  # regeneration that failed last time is made again.
  if [[ ! -f $SCRIPT || $(< "$SCRIPT") != "$want" ]] || ! entries_ok "$GRUB_CFG"; then
    old=
    [[ ! -f $SCRIPT ]] || old=$(< "$SCRIPT")
    printf '%s\n' "$want" > "$SCRIPT"
    chmod 755 "$SCRIPT"
    if ! regen_grub entries_ok; then
      # The script goes back to what grub.cfg was made from.
      if [[ -n $old ]]; then printf '%s\n' "$old" > "$SCRIPT"; else rm -f "$SCRIPT"; fi
      die "the safe entries aren't in grub.cfg as written (see above); nothing selected"
    fi
  fi
  if ((nosep)); then id=$ENTRY_NOSEP line=$nosep_line; else id=$ENTRY line=$plain_line; fi
  have_entry "$GRUB_CFG" "$id" "$line" || die "no $id entry with its command line in $GRUB_CFG; nothing selected"
  grub-reboot "$id" || die "grub-reboot failed; nothing new selected"
  # grub-reboot can return 0 without having written the selection: read it back, once.
  local env
  env=$(grub-editenv - list 2> /dev/null) ||
    die "grub-reboot returned 0, but GRUB's environment block couldn't be read back: whether $id is selected isn't known. Check with: sleep-drain-safe status"
  grep -x -F "next_entry=$id" <<< "$env" > /dev/null ||
    die "grub-reboot returned 0, but the next entry isn't $id: $(grep '^next_entry=' <<< "$env" || echo 'none is set'). Not selected"
  if ((nosep)); then
    echo "the next restart is a safe boot ($release, disk read-only) without the Secure Enclave's driver (apple_sep on the module blacklist); every restart after that is the regular one"
  elif sep_blacklisted "$cmdline"; then
    echo "the next restart is a safe boot ($release, disk read-only); the regular command line already keeps apple_sep out; every restart after that is the regular one"
  else
    echo "the next restart is a safe boot ($release, disk read-only); every restart after that is the regular one"
  fi
}

cmd_status() {
  local next dev
  if is_safe; then
    dev=$(< "$RUN/active")
    # sysfs, not blockdev, so it reads without root
    local ro
    ro=$(cat "/sys/class/block/$(basename "$(realpath "$dev")")/ro" 2> /dev/null || echo '?')
    echo "this boot is a safe boot: $dev read-only $([[ $ro == 1 ]] && echo yes || echo "NO ($ro)")," \
      "/ on $(findmnt -no FSTYPE /)"
    df -h --output=used,size "$RUN/rw" | tail -1 | awk '{ print "RAM used by changes: " $1 " of " $2 }'
    # "Kept out" only on the kernel's own list, which reads as root alone. Without it the command line's text is what
    # was asked for, not what the kernel took (it drops a list over 1024 bytes, and anything after a "--").
    local bl
    if bl=$(cat "$KPARAM" 2> /dev/null); then
      if [[ ,$bl, == *,apple_sep,* ]]; then
        echo "the Secure Enclave's driver is kept out of this boot (the kernel's module blacklist lists apple_sep): apple_sep $([[ -d /sys/module/apple_sep ]] && echo "IS LOADED all the same" || echo "isn't loaded")"
      else
        echo "the Secure Enclave's driver may load in this boot: apple_sep $([[ -d /sys/module/apple_sep ]] && echo "is loaded" || echo "isn't loaded")"
      fi
    else
      echo "NOT VERIFIED whether the Secure Enclave's driver is kept out of this boot: the kernel's own module blacklist reads only as root (pkexec sleep-drain-safe status). The command line $(sep_blacklisted "$(< "$PROC_CMDLINE")" && echo "asks for it" || echo "doesn't ask for it"); apple_sep $([[ -d /sys/module/apple_sep ]] && echo "is loaded" || echo "isn't loaded")"
    fi
  else
    echo "this boot is a regular boot"
  fi
  if ! is_safe && compgen -G "$IMAGE_DIR/saved/*.tar" > /dev/null; then
    echo "results saved in a safe boot are waiting: pkexec sleep-drain-safe collect"
  fi
  next=$(grub-editenv - list 2> /dev/null | sed -n 's/^next_entry=//p')
  if [[ $next == "$ENTRY" ]]; then
    echo "the next restart is a safe boot"
  elif [[ $next == "$ENTRY_NOSEP" ]]; then
    echo "the next restart is a safe boot without the Secure Enclave's driver"
  else
    echo "the next restart is a regular boot"
  fi
}

# The lower (on-disk, read-only) directory of PATH below the overlays, as the
# hook named them: the overlay whose mount point is the longest prefix of PATH.
lower_of() {
  local path=$1 best= mp
  while read -r _ mp type _; do
    [[ $type == overlay && $mp == /* ]] || continue
    if [[ $path == "$mp" || $path == "${mp%/}/"* ]] && (( ${#mp} >= ${#best} )); then
      best=$mp
    fi
  done < /proc/mounts
  [[ -n $best ]] || return 1
  local name=root
  [[ $best == / ]] || name=$(sed 's|/|_|g' <<< "$best")
  echo "$RUN/lower/$name${path#"${best%/}"}"
}

# The boot partition (vfat), from the disk's own fstab below the overlay.
boot_source() {
  awk '$1 !~ /^#/ && $2 == "/boot" { print $1; exit }' "$RUN/lower/root/etc/fstab"
}

# In a safe boot the disk's btrfs stays read-only; it was opened on a
# read-only device, and the overlays sit on it. So save writes nothing there.
# It puts what this boot added into one tar on the boot partition, which the
# safe boot doesn't mount otherwise and mounts here only for the write:
# - log/sleep-drain.log.new: the lines added to /var/log/sleep-drain.log;
# - log/sleep-drain/: the snapshot directories this boot made, and the journal;
# - paths/<PATH>: each PATH given, as it reads now.
# "collect", in the next regular boot, puts them in place.
cmd_save() {
  need_root
  is_safe || die "this isn't a safe boot; nothing to save"
  local now base stage lower n d p src mnt=$RUN/boot tar
  now=$(date +%Y%m%dT%H%M%S)
  # More than one save in a second (recfg-peek saves after each stage): a
  # journal of its own for each, or collect would find one name with different
  # contents, keep the first and leave the later tars on the boot partition.
  base=$now
  n=1
  while [[ -e /var/log/sleep-drain/safe-journal-$now.txt ]]; do
    n=$((n + 1))
    now=$base-$n
  done
  stage=$RUN/rw/save-$now
  for p in "$@"; do
    [[ $p == /* && -e $p ]] || die "$p: give existing absolute paths"
  done
  mkdir -p /var/log/sleep-drain "$stage/log/sleep-drain" "$stage/paths"
  journalctl -b -o short-precise > "/var/log/sleep-drain/safe-journal-$now.txt" 2>&1 || true

  # Only appends happen to the log, so the new lines follow the disk's.
  if [[ -f /var/log/sleep-drain.log ]]; then
    lower=$(lower_of /var/log/sleep-drain.log) || die "no overlay holds /var/log"
    n=0
    [[ -f $lower ]] && n=$(wc -l < "$lower")
    tail -n "+$((n + 1))" /var/log/sleep-drain.log > "$stage/log/sleep-drain.log.new"
  fi
  lower=$(lower_of /var/log/sleep-drain) || die "no overlay holds /var/log"
  for d in /var/log/sleep-drain/*; do
    [[ -e $d && ! -e $lower/${d##*/} ]] || continue
    cp -a "$d" "$stage/log/sleep-drain/"
  done
  for p in "$@"; do
    src=$(realpath -s "$p")
    mkdir -p "$stage/paths$(dirname "$src")"
    cp -a "$src" "$stage/paths$src"
  done
  tar -C "$stage" -cf "$stage.tar" . || die "tar failed; nothing saved"
  rm -rf -- "${stage:?}"

  # The boot partition: mounted, written, synced and unmounted again, whatever
  # happens in between.
  src=$(boot_source)
  [[ -n $src ]] || die "no /boot in the disk's fstab"
  mkdir -p "$mnt"
  mount -t vfat -o rw,flush "$src" "$mnt" || die "couldn't mount $src; the tar is at $stage.tar (RAM)"
  tar=$mnt/sleep-drain-safe/saved/$now.tar
  local n=1
  while [[ -e $tar ]]; do
    n=$((n + 1))
    tar=$mnt/sleep-drain-safe/saved/$now-$n.tar
  done
  if mkdir -p "${tar%/*}" && cp "$stage.tar" "$tar.part" && sync -f "$tar.part" &&
     mv "$tar.part" "$tar" && sync -f "$mnt"; then
    umount "$mnt" || die "saved, but /boot is still mounted at $mnt: restart now"
    rm -f "$stage.tar"
    echo "saved to the boot partition (sleep-drain-safe/saved/${tar##*/})." \
      "After the next regular boot: pkexec sleep-drain-safe collect"
  else
    rm -f "$tar.part"
    umount "$mnt" || echo "sleep-drain-safe: /boot is still mounted at $mnt: restart now" >&2
    die "couldn't write to the boot partition; the tar is at $stage.tar (RAM)"
  fi
}

# In a regular boot: put each saved tar's contents in place, then delete it.
# New log lines are appended (lines the log has already are skipped), snapshot
# directories added (never over existing ones), and saved paths go under
# /var/log/sleep-drain/safe-saved-<time>/, not over the originals.
cmd_collect() {
  need_root
  ! is_safe || die "this is a safe boot: collect in the next regular boot"
  local tar t tmp d
  for tar in "$IMAGE_DIR"/saved/*.tar; do
    [[ -f $tar ]] || continue
    t=$(basename "$tar" .tar)
    tmp=$(mktemp -d)
    tar -C "$tmp" -xf "$tar" || { rm -rf -- "${tmp:?}"; die "couldn't read $tar"; }
    if [[ -s $tmp/log/sleep-drain.log.new ]]; then
      touch /var/log/sleep-drain.log
      # grep exits 1 when every line is there already; anything else above 0
      # is an error, and the tar stays.
      local rc=0
      grep -vxF -f /var/log/sleep-drain.log "$tmp/log/sleep-drain.log.new" >> /var/log/sleep-drain.log || rc=$?
      if (( rc > 1 )); then
        rm -rf -- "${tmp:?}"
        die "couldn't add $t's log lines (grep exit $rc); $tar kept"
      fi
    fi
    mkdir -p /var/log/sleep-drain
    # A later save in the same safe boot repeats what an earlier one saved, so
    # an existing snapshot or journal that's identical is collected already.
    # One that differs stays, and so does the tar.
    local keep=0 dst
    for d in "$tmp"/log/sleep-drain/*; do
      [[ -e $d ]] || continue
      dst=/var/log/sleep-drain/${d##*/}
      if [[ ! -e $dst ]]; then
        cp -a "$d" /var/log/sleep-drain/
      elif ! diff -rq "$d" "$dst" > /dev/null 2>&1; then
        echo "kept the existing $dst, which differs from $t's copy; $tar stays" >&2
        keep=1
      fi
    done
    if [[ -n $(ls -A "$tmp/paths" 2> /dev/null) ]]; then
      mkdir -p "/var/log/sleep-drain/safe-saved-$t"
      cp -a "$tmp/paths/." "/var/log/sleep-drain/safe-saved-$t/"
      echo "saved paths from $t are in /var/log/sleep-drain/safe-saved-$t/"
    fi
    rm -rf -- "${tmp:?}"
    if (( keep )); then
      echo "collected $t, except what differs; $tar kept" >&2
    else
      rm -f "$tar"
      echo "collected $t"
    fi
  done
}

cmd_remove() {
  need_root
  ! compgen -G "$IMAGE_DIR/saved/*.tar" > /dev/null || die "uncollected results in $IMAGE_DIR/saved: collect first"
  rm -f "$SCRIPT"
  regen_grub || die "grub.cfg not regenerated; the image is still in place"
  if grub-editenv - list | grep -x -e "next_entry=$ENTRY" -e "next_entry=$ENTRY_NOSEP" > /dev/null; then
    grub-editenv - unset next_entry
  fi
  rm -rf -- "${IMAGE_DIR:?}"
  echo "removed the safe boot"
}

case "${1:-}" in
  boot) shift; cmd_boot "$@" ;;
  status) cmd_status ;;
  save) shift; cmd_save "$@" ;;
  collect) cmd_collect ;;
  remove) cmd_remove ;;
  *) echo "usage: sleep-drain-safe boot [--no-sep] | status | save [PATH...] | collect | remove" >&2; exit 2 ;;
esac
