#!/bin/bash
# Summarise /var/log/sleep-drain.log: one row per suspend, plus suspends the
# battery did not survive (a "pre" with no "post" before the next "pre").

LOG=${1:-/var/log/sleep-drain.log}
[ -r "$LOG" ] || { echo "no log at $LOG yet" >&2; exit 1; }

awk '
  function get(k,   i) { for (i = 3; i <= NF; i++) if (index($i, k "=") == 1) return substr($i, length(k) + 2); return "-" }
  # 7.1.12-2-11.16-sep-ARCH -> 11.16 (iconidentify build), 7.2.10-1-2-ARCH -> 7.2.10
  function kern(k,   a) { if (k == "-") return k; split(k, a, "-"); return (k ~ /-sep-/) ? a[3] : a[1] }
  BEGIN { printf "%-16s %6s %8s %7s %6s %6s %-9s %-7s %-7s %-4s %-4s %-5s %-7s %-5s %-4s %-24s %s\n", "slept at", "hours", "pct", "%/h", "mW", "mW(cc)", "valid", "kernel", "radios", "wake", "pcie", "pmp", "aop", "wifi", "bt", "typec", "displays" }
  $2 == "pre" {
    if (pending) printf "%-16s %6s %8s %7s %6s %6s %-9s %s\n", start, "?", startcap "->dead?", "-", "-", "-", "no-post", "(no resume logged)"
    pending = 1; start = substr($1, 1, 16); startcap = get("capacity") "%"; radios = get("radios"); wake = get("wake"); pcie = get("pcie"); pmp = get("pmp_release"); aop = get("aop"); wifi = get("wifi"); bt = get("bt"); next
  }
  $2 == "post" && pending {
    pending = 0
    # wifi/bt as they were going to sleep (post sees them after the hook restored them)
    printf "%-16s %6.1f %8s %7s %6s %6s %-9s %-7s %-7s %-4s %-4s %-5s %-7s %-5s %-4s %-24s %s\n", start, get("slept_s") / 3600,
      startcap "->" get("capacity") "%", get("pct_per_h"), get("avg_mw"), get("avg_mw_cc"), get("valid"),
      kern(get("kernel")), radios, wake, pcie, pmp, aop, wifi, bt, get("typec"), get("displays")
  }
  END { if (pending) printf "%-16s %6s %8s %7s %6s %6s %-9s %s\n", start, "?", startcap, "-", "-", "-", "pending", "(suspended now, or did not resume)" }
' "$LOG"
